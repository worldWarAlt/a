	end

	-- Event:FireServer(<the line>, "<its category folder name>")
	local function fireLine(line, chain)
		local g, ev = getVoice()
		if not ev then return false end
		if not (line and line:IsDescendantOf(g)) then line = nodeAt(chain) end
		if not (line and line.Parent) then return false end
		ev:FireServer(line, line.Parent.Name)
		return true
	end

	---------------- HOTBAR: pin lines (or whole folders = random line) to keys, usable mid-fight with the panel closed
	local HOTBAR_FILE = "voicelines_hotbar.json"
	local DEFAULT_KEYS = {
		"Z", "X", "C", "V", "B", "N", "M", "J", "K", "L", "U", "I", "O", "P", "Y", "T", "G", "H",
		"One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Zero",
	}
	local MAX_PINS = 28
	local SLOT_W, SLOT_GAP = 72, 5
	local pins = {} -- { { chain = {names...}, key = "Z" }, ... }  (order here = order on screen)
	local hotPos = nil -- { x = 0..1, y = 0..1 } screen fraction of the hotbar's bottom-centre, nil = default spot
	local editMode = false

	pcall(function()
		if isfile and readfile and isfile(HOTBAR_FILE) then
			local d = HttpService:JSONDecode(readfile(HOTBAR_FILE))
			if type(d) ~= "table" then return end
			local list = d.pins or d -- older saves were a bare array of pins
			if type(d.pos) == "table" and type(d.pos.x) == "number" and type(d.pos.y) == "number" then
				hotPos = { x = math.clamp(d.pos.x, 0, 1), y = math.clamp(d.pos.y, 0, 1) }
			end
			for _, p in ipairs(list) do
				if #pins < MAX_PINS and type(p) == "table" and type(p.chain) == "table" and #p.chain > 0 and type(p.key) == "string" then
					pins[#pins + 1] = { chain = p.chain, key = p.key }
				end
			end
		end
	end)

	local function savePins()
		if writefile then pcall(writefile, HOTBAR_FILE, HttpService:JSONEncode({ pins = pins, pos = hotPos })) end
	end

	local function sameChain(a, b)
		if #a ~= #b then return false end
		for i = 1, #a do if a[i] ~= b[i] then return false end end
		return true
	end

	local function findPin(chain)
		for i, p in ipairs(pins) do
			if sameChain(p.chain, chain) then return i end
		end
		return nil
	end

	local function isLeafNode(n)
		return n:IsA("Sound") or #n:GetChildren() == 0
	end

	local function collectLeaves(node, chain, out)
		for _, kid in ipairs(node:GetChildren()) do
			local c = table.clone(chain)
			c[#c + 1] = kid.Name
			if isLeafNode(kid) then
				out[#out + 1] = { inst = kid, chain = c }
			else
				collectLeaves(kid, c, out)
			end
		end
		return out
	end

	-- leaf = fire that line; folder = fire a random line from it
	local function firePin(chain)
		local node = nodeAt(chain)
		if not node then return false end
		if isLeafNode(node) then return fireLine(node, chain) end
		local leaves = collectLeaves(node, chain, {})
		if #leaves == 0 then return false end
		local pick = leaves[math.random(#leaves)]
		return fireLine(pick.inst, pick.chain)
	end

	local function unusedKey()
		for _, k in ipairs(DEFAULT_KEYS) do
			local used = false
			for _, p in ipairs(pins) do if p.key == k then used = true break end end
			if not used then return k end
		end
		return nil
	end

