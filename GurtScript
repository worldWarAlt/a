---------------------------------------------------------------- 24) animation replace
runSection("24", function()
	-- game animation id -> replacement animation id
	local MAP = {
		["114891880675311"] = "rbxassetid://108890808800033",
		["97660793956521"]  = "rbxassetid://111371061821635",
		["120021777910522"] = "rbxassetid://108890808800033", -- third swing uses the first swing's replacement
	}

	-- Event based: the game's track is hidden (weight 0, lowest priority) the moment it starts and the replacement
	-- plays instead with the same priority / looping / speed / weight. The per-frame step only exists while at
	-- least one replacement is running.
	local on = false
	local hooked = {}  -- [animator] = { conn, dconn }
	local active = {}  -- [game track] = { rep, animator, w, stopConn }
	local prio = setmetatable({}, { __mode = "k" }) -- game track -> its real priority (it gets demoted)
	local conns = {}
	local stepConn = nil
	local repSet = setmetatable({}, { __mode = "k" }) -- our own replacement tracks: never stopped

	local function release(orig, st)
		active[orig] = nil
		if st.stopConn then st.stopConn:Disconnect() end
		pcall(function() if st.rep.IsPlaying then st.rep:Stop(0.1) end end)
	end

	local function step()
		if next(active) == nil then
			if stepConn then stepConn:Disconnect() stepConn = nil end
			return
		end
		for orig, st in pairs(active) do
			if orig.IsPlaying then
				local w = orig.WeightTarget
				if w > 0.001 then -- the game track is kept hidden; the replacement always plays at full weight
					st.w = w
					orig:AdjustWeight(0, 0)
				end
				local sp = orig.Speed
				if st.rep.Speed ~= sp then st.rep:AdjustSpeed(sp) end
			end
		end
	end

	local function handle(track, animator)
		if repSet[track] then return end
		local id = Kit.idOf(track)
		local repId = id and not Kit.viral.swingIds[id] and MAP[id] -- a VIRAL pack owns its swing animations
		if not repId then return end -- not one we replace: leave it completely alone
		local pool = nil
		if type(repId) == "table" then pool, repId = repId, nil end

		local st = active[track]
		if st then
			-- the game restarted the same track: restart a one-shot replacement too
			if not st.rep.Looped then
				st.rep:Stop(0)
				st.rep:Play(0.05, 1, track.Speed)
				Kit.override(animator, st.rep)
			end
			return
		end

		local rep
		if pool then
			local ready = {}
			for _, cand in ipairs(pool) do
				local t = Kit.get(animator, cand)
				if t and t.Length > 0 then ready[#ready + 1] = t end
			end
			rep = ready[#ready > 0 and math.random(#ready) or 1]
		else
			rep = Kit.get(animator, repId)
		end
		if not rep or rep.Length <= 0 then return end -- not loaded yet: leave the game's animation alone

		repSet[rep] = true
		Kit.protect[rep] = true
		if prio[track] == nil then prio[track] = track.Priority end
		local w = track.WeightTarget
		if w <= 0.001 then w = 1 end

		-- highest priority: Action4 for one-shots, Action3 for loops (a one-shot still beats a loop), full weight
		rep.Looped = track.Looped
		rep.Priority = rep.Looped and Enum.AnimationPriority.Action3 or Enum.AnimationPriority.Action4
		if rep.IsPlaying then rep:Stop(0) end
		rep:Play(0.1, 1, track.Speed)
		Kit.silence(track, "animrep")
		Kit.override(animator, rep) -- everything else that could compete is pushed under it until it is done

		st = { rep = rep, animator = animator, w = w }
		active[track] = st
		st.stopConn = track.Stopped:Once(function()
			if active[track] == st then active[track] = nil end
			-- looped replacement follows the game track; one-shots finish by themselves
			if rep.Looped and rep.IsPlaying then rep:Stop(0.1) end
		end)
		if not stepConn then stepConn = RunService.RenderStepped:Connect(step) end
	end

	local function hookAnimator(a)
		if hooked[a] then return end
		local h = {}
		hooked[a] = h
		for _, repId in pairs(MAP) do -- start loading the replacements now
			if type(repId) == "table" then
				for _, r in ipairs(repId) do Kit.get(a, r) end
			else
				Kit.get(a, repId)
			end
		end
		h.conn = a.AnimationPlayed:Connect(function(t) handle(t, a) end)
		h.dconn = a.Destroying:Once(function()
			if h.conn then h.conn:Disconnect() end
			hooked[a] = nil
			for orig, st in pairs(active) do
				if st.animator == a then release(orig, st) end
			end
		end)
		for _, t in ipairs(a:GetPlayingAnimationTracks()) do handle(t, a) end -- already playing right now
	end

	local function hookModel(model)
		if not model then return end
		task.spawn(function()
			local hum = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 10)
			local a = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 10))
			if a and on then hookAnimator(a) end
		end)
	end

	local function setOn(state)
		if state == on then return end
		on = state
		for id in pairs(MAP) do Kit.arIds[id] = on or nil end -- SIN skips these game animations while ANIM REPLACE is on
		if on then
			conns[#conns + 1] = LocalPlayer.CharacterAdded:Connect(hookModel)
			local folder = Workspace:FindFirstChild("Characters")
			if folder then
				conns[#conns + 1] = folder.ChildAdded:Connect(function(c)
					if c.Name == LocalPlayer.Name then hookModel(c) end
				end)
			end
			hookModel(LocalPlayer.Character)
			local m = folder and folder:FindFirstChild(LocalPlayer.Name)
			if m and m ~= LocalPlayer.Character then hookModel(m) end
		else
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			if stepConn then stepConn:Disconnect() stepConn = nil end
			for orig, st in pairs(active) do
				release(orig, st)
				pcall(function() if orig.IsPlaying then orig:AdjustWeight(st.w, 0.1) end end)
			end
			for a, h in pairs(hooked) do
				if h.conn then h.conn:Disconnect() end
				if h.dconn then h.dconn:Disconnect() end
				hooked[a] = nil
			end
			Kit.overrideEnd()
			Kit.restore("animrep")
		end
	end
	onCleanup(function() setOn(false) end)

	local setVisual
	setVisual = makeToggleCard("AnimReplaceGui", "AnimReplaceToggle", "ANIM REPLACE", 10, Color3.fromRGB(120, 200, 255), 1096, function()
		setOn(not on)
		return on
	end)
	FeatureHooks.animreplace = function() setOn(false) setVisual(false) end
end)

