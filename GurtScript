						Position = on and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
					}):Play()
				end
				render()

				row.MouseButton1Click:Connect(function()
					on = not on
					render()
					callback(on)
				end)

				return row
			end

			local function makeMiscButton(name, text, color)
