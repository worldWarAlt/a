	end)

	local function fit()
		local cam = Workspace.CurrentCamera
		local h = cam and cam.ViewportSize.Y or 600
		uiScale.Scale = math.clamp((h - 16) / FULL_H, 0.55, 1)
	end

	-- the panel can be dragged freely, also partly (or mostly) out of the screen; once it is let go (or the screen
	-- changes) it is only nudged back if the title bar would end up out of reach
	local function rescue()
		if not (main and uiScale) then return end
		local cam = Workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(800, 450)
		local ap, sz = main.AbsolutePosition, main.AbsoluteSize
		local margin = 64
		local dx, dy = 0, 0
		if ap.X + sz.X < margin then dx = margin - (ap.X + sz.X)
		elseif ap.X > vp.X - margin then dx = (vp.X - margin) - ap.X end
		if ap.Y < 0 then dy = -ap.Y
		elseif ap.Y > vp.Y - 40 then dy = (vp.Y - 40) - ap.Y end
		if dx ~= 0 or dy ~= 0 then
			local sc = uiScale.Scale
			local p = main.Position
			main.Position = UDim2.new(p.X.Scale, p.X.Offset + dx / sc, p.Y.Scale, p.Y.Offset + dy / sc)
		end
	end

