				for _, f in ipairs(features) do setKeep(f.key, fn(f.key)) end
				syncKept()
				saveConfig()
			end)
		end
		barButton("KEEP ALL", 0, function() return true end)
		barButton("KEEP NONE", 0.5, function() return false end)

		for i, f in ipairs(features) do
			local row = Instance.new("TextButton")
			row.Size = UDim2.new(1, -6, 0, 30)
			row.BackgroundColor3 = ROW_BG
			row.BorderSizePixel = 0
			row.AutoButtonColor = false
			row.Text = ""
			row.LayoutOrder = i
			row.Parent = kpScroll
			Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)

			local name = Instance.new("TextLabel")
			name.BackgroundTransparency = 1
			name.Size = UDim2.new(1, -70, 1, 0)
			name.Position = UDim2.new(0, 10, 0, 0)
			name.Font = Enum.Font.GothamMedium
			name.Text = f.label
			name.TextSize = 12
			name.TextColor3 = Color3.fromRGB(235, 235, 245)
			name.TextXAlignment = Enum.TextXAlignment.Left
			name.TextTruncate = Enum.TextTruncate.AtEnd
			name.Parent = row

			local state = Instance.new("TextLabel")
			state.BackgroundTransparency = 1
			state.Size = UDim2.new(0, 56, 1, 0)
			state.Position = UDim2.new(1, -62, 0, 0)
			state.Font = Enum.Font.GothamBold
			state.TextSize = 11
			state.TextXAlignment = Enum.TextXAlignment.Right
			state.Parent = row
			kpRows[f.key] = state
			paintRow(f.key)

			row.Activated:Connect(function()
				setKeep(f.key, keepOnClose[f.key] ~= true)
				syncKept()
				saveConfig()
			end)
		end

		-- row inside the settings panel
		local kpRow = Instance.new("TextButton")
		kpRow.Size = UDim2.new(1, -6, 0, 34)
		kpRow.BackgroundColor3 = ACCENT
		kpRow.BorderSizePixel = 0
		kpRow.AutoButtonColor = true
		kpRow.Text = "KEEP ON CLOSE...  >"
		kpRow.Font = Enum.Font.GothamBold
		kpRow.TextSize = 12
		kpRow.TextColor3 = Color3.fromRGB(255, 255, 255)
		kpRow.LayoutOrder = 0
		kpRow.Parent = scroll
		Instance.new("UICorner", kpRow).CornerRadius = UDim.new(0, 8)
		kpRow.Activated:Connect(function()
			setPanel(false)
			kpPanel.Visible = true
		end)

		local function hideGui(g)
			if OV.kept(g.Name) then return end -- the overlay of a pinned button (visor HUD) stays
			if g.Enabled then
				hidden[g] = true
				g.Enabled = false
			end
			if not guards[g] then
				guards[g] = g:GetPropertyChangedSignal("Enabled"):Connect(function()
					if allClosed and g.Enabled and not OV.kept(g.Name) then
						hidden[g] = true -- remember it should come back on OPEN
						g.Enabled = false
					end
				end)
			end
		end

		-- a pin was added / removed while CLOSE is active: bring the overlay back, or hide it again
		function OV.sync()
			if not allClosed then return end
			for _, names in pairs(OV.map) do
				for _, n in ipairs(names) do
					local g = PlayerGui:FindFirstChild(n)
					if g then
						if OV.kept(n) then
							if hidden[g] then
								hidden[g] = nil
								g.Enabled = true
							end
						elseif g.Enabled then
							hideGui(g)
						end
					end
				end
			end
		end

		local function setAllClosed(on)
			allClosed = on
			syncKept()
			if on then
				setPanel(false)
				kpPanel.Visible = false
				if tpPanel then tpPanel.Visible = false end
				for _, g in ipairs(PlayerGui:GetChildren()) do
					if g:IsA("ScreenGui") and GUI_SET[g.Name] then hideGui(g) end
				end
			else
				for g, c in pairs(guards) do
					c:Disconnect()
					guards[g] = nil
				end
				for g in pairs(hidden) do
					hidden[g] = nil
					if g.Parent then g.Enabled = true end
				end
			end
			closeAll.Text = on and "OPEN" or "CLOSE"
			closeAll.TextColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(190, 190, 210)
			closeAll.BackgroundColor3 = on and ACCENT or CARD_BG
			closeAllStroke.Color = on and ACCENT or STROKE_OFF
		end

		closeAll.Activated:Connect(function() setAllClosed(not allClosed) end)

		-- a GUI created while closed (a panel opened by a script, a grip gizmo...) is hidden too
		bind(PlayerGui.ChildAdded:Connect(function(g)
			if allClosed and g:IsA("ScreenGui") and GUI_SET[g.Name] then hideGui(g) end
		end))
		onCleanup(function()
			for g, c in pairs(guards) do
				c:Disconnect()
				guards[g] = nil
			end
		end)
	end

	-- ---------- UI KEEPER: SETTINGS / CLOSE (SettingsGui) and EDIT (LayoutEditorGui) are re-checked 4 times a second ----------
	-- if the game (or anything else) disables the gui, re-parents it, hides a pill or pushes it off screen, it is put straight back.
	-- CLOSE on purpose (the pill says OPEN) is respected: the layout gui is left alone while it is closed.
	do
		local alive = true
		onCleanup(function() alive = false end)

		local function viewport()
			local cam = workspace.CurrentCamera
			return cam and cam.ViewportSize or Vector2.new(800, 450)
		end
		local function onScreen(b)
			local pos, size, v = b.AbsolutePosition, b.AbsoluteSize, viewport()
			return size.X > 1 and size.Y > 1 and pos.X > -size.X + 12 and pos.Y > -size.Y + 12 and pos.X < v.X - 12 and pos.Y < v.Y - 12
		end
		local function enforceGui(g, order)
			if not g or not g:IsA("ScreenGui") then return end
			pcall(function()
				if g.Parent ~= PlayerGui then g.Parent = PlayerGui end
				if g.DisplayOrder ~= order then g.DisplayOrder = order end
				if g.ResetOnSpawn then g.ResetOnSpawn = false end
				if not g.IgnoreGuiInset then g.IgnoreGuiInset = true end
				if not g.Enabled then g.Enabled = true end
			end)
		end
		local function enforcePill(b, defaultPos)
			if not b or not b:IsA("GuiObject") then return end
			pcall(function()
				if not b.Visible then b.Visible = true end
				if not b.Active then b.Active = true end
				if b.AbsoluteSize.X > 1 and not onScreen(b) then b.Position = defaultPos end
			end)
		end

		local lastWarn = 0
		bind(PlayerGui.ChildRemoved:Connect(function(c)
			if not alive then return end
			if c == sg or c == layoutGui then
				if os.clock() - lastWarn > 2 then
					lastWarn = os.clock()
					warn("[UI keeper] " .. c.Name .. " was removed from PlayerGui by something other than this script")
					Kit.log("ui removed " .. c.Name)
				end
			end
		end))

		task.spawn(function()
			while alive do
				enforceGui(sg, 210)
				enforceGui(keepGui, 151)
				enforcePill(pill, UDim2.new(1, -122, 0, 8))
				local ca = sg:FindFirstChild("CloseAllToggle")
				enforcePill(ca, UDim2.new(1, -8, 0, 8))
				local closedOnPurpose = ca ~= nil and ca:IsA("TextButton") and ca.Text == "OPEN"
				if not closedOnPurpose and layoutGui:IsA("ScreenGui") then
					enforceGui(layoutGui, 150)
					enforcePill(layoutGui:FindFirstChild("EditToggle"), UDim2.new(1, -80, 0, 10))
				end
				task.wait(0.25)
			end
		end)
	end

	applyVisibility() -- apply the saved configuration

	bind(UIS.InputBegan:Connect(function(input, gp)
		if gp or input.KeyCode ~= HIDE_KEY then return end
		setMasterHidden(not masterHidden)
		setMasterRow(masterHidden)
	end))
end)

---------------------------------------------------------------- 17) morph gui (MorphGui v5)
runSection("17", function()
	onCleanup(function()
		local u = env.MorphGuiUnload
		if type(u) == "function" then pcall(u) end
	end)
	-- the morph script waits on ReplicatedStorage folders, so it runs in its own thread
	task.spawn(function()
		local ok, err = xpcall(function()
			--[[
				MorphGui v5

				New in v5 (on top of v4):
				  * Misc tab: "First Person: Show Body" - in first person you see your whole body and non-head
				    accessories (capes, backpacks, waist/shoulder items). The head and head accessories stay hidden
				    so they don't block your view.
				  * Misc tab: "First Person: Hide Head Accs" - head accessories are always invisible in first person,
				    even if Show Body is off.

				v4 features: look lock, single instance, reconcile + watchdog, X unloads and restores your outfit.
			]]

			local alive = true -- declared up here so every watcher below (CHAIN re-check etc.) can see it
			local Players = game:GetService("Players")
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local UserInputService = game:GetService("UserInputService")
			local TweenService = game:GetService("TweenService")
			local RunService = game:GetService("RunService")

			local player = Players.LocalPlayer

			----------------------------------------------------------------
			-- Single instance: unload the previous copy of this script
			----------------------------------------------------------------
			local env = (getgenv and getgenv()) or _G
			if env.MorphGuiUnload then
				pcall(env.MorphGuiUnload)
				env.MorphGuiUnload = nil
			end

			-- clean up leftovers from older versions of this script
			pcall(function() RunService:UnbindFromRenderStep("MorphGuiStep") end)
			pcall(function() RunService:UnbindFromRenderStep("MorphGuiLook") end)
			pcall(function() RunService:UnbindFromRenderStep("MorphGuiFP") end)
			pcall(function()
				local oldFolder = workspace:FindFirstChild("MG_Acc")
				if oldFolder then oldFolder:Destroy() end
			end)
			pcall(function()
				local oldGui = player:WaitForChild("PlayerGui"):FindFirstChild("MorphGui")
				if oldGui then oldGui:Destroy() end
			end)

			----------------------------------------------------------------
			-- Morph source folder
			----------------------------------------------------------------
			local classModels = ReplicatedStorage:WaitForChild("ClassModels", 15)
			local devFolder = classModels and classModels:WaitForChild("DEV FOLDER", 15)
			local morphFolder = devFolder and devFolder:WaitForChild("DEV MORPH", 15)

			if not morphFolder then
				warn("[MorphGui] Could not find ReplicatedStorage.ClassModels['DEV FOLDER']['DEV MORPH'] - check the names.")
				if classModels then
					warn("[MorphGui] ClassModels contains:")
					for _, c in ipairs(classModels:GetChildren()) do
						warn("   " .. c.Name .. " (" .. c.ClassName .. ")")
					end
				end
				morphFolder = Instance.new("Folder")
			end

			-- CHAIN morphs. Every CHAIN form gets its own button and its own file (ChainMorph_<name>.json in your
			-- executor workspace folder). Clicking a CHAIN button scans for loaded CHAIN models, saves every form it
			-- has not seen before, and builds the one you picked. Forms with the same model name but a different look
			-- are named "CHAIN (Form 2)", "CHAIN (Form 3)", ...
			-- If CHAIN is not loaded, the form is rebuilt from its saved file (or downloaded from Chain.URL, see below).
			local Chain = {
				NAME = "CHAIN",
				INDEX = "ChainMorph_index.json",
				URL = "", -- optional: base link; a missing file X is downloaded from URL .. X
				forms = {}, bySig = {}, lastScan = 0,
				CHAINSAW = true,
				HIDE_FACE = true, -- no face on your head while morphed into any CHAIN form
				COLOR = Color3.new(0, 0, 0), -- fallback limb color (used for a limb whose color could not be read from the rig, or when FORCE_BLACK is on)
				FORCE_BLACK = false, -- true = the old behaviour: every limb pure black. false = limb colors are copied from the CHAIN rig
				LIMB_LOOKS = true, -- also capture a limb part that itself carries a custom mesh / PBR texture (custom arms, heads ...)
				SCHEMA = 2, -- look-file format. Forms saved by an older version are upgraded in place the next time CHAIN is seen
				MAX_FORMS = 20, -- safety: stop registering new looks after this many (a flashing color would otherwise spam buttons)
				BC_PROP = {
					["Head"] = "HeadColor3", ["Torso"] = "TorsoColor3",
					["Right Arm"] = "RightArmColor3", ["Left Arm"] = "LeftArmColor3",
					["Right Leg"] = "RightLegColor3", ["Left Leg"] = "LeftLegColor3",
				},
				SKIP_CLASS = { Seat = true, VehicleSeat = true, SpawnLocation = true }, -- never copied (a seat would trap you)
				PART_CLASS = { Part = true, WedgePart = true, CornerWedgePart = true }, -- plain parts that can be rebuilt from a file
				ANCHORS = {
					["Head"] = "HatAttachment",
					["Torso"] = "BodyFrontAttachment",
					["Right Arm"] = "RightGripAttachment",
					["Left Arm"] = "LeftGripAttachment",
					["Right Leg"] = "RightFootAttachment",
					["Left Leg"] = "LeftFootAttachment",
				},
				STRIP = {
					Weld = true, WeldConstraint = true, Motor6D = true, ManualWeld = true, Snap = true,
					Sound = true, Script = true, LocalScript = true, ModuleScript = true,
					Attachment = true, Beam = true, Trail = true, ParticleEmitter = true,
					Highlight = true, ObjectValue = true, BindableEvent = true,
				},
				building = false,
			}

			local function cfToTable(cf) return { cf:GetComponents() } end
			local function tableToCf(t) return CFrame.new(table.unpack(t)) end

			local LIGHTS = { SurfaceLight = true, PointLight = true, SpotLight = true }
			function Chain.visible(part)
				if part.Transparency < 1 then return true end
				for _, c in ipairs(part:GetChildren()) do
					if LIGHTS[c.ClassName] then return true end -- invisible glow parts that carry a light
				end
				return false
			end

			-- clone that also works on instances the game marked Archivable = false (those return nil from :Clone())
			function Chain.safeClone(inst)
				local unlocked = {}
				local function unlock(i)
					if not i.Archivable then
						unlocked[#unlocked + 1] = i
						pcall(function() i.Archivable = true end)
					end
				end
				unlock(inst)
				for _, d in ipairs(inst:GetDescendants()) do unlock(d) end
				local ok, c = pcall(function() return inst:Clone() end)
				for _, i in ipairs(unlocked) do pcall(function() i.Archivable = false end) end
				if ok then return c end
				return nil
			end

			-- the default face decal on a head is never copied (your own face is removed by HIDE_FACE)
			function Chain.isFace(d, limbName)
				return limbName == "Head" and d:IsA("Decal") and d.Name:lower() == "face"
			end

			-- a limb part that is not just the plain block: custom mesh, FileMesh or PBR texture on the limb itself
			function Chain.limbHasLook(limb)
				if limb.Transparency >= 1 then return false end
				if limb:IsA("MeshPart") and limb.MeshId ~= "" then return true end
				for _, c in ipairs(limb:GetChildren()) do
					if c:IsA("SpecialMesh") and c.MeshId ~= "" then return true end
					if c:IsA("SurfaceAppearance") then return true end
				end
				return false
			end

			-- Lists every visible piece of the CHAIN rig with its offset from its limb, plus the body colors and the
			-- shirt / pants / graphic of the rig. It now looks at EVERYTHING under the model (not only Model children of
			-- the limbs): parts directly in a limb, custom arm models, accessories, folders, parts welded to a limb from
			-- outside it, and the limbs themselves when they carry a custom mesh.
			-- returns pieces, extra   (extra = { colors = { [limb] = {r,g,b} }, clothes = { Shirt / Pants / Graphic } })
			function Chain.gather(chain)
				local pieces, seen = {}, {}
				local limbs, limbOf = {}, {}
				for limbName in pairs(Chain.ANCHORS) do
					local l = chain:FindFirstChild(limbName)
					if l and l:IsA("BasePart") then limbs[limbName] = l limbOf[l] = limbName end
				end

				local function add(part, limbName, isLimb)
					if seen[part] then return end
					local limb = limbs[limbName]
					if not limb then return end
					seen[part] = true
					local att = limb:FindFirstChild(Chain.ANCHORS[limbName])
					pieces[#pieces + 1] = {
						src = part, limb = limbName, isLimb = isLimb or nil,
						rel = limb.CFrame:ToObjectSpace(part.CFrame),
						anchor = (att and att:IsA("Attachment")) and att.CFrame or CFrame.new(),
					}
				end

				-- which limb does this part belong to? inside a limb -> that limb, inside Chainsaw -> Right Arm,
				-- welded (through up to 3 hops) to a limb -> that limb, otherwise the closest limb
				local function direct(part)
					if limbOf[part] then return limbOf[part] end
					local p = part.Parent
					while p and p ~= chain do
						if limbOf[p] then return limbOf[p] end
						if p.Name == "Chainsaw" and limbs["Right Arm"] then return "Right Arm" end
						p = p.Parent
					end
					return nil
				end
				local function resolve(part, depth, visited)
					visited[part] = true
					local n = direct(part)
					if n then return n end
					if depth <= 0 then return nil end
					local ok, joints = pcall(function() return part:GetJoints() end)
					if ok then
						for _, j in ipairs(joints) do
							local other = (j.Part0 == part) and j.Part1 or j.Part0
							if other and other:IsA("BasePart") and not visited[other] and other.Name ~= "HumanoidRootPart" then
								local r = resolve(other, depth - 1, visited)
								if r then return r end
							end
						end
					end
					return nil
				end
				local function ownerOf(part)
					local n = resolve(part, 3, {})
					if n then return n end
					local best, bestD
					for name, l in pairs(limbs) do
						local d = (l.Position - part.Position).Magnitude
						if not bestD or d < bestD then best, bestD = name, d end
					end
					return best
				end

				for _, d in ipairs(chain:GetDescendants()) do
					if d:IsA("BasePart") and not limbOf[d] and d.Name ~= "HumanoidRootPart"
						and not Chain.SKIP_CLASS[d.ClassName] and Chain.visible(d) then
						local name = ownerOf(d)
						if name and (Chain.CHAINSAW or not (d.Parent and d:FindFirstAncestor("Chainsaw"))) then
							add(d, name)
						end
					end
				end

				if Chain.LIMB_LOOKS then
					for limbName, limb in pairs(limbs) do
						if Chain.limbHasLook(limb) then add(limb, limbName, true) end
					end
				end

				local extra = { colors = {}, clothes = {} }
				local bc = chain:FindFirstChildOfClass("BodyColors") or chain:FindFirstChildWhichIsA("BodyColors", true)
				for limbName, prop in pairs(Chain.BC_PROP) do
					local c
					if bc then c = bc[prop] end
					local limb = limbs[limbName]
					if not c and limb and limb.Transparency < 0.95 then c = limb.Color end
					if c then extra.colors[limbName] = { c.R, c.G, c.B } end
				end
				for _, d in ipairs(chain:GetDescendants()) do
					if d:IsA("Shirt") and not extra.clothes.Shirt and d.ShirtTemplate ~= "" then
						extra.clothes.Shirt = { tmpl = d.ShirtTemplate, color = { d.Color3.R, d.Color3.G, d.Color3.B } }
					elseif d:IsA("Pants") and not extra.clothes.Pants and d.PantsTemplate ~= "" then
						extra.clothes.Pants = { tmpl = d.PantsTemplate, color = { d.Color3.R, d.Color3.G, d.Color3.B } }
					elseif d:IsA("ShirtGraphic") and not extra.clothes.Graphic and d.Graphic ~= "" then
						extra.clothes.Graphic = { tmpl = d.Graphic, color = { d.Color3.R, d.Color3.G, d.Color3.B } }
					end
				end
				return pieces, extra
			end

			-- body colors + shirt / pants / graphic of a form (from a live scan or from its saved file)
			function Chain.applyExtra(morph, hats, extra)
				if not (morph and hats) then return end
				local bc = morph:FindFirstChildOfClass("BodyColors")
				if bc then
					local col = (extra and extra.colors) or {}
					for limbName, prop in pairs(Chain.BC_PROP) do
						local t = col[limbName]
						if Chain.FORCE_BLACK then t = nil end
						bc[prop] = t and Color3.new(t[1], t[2], t[3]) or Chain.COLOR
					end
				end
				for _, c in ipairs(hats:GetChildren()) do
					if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then c:Destroy() end
				end
				local cl = extra and extra.clothes
				if type(cl) ~= "table" then return end
				local function mk(class, prop, c)
					if type(c) ~= "table" or type(c.tmpl) ~= "string" or c.tmpl == "" then return end
					local inst = Instance.new(class)
					pcall(function() inst[prop] = c.tmpl end)
					if type(c.color) == "table" then
						pcall(function() inst.Color3 = Color3.new(c.color[1], c.color[2], c.color[3]) end)
					end
					inst.Parent = hats
				end
				mk("Shirt", "ShirtTemplate", cl.Shirt)
				mk("Pants", "PantsTemplate", cl.Pants)
				mk("ShirtGraphic", "Graphic", cl.Graphic)
			end

			-- wraps a handle part into an Accessory that sits exactly where it sat on the CHAIN rig
			-- where each CHAIN limb attaches on your character: R6 uses the same limb, R15 uses the closest part
			local R15_TARGET = {
				["Head"] = { "Head", "HatAttachment" },
				["Torso"] = { "UpperTorso", "BodyFrontAttachment" },
				["Right Arm"] = { "RightUpperArm", "RightShoulderAttachment" },
				["Left Arm"] = { "LeftUpperArm", "LeftShoulderAttachment" },
				["Right Leg"] = { "RightUpperLeg", "RightHipAttachment" },
				["Left Leg"] = { "LeftUpperLeg", "LeftHipAttachment" },
			}
			-- where the R6 limb centers sit relative to the root part in the R6 rest pose
			local R6_REST = {
				["Head"] = CFrame.new(0, 1.5, 0), ["Torso"] = CFrame.new(),
				["Right Arm"] = CFrame.new(1.5, 0, 0), ["Left Arm"] = CFrame.new(-1.5, 0, 0),
				["Right Leg"] = CFrame.new(0.5, -2, 0), ["Left Leg"] = CFrame.new(-0.5, -2, 0),
			}

			-- rest-pose CFrame of a part relative to the root part, from the Motor6D chain (ignores animations)
			local function restFrom(char, part, depth)
				local root = char:FindFirstChild("HumanoidRootPart")
				if not root or part == root then return CFrame.new() end
				if (depth or 0) > 12 then return nil end
				for _, m in ipairs(char:GetDescendants()) do
					if m:IsA("Motor6D") and m.Part1 == part and m.Part0 then
						local up = restFrom(char, m.Part0, (depth or 0) + 1)
						if up then return up * m.C0 * m.C1:Inverse() end
					end
				end
				return nil
			end

			function Chain.addAcc(hats, name, handle, limbName, rel, storedAnchor)
				local attName = Chain.ANCHORS[limbName]
				local C1 = storedAnchor
				local vo = CFrame.new()
				local char = player.Character
				if char then
					local r15 = char:FindFirstChild("UpperTorso") ~= nil
					local target = r15 and R15_TARGET[limbName] or { limbName, attName }
					local part = char:FindFirstChild(target[1])
					if part and part:IsA("BasePart") then
						local att = part:FindFirstChild(target[2])
						if not (att and att:IsA("Attachment")) then att = part:FindFirstChildWhichIsA("Attachment") end
						if att then
							attName = att.Name
							C1 = att.CFrame
							if r15 then
								local rest = restFrom(char, part)
								if rest then vo = rest:Inverse() * R6_REST[limbName] end
							end
						end
					end
				end

				local acc = Instance.new("Accessory")
				acc.Name = name
				handle.Name = "Handle"
				handle.Anchored = false
				handle.CanCollide = false
				handle.CanTouch = false
				handle.Massless = true
				local att = Instance.new("Attachment")
				att.Name = attName
				-- the weld puts the handle at part * C1 * C0^-1, so this lands it at part * vo * rel
				att.CFrame = rel:Inverse() * vo:Inverse() * C1
				att.Parent = handle
				handle.Parent = acc
				acc.Parent = hats
			end

			function Chain.fromLive(pieces, hats, extra, morph)
				for _, p in ipairs(pieces) do
					local h = Chain.safeClone(p.src)
					if h then
						for _, d in ipairs(h:GetDescendants()) do
							-- nested parts / models are their own pieces, so they are not copied twice
							if Chain.STRIP[d.ClassName] or Chain.isFace(d, p.limb)
								or d:IsA("BasePart") or d:IsA("Model") or d:IsA("Accessory") or d:IsA("Folder") then
								d:Destroy()
							end
						end
						Chain.addAcc(hats, p.limb .. "_" .. p.src.Name, h, p.limb, p.rel, p.anchor)
					else
						warn("[ChainMorph] could not copy " .. p.src:GetFullName())
					end
				end
				Chain.applyExtra(morph, hats, extra)
			end

			local function hashStr(str)
				local h = 5381
				for i = 1, #str do h = (h * 33 + string.byte(str, i)) % 4294967296 end
				return string.format("%x", h)
			end

			local function c3(c) return string.format("%.3f,%.3f,%.3f", c.R, c.G, c.B) end

			-- hashes of each kind of look, so a new look can be named after what changed
			function Chain.sigParts(pieces, extra)
				local cat = { mesh = {}, tex = {}, color = {}, mat = {}, glow = {}, cloth = {}, body = {} }
				for _, p in ipairs(pieces) do
					local s = p.src
					local id = p.limb .. "|" .. s.Name .. "|" .. s.ClassName
					local mp = s:IsA("MeshPart")
					local sm = s:FindFirstChildOfClass("SpecialMesh")
					local shape = s:IsA("Part") and s.Shape.Name or ""
					table.insert(cat.mesh, id .. "|" .. (mp and s.MeshId or "") .. "|" .. (sm and (sm.MeshType.Name .. sm.MeshId) or "")
						.. "|" .. shape .. string.format("|%.2f,%.2f,%.2f", s.Size.X, s.Size.Y, s.Size.Z))
					local tex = id .. "|" .. (mp and s.TextureID or "") .. (sm and sm.TextureId or "")
					for _, c in ipairs(s:GetChildren()) do
						if c:IsA("SurfaceAppearance") then
							tex = tex .. "|" .. c.ColorMap .. c.NormalMap .. c.MetalnessMap .. c.RoughnessMap
						elseif c:IsA("Decal") or c:IsA("Texture") then
							if not Chain.isFace(c, p.limb) then tex = tex .. "|" .. c.Texture .. c.Transparency end
						end
					end
					table.insert(cat.tex, tex)
					table.insert(cat.color, id .. "|" .. c3(s.Color) .. "|" .. s.Reflectance .. "|" .. s.Transparency)
					table.insert(cat.mat, id .. "|" .. s.Material.Name)
					local glow = id .. "|" .. (s.Material == Enum.Material.Neon and "neon" or "")
					for _, c in ipairs(s:GetChildren()) do
						if LIGHTS[c.ClassName] then
							glow = glow .. "|" .. c.ClassName .. c3(c.Color) .. string.format("%.2f,%.1f", c.Brightness, c.Range) .. tostring(c.Enabled)
						end
					end
					table.insert(cat.glow, glow)
				end
				local cl = (extra and extra.clothes) or {}
				for _, k in ipairs({ "Shirt", "Pants", "Graphic" }) do
					local c = cl[k]
					if c then
						table.insert(cat.cloth, k .. "|" .. c.tmpl .. string.format("|%.3f,%.3f,%.3f", c.color[1], c.color[2], c.color[3]))
					end
				end
				for name, t in pairs((extra and extra.colors) or {}) do
					table.insert(cat.body, name .. "|" .. string.format("%.3f,%.3f,%.3f", t[1], t[2], t[3]))
				end
				local out = {}
				for k, list in pairs(cat) do
					table.sort(list)
					out[k] = hashStr(table.concat(list, ";"))
				end
				return out
			end

			function Chain.signature(parts)
				return "v2" .. parts.mesh .. parts.tex .. parts.color .. parts.mat .. parts.glow .. parts.cloth .. parts.body
			end

			local CAT_LABEL = { mesh = "Meshes", tex = "Textures", color = "Colors", mat = "Materials", glow = "Glow", cloth = "Clothes", body = "Body Colors" }
			local CAT_ORDER = { "mesh", "tex", "color", "mat", "glow", "cloth", "body" }
			-- e.g. "CHAIN (Textures, Glow)" = what is different from the form it is compared to
			function Chain.nameFor(base, parts, ref)
				local labels = {}
				if ref and ref.parts then
					for _, k in ipairs(CAT_ORDER) do
						if ref.parts[k] ~= parts[k] then labels[#labels + 1] = CAT_LABEL[k] end
					end
				end
				local name = base .. (#labels > 0 and (" (" .. table.concat(labels, ", ") .. ")") or " (Form 2)")
				local candidate, n = name, 2
				while Chain.forms[candidate] do
					candidate = name .. " #" .. n
					n += 1
				end
				return candidate
			end

			-- one saved entry for one piece (nil = cannot be rebuilt from a file, e.g. a union: it only works while CHAIN is loaded)
			function Chain.entryOf(p)
				local s = p.src
				local e = {
					limb = p.limb, name = s.Name, class = s.ClassName,
					Size = { s.Size.X, s.Size.Y, s.Size.Z },
					Color = { s.Color.R, s.Color.G, s.Color.B },
					Material = s.Material.Name, Transparency = s.Transparency, Reflectance = s.Reflectance,
					rel = cfToTable(p.rel), anchor = cfToTable(p.anchor),
					decals = {}, lights = {},
				}
				if s:IsA("MeshPart") then
					if s.MeshId == "" then return nil end
					e.MeshId, e.TextureID = s.MeshId, s.TextureID
					local ok, v = pcall(function() return s.MeshSize end)
					if ok and typeof(v) == "Vector3" then e.MeshSize = { v.X, v.Y, v.Z } end
				elseif Chain.PART_CLASS[s.ClassName] then
					if s:IsA("Part") then e.Shape = s.Shape.Name end
					local sm = s:FindFirstChildOfClass("SpecialMesh")
					if sm then
						e.sm = {
							MeshType = sm.MeshType.Name, MeshId = sm.MeshId, TextureId = sm.TextureId,
							Scale = { sm.Scale.X, sm.Scale.Y, sm.Scale.Z },
							Offset = { sm.Offset.X, sm.Offset.Y, sm.Offset.Z },
							VertexColor = { sm.VertexColor.X, sm.VertexColor.Y, sm.VertexColor.Z },
						}
					end
				else
					return nil
				end
				local sa = s:FindFirstChildOfClass("SurfaceAppearance")
				if sa then
					e.sa = { ColorMap = sa.ColorMap, NormalMap = sa.NormalMap, MetalnessMap = sa.MetalnessMap, RoughnessMap = sa.RoughnessMap }
					pcall(function() e.sa.Color = { sa.Color.R, sa.Color.G, sa.Color.B } end)
					pcall(function() e.sa.AlphaMode = sa.AlphaMode.Name end)
				end
				for _, d in ipairs(s:GetChildren()) do
					if LIGHTS[d.ClassName] then
						e.lights[#e.lights + 1] = {
							class = d.ClassName, Color = { d.Color.R, d.Color.G, d.Color.B },
							Brightness = d.Brightness, Range = d.Range, Enabled = d.Enabled,
							Face = d:IsA("SurfaceLight") and d.Face.Name or nil,
						}
					elseif d:IsA("Decal") and not Chain.isFace(d, p.limb) then -- Texture is a Decal too
						local rec = { Texture = d.Texture, Face = d.Face.Name, Transparency = d.Transparency, Color3 = { d.Color3.R, d.Color3.G, d.Color3.B } }
						if d:IsA("Texture") then rec.tile = { d.StudsPerTileU, d.StudsPerTileV } end
						e.decals[#e.decals + 1] = rec
					end
				end
				return e
			end

			-- recipe files
			function Chain.save(pieces, file, extra)
				if not writefile then return false end
				local out, skipped = {}, 0
				for _, p in ipairs(pieces) do
					local e = Chain.entryOf(p)
					if e then out[#out + 1] = e else skipped = skipped + 1 end
				end
				if skipped > 0 then
					print("[ChainMorph] " .. skipped .. " piece(s) of " .. file .. " cannot be stored in a file (unions etc.): they show up while CHAIN is loaded")
				end
				local hasClothes = extra and next(extra.clothes) ~= nil
				if #out == 0 and not hasClothes then return false end
				return pcall(writefile, file, game:GetService("HttpService"):JSONEncode({
					version = 2, pieces = out,
					colors = extra and extra.colors or {}, clothes = extra and extra.clothes or {},
				}))
			end
			local function chainDownload(file)
				if Chain.URL == "" then return end
				local url = Chain.URL .. file
				local body
				local req = (syn and syn.request) or (http and http.request) or http_request or request
				if req then
					local ok, res = pcall(req, { Url = url, Method = "GET" })
					if ok and type(res) == "table" and res.StatusCode == 200 then body = res.Body end
				end
				if not body then
					local ok, res = pcall(function() return game:HttpGet(url) end)
					if ok then body = res end
				end
				if body then pcall(writefile, file, body) end
			end

