---------------------------------------------------------------- 29) tight grip (merged from Grippy_tight_grip.txt)
-- Equipped tools are moved OPTIMIZED_HEIGHT studs along the grip's Y axis and their handle gets CanCollide / CastShadow off and Massless on.
-- Everything is put back when the card is turned off or the tool is unequipped. CUSTOM GRIP and TIGHT GRIP switch each other off.
runSection("29", function()
	local OPTIMIZED_HEIGHT = 30
	local isGripActive = false
	local originalGrips = setmetatable({}, { __mode = "k" })
	local originalProperties = setmetatable({}, { __mode = "k" })
	local charConns = {}
	local setVisual

	local function applyGrip(tool)
		if not isGripActive or Kit.customGripOn then return end
		if not (tool and tool.Parent and tool:IsA("Tool")) then return end
		local handle = tool:FindFirstChild("Handle")

		if not originalGrips[tool] then
			originalGrips[tool] = tool.Grip
		end
		if handle and handle:IsA("BasePart") and not originalProperties[tool] then
			originalProperties[tool] = {
				CanCollide = handle.CanCollide,
				CastShadow = handle.CastShadow,
				Massless = handle.Massless,
			}
			handle.CanCollide = false
			handle.CastShadow = false
			handle.Massless = true
		end
		tool.Grip = originalGrips[tool] * CFrame.new(0, OPTIMIZED_HEIGHT, 0)
	end

	local function resetGrip(tool)
		if not (tool and tool:IsA("Tool")) then return end
		if originalGrips[tool] then
			pcall(function() tool.Grip = originalGrips[tool] end)
			originalGrips[tool] = nil
		end
		local handle = tool:FindFirstChild("Handle")
		local saved = originalProperties[tool]
		if handle and saved then
			pcall(function()
				handle.CanCollide = saved.CanCollide
				handle.CastShadow = saved.CastShadow
				handle.Massless = saved.Massless
			end)
		end
		originalProperties[tool] = nil
	end

	local function forEachHeldTool(fn)
		local char = LocalPlayer.Character
		if not char then return end
		for _, child in ipairs(char:GetChildren()) do
			if child:IsA("Tool") then fn(child) end
		end
	end

	local function setupCharacter(char)
		for _, c in ipairs(charConns) do pcall(function() c:Disconnect() end) end
		table.clear(charConns)
		table.insert(charConns, char.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(applyGrip, child) -- after the game has finished equipping it
			end
		end))
		table.insert(charConns, char.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then resetGrip(child) end
		end))
	end

	if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
	bind(LocalPlayer.CharacterAdded:Connect(setupCharacter))

	local function setActive(on)
		if on == isGripActive then return end
		if on then
			-- CUSTOM GRIP writes Tool.Grip too: switch it off first so it never reads our moved grip as the original
			if Kit.customGripOn and FeatureHooks.toolgrip_custom then FeatureHooks.toolgrip_custom() end
			isGripActive = true
			forEachHeldTool(applyGrip)
		else
			isGripActive = false
			forEachHeldTool(resetGrip)
		end
	end

	setVisual = makeToggleCard("ToolGripGui", "ToolGripToggle", "TIGHT GRIP", 11, Color3.fromRGB(255, 150, 70), 1656, function()
		setActive(not isGripActive)
		return isGripActive
	end)

	Kit.tightGripOff = function()
		setActive(false)
		setVisual(false)
	end
	FeatureHooks.tight_grip = Kit.tightGripOff

	onCleanup(function()
		Kit.tightGripOff = nil
		isGripActive = false
		forEachHeldTool(resetGrip)
		for _, c in ipairs(charConns) do pcall(function() c:Disconnect() end) end
		table.clear(charConns)
	end)
end)


---------------------------------------------------------------- 30) AUTO INCREASE CI TIME (formerly LOW HP HUNT) (teleport in front of any NPC in workspace.Characters with 1-400 hp, except Bomber / Shielder / Gunner / Gilbert / Mikhail, and spam VIRAL FISTS F until it dies)
runSection("30", function()
	local HP_MIN, HP_MAX = 1, 400         -- hunt anything whose CURRENT health is in this range
	-- bosses: never hunted; matches the START of the name, lowercase (unchanged from v65)
	local SKIP_BOSS_NAMES = { "gilbert", "mikhail" }
	-- common infected: never hunted; matches ANYWHERE in the name once digits / spaces / symbols are removed, lowercase.
	-- So Shielder, Shielder1 .. Shielder40, "Shielder [12]", "Infected_Shielder_7", "3 Shielder" ... all match, however many there are (auto detected).
	-- "shield" is there on purpose in case the real name is a bit different from "Shielder". Add more stems here for other excluded enemies.
	local SKIP_COMMON_NAMES = { "bomber", "shielder", "shield", "gunner" }
	local FRONT_DIST = 3                  -- studs in front of the target (right in its face)
	local SAFE_DIST = 50                  -- never hunt / kill an NPC within this many studs of another player (0 = off)
	local FIRE_INTERVAL = 0.03            -- seconds between VIRAL FISTS "F" presses while a target is alive
	local lastFire, fireEvent = 0, nil
	local active, origin, target, hbConn, lastPick, returned = false, nil, nil, nil, 0, true
	local setVisual

	local function rootOf(m) return m and (m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")) end
	local function isAlive(m)
		if not (m and m.Parent) then return false end
		local h = m:FindFirstChildOfClass("Humanoid")
		return h ~= nil and h.Health > 0 and rootOf(m) ~= nil
	end
	local function isPlayerChar(m) -- real players (by character or by name) are never targeted, NPCs only
		if Players:GetPlayerFromCharacter(m) then return true end
		local p = Players:FindFirstChild(m.Name)
		return p ~= nil and p:IsA("Player")
	end
	-- true for the skipped NPC types (Bomber / Shielder / Gunner + the Gilbert and Mikhail bosses)
	local function isSkipped(m)
		local h = m:FindFirstChildOfClass("Humanoid")
		local names = { m.Name:lower(), h and h.DisplayName:lower() or "" }
		for _, n in ipairs(names) do
			-- bosses (Gilbert / Mikhail): start-of-name match, same as before
			for _, k in ipairs(SKIP_BOSS_NAMES) do
				if n:sub(1, #k) == k then return true end
			end
			-- common infected: drop everything that is not a letter (numbers, spaces, [], _, -), then look for the name anywhere inside
			local letters = n:gsub("[^%a]", "")
			for _, k in ipairs(SKIP_COMMON_NAMES) do
				if letters:find(k, 1, true) then return true end
			end
		end
		return false
	end
	-- true when the model is within SAFE_DIST studs of any OTHER player (you are never counted)
	local function nearPlayer(m)
		if SAFE_DIST <= 0 then return false end
		local mr = rootOf(m)
		if not mr then return false end
		local pos = mr.Position
		local chars = Workspace:FindFirstChild("Characters")
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				local pc = p.Character
				local cm = chars and chars:FindFirstChild(p.Name) -- characters also live in workspace.Characters.<name>
				for _, c in ipairs({ pc, cm }) do
					if c and c ~= m then
						local pr = rootOf(c)
						if pr and (pr.Position - pos).Magnitude <= SAFE_DIST then return true end
					end
				end
			end
		end
		return false
	end
	local function pick()
		local chars = Workspace:FindFirstChild("Characters")
		if not chars then return nil end
		local me, best, bestHp = LocalPlayer.Character, nil, nil
		for _, m in ipairs(chars:GetChildren()) do
			if m:IsA("Model") and m ~= me and m.Name ~= LocalPlayer.Name and not isPlayerChar(m) then
				local h = m:FindFirstChildOfClass("Humanoid")
				if h and h.Health >= HP_MIN and h.Health <= HP_MAX and rootOf(m) and not isSkipped(m) and not nearPlayer(m) then
					if not bestHp or h.Health < bestHp then best, bestHp = m, h.Health end
				end
			end
		end
		return best
	end
	local function myRoot()
		local c = LocalPlayer.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end
	local function goTo(cf)
		local r = myRoot()
		if r then
			r.CFrame = cf
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
	end
	-- stand right in front of the target, facing it
	local function frontOf(t)
		local tr = rootOf(t)
		local pos = (tr.CFrame * CFrame.new(0, 0, -FRONT_DIST)).Position
		return CFrame.lookAt(pos, Vector3.new(tr.Position.X, pos.Y, tr.Position.Z))
	end
	-- same remote the VIRAL FISTS button / F key uses (section 3)
	local function pressF()
		local now = os.clock()
		if now - lastFire < FIRE_INTERVAL then return end
		lastFire = now
		if not (fireEvent and fireEvent.Parent) then
			fireEvent = ReplicatedStorage:FindFirstChild("ViralFistsKeyPressEvent")
		end
		if fireEvent then fireEvent:FireServer("F") end
	end
	local function stopHunt()
		active = false
		if hbConn then hbConn:Disconnect() hbConn = nil end
		target = nil
		if origin then goTo(origin) end -- back to the old position
		origin = nil
	end
	local function startHunt()
		local r = myRoot()
		if not r then return false end
		origin, target, returned, active = r.CFrame, nil, true, true
		hbConn = RunService.Heartbeat:Connect(function()
			if not active then return end
			if target and not isAlive(target) then target = nil end -- dead (or gone): move on
			if target and nearPlayer(target) then target = nil lastPick = 0 end -- walked within SAFE_DIST of a player: drop it, no more F presses
			if not target and os.clock() - lastPick > 0.2 then
				lastPick = os.clock()
				target = pick()
			end
			if target then
				returned = false
				goTo(frontOf(target)) -- keep sticking to its front while it moves
				pressF()              -- spam viral fists until it dies
			elseif not returned and origin then
				returned = true
				goTo(origin) -- nobody to hunt (1-400 hp, not a skipped type, not near a player): wait at the old spot
			end
		end)
		return true
	end

	setVisual = makeToggleCard("LowHpHuntGui", "LowHpHuntToggle", "AUTO INCREASE CI TIME", 11, Color3.fromRGB(235, 60, 60), 1712, function()
		if active then stopHunt() else startHunt() end
		return active
	end)
	-- the title is long: shrink it to fit the card's title box
	pcall(function()
		local g = PlayerGui:FindFirstChild("LowHpHuntGui")
		local c = g and g:FindFirstChild("LowHpHuntToggle")
		if not c then return end
		for _, d in ipairs(c:GetChildren()) do
			if d:IsA("TextLabel") and d.Text == "AUTO INCREASE CI TIME" then
				d.TextScaled = true
				local k = Instance.new("UITextSizeConstraint")
				k.MaxTextSize = 11
				k.MinTextSize = 6
				k.Parent = d
			end
		end
	end)
	FeatureHooks.hunt = function() if active then stopHunt() end setVisual(false) end
	onCleanup(function() if active then stopHunt() end end)
end)

