				{ 98229574373717, "Black-Neck-Fluff" },
			}
			local magnaContainer, magnaFailed, magnaBusy = nil, {}, false

			local function isWearable(o)
				return o:IsA("Accoutrement") or o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic")
			end

			-- downloads one asset; returns the wearable items inside it (Accessory / Pants / Shirt ...)
			local function loadWearables(id)
				local roots
				local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
				if ok and type(res) == "table" and #res > 0 then
					roots = res
				else
					local ok2, model = pcall(function() return game:GetService("InsertService"):LoadAsset(id) end)
					if ok2 and model then roots = model:GetChildren() end
				end
				if not roots then return nil end
				local items = {}
				for _, o in ipairs(roots) do
					if isWearable(o) then
						items[#items + 1] = o
					else
						for _, d in ipairs(o:GetDescendants()) do
							if isWearable(d) then items[#items + 1] = d end
						end
					end
				end
				return items
			end

			local function getMagna(report)
				if magnaContainer then return magnaContainer end
				local container = Instance.new("Folder")
				container.Name = "Magna"
				table.clear(magnaFailed)
				for n, a in ipairs(MAGNA_ASSETS) do
					report("Loading Magna " .. n .. "/" .. #MAGNA_ASSETS .. "...")
					local items = loadWearables(a[1])
					if items and #items > 0 then
						for _, it in ipairs(items) do it.Parent = container end
					else
						magnaFailed[#magnaFailed + 1] = a[2]
						warn("[MorphGui] Magna: couldn't load " .. a[2] .. " (" .. a[1] .. ")")
					end
				end
				if #container:GetChildren() == 0 then
					container:Destroy()
					return nil
				end
				magnaContainer = container -- only cached when it worked, so a failed attempt can be retried
				return container
			end

