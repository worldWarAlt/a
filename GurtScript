	bind(LocalPlayer.CharacterAdded:Connect(reapplyAfterRespawn))

	task.spawn(function()
		local last = nil
		while alive do
			if keepOn and keepValue ~= nil then -- KEEP: put the value back whenever the game changes it
				local cur = tonumber(readValue())
				if cur ~= nil and cur ~= keepValue then pcall(writeValue, keepValue) end
			end
			local ok, text = pcall(function() return fmt(readValue()) end)
			if not ok then text = "N/A" end
			if text ~= last then
				last = text
				valueLabel.Text = text
				fitCard(text)
			end
			task.wait(POLL)
		end
	end)
end)

