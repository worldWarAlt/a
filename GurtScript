function H.shoulderPos(char)
	local m = char:FindFirstChild("Left Shoulder", true) or char:FindFirstChild("LeftShoulder", true)
	if m and m:IsA("Motor6D") and m.Part0 then return (m.Part0.CFrame * m.C0).Position end
	local a = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
	if a and a:IsA("BasePart") then return a.Position + a.CFrame.UpVector * (a.Size.Y / 2) end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then return root.Position + Vector3.new(-1.5, 0.5, 0) end
	return nil
end

function H.isLimbPart(char, p)
	return p.Parent == char and LIMB_NAMES[p.Name] == true
end

-- anything NAMED like a left arm, wherever the game puts it (character, tools, first-person viewmodel in the camera)
local ARM_NAMES = { leftarm = true, leftupperarm = true, leftlowerarm = true, lefthand = true, leftforearm = true, larm = true }
function H.isLeftArmName(n)
	return ARM_NAMES[string.lower((string.gsub(n, "[%s_%-]", "")))] == true
end

-- every part that belongs to the left arm: the limb, everything inside it (CHAIN's meshes live in Models
-- inside the limb) and loose parts / accessories welded onto it
function H.collectArm(char)
	local set, list = {}, {}
	local function add(p)
		if not set[p] then set[p] = true list[#list + 1] = p end
	end
	for _, limb in ipairs(char:GetChildren()) do
		if limb:IsA("BasePart") and LIMB_NAMES[limb.Name] then
			add(limb)
			for _, d in ipairs(limb:GetDescendants()) do
				if d:IsA("BasePart") then add(d) end
			end
		end
	end
	local function byName(root)
		if not root then return end
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") and not set[d] and H.isLeftArmName(d.Name) and not d:GetAttribute("MG_RageArm") then add(d) end
		end
	end
	byName(char)
	byName(workspace.CurrentCamera)
	if #list == 0 then return list end
	local joints = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then joints[#joints + 1] = d end
	end
	for _ = 1, 4 do
		local grew = false
		for _, j in ipairs(joints) do
			local p0, p1 = j.Part0, j.Part1
			if p0 and p1 then
				for _, pair in ipairs({ { p0, p1 }, { p1, p0 } }) do
					local a, b = pair[1], pair[2]
					if set[a] and not set[b] and not (b.Parent == char and CORE_NAMES[b.Name]) and b:IsDescendantOf(char) then
						add(b)
						grew = true
					end
				end
			end
		end
		if not grew then break end
	end
	return list
end

-- visibility goes through LocalTransparencyModifier (client only, nothing else fights over it)
function H.newInfo(char, p)
	return { part = p, size = p.Size, limb = H.isLimbPart(char, p), t = 0, fx = {}, fxSeen = {} }
end

function H.scanFx(info)
	for _, c in ipairs(info.part:GetChildren()) do
		if RAGE_FX[c.ClassName] and not info.fxSeen[c] and string.sub(c.Name, 1, 7) ~= "MG_Rage" then
			info.fxSeen[c] = true
			info.fx[#info.fx + 1] = { c, c.Enabled }
			info.fxOn = nil -- re-apply on the next visibility update
		end
	end
end

function H.applyVisibility(info, alpha)
	local p = info.part
	if p.Parent then p.LocalTransparencyModifier = 1 - alpha end
	local fxOn = alpha > 0.5
	if info.fxOn ~= fxOn then
		info.fxOn = fxOn
		for _, f in ipairs(info.fx) do
			if f[1].Parent then f[1].Enabled = fxOn and f[2] end
		end
	end
end

function H.easeOutBack(x)
	local c1 = 1.70158
	local c3 = c1 + 1
	return 1 + c3 * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
end

