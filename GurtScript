				if stateName == "idle" then
					Kit.idleOrig = Kit.idleOrig or setmetatable({}, { __mode = "k" })
					if Kit.idleOrig[obj] == nil then Kit.idleOrig[obj] = obj.AnimationId end -- the game's own idle
					if env.__NO_IDLES then want = Kit.idleOrig[obj] end -- NO IDLES: the game's idle stays
				end
