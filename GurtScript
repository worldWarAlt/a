			conn = RunService.Heartbeat:Connect(function(dt)
				acc += dt
				if acc < CHECK_EVERY then return end
				acc = 0
				local was = near
				near = bigNpcNear(bossWanted() and LEAVE_RANGE or RANGE)
				if near ~= was then reconcile() end
				if bossWanted() and not magnaDone then sweepMusic() end
				if infoLabel then infoLabel.Text = (bossWanted() and "PLAYING - " or "") .. (nearestInfo or "") end
			end)
		elseif not need and conn then
			conn:Disconnect()
			conn = nil
			near = false
			if infoLabel then infoLabel.Text = "" end
		end
	end

