-- short red lightning arc jumping off the arm
function H.arc()
	local list = Rage.list
	if #list == 0 then return end
	local a = list[math.random(#list)].part
	if not a.Parent then return end
	local sz = a.Size
	local p0 = (a.CFrame * CFrame.new((math.random() - 0.5) * sz.X, (math.random() - 0.5) * sz.Y, (math.random() - 0.5) * sz.Z)).Position
	local dir = Vector3.new(math.random() - 0.5, math.random() - 0.25, math.random() - 0.5)
	if dir.Magnitude < 0.1 then return end
	local p1 = p0 + dir.Unit * (2 + math.random() * 3.5)
	local function node(pos)
		local part = Instance.new("Part")
		part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
		part.Transparency = 1
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		part.CFrame = CFrame.new(pos)
		part.Parent = workspace.CurrentCamera
		local att = Instance.new("Attachment")
		att.Parent = part
		return part, att
	end
	local part0, a0 = node(p0)
	local part1, a1 = node(p1)
	local b = Instance.new("Beam")
	b.Attachment0, b.Attachment1 = a0, a1
	b.Color = ColorSequence.new(Color3.fromRGB(255, 235, 215), Color3.fromRGB(255, 40, 25))
	b.LightEmission = 1
	b.LightInfluence = 0
	b.FaceCamera = true
	b.Segments = 10
	b.Width0, b.Width1 = 0.4, 0.05
	b.CurveSize0, b.CurveSize1 = (math.random() - 0.5) * 3, (math.random() - 0.5) * 3
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.6) })
	b.Parent = part0
	task.delay(0.14, function() part0:Destroy() part1:Destroy() end)
