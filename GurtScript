			----------------------------------------------------------------
			-- Body bundles (Super Hero, Robot, Zombie ...): type  b:<name>  or  b:<bundle id / catalog link>  + Enter
			----------------------------------------------------------------
			function Body.morphIntoBundle(id, label, btn)
				status.Text = "Loading bundle " .. tostring(id) .. "..."
				task.spawn(function()
					local data, err = Body.fetchBundle(id)
					if not data then
						status.Text = "Bundle " .. tostring(id) .. " not found (" .. tostring(err) .. ")"
						return
					end
					local name = tostring(data.name or label or id)
					local desc = Body.bundleDescription(data)
					if not desc then
						status.Text = "'" .. name .. "' has no body parts I can load"
						return
					end
					local char = player.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					status.Text = "Building " .. name .. "..."
					local okC, container = pcall(Body.makeBundle, desc, name, hum ~= nil and hum.RigType == Enum.HumanoidRigType.R6)
					if not (okC and container) then
						warn("[MorphGui] bundle '" .. name .. "' failed: " .. tostring(container))
						status.Text = "Couldn't build " .. name .. " (see Output)"
						return
					end
					if morphInto(container, container) then
						if btn then
							btn.Text = "[BODY] " .. name
							setSelected(btn)
						end
						status.Text = morphMessage(name)
					else
						status.Text = "Failed to morph into " .. name
					end
				end)
			end

