runSection("16", function()
	local FINAL_TARGET_CFRAME = CFrame.new(-256.080963, -20.1576881, -769.15863, -0.863753378, -0.496257395, 0.0875138789, 7.76850761e-09, 0.173668012, 0.984804273, -0.503914773, 0.850628018, -0.150006339)
	local SWITCH_HEALTH = 30   -- at or below this, stop following the mutant and sit at the final spot
	local END_HEALTH = 10      -- at or below this, the sequence ends and you are sent back
	local NEAR_NPC_DIST = 30   -- a mutant with another living NPC within this many studs is avoided (go to one with nobody near it)
	local RECHECK_TIME = 0.25  -- how often (seconds) the mutant choice is re-checked
