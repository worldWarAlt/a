function H.themeIsAudio(body)
	if type(body) ~= "string" or #body < 10000 then return false end
	if string.sub(body, 1, 3) == "ID3" then return true end
	return string.byte(body, 1) == 0xFF and (string.byte(body, 2) or 0) >= 0xE0
end

function H.trackFileOk(T)
	if T.good then return true end
	local ok, body = pcall(function()
		return isfile and readfile and isfile(T.file) and readfile(T.file)
	end)
	if ok and H.themeIsAudio(body) then T.good = true end
	return T.good
end

function H.trackFetch(T, url)
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if req then
		local ok, res = pcall(req, { Url = url, Method = "GET" })
		if ok and type(res) == "table" then
			if res.StatusCode == 200 and H.themeIsAudio(res.Body) then return res.Body end
			T.lastErr = "HTTP " .. tostring(res.StatusCode) .. (res.StatusCode == 200 and " (not an mp3)" or "")
		elseif not ok then
			T.lastErr = tostring(res)
		end
	end
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and H.themeIsAudio(res) then return res end
	return nil
end

function H.trackDownload(T)
	if H.trackFileOk(T) then return true end
	if not writefile then T.lastErr = "writefile not supported" return false end
	if T.downloading then return false end
	T.downloading = true
	local body
	for _, url in ipairs(T.urls) do
		body = H.trackFetch(T, url)
		if body then break end
	end
	T.downloading = false
	if not body then return false end
	local ok, err = pcall(writefile, T.file, body)
	if not ok then T.lastErr = "writefile failed: " .. tostring(err) return false end
	T.good = false
	return H.trackFileOk(T)
end

function H.trackAsset(T)
	if T.assetId then return T.assetId end
	if not H.trackFileOk(T) then return nil end
	local fn = getcustomasset or getsynasset
	if not fn then T.lastErr = "executor has no getcustomasset" return nil end
	local ok, id = pcall(fn, T.file)
	if ok and id then T.assetId = id else T.lastErr = "getcustomasset failed: " .. tostring(id) end
	return T.assetId
end

-- starts looping song T (only while the rage is still in phase T.tag and nothing was reset meanwhile)
function H.startTrack(T, token)
	task.spawn(function()
		local waited = 0
		while T.downloading and waited < 30 do task.wait(0.25) waited = waited + 0.25 end
		if not H.trackDownload(T) then warn("[ChainRage] " .. T.name .. " download failed (" .. T.lastErr .. ")") return end
		local id = H.trackAsset(T)
		if not id then warn("[ChainRage] " .. T.name .. " not playable (" .. T.lastErr .. ")") return end
		if Rage.token ~= token or not alive or Rage.phase ~= T.tag then return end
		if not (T.sound and T.sound.Parent) then
			local snd = Instance.new("Sound")
			snd.Name = T.name
			snd.SoundId = id
			snd.Looped = true
			snd.Volume = 0
			snd.Parent = RageSoundService
			T.sound = snd
		end
		local snd = T.sound
		snd.TimePosition = 0
		snd.Volume = 0
		snd:Play()
		TweenService:Create(snd, TweenInfo.new(Rage.THEME_FADE), { Volume = T.volume }):Play()
	end)
end

function H.stopTrack(T, instant)
	local snd = T.sound
	if not (snd and snd.Parent) then return end
	if instant then snd:Stop() snd.Volume = 0 return end
	TweenService:Create(snd, TweenInfo.new(0.6), { Volume = 0 }):Play()
	task.delay(0.65, function()
		if snd.Parent and Rage.phase ~= T.tag then snd:Stop() end
	end)
end

