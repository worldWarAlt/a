runSection("4", function()
	local NORMAL_SPEED = 16
	local SPRINT_SPEED = 24
	local SPRINT_START_SPEED = 19
	local SPRINT_STOP_SPEED = 12
	local SPRINT_GRACE = 0.3

	local SPRINT_ANIMATION_ID = "rbxassetid://111821553591135"

