		local title = mk("TextLabel", {
			Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -10, 0, 17), BackgroundTransparency = 1, Font = Enum.Font.GothamMedium,
			Text = "", TextSize = 12, TextColor3 = WHITE, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, pick)
		local coords = mk("TextLabel", {
			Position = UDim2.fromOffset(8, 19), Size = UDim2.new(1, -10, 0, 13), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
			Text = "", TextSize = 10, TextColor3 = GREY_TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
		}, pick)
