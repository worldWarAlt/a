				if enterPressed and currentTab == "custom" then
					local raw = search.Text:match("^%s*(.-)%s*$")
					if not Body.bundleRequest(raw) then
						local name = raw:gsub("%s", "")
						if name ~= "" then
							addCustomEntry(name)
							status.Text = "Added @" .. name
						end
					end
					search.Text = ""
				end
			end)

