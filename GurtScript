---------------------------------------------------------------- 7) layout editor
---------------------------------------------------------------- 23) tool grip (5000 up + custom grips assigned per item)
runSection("23", function()
	local ACCENT = Color3.fromRGB(255, 160, 90)
	local CARD_BG = Color3.fromRGB(20, 20, 27)
	local ROW_BG = Color3.fromRGB(32, 32, 42)
	local WHITE = Color3.fromRGB(240, 240, 248)
	local TAB_SAVED_ON = Color3.fromRGB(180, 110, 50)
	local TAB_ITEMS_ON = Color3.fromRGB(60, 150, 90)
	local DEL_BG = Color3.fromRGB(120, 45, 55)
	local SAVE_FILE = "toolgrip_presets.json"
	local SAVE_DELAY = 0.5
	local POS_LIMIT, ROT_LIMIT = 100000, 3600
	local FIELDS = { "x", "y", "z", "rx", "ry", "rz" }
	local FULL_H = 406

	local lower, gsub, sformat = string.lower, string.gsub, string.format
	local cfNew, cfAngles, rad = CFrame.new, CFrame.Angles, math.rad

	local function trim(t) return (gsub(t or "", "^%s*(.-)%s*$", "%1")) end

	---------------------------------------------------------------- engine: no loop, no scanning
	-- Sets Tool.Grip once when a tool is equipped and sets it again only when something changes it back.
	-- Grip = original grip * (move, then tilt)^-1, so 0,0,0 = the tool's normal hold.
	-- resolver(lowercaseToolName) returns the grip table for that tool, or nil to leave the tool alone.
	--
	-- Cost model (v29, tightened again):
	--  * hot path (game resets the grip): one Grip read + one exact CFrame compare, a write only when it really differs;
	--    our own write coming back through the signal ends at the compare; the callback is built once per tool
	--  * a tool that is moved far away (FAR_DIST+) is stripped of everything the engine would keep working on for a
	--    handle thousands of studs from the character: collisions, touch events, spatial queries (raycasts), shadows,
	--    mass, and every particle / trail / beam / light inside it. All of it is put back when the grip is turned off
	--  * parts / effects that get added to a far tool later are stripped too (one cheap signal, only while it is held)
	--  * a script that keeps rewriting the grip can no longer start a ping-pong: more than STORM_MAX corrections inside
	--    STORM_WINDOW seconds are held back until the window is over
	--  * equip / unequip swaps: a tool is analysed once (parts, original grip, signals); unequipping to the backpack
	--    only parks it (a disconnect), re-equipping reconnects one signal - no GetDescendants, no allocations
	--  * dead characters and destroyed tools are pruned instead of piling up
	local FAR_DIST = 150
	local FAR_SQ = FAR_DIST * FAR_DIST
	local STORM_WINDOW, STORM_MAX = 0.1, 8
	local clock = os.clock
	local EFFECTS = {
		ParticleEmitter = true, Trail = true, Beam = true, Fire = true, Smoke = true, Sparkles = true,
		PointLight = true, SpotLight = true, SurfaceLight = true, Highlight = true,
	}

	local resolver = nil
	local tools = {}      -- [tool] = entry { orig, d, want, active, far, sig, fn, onAdd, gripConn, addConn, ancConn, t0, n, pp, pm, pc, pt, pq, ps, ep, ee }
	local watched = {}    -- [root] = its ChildAdded connection
	local conns = {}
	local running = false
	local activeCount = 0 -- tools that are held right now and moved

	-- title text lives in Lua; the label only gets written when the panel exists and the text changed
	local titleLabel
	local statusText, lastN = "TOOL GRIP POSITION", nil
	local function onStatus(n)
		if n == lastN then return end
		lastN = n
		local text
		if n < 0 then text = "TOOL GRIP POSITION"
		elseif n == 0 then text = "GRIP: equip a tool"
		else text = "GRIP: " .. n .. " tool" .. (n == 1 and "" or "s") .. " moved" end
		statusText = text
		if titleLabel then titleLabel.Text = text end
	end

	local function wantedFor(orig, d)
		local t = cfNew(d.x, d.y, d.z) * cfAngles(rad(d.rx), rad(d.ry), rad(d.rz))
		return orig * t:Inverse()
	end

	local function isFar(d)
		return d.x * d.x + d.y * d.y + d.z * d.z > FAR_SQ
	end

	local function near(a, b)
		return (a.Position - b.Position).Magnitude < 0.01
			and a.LookVector:Dot(b.LookVector) > 0.99999
			and a.UpVector:Dot(b.UpVector) > 0.99999
	end

	-- the RightGrip weld (default tool system keeps its C1 in sync with Tool.Grip; a custom one may not, so it is kept in
	-- sync here too). The joint is looked up once per equip and cached; a failed lookup is not retried for a second.
	local function syncWeld(tool, e, cf)
		local j = e.rg
		if not (j and j.Parent) then
			local now = clock()
			if now - e.rgMiss < 1 then return end
			j = nil
			local h = tool:FindFirstChild("Handle")
			if h then
				for _, jj in ipairs(h:GetJoints()) do
					if jj.Name == "RightGrip" then j = jj break end
				end
			end
			e.rg = j
			if not j then e.rgMiss = now return end
		end
		if j.C1 ~= cf then j.C1 = cf end
	end


	-- the Grip-changed callback of one tool: built once, reused on every equip
	local function makeReset(tool, e)
		return function()
			local want = e.want
			if not want then return end
			local g = tool.Grip
			if g == want or near(g, want) then return end -- exact compare first: almost every call ends here
			local now = clock()
			if now - e.t0 > STORM_WINDOW then
				e.t0, e.n = now, 0
			end
			local n = e.n + 1
			e.n = n
			if n > STORM_MAX then
				-- something rewrites the grip as fast as we fix it: do not ping-pong, correct once the window is over
				if not e.retry then
					e.retry = true
					task.delay(STORM_WINDOW, function()
						e.retry = false
						if e.active then e.fn() end
					end)
				end
				return
			end
			tool.Grip = want
			pcall(syncWeld, tool, e, want)
		end
	end

	local function setGrip(tool, g) tool.Grip = g end

	-- records one part / effect with its original values (once: `seen` stops a re-added part from being recorded with the
	-- values we already stripped)
	local MAX_RECORDED = 1024
	local function recordOne(e, d)
		local seen = e.seen
		if seen[d] then return end
		local cn = d.ClassName
		if EFFECTS[cn] then
			seen[d] = true
			local k = #e.ep + 1
			e.ep[k], e.ee[k] = d, d.Enabled
		elseif d:IsA("BasePart") then
			seen[d] = true
			local n = #e.pp + 1
			if n > MAX_RECORDED then return end
			e.pp[n], e.pm[n], e.pc[n] = d, d.Massless, d.CanCollide
			e.pt[n], e.pq[n], e.ps[n] = d.CanTouch, d.CanQuery, d.CastShadow
		end
	end

	-- one pass over the tool: records everything not seen yet (nothing is changed here)
	local function record(tool, e)
		for _, d in ipairs(tool:GetDescendants()) do recordOne(e, d) end
	end

	-- far mode on / off. Far: parts lose mass / collision / touch / query / shadow and effects are switched off. Near: all of
	-- it is put back exactly as recorded. A tool that is only moved a little is never touched.
	local function setFar(tool, e, far)
		if e.far == far then return end
		e.far = far
		local pp, pm, pc, pt, pq, ps = e.pp, e.pm, e.pc, e.pt, e.pq, e.ps
		if far then
			if e.fresh then e.fresh = false else record(tool, e) end -- parts added since the first look
			pp, pm, pc, pt, pq, ps = e.pp, e.pm, e.pc, e.pt, e.pq, e.ps
			for i = 1, #pp do
				local p = pp[i]
				p.Massless = true
				p.CanCollide = false
				p.CanTouch = false
				p.CanQuery = false
				p.CastShadow = false
			end
		else
			for i = 1, #pp do
				local p = pp[i]
				p.Massless = pm[i]
				p.CanCollide = pc[i]
				p.CanTouch = pt[i]
				p.CanQuery = pq[i]
				p.CastShadow = ps[i]
			end
		end
		local ep, ee = e.ep, e.ee
		for i = 1, #ep do
			ep[i].Enabled = (not far) and ee[i]
		end
	end

	-- keeps the far state and its "new parts" listener in line with the current values / held state
	local function syncFar(tool, e)
		local far = isFar(e.d)
		if far ~= e.far then pcall(setFar, tool, e, far) end
		if far and e.active then
			if not e.addConn then e.addConn = tool.DescendantAdded:Connect(e.onAdd) end
		elseif e.addConn then
			e.addConn:Disconnect()
			e.addConn = nil
		end
	end

	-- full removal: puts the tool back the way it was and forgets it
	local function unhook(tool)
		local e = tools[tool]
		if not e then return end
		tools[tool] = nil
		local wasActive = e.active
		if wasActive then
			e.active = false
			activeCount = activeCount - 1
			e.gripConn:Disconnect()
			e.gripConn = nil
		end
		if e.addConn then
			e.addConn:Disconnect()
			e.addConn = nil
		end
		e.ancConn:Disconnect()
		pcall(setGrip, tool, e.orig)
		pcall(function() if e.rg and e.rg.Parent then e.rg.C1 = e.orig end end)
		pcall(setFar, tool, e, false)
		if wasActive then onStatus(activeCount) end
	end

	-- the tool went back to the backpack: stop listening for grip changes, keep everything cached
	local function park(e)
		if not e.active then return end
		e.active = false
		activeCount = activeCount - 1
		e.gripConn:Disconnect()
		e.gripConn = nil
		if e.addConn then
			e.addConn:Disconnect()
			e.addConn = nil
		end
		e.rg = nil -- the weld is gone with the unequip; it is looked up again on the next equip
		onStatus(activeCount)
	end

	local function onAncestry(tool)
		local e = tools[tool]
		if not e then return end
		local parent = tool.Parent
		if parent and watched[parent] and parent.Parent then return end -- held by a live character (ChildAdded handles it)
		if parent and parent.ClassName == "Backpack" then
			park(e)
		else
			unhook(tool) -- dropped, destroyed, or its character is gone
		end
	end

	-- a part / effect that appears inside a far tool is recorded (so it can be restored later) and stripped on the spot
	local function makeOnAdd(e)
		return function(d)
			recordOne(e, d)
			if EFFECTS[d.ClassName] then
				d.Enabled = false
			elseif d:IsA("BasePart") then
				d.Massless = true
				d.CanCollide = false
				d.CanTouch = false
				d.CanQuery = false
				d.CastShadow = false
			end
		end
	end

	local function hook(tool)
		local resolve = resolver
		if not resolve then return end
		local e = tools[tool]
		if e and e.active then return end
		local d = resolve(lower(tool.Name))
		if not d then
			if e then unhook(tool) end
			return
		end
		if e then
			-- back from the backpack: everything is cached, only the values may have changed
			if d ~= e.d then
				e.d = d
				e.want = wantedFor(e.orig, d)
			end
		else
			e = {
				orig = tool.Grip, d = d, far = false, t0 = 0, n = 0, fresh = true, rg = nil, rgMiss = -1e9,
				seen = setmetatable({}, { __mode = "k" }),
				pp = {}, pm = {}, pc = {}, pt = {}, pq = {}, ps = {}, ep = {}, ee = {},
			}
			e.want = wantedFor(e.orig, d)
			e.fn = makeReset(tool, e)
			e.onAdd = makeOnAdd(e)
			tools[tool] = e
			record(tool, e)
			e.sig = tool:GetPropertyChangedSignal("Grip")
			e.ancConn = tool.AncestryChanged:Connect(function() onAncestry(tool) end)
		end
		e.active = true
		activeCount = activeCount + 1
		e.gripConn = e.sig:Connect(e.fn)
		e.n = 0
		e.fn()
		syncFar(tool, e)
		e.fresh = false
		onStatus(activeCount)
	end

	local function dropRoot(root)
		local c = watched[root]
		watched[root] = nil
		if c then c:Disconnect() end
	end

	-- re-evaluates every known tool (after values / assignments / the item name change)
	local function refresh()
		local resolve = resolver
		if not resolve then return end
		for tool, e in pairs(tools) do
			local d = resolve(lower(tool.Name))
			if d then
				if d ~= e.d then
					e.d = d
					e.want = wantedFor(e.orig, d)
				end
				if e.active then
					e.n = 0
					e.fn()
				end
				syncFar(tool, e)
			else
				unhook(tool)
			end
		end
		for root in pairs(watched) do
			if root.Parent then
				for _, c in ipairs(root:GetChildren()) do
					if c:IsA("Tool") then hook(c) end -- already-active tools return immediately
				end
			else
				dropRoot(root)
			end
		end
		onStatus(activeCount)
	end

	local function watchRoot(root)
		if not root or watched[root] then return end
		for r in pairs(watched) do -- characters from earlier lives are gone: stop holding on to them
			if not r.Parent then dropRoot(r) end
		end
		watched[root] = root.ChildAdded:Connect(function(c)
			if c:IsA("Tool") then hook(c) end
		end)
		for _, c in ipairs(root:GetChildren()) do
			if c:IsA("Tool") then hook(c) end
		end
	end

	local function engineSet(r)
		if r then
			resolver = r
			if not running then
				running = true
				local myName = LocalPlayer.Name
				conns[#conns + 1] = LocalPlayer.CharacterAdded:Connect(watchRoot)
				local folder = Workspace:FindFirstChild("Characters")
				if folder then
					conns[#conns + 1] = folder.ChildAdded:Connect(function(c)
						if c.Name == myName then watchRoot(c) end
					end)
				end
				watchRoot(LocalPlayer.Character)
				watchRoot(folder and folder:FindFirstChild(myName))
			end
			refresh()
		else
			resolver = nil
			running = false
			for _, c in ipairs(conns) do c:Disconnect() end
			table.clear(conns)
			for root in pairs(watched) do dropRoot(root) end
			for tool in pairs(tools) do unhook(tool) end
			activeCount = 0
			onStatus(-1)
		end
	end

	local function heldTool()
		local c = LocalPlayer.Character
		local t = c and c:FindFirstChildOfClass("Tool")
		if t then return t end
		local f = Workspace:FindFirstChild("Characters")
		local m = f and f:FindFirstChild(LocalPlayer.Name)
		return m and m:FindFirstChildOfClass("Tool") or nil
	end

	---------------------------------------------------------------- saved data
	local presets = {}      -- named positions (list)
	local assignments = {}  -- [lowercase item name] = { name, x, y, z, rx, ry, rz } (never edited in place, only replaced)
	local cur = { x = 0, y = 0, z = 0, rx = 0, ry = 0, rz = 0 } -- replaced (never edited in place) when the values change

	local function readEntry(t)
		if type(t) ~= "table" then return nil end
		local e = {}
		for _, k in ipairs(FIELDS) do
			local v = tonumber(t[k])
			if v == nil then
				if k == "x" or k == "y" or k == "z" then return nil end
				v = 0
			end
			e[k] = v
		end
		return e
	end

	pcall(function()
		if not (isfile and readfile and isfile(SAVE_FILE)) then return end
		local d = HttpService:JSONDecode(readfile(SAVE_FILE))
		if type(d) ~= "table" then return end
		if type(d.presets) == "table" then
			for _, p in ipairs(d.presets) do
				local e = readEntry(p)
				if e and type(p.name) == "string" then
					e.name = p.name
					table.insert(presets, e)
				end
			end
		end
		if type(d.assign) == "table" then
			for _, a in pairs(d.assign) do
				local e = readEntry(a)
				if e and type(a.name) == "string" and a.name ~= "" then
					e.name = a.name
					assignments[lower(a.name)] = e
				end
			end
		end
		local l = readEntry(d.last)
		if l then cur = l end
	end)

	-- saving is debounced: a burst of edits is one JSON encode + one file write, and an unchanged file is not rewritten
	local dirty, saveQueued, lastJson = false, false, nil
	local function flushSave()
		saveQueued = false
		if not dirty or not writefile then return end
		dirty = false
		local ok, json = pcall(HttpService.JSONEncode, HttpService, { presets = presets, assign = assignments, last = cur })
		if ok and json ~= lastJson and pcall(writefile, SAVE_FILE, json) then lastJson = json end
	end
	local function persist()
		dirty = true
		if saveQueued then return end
		saveQueued = true
		task.delay(SAVE_DELAY, flushSave)
	end

	local function num(t, lim) return math.clamp(tonumber(t) or 0, -lim, lim) end
	local function fmt(n) return sformat("%g", n) end
	local function coordText(p)
		local c = fmt(p.x) .. ", " .. fmt(p.y) .. ", " .. fmt(p.z)
		if p.rx ~= 0 or p.ry ~= 0 or p.rz ~= 0 then
			c = c .. "  |  " .. fmt(p.rx) .. ", " .. fmt(p.ry) .. ", " .. fmt(p.rz)
		end
		return c
	end

	---------------------------------------------------------------- state shared by the panel and the engine
	local customOn = false
	local setVisCustom
	local editKey = ""  -- lowercase name of the item being edited ("" = every other tool gets the values)

	-- which grip each tool gets while CUSTOM GRIP is on:
	--  * the tool named in the ITEM box is edited live with the values above
	--  * any other tool with an assigned grip uses its assignment
	--  * with the ITEM box empty, every other tool gets the values above
	local function customResolver(key)
		if editKey ~= "" and key == editKey then return cur end
		local a = assignments[key]
		if a then return a end
		if editKey == "" then return cur end
		return nil
	end

	local function applyIfOn()
		if customOn then engineSet(customResolver) end
		persist()
	end

	onCleanup(function()
		Kit.customGripOn = false
		engineSet(nil)
		flushSave()
	end)

	---------------------------------------------------------------- panel UI (built the first time CUSTOM GRIP is opened)
	local function mk(class, props, parent)
		local o = Instance.new(class)
		for k, v in pairs(props) do o[k] = v end
		o.Parent = parent
		return o
	end
	local function corner(o, r) Instance.new("UICorner", o).CornerRadius = UDim.new(0, r) end

	local gui, main, uiScale, body, boxes, itemBox, nameBox, msg, emptyLabel, tabSaved, tabItems, list
	local viewConn, moveConn
	local setPanelOpen, pillGui
	local tab = "saved"
	local rows = {} -- pooled list rows, reused instead of destroyed and rebuilt
	local rebuild

	local function say(t) if msg then msg.Text = t end end

	-- boxes -> cur; returns true when a value really changed (nothing else needs to run when it did not)
	local function readBoxes()
		local c, changed = {}, false
		for i = 1, #FIELDS do
			local k = FIELDS[i]
			local box = boxes[k]
			local v = num(box.Text, i <= 3 and POS_LIMIT or ROT_LIMIT)
			c[k] = v
			if v ~= cur[k] then changed = true end
			local s = fmt(v)
			if box.Text ~= s then box.Text = s end
		end
		if changed then cur = c end
		return changed
	end

	-- values -> boxes (+ cur); returns true when the values changed
	local function loadValues(t)
		for _, k in ipairs(FIELDS) do
			local s = fmt(t[k] or 0)
			local box = boxes[k]
			if box.Text ~= s then box.Text = s end
		end
		return readBoxes()
	end

	-- ITEM box -> editKey; returns true when the edited item changed
	local function commitItem()
		local text = trim(itemBox.Text)
		if itemBox.Text ~= text then itemBox.Text = text end
		local key = lower(text)
		if key == editKey then return false end
		editKey = key
		return true
	end

	local function loadAssignedIfAny()
		local a = assignments[editKey]
		if a then return loadValues(a) end
		return false
	end

	local function stopDrag()
		if moveConn then
			moveConn:Disconnect()
			moveConn = nil
		end
	end

	---------------------------------------------------------------- btools-style handles
	-- Arrows move the held tool, rings tilt it (like Roblox build tools). They sit on the held tool's Handle part and write
	-- straight into the X / Y / Z / tilt values. Grip = orig * t^-1 puts the Handle at hand * t * orig^-1, so a drag D made in
	-- the Handle's own frame turns into t' = t * orig^-1 * D * orig. SNAP rounds the drag. Only one small poll (4x/s) runs
	-- while the handles are on, to follow the held tool; nothing runs per frame.
	local SNAPS = { { "OFF", 0, 0 }, { "FINE", 0.1, 1 }, { "MED", 0.5, 5 }, { "BIG", 1, 15 } }
	local snapIdx = 1
	local gizBtn, snapBtn
	local giz = { on = false, gui = nil, mv = nil, rt = nil, tool = nil, token = 0, endConn = nil }
	local nud = { on = false, gui = nil, axis = 1 }
	local MOBILE = UIS.TouchEnabled and not UIS.KeyboardEnabled
	local dragTool, dragT0, dragOrig = nil, nil, nil
	local deg = math.deg

	local function liveApply(tool)
		local e = tools[tool]
		if not e then applyIfOn() return end
		local d = customResolver(lower(tool.Name))
		if not d then return end
		if d ~= e.d then
			e.d = d
			e.want = wantedFor(e.orig, d)
		end
		if e.active then
			e.n = 0
			e.fn()
		end
		syncFar(tool, e)
	end

	local function r3(v) return math.floor(v * 1000 + 0.5) / 1000 end

	local function applyT(tool, tn)
		local rx, ry, rz = tn:ToEulerAnglesXYZ()
		local c = {
			x = num(r3(tn.X), POS_LIMIT), y = num(r3(tn.Y), POS_LIMIT), z = num(r3(tn.Z), POS_LIMIT),
			rx = num(r3(deg(rx)), ROT_LIMIT), ry = num(r3(deg(ry)), ROT_LIMIT), rz = num(r3(deg(rz)), ROT_LIMIT),
		}
		cur = c
		if boxes then
			for _, k in ipairs(FIELDS) do
				local box = boxes[k]
				local txt = fmt(c[k])
				if box and box.Text ~= txt then box.Text = txt end
			end
		end
		liveApply(tool)
	end

	local function dragBegin()
		local tool = giz.tool
		local e = tool and tools[tool]
		if not e then say("Equip a tool while CUSTOM GRIP is on to use the handles") return end
		dragTool = tool
		dragT0 = cfNew(cur.x, cur.y, cur.z) * cfAngles(rad(cur.rx), rad(cur.ry), rad(cur.rz))
		dragOrig = e.orig
	end

	local function dragMove(D)
		if not dragTool then return end
		applyT(dragTool, dragT0 * (dragOrig:Inverse() * D * dragOrig))
	end

	local function dragEnd()
		if dragTool then
			dragTool = nil
			persist()
		end
	end

	local function buildGizmo()
		if giz.gui then return end
		giz.gui = mk("ScreenGui", { Name = "ToolGripGizmoGui", ResetOnSpawn = false, DisplayOrder = 219 }, PlayerGui)
		local mv = mk("Handles", {
			Style = Enum.HandlesStyle.Movement, Color3 = ACCENT,
			Faces = Faces.new(Enum.NormalId.Right, Enum.NormalId.Left, Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Back, Enum.NormalId.Front),
		}, giz.gui)
		local rt = mk("ArcHandles", {
			Color3 = Color3.fromRGB(120, 200, 255), Axes = Axes.new(Enum.Axis.X, Enum.Axis.Y, Enum.Axis.Z),
		}, giz.gui)
		giz.mv, giz.rt = mv, rt
		mv.MouseButton1Down:Connect(dragBegin)
		mv.MouseDrag:Connect(function(face, dist)
			local step = SNAPS[snapIdx][2]
			if step > 0 then dist = math.floor(dist / step + 0.5) * step end
			dragMove(cfNew(Vector3.fromNormalId(face) * dist))
		end)
		mv.MouseButton1Up:Connect(dragEnd)
		rt.MouseButton1Down:Connect(dragBegin)
		rt.MouseDrag:Connect(function(axis, angle)
			local step = SNAPS[snapIdx][3]
			local a = deg(angle)
			if step > 0 then a = math.floor(a / step + 0.5) * step end
			dragMove(CFrame.fromAxisAngle(Vector3.fromAxis(axis), rad(a)))
		end)
		rt.MouseButton1Up:Connect(dragEnd)
		-- releasing outside the handle must still end the drag
		giz.endConn = UIS.InputEnded:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then dragEnd() end
		end)
	end

	-- follows the held tool: handles go on its Handle part, and the ITEM box switches to it (same as the HELD button)
	local function retarget()
		local tool = heldTool()
		local part = tool and tool:FindFirstChild("Handle")
		if part and not part:IsA("BasePart") then part = nil end
		if tool and not part then part = tool:FindFirstChildWhichIsA("BasePart", true) end
		if tool ~= giz.tool then
			dragTool = nil
			giz.tool = tool
			if tool and itemBox then
				itemBox.Text = tool.Name
				local c1 = commitItem()
				local c2 = loadAssignedIfAny()
				if c1 or c2 then applyIfOn() end
				say("Editing: " .. tool.Name)
			end
		end
		if giz.on and giz.mv and giz.mv.Adornee ~= part then
			giz.mv.Adornee = part
			giz.rt.Adornee = part
		end
	end

	local function paintGizBtn()
		if gizBtn then
			gizBtn.Text = "HANDLES: " .. (giz.on and "ON" or "OFF")
			gizBtn.BackgroundColor3 = giz.on and TAB_ITEMS_ON or ROW_BG
		end
	end

	-- one small poll (4x/s) follows the held tool while the handles or the nudge bar are on
	local pollToken = 0
	local function startPoll()
		pollToken += 1
		local t = pollToken
		task.spawn(function()
			while (giz.on or nud.on) and pollToken == t do
				pcall(retarget)
				task.wait(0.25)
			end
		end)
	end

	local function setGizmo(on)
		if on == giz.on then return end
		giz.on = on
		giz.token += 1
		paintGizBtn()
		if on then
			buildGizmo()
			startPoll()
		elseif giz.mv then
			giz.mv.Adornee = nil
			giz.rt.Adornee = nil
			giz.tool = nil
			dragTool = nil
		end
	end

	onCleanup(function()
		setGizmo(false)
		if giz.endConn then giz.endConn:Disconnect() giz.endConn = nil end
		if giz.gui then giz.gui:Destroy() giz.gui = nil end
	end)

	---------------------------------------------------------------- touch-friendly nudge bar
	-- Handles are tiny on a phone, so this is the finger version: pick an axis, then swipe the big bar left / right or tap /
	-- hold - and +. Values are the same X / Y / Z / tilt numbers as the boxes (hand frame). Step size follows SNAP.
	local AXES = { "x", "y", "z", "rx", "ry", "rz" }
	local AXIS_LABEL = { "X", "Y", "Z", "RX", "RY", "RZ" }
	local PX_PER_UNIT = 8
	local nudBtn, nudBar, nudStep
	local nudChips = {}
	local nudToken = 0

	local function nudUnit()
		local isRot = nud.axis >= 4
		local sn = SNAPS[snapIdx]
		local step = isRot and sn[3] or sn[2]
		if step <= 0 then step = isRot and 1 or 0.1 end
		return step
	end

	local function nudRefresh()
		if not nud.gui then return end
		local k = AXES[nud.axis]
		nudBar.Text = "<   " .. AXIS_LABEL[nud.axis] .. " = " .. fmt(cur[k]) .. "   >"
		nudStep.Text = "STEP " .. fmt(nudUnit()) .. (nud.axis >= 4 and " deg" or "")
		for i, b in ipairs(nudChips) do
			b.BackgroundColor3 = i == nud.axis and TAB_SAVED_ON or ROW_BG
		end
	end

	local function cycleSnap()
		snapIdx = snapIdx % #SNAPS + 1
		local sn = SNAPS[snapIdx]
		if snapBtn then snapBtn.Text = "SNAP: " .. sn[1] end
		if sn[2] > 0 then say("Snap: " .. fmt(sn[2]) .. " studs / " .. fmt(sn[3]) .. " deg") else say("Snap off") end
		nudRefresh()
	end

	local function bump(delta)
		local k = AXES[nud.axis]
		local c = {}
		for _, f in ipairs(FIELDS) do c[f] = cur[f] end
		c[k] = num(r3(c[k] + delta), nud.axis <= 3 and POS_LIMIT or ROT_LIMIT)
		if c[k] == cur[k] then return end
		cur = c
		if boxes then
			local box, txt = boxes[k], fmt(c[k])
			if box and box.Text ~= txt then box.Text = txt end
		end
		nudRefresh()
		local tool = heldTool()
		if tool then
			liveApply(tool)
			persist()
		else
			applyIfOn()
		end
	end

	local function isPress(input)
		local t = input.UserInputType
		return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
