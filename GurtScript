	local function panelButton(parent, text, size, pos, color)
		local b = Instance.new("TextButton")
		b.Size = size
		b.Position = pos
		b.BackgroundColor3 = color or BTN_BG
		b.BorderSizePixel = 0
		b.AutoButtonColor = true
		b.Font = Enum.Font.GothamBold
