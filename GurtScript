	-- LOCAL PLAYER ONLY. The timer lives on the model that is you: workspace.Characters.<your name>, your live character, your Player.
	-- Other players' / NPC models are never read or touched. Also accepts an Attribute named HatredTimer.
	local function holders()
		local list, seen = {}, {}
		local function add(h) if h and not seen[h] then seen[h] = true table.insert(list, h) end end
		local folder = Workspace:FindFirstChild("Characters")
		add(folder and folder:FindFirstChild(LocalPlayer.Name))
		add(LocalPlayer.Character)
		add(LocalPlayer)
		return list
	end

	local lastWhere = nil
	-- returns obj (an Instance) or nil, plus an attribute value when the timer is stored as an Attribute
	local function findObj()
		for _, h in ipairs(holders()) do
			local o = h:FindFirstChild(OBJ_NAME) or h:FindFirstChild(OBJ_NAME, true)
			if o then
				local where = o:GetFullName()
				if where ~= lastWhere then lastWhere = where print("[HATRED TIMER] found at " .. where) end
				return o, nil
			end
			local a = h:GetAttribute(OBJ_NAME)
			if a ~= nil then
				local where = h:GetFullName() .. "@" .. OBJ_NAME
				if where ~= lastWhere then lastWhere = where print("[HATRED TIMER] attribute on " .. h:GetFullName()) end
				return nil, a
			end
		end
		return nil, nil
	end

	-- HatredTimer can be the BoolValue itself, or a plain object (Folder/Configuration/...) holding BoolValue(s)
	local function readObj(o)
		if not o then return nil end
		if o:IsA("ValueBase") then return o.Value end
		local parts = {}
		for _, d in ipairs(o:GetDescendants()) do
			if d:IsA("ValueBase") then
				table.insert(parts, { name = d.Name, value = d.Value })
			end
		end
		if #parts == 1 then return parts[1].value end
		if #parts > 1 then
			local out = {}
			for _, p in ipairs(parts) do
				table.insert(out, p.name .. "=" .. tostring(p.value))
			end
			return table.concat(out, " ")
		end
		local attr = o:GetAttribute("Value")
		if attr ~= nil then return attr end
		return nil
	end

	local function fmt(v)
		if v == nil then return "N/A", NEUTRAL end
		if type(v) == "boolean" then
			return v and "TRUE" or "FALSE", v and ON_COL or OFF_COL
		end
		if type(v) == "number" then
			if v == math.floor(v) then return tostring(v), NEUTRAL end
			return string.format("%.2f", v), NEUTRAL
		end
		return tostring(v), NEUTRAL
	end

	-- X deletes the ENTIRE HatredTimer value (the object and everything inside it) on YOUR model only.
	-- NOTE: this only removes the CLIENT copy. If the game's server counts the time down itself, the limit still runs out on the server.
	local deleted = false
	delBtn.MouseButton1Click:Connect(function()
		local n = 0
		for _, h in ipairs(holders()) do
			for _, o in ipairs(h:GetDescendants()) do
				if o.Name == OBJ_NAME then
					pcall(function() o:Destroy() end)
					n = n + 1
				end
			end
			if h:GetAttribute(OBJ_NAME) ~= nil then
				pcall(function() h:SetAttribute(OBJ_NAME, nil) end)
				n = n + 1
			end
		end
		if n > 0 then
			deleted = true
			valueLabel.Text = "DELETED"
			valueLabel.TextColor3 = NEUTRAL
		end
	end)

	local alive = true
	onCleanup(function() alive = false end)

	task.spawn(function()
		local last = nil
		while alive do
			local obj, attr = findObj()
			if obj or attr ~= nil then deleted = false end
			local ok, text, col = pcall(function()
				if obj then return fmt(readObj(obj)) end
				return fmt(attr)
			end)
			if not ok then text, col = "N/A", NEUTRAL end
			if deleted and not obj and attr == nil then text, col = "DELETED", NEUTRAL end
			if text ~= last then
				last = text
				valueLabel.Text = text
				valueLabel.TextColor3 = col
			end
			task.wait(POLL)
		end
	end)

	---------------------------------------------------------------- HATRED GOD (fixed fires per SECOND, spread evenly over the frames, ping-guarded)
	-- Same remote as the GODMODE card (section 9). Rate is per SECOND (not per frame), so it is the same at 30 / 60 / 144 FPS and the fires are spread
	-- evenly (never one huge burst). The cause of the desync is the remote queue filling the connection so your position updates arrive late:
	-- the PING GUARD watches Data Ping 10x per second and cuts the rate when the ping climbs, then lets it recover slowly toward GOD_RATE.
	-- Console: HatredGodRate(n) sets the target per second, HatredGodRate() prints status, HatredGodGuard(false/true) switches the guard off/on.
	local GOD_RATE = 800        -- target fires per second
	local GOD_RATE_MAX = 3000   -- ceiling for HatredGodRate(n)
	local GOD_RATE_MIN = 40     -- the guard never goes below this
	local GOD_FRAME_CAP = 40    -- hard cap per frame (keeps one slow frame from becoming a burst)
	local GOD_GUARD = true
	local GOD_PING_RATIO, GOD_PING_ADD = 1.15, 8  -- strain = ping > base * ratio + add (ms): tighter than GODMODE because desync starts before lag
	local godRate = GOD_RATE    -- rate actually in use (the guard moves this)
	local godCredit, godBasePing, godNextPing, godLastBack = 0, nil, 0, 0
	local godCount, godFrames, godLastLog = 0, 0, 0
	local godRemote, godFire, godConn = nil, nil, nil
	local godLastSearch, godWarned = 0, false

	local godPingItem = nil
	do
		local okP, item = pcall(function() return game:GetService("Stats").Network.ServerStatsItem["Data Ping"] end)
		if okP then godPingItem = item end
	end
	local function godReadPing()
		if not godPingItem then return nil end
		local okV, v = pcall(godPingItem.GetValue, godPingItem)
		if okV and type(v) == "number" and v > 0 then return v end
		return nil
	end

	local function godResolve()
		local r = ReplicatedStorage:FindFirstChild("TauntEvent")
		if not r then
			local now = os.clock()
			if now - godLastSearch < 0.5 then godRemote, godFire = nil, nil return false end
			godLastSearch = now
			local char = LocalPlayer.Character
			local pack = LocalPlayer:FindFirstChildOfClass("Backpack")
			r = (char and char:FindFirstChild("TauntEvent", true)) or (pack and pack:FindFirstChild("TauntEvent", true))
			if r and not r:IsA("RemoteEvent") then r = nil end
			if not r and not godWarned then
				godWarned = true
				warn("[HATRED GOD] TauntEvent not found in ReplicatedStorage, your character or your Backpack (equip the tool and try again)")
			end
		end
		if r then godWarned = false end
		godRemote = r
		godFire = r and r.FireServer or nil
		return godFire ~= nil
	end

	local function godStep(dt)
		if dt > 0.25 then godCredit = 0 return end
		if not (godRemote and godRemote.Parent) and not godResolve() then return end
		local now = os.clock()

		-- ping guard
		if GOD_GUARD and godPingItem and now >= godNextPing then
			godNextPing = now + 0.1
			local ping = godReadPing()
			if ping then
				if not godBasePing or ping < godBasePing then
					godBasePing = ping
				else
					godBasePing += (ping - godBasePing) * 0.0005
				end
				if ping > godBasePing * GOD_PING_RATIO + GOD_PING_ADD then
					if now - godLastBack >= 0.25 then
						godLastBack = now
						godRate = math.max(GOD_RATE_MIN, godRate * 0.6)
					end
				else
					-- recover slowly toward the target
					godRate = math.min(GOD_RATE, godRate + GOD_RATE * 0.15 * dt)
				end
			end
		elseif not GOD_GUARD then
			godRate = GOD_RATE
		end

		godCredit = math.min(godCredit + godRate * dt, GOD_FRAME_CAP)
		local n = math.floor(godCredit)
		if n < 1 then return end
		godCredit -= n
		local f, r = godFire, godRemote
		pcall(function()
			for _ = 1, n do f(r) end
		end)

		godCount += n
		godFrames += 1
		if now - godLastLog >= 1 then
			print(string.format("[HATRED GOD] %d fires/s | rate in use %d (target %d) | ping %s ms (base %s)", godCount / math.max(now - godLastLog, 0.001), godRate, GOD_RATE,
				tostring(math.floor(godReadPing() or 0)), tostring(math.floor(godBasePing or 0))))
			godCount, godFrames, godLastLog = 0, 0, now
		end
	end

	local function godSet(on)
		if on then
			if godConn then return end
			-- the adaptive GODMODE card fires the same remote: switch it off so the two never add up
			if FeatureHooks.taunt then pcall(FeatureHooks.taunt) end
			godResolve()
			godCount, godFrames, godLastLog = 0, 0, os.clock()
			godCredit, godRate, godBasePing, godNextPing, godLastBack = 0, GOD_RATE, godReadPing(), 0, 0
			print("[HATRED GOD] ON | target " .. GOD_RATE .. " fires/s, ping guard " .. (GOD_GUARD and "ON" or "OFF"))
			godConn = RunService.Heartbeat:Connect(godStep)
		elseif godConn then
			godConn:Disconnect()
			godConn = nil
		end
	end
	onCleanup(function() godSet(false) end)
	-- drop the cached remote on respawn so a replaced TauntEvent is found again
	bind(LocalPlayer.CharacterAdded:Connect(function() godRemote, godFire = nil, nil end))

	env.HatredGodRate = function(n)
		if type(n) == "number" and n > 0 then
			GOD_RATE = math.min(n, GOD_RATE_MAX)
			godRate = math.min(godRate, GOD_RATE)
		end
		print(string.format("[HATRED GOD] %s | target %d/s | in use %d/s | guard %s", godConn and "ON" or "OFF", GOD_RATE, godRate, GOD_GUARD and "ON" or "OFF"))
	end
	env.HatredGodGuard = function(v)
		if type(v) == "boolean" then GOD_GUARD = v end
		print("[HATRED GOD] ping guard " .. (GOD_GUARD and "ON" or "OFF"))
	end

	local godOn = false
	local godVisual
	godVisual = makeToggleCard("HatredGodGui", "HatredGodToggle", "HATRED GOD", 11, Color3.fromRGB(255, 70, 70), 1824, function()
		godOn = not godOn
		godSet(godOn)
		return godOn
	end)
	FeatureHooks.hatredgod = function()
		godOn = false
		godSet(false)
		godVisual(false)
	end
end)

---------------------------------------------------------------- 32) LIGHTING LOCK (toggle)
-- The lighting is recorded when the script LOADS (Lighting values + the effects inside it: ColorCorrection, Blur, Bloom, SunRays,
-- DepthOfField, Atmosphere, Sky). While the LIGHT LOCK card is ON, every change to those values is put back to the recording at once,
-- effects the game adds later are switched off (post effects) or taken out of Lighting (Atmosphere / Sky), and a recorded effect the game
-- deletes is put back. It only reacts to change events (no polling loop). OFF puts the parked effects back and stops reverting.
-- FULLBRIGHT keeps working: while it is on, the lock leaves the values fullbright owns alone.
-- Console: LightingLockResnap() records the CURRENT lighting as the new baseline (turn FULLBRIGHT off first).
runSection("32", function()
	local LOCK_CLOCK = true          -- also freeze the time of day (ClockTime)
	local BLOCK_NEW_EFFECTS = true   -- switch off / park effects the game adds after the recording
	local IGNORE = {                 -- effect names that are never touched
		MG_BloodMoonCC = true,       -- the BLOODMOON tint of CHAIN RAGE (delete this line to block it too)
	}

	local LIGHTING_PROPS = {
		"Ambient", "OutdoorAmbient", "Brightness", "ColorShift_Bottom", "ColorShift_Top",
		"EnvironmentDiffuseScale", "EnvironmentSpecularScale", "ExposureCompensation",
		"FogColor", "FogStart", "FogEnd", "GlobalShadows", "ShadowSoftness", "GeographicLatitude",
	}
	if LOCK_CLOCK then table.insert(LIGHTING_PROPS, "ClockTime") end

	local EFFECT_PROPS = {
		ColorCorrectionEffect = { "Enabled", "Brightness", "Contrast", "Saturation", "TintColor" },
		BlurEffect = { "Enabled", "Size" },
		BloomEffect = { "Enabled", "Intensity", "Size", "Threshold" },
		SunRaysEffect = { "Enabled", "Intensity", "Spread" },
		DepthOfFieldEffect = { "Enabled", "FarIntensity", "FocusDistance", "InFocusRadius", "NearIntensity" },
		Atmosphere = { "Color", "Decay", "Density", "Glare", "Haze", "Offset" },
		Sky = {
			"SkyboxBk", "SkyboxDn", "SkyboxFt", "SkyboxLf", "SkyboxRt", "SkyboxUp",
			"CelestialBodiesShown", "StarCount", "SunTextureId", "MoonTextureId", "SunAngularSize", "MoonAngularSize",
		},
	}
	-- what FULLBRIGHT (section 13) writes itself: the lock does not fight it while it is on
	local FB_LIGHTING = { Brightness = true, ClockTime = true, FogEnd = true, GlobalShadows = true, Ambient = true, OutdoorAmbient = true }
	local FB_ATMOS = { Density = true, Haze = true }

	-- ---------- the recording (taken now, when the script loads) ----------
	local base = { props = {}, effects = {} } -- effects: instance -> { props = {...}, clone = copy }
	local function snapshot()
		base.props = {}
		for _, p in ipairs(LIGHTING_PROPS) do
			local ok, v = pcall(function() return Lighting[p] end)
			if ok then base.props[p] = v end
		end
		base.effects = {}
		for _, c in ipairs(Lighting:GetChildren()) do
			local list = EFFECT_PROPS[c.ClassName]
			if list and not IGNORE[c.Name] then
				local info = { props = {} }
				for _, p in ipairs(list) do
					local ok, v = pcall(function() return c[p] end)
					if ok then info.props[p] = v end
				end
				local okC, copy = pcall(function() return c:Clone() end)
				info.clone = okC and copy or nil
				base.effects[c] = info
			end
		end
	end
	snapshot()

	-- ---------- the lock ----------
	local on = false
	local conns = {}
	local locked = {}   -- recorded effect currently in Lighting -> its info
	local parked = {}   -- effect we switched off / took out of Lighting -> "enabled" | "parent"
	local ours = {}     -- copies we put back ourselves

	local function connect(sig, fn) conns[#conns + 1] = sig:Connect(fn) end

	local function skipped(inst, prop)
		if env.__FULLBRIGHT ~= true then return false end
		if inst == Lighting then return FB_LIGHTING[prop] == true end
		return FB_ATMOS[prop] == true and inst:IsA("Atmosphere")
	end

	local function restore(inst, prop, want)
		pcall(function() if inst[prop] ~= want then inst[prop] = want end end)
	end

	-- put the values back now and whenever they change
	local function lockInst(inst, values)
		for prop, want in pairs(values) do
			local okS, sig = pcall(inst.GetPropertyChangedSignal, inst, prop)
			if okS then
				connect(sig, function()
					if on and not skipped(inst, prop) then restore(inst, prop, want) end
				end)
			end
			if not skipped(inst, prop) then restore(inst, prop, want) end
		end
	end

	local function adopt(inst, info)
		locked[inst] = info
		lockInst(inst, info.props)
	end

	local function handleNew(child)
		if ours[child] or locked[child] or parked[child] or IGNORE[child.Name] then return end
		if child:IsA("PostEffect") then
			-- switched off and kept off (not deleted: the game's own code may still point at it)
			if child.Enabled then parked[child] = "enabled" end
			pcall(function() child.Enabled = false end)
			connect(child:GetPropertyChangedSignal("Enabled"), function()
				if on and child.Enabled then pcall(function() child.Enabled = false end) end
			end)
		elseif child:IsA("Atmosphere") or child:IsA("Sky") then
			parked[child] = "parent"
			pcall(function() child.Parent = nil end)
		end
	end

	local function putBack(info)
		if not (on and info.clone) then return end
		local copy = info.clone:Clone()
		ours[copy] = true
		copy.Parent = Lighting
		base.effects[copy] = info
		adopt(copy, info)
	end

	local function turnOff()
		on = false
		for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
		table.clear(conns)
		table.clear(locked)
		for inst, mode in pairs(parked) do
			if mode == "enabled" then
				pcall(function() inst.Enabled = true end)
			else
				pcall(function() inst.Parent = Lighting end)
			end
		end
		table.clear(parked)
		table.clear(ours)
	end

	local function turnOn()
		if on then return end
		on = true
		lockInst(Lighting, base.props)

		local missing = {}
		for inst, info in pairs(base.effects) do
			if inst.Parent == Lighting then adopt(inst, info) else missing[#missing + 1] = info end
		end
		for _, info in ipairs(missing) do putBack(info) end

		if BLOCK_NEW_EFFECTS then
			for _, c in ipairs(Lighting:GetChildren()) do handleNew(c) end
		end
		connect(Lighting.ChildAdded, function(child)
			if on and BLOCK_NEW_EFFECTS then handleNew(child) end
		end)
		connect(Lighting.ChildRemoved, function(child)
			local info = locked[child]
			if not (on and info) then return end
			locked[child] = nil
			task.defer(function() putBack(info) end)
		end)
	end
	onCleanup(function() turnOff() env.LightingLockResnap = nil end)

	env.LightingLockResnap = function()
		local was = on
		if was then turnOff() end
		snapshot()
		if was then turnOn() end
		print("[LightingLock] new baseline recorded")
	end

	local setVisual
	setVisual = makeToggleCard("LightLockGui", "LightLockToggle", "LIGHT LOCK", 11, Color3.fromRGB(120, 220, 255), 1768, function()
		if on then turnOff() else turnOn() end
		return on
	end)
	FeatureHooks.lightlock = function() turnOff() setVisual(false) end
end)

---------------------------------------------------------------- 33) force equip (merged from attachment: keeps the chosen tool equipped; PICK ITEM opens a list so you choose which)
runSection("33", function()
	local ACCENT = Color3.fromRGB(60, 200, 130)
	local PANEL_BG, ROW_BG, BTN_BG = Color3.fromRGB(20, 20, 27), Color3.fromRGB(46, 46, 60), Color3.fromRGB(46, 46, 60)
	local SEL_BG = Color3.fromRGB(60, 150, 90)
	local TXT = Color3.fromRGB(240, 240, 248)
	local GuiService = game:GetService("GuiService")
	local RunService = game:GetService("RunService")

	local selectedName = nil
	local enabled = false
	local setVisual = function() end
	local refreshList = function() end
	local updateButtonText = function() end

	-- ---------- tool helpers ----------
	local function collectTools()
		local found, seen = {}, {}
		local function scan(parent)
			if not parent then return end
			for _, child in ipairs(parent:GetChildren()) do
				if child:IsA("Tool") and not seen[child.Name] then
					seen[child.Name] = true
					table.insert(found, child)
				end
			end
		end
		scan(LocalPlayer:FindFirstChildOfClass("Backpack"))
		scan(LocalPlayer.Character)
		table.sort(found, function(a, b) return a.Name < b.Name end)
		return found
	end

	local selectedTool = nil -- the exact Tool that was picked (a respawn gives new Tool objects: then it is found again by name)
	local function resolveTool()
		if not selectedName then return nil end
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		local char = LocalPlayer.Character
		local cur = selectedTool
		if cur and cur.Parent and (cur.Parent == char or cur.Parent == backpack) then return cur end
		for _, parent in ipairs({ char, backpack }) do
			if parent then
				for _, c in ipairs(parent:GetChildren()) do
					if c:IsA("Tool") and c.Name == selectedName then
						selectedTool = c
						return c
					end
				end
			end
		end
		selectedTool = nil
		return nil
	end

	-- ---------- force-equip logic (cannot be unequipped while FORCE EQUIP is on) ----------
	-- Re-equips happen the moment anything takes the tool off you: the tool's own Unequipped / Parent changes, the backpack getting it back, the
	-- character losing it, a respawn - plus a check every RenderStepped (before the frame is drawn) and every Heartbeat as a safety net.
	-- Safety rules (from the Roblox developer forum): never reparent a tool INSIDE its own Unequipped / Parent event (Roblox errors with
	-- "tried to set the parent ... while trying to set the parent"), so events only queue a re-equip one step later; and re-equipping blindly on every
	-- unequip can start equip / unequip loops, so attempts are throttled and a fight with the game backs off.
	local LOCK_HOTBAR = false -- true = also hide Roblox's default hotbar while ON, so you cannot click / key the tool off at all (restored when OFF). Hides every tool slot, so it is off by default
	local MIN_GAP = 0.03      -- seconds between two equip attempts
	local FIGHT_LIMIT = 15    -- more than this many re-equips inside one second = something keeps unequipping it: back off for FIGHT_PAUSE
	local FIGHT_PAUSE = 0.3

	local conns = {}        -- event connections that live only while FORCE EQUIP is on
	local watched = nil     -- the Tool currently being watched for Unequipped / Parent changes
	local toolConns = {}
	local deferQueued = false
	local nextTry, winStart, winCount = 0, 0, 0
	local missing = false
	local hotbarWas = nil

	local function setMissing(v)
		if missing == v then return end
		missing = v
		updateButtonText()
	end

	local function equipNow()
		if not enabled then return end
		local now = os.clock()
		if now < nextTry then return end
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then return end
		local tool = resolveTool()
		if not tool then
			setMissing(true) -- chosen item is not in your backpack / hands right now: waits until it shows up again
			return
		end
		setMissing(false)
		if tool.Parent == char then return end

		if now - winStart > 1 then winStart, winCount = now, 0 end
		winCount += 1
		nextTry = now + ((winCount > FIGHT_LIMIT) and FIGHT_PAUSE or MIN_GAP)

		pcall(function() hum:EquipTool(tool) end)                                 -- 1) the normal way
		if tool.Parent ~= char then pcall(function() tool.Parent = char end) end  -- 2) the game blocked that: force parent it onto the character
	end

	-- a re-equip from inside an event runs one step later (never reparent while the engine is still moving the tool)
	local function equipSoon()
		if deferQueued or not enabled then return end
		deferQueued = true
		task.defer(function()
			deferQueued = false
			equipNow()
		end)
	end

	local function unwatchTool()
		for _, c in ipairs(toolConns) do c:Disconnect() end
		table.clear(toolConns)
		watched = nil
	end

	local function watchTool(tool)
		if watched == tool then return end
		unwatchTool()
		if not (tool and tool:IsA("Tool")) then return end
		watched = tool
		table.insert(toolConns, tool.Unequipped:Connect(equipSoon))
		table.insert(toolConns, tool:GetPropertyChangedSignal("Parent"):Connect(equipSoon))
	end

	local function step()
		if not enabled then return end
		local tool = resolveTool()
		if tool ~= watched then watchTool(tool) end
		equipNow()
	end

	local function isChosen(c)
		return c == selectedTool or c.Name == selectedName
	end

	local function onCharacter(char)
		if not char then return end
		table.insert(conns, char.ChildRemoved:Connect(function(c)
			if isChosen(c) then equipSoon() end
		end))
		table.insert(conns, char.ChildAdded:Connect(function(c)
			if c:IsA("Tool") and isChosen(c) then selectedTool = c watchTool(c) equipSoon() end
		end))
	end

	local function onBackpack(bp)
		if not bp then return end
		table.insert(conns, bp.ChildAdded:Connect(function(c)
			if c:IsA("Tool") and isChosen(c) then selectedTool = c watchTool(c) equipSoon() end
		end))
	end

	local function connectAll()
		table.insert(conns, RunService.RenderStepped:Connect(step))
		table.insert(conns, RunService.Heartbeat:Connect(step))
		onCharacter(LocalPlayer.Character)
		onBackpack(LocalPlayer:FindFirstChildOfClass("Backpack"))
		table.insert(conns, LocalPlayer.CharacterAdded:Connect(function(char) -- respawn: new character and a new backpack, the tools are new objects
			unwatchTool()
			selectedTool = nil
			onCharacter(char)
			task.spawn(function()
				local bp = LocalPlayer:WaitForChild("Backpack", 10)
				if enabled and bp then onBackpack(bp) end
			end)
			equipSoon()
		end))
	end

	local function disconnectAll()
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		unwatchTool()
		missing = false
	end

	local function setEnabled(state)
		if enabled == state then return end
		enabled = state
		if enabled then
			if LOCK_HOTBAR then
				pcall(function()
					hotbarWas = game:GetService("StarterGui"):GetCoreGuiEnabled(Enum.CoreGuiType.Backpack)
					game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
				end)
			end
			nextTry, winStart, winCount = 0, 0, 0
			connectAll()
			equipNow()
		else
			disconnectAll()
			if hotbarWas ~= nil then
				pcall(function() game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, hotbarWas) end)
				hotbarWas = nil
			end
		end
		updateButtonText()
	end
	onCleanup(function() setEnabled(false) end)

	-- ---------- PICK ITEM button + list panel ----------
	local setGui = Instance.new("ScreenGui")
	setGui.Name = "ForceEquipSetGui"
	setGui.ResetOnSpawn = false
	setGui.DisplayOrder = 300
	setGui.Parent = PlayerGui

	local setButton = Instance.new("TextButton")
	setButton.Name = "ForceEquipSetButton"
	setButton.Size = UDim2.fromOffset(156, 34)
	setButton.Position = UDim2.new(0.02, 0, 0.45, 1936)
	setButton.BackgroundColor3 = PANEL_BG
	setButton.TextColor3 = TXT
	setButton.Font = Enum.Font.GothamBold
	setButton.TextSize = 11
	setButton.TextTruncate = Enum.TextTruncate.AtEnd
	setButton.Text = "PICK ITEM"
	setButton.Parent = setGui
	Instance.new("UICorner", setButton).CornerRadius = UDim.new(0, 8)

	local panelGui = Instance.new("ScreenGui")
	panelGui.Name = "ForceEquipPanelGui"
	panelGui.ResetOnSpawn = false
	panelGui.IgnoreGuiInset = true
	panelGui.DisplayOrder = 400
	panelGui.Parent = PlayerGui

	local panel = Instance.new("Frame")
	panel.BackgroundColor3 = PANEL_BG
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.ZIndex = 60
	panel.Parent = panelGui
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)
	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = ACCENT
	panelStroke.Transparency = 0.4
	panelStroke.Thickness = 1.5
	panelStroke.Parent = panel

	local function place()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(800, 450)
		local w, h = math.min(250, vp.X - 16), math.min(300, vp.Y - 16)
		panel.Size = UDim2.fromOffset(w, h)
		local ap, asz = setButton.AbsolutePosition, setButton.AbsoluteSize
		local sg = setButton:FindFirstAncestorOfClass("ScreenGui")
		if sg and not sg.IgnoreGuiInset then ap += GuiService:GetGuiInset() end
		local x = ap.X + asz.X + 8
		if x + w > vp.X - 8 then x = ap.X - w - 8 end
		x = math.clamp(x, 8, math.max(vp.X - w - 8, 8))
		local y = math.clamp(ap.Y, 8, math.max(vp.Y - h - 8, 8))
		panel.Position = UDim2.fromOffset(x, y)
	end

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, -44, 0, 24)
	title.Position = UDim2.fromOffset(10, 6)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 13
	title.TextColor3 = ACCENT
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "FORCE EQUIP: CHOOSE ITEM"
	title.ZIndex = 62
	title.Parent = panel

	local closeButton = Instance.new("TextButton")
	closeButton.Size = UDim2.fromOffset(28, 28)
	closeButton.Position = UDim2.new(1, -34, 0, 4)
