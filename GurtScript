---------------------------------------------------------------- 9) taunt spam toggle
runSection("9", function()
	-- GODMODE (taunt spam) v3: SERVER-HEALTH driven.
	-- * The frame-time back-off is gone (your frames were never the problem). The only signal is the server: Data Ping is sampled 10x per second and
	--   compared with a baseline taken before spamming. When the server starts to queue the remotes (ping climbs) the rate drops at once.
	-- * SLOW START up to the first sign of server strain, then the safe rate is REMEMBERED (also across switching GODMODE off / on). After a back-off the
	--   rate returns straight to 85% of the rate that strained the server and stays there, only creeping upwards slowly, so the server is not pushed over the edge again.
	-- * Ceiling is 3000 fires/s. Console: TauntRate() prints the status, TauntRate(500) locks a fixed rate (no adaptation), TauntRate("auto") goes back to automatic.
	-- * Holding a proximity prompt (F, doors) still caps the rate at RATE_PROMPT so the prompt stays responsive.
	local RATE_MIN = 40         -- fires per second, floor
	local RATE_START = 150      -- where the slow start begins
	local RATE_MAX = 3000       -- fires per second, ceiling
	local RATE_FALLBACK = 400   -- used when the client cannot read the server ping at all
	local RATE_PROMPT = 30      -- cap while you are holding a proximity prompt
	local SLOW_START = 1.6      -- growth per second while no strain has been seen yet (1.6 = +160% per second)
	local BACKOFF = 0.6         -- rate multiplier on a back-off
	local BACKOFF_GAP = 0.35    -- min seconds between two back-offs (the ping value needs a moment to reflect the new rate)
	local SAFETY = 0.85         -- after a back-off the rate returns to this share of the rate that strained the server
	local CUBIC_C = 1200        -- speed of the return to the safe rate
	local PROBE = 20            -- fires/s gained per second above the safe rate (slow on purpose)
	local PING_SAMPLE = 0.1     -- seconds between ping reads
	local PING_RATIO, PING_ADD = 1.25, 12 -- strain = ping > baseline * ratio + add (ms)
	local MAX_PER_FRAME = 120   -- hard cap per frame
	local FRAME_BUDGET = 0.004  -- seconds of CPU per frame the fire loop may use (only stops the frame, it is NOT a back-off signal)
	local MAX_DT = 0.25         -- a hitch this long: skip the frame

	local ProximityPromptService = game:GetService("ProximityPromptService")
	local Stats = game:GetService("Stats")
	local clock, floor, min, max = os.clock, math.floor, math.min, math.max

	local remote, fire, conn = nil, nil, nil
	local lastSearch, warned = 0, false

	local function resolve()
		remote = ReplicatedStorage:FindFirstChild("TauntEvent")
		if not remote then
			-- the game's own taunt code keeps TauntEvent inside the Tool; throttled because this runs every frame while nothing is found
			local now = clock()
			if now - lastSearch < 0.5 then fire = nil return false end
			lastSearch = now
			local char = LocalPlayer.Character
			local pack = LocalPlayer:FindFirstChildOfClass("Backpack")
			remote = (char and char:FindFirstChild("TauntEvent", true)) or (pack and pack:FindFirstChild("TauntEvent", true))
			if remote and not remote:IsA("RemoteEvent") then remote = nil end
			if not remote and not warned then
				warned = true
				warn("[GODMODE] TauntEvent not found in ReplicatedStorage, your character or your Backpack (equip the tool and try again)")
			end
		end
		if remote then warned = false end
		fire = remote and remote.FireServer or nil
		return fire ~= nil
	end

	-- server ping: the signal that tells us the server is queueing our remotes
	local pingItem = nil
	do
		local okP, item = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"] end)
		if okP then pingItem = item end
	end
	local function readPing()
		if not pingItem then return nil end
		local okV, ping = pcall(pingItem.GetValue, pingItem)
		if okV and type(ping) == "number" and ping > 0 then return ping end
		return nil
	end

	local rate = RATE_START
	local credit = 0
	local lastBackoff = 0
	local nextPing, basePing = 0, nil
	local holds = 0                         -- proximity prompts currently being held
	local slowStart = true                  -- no server strain seen yet
	local safeRate = nil                    -- remembered safe rate (survives switching off / on)
	local epochStart, epochK, wMax = 0, 0, RATE_MAX
	local manualRate = nil                  -- TauntRate(n) lock

	-- CUBIC epoch: the rate follows C*(t-K)^3 + wMax up to wMax, which equals the current rate at t = 0
	local function beginEpoch(now, w)
		wMax = w
		epochStart = now
		epochK = (max(0, w - rate) / CUBIC_C) ^ (1 / 3)
	end

	local function backoff(now)
		if now - lastBackoff < BACKOFF_GAP then return end
		lastBackoff = now
		slowStart = false
		local w = max(RATE_MIN, rate * SAFETY)
		safeRate = w
		rate = max(RATE_MIN, min(rate * BACKOFF, w * 0.8))
		credit = 0
		beginEpoch(now, w)
	end

	-- defined once: enabling / disabling never allocates a closure per frame
	local function step(dt)
		if dt > MAX_DT then credit = 0 epochStart += dt return end
		if not (remote and remote.Parent) and not resolve() then return end
		local now = clock()

		local limit
		if manualRate then
			limit = manualRate
		else
			-- 1) server signal
			if pingItem then
				if now >= nextPing then
					nextPing = now + PING_SAMPLE
					local ping = readPing()
					if ping then
						if not basePing or ping < basePing then
							basePing = ping
						elseif rate <= RATE_MIN * 1.05 then
							basePing += (ping - basePing) * 0.05 -- already at the floor: a high ping is not our doing, follow it
						else
							basePing += (ping - basePing) * 0.0005 -- slow drift so a permanently worse connection is accepted eventually
						end
						if ping > basePing * PING_RATIO + PING_ADD then backoff(now) end
					end
				end

				-- 2) growth (never lowers the rate; only back-offs do)
				if slowStart then
					rate = min(RATE_MAX, rate * (1 + SLOW_START * dt))
				else
					local t = now - epochStart - epochK
					local target
					if t < 0 then target = CUBIC_C * t * t * t + wMax else target = wMax + PROBE * t end
					if target > RATE_MAX then target = RATE_MAX end
					if target > rate then rate = target end
				end
				limit = rate
			else
				limit = RATE_FALLBACK
			end
		end
		if holds > 0 then limit = min(limit, RATE_PROMPT) end

		credit = min(credit + dt * limit, MAX_PER_FRAME)
		local n = floor(credit)
		if n < 1 then return end
		credit -= n

		-- 3) fire with a CPU budget (the clock is only read every 16 fires)
		local t0 = clock()
		local f, r = fire, remote
		for i = 1, n do
			f(r)
			if i % 16 == 0 and clock() - t0 > FRAME_BUDGET then
				credit = 0
				break
			end
		end
	end

	local function setActive(on)
		if on then
			if conn then return end
			resolve()
			local now = clock()
			credit, lastBackoff = 0, 0
			basePing, nextPing = readPing(), now + PING_SAMPLE
			if safeRate then
				-- the safe rate is already known: go straight back to it
				slowStart = false
				rate = max(RATE_MIN, safeRate * 0.5)
				beginEpoch(now, safeRate)
			else
				slowStart = true
				rate = RATE_START
			end
			conn = RunService.Heartbeat:Connect(step)
		elseif conn then
			conn:Disconnect()
			conn = nil
		end
	end
	onCleanup(function() setActive(false) end)

	env.TauntRate = function(v)
		if v == nil then
			print(string.format("[GODMODE] %s | rate now %d/s | safe rate %s | base ping %s ms | %s",
				conn and "ON" or "OFF", floor(manualRate or rate), safeRate and (floor(safeRate) .. "/s") or "not learned yet",
				basePing and floor(basePing) or "?", manualRate and "LOCKED" or "auto"))
		elseif v == "auto" or v == 0 then
			manualRate = nil
			print("[GODMODE] automatic rate")
		elseif type(v) == "number" and v > 0 then
			manualRate = min(v, RATE_MAX)
			print("[GODMODE] locked at " .. floor(manualRate) .. "/s")
		end
	end

	-- keep proximity prompts (F, doors) responsive: slow down while one is being held
	bind(ProximityPromptService.PromptButtonHoldBegan:Connect(function() holds += 1 end))
	bind(ProximityPromptService.PromptButtonHoldEnded:Connect(function() holds = max(0, holds - 1) end))
	bind(ProximityPromptService.PromptHidden:Connect(function() holds = 0 end))

	-- the event is character independent; just drop the cached remote so a replaced TauntEvent is re-resolved lazily
	bind(LocalPlayer.CharacterAdded:Connect(function() remote, fire = nil, nil end))

	local active = false
	local setVisual
	setVisual = makeToggleCard("TauntSpamGui", "TauntSpamToggle", "GODMODE", 13, Color3.fromRGB(255, 210, 60), 480, function()
		active = not active
		setActive(active)
		return active
	end)

	FeatureHooks.taunt = function()
		active = false
		setActive(false)
		setVisual(false)
	end

	-- T keybind backup so taunt spam can always be switched off
	bind(UIS.InputBegan:Connect(function(input, gp)
		if gp or input.KeyCode ~= Enum.KeyCode.T then return end
		active = not active
		setActive(active)
		setVisual(active)
	end))
end)

---------------------------------------------------------------- 10) corpse prompt (players / NPCs)
runSection("10", function()
	local OFFSET = Vector3.new(0, -4, 0)  -- how far below the torso to stand
	local SCAN_DELAY = 0.1                  -- seconds between scans (was 0.3)
	local PROMPT_COOLDOWN = 4             -- base seconds before retrying a prompt that failed (doubles on repeat failures)
	local ARRIVE_WAIT = 0.2               -- wait after teleporting, before first fire (was 0.4; you are moved the very same frame now)
	local MIN_RETRY = 0.3                 -- least seconds between fire attempts on the same prompt (ping makes it longer when the connection is slow)
	local FIRE_TIMEOUT = 10               -- give up on one prompt after this many seconds
	local PICKUP_GAP = 0                  -- no pause after a pickup: grab the next tag instantly
	local SETTLE_TIME = 1.2               -- after the FIRST pickup, stay put this long and watch for the "second" dog tag
	local SETTLE_AFTER_SECOND = 0.5       -- once two things were picked up (tag + second tag) there is nothing left to wait for: leave sooner
	local HOME_DELAY = 0.35               -- with no body left, wait this long for another one before going back to where you stood
	local PICKUP_RADIUS = 14              -- brand-new prompts that appear this close to the body count as part of the loot
	local ONLY_DETECTED_PLAYER = true     -- LOOT PLAYERS fires ONLY the prompt it detected on the body: no nearby/new prompts, no settle wait. (A re-dropped tag on a new corpse is picked up as its own target.) Set false for the old behaviour.
	local MAX_PICKUPS = 4                 -- safety cap per visit
	local VISIT_TIMEOUT = 25              -- hard cap per body
	local NPC_NAME = "slasher"            -- NPC models whose name contains this (case-insensitive)
	local TORSO_NAMES = { "Torso", "UpperTorso", "HumanoidRootPart" }

	local playersOn, npcsOn = false, false
	local alive = true
	local debugOn = false
	local lastFired = setmetatable({}, { __mode = "k" })
	local fails = setmetatable({}, { __mode = "k" })

	onCleanup(function() alive = false; playersOn = false; npcsOn = false end)

	local function dprint(...)
		if debugOn then print("[LOOT]", ...) end
	end
	env.LootDebug = function(v)
		debugOn = v ~= false
		print("[LOOT] debug " .. (debugOn and "ON" or "OFF"))
	end

	-- every username seen this session (kept after they leave, so their corpse is still recognised as a player)
	local knownNames = {}
	local function remember(plr) knownNames[string.lower(plr.Name)] = true end
	for _, plr in ipairs(Players:GetPlayers()) do remember(plr) end
	bind(Players.PlayerAdded:Connect(remember))

	local function getRoot()
		local char = LocalPlayer.Character
		return char and char:FindFirstChild("HumanoidRootPart")
	end

	-- "player" / "npc" / nil. Player wins every tie, so a player body is never treated as an NPC.
	local function classify(model, inCorpses)
		if inCorpses then return "player" end -- PlayerCorpses only ever holds player corpses, whatever the model is named
		if Players:GetPlayerFromCharacter(model) or knownNames[string.lower(model.Name)] then
			return "player"
		end
		if string.find(string.lower(model.Name), NPC_NAME, 1, true) then
			return "npc"
		end
		return nil
	end

	-- the prompt can sit on any of the torso-ish parts, so check all of them (not just the first one found)
	local function findPrimary(model)
		for _, name in ipairs(TORSO_NAMES) do
			local part = model:FindFirstChild(name)
			if part and part:IsA("BasePart") then
				local prompt = part:FindFirstChildOfClass("ProximityPrompt")
				if prompt and prompt.Enabled then return prompt, part end
			end
		end
	end

	local function isDead(model, fromCharacters)
		if model == LocalPlayer.Character then return false end
		if not fromCharacters then return true end -- anything in PlayerCorpses counts
		local hum = model:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and hum.Health <= 0
	end

	local function collectTargets(fromPos)
		local targets = {}
		local function scan(folder, fromCharacters)
			if not folder then return end
			for _, model in ipairs(folder:GetChildren()) do
				if model:IsA("Model") and isDead(model, fromCharacters) then
					local kind = classify(model, not fromCharacters)
					if (kind == "player" and playersOn) or (kind == "npc" and npcsOn) then
						local prompt, torso = findPrimary(model)
						if prompt then
							table.insert(targets, {
								model = model, torso = torso, prompt = prompt, kind = kind,
								dist = (torso.Position - fromPos).Magnitude,
							})
						end
					end
				end
			end
		end
		scan(Workspace:FindFirstChild("Characters"), true)
		scan(Workspace:FindFirstChild("PlayerCorpses"), false)
		-- players first, then nearest first
		table.sort(targets, function(a, b)
			if a.kind ~= b.kind then return a.kind == "player" end
			return a.dist < b.dist
		end)
		return targets
	end

	local function promptGone(prompt)
		return prompt.Parent == nil or not prompt:IsDescendantOf(Workspace) or not prompt.Enabled
	end

	local function promptPosition(prompt)
		local p = prompt.Parent
		if not p then return nil end
		if p:IsA("BasePart") then return p.Position end
		if p:IsA("Attachment") then return p.WorldPosition end
		if p:IsA("Model") then return p:GetPivot().Position end
		return nil
	end

	local function firePrompt(prompt)
		pcall(function()
			if prompt.HoldDuration ~= 0 then prompt.HoldDuration = 0 end -- no waiting out the hold bar
			if prompt.RequiresLineOfSight then prompt.RequiresLineOfSight = false end
		end)
		if fireproximityprompt then
			fireproximityprompt(prompt)
		else
			prompt:InputHoldBegin()
			task.wait(prompt.HoldDuration + 0.05)
			prompt:InputHoldEnd()
		end
	end

	-- how long to wait for the server to consume a fire before we are allowed to fire again
	local function retryDelay()
		local ping = 0
		local ok, v = pcall(function() return LocalPlayer:GetNetworkPing() end)
		if ok and type(v) == "number" then ping = v end
		return math.max(MIN_RETRY, ping * 2 + 0.1)
	end

	-- Fire ONCE, then wait patiently for the prompt to disappear. Only re-fires if the server clearly ignored it.
	-- (Firing again while the first pickup is still being processed is what made the server flag an error.)
	local function triggerPrompt(prompt, stillWanted)
		local t0 = os.clock()
		while stillWanted() and getRoot() and os.clock() - t0 < FIRE_TIMEOUT do
			if promptGone(prompt) then return true end
			firePrompt(prompt)
			local w0, wait = os.clock(), retryDelay()
			while os.clock() - w0 < wait do
				if promptGone(prompt) then return true end
				task.wait()
			end
		end
		return promptGone(prompt)
	end

	-- Teleport under the body, freeze there, pick up everything that shows up (including the re-dropped dog tag), go back.
	-- Returns how many pickups succeeded.
	local function lootTarget(target)
		local root = getRoot()
		if not root then return 0 end
		local model, torso, primary = target.model, target.torso, target.prompt
		local anchor = torso.CFrame      -- last known body position (kept even if the body is removed after the pickup)
		local pickups = 0
		local abandoned = {}
		local strict = ONLY_DETECTED_PLAYER and target.kind == "player" -- only ever fire the detected prompt

		local function stillWanted()
			if not alive then return false end
			if target.kind == "player" then return playersOn end
			return npcsOn
		end

		-- prompts that already existed on the body (e.g. revive) are NOT ours; only the main one and brand-new ones are
		local known = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("ProximityPrompt") then known[d] = true end
		end
		known[primary] = nil

		local fresh = {}
		local addConn = nil
		if not strict then
			addConn = Workspace.DescendantAdded:Connect(function(inst)
				if inst:IsA("ProximityPrompt") and not known[inst] then
					fresh[#fresh + 1] = inst
				end
			end)
		end

		local function snapToBody()
			local r = getRoot()
			if not r then return end
			if torso.Parent then anchor = torso.CFrame end
			r.CFrame = anchor + OFFSET
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
		snapToBody() -- already there this very frame, no waiting for the first Heartbeat
		local lock = RunService.Heartbeat:Connect(snapToBody)

		local function belongsToOtherBody(prompt)
			local m = prompt:FindFirstAncestorOfClass("Model")
			if m == nil or m == model then return false end
			-- the player's fresh corpse (it replaces the body in Characters and brings the new dog tag) is NOT "another body"
			if target.kind == "player" and m.Parent == Workspace:FindFirstChild("PlayerCorpses") then return false end
			return m:FindFirstChildOfClass("Humanoid") ~= nil
		end

		local function eligible(prompt)
			if abandoned[prompt] or promptGone(prompt) then return false end
			if prompt:IsDescendantOf(model) then return true end
			if belongsToOtherBody(prompt) then return false end -- never wander onto some other corpse (NPC or player)
			local pos = promptPosition(prompt)
			return pos ~= nil and (pos - anchor.Position).Magnitude <= PICKUP_RADIUS
		end

		local function pickPrompt()
			if eligible(primary) then return primary end
			if strict then return nil end -- detected prompt only: ignore every other prompt near the body
			for i = 1, #fresh do
				if eligible(fresh[i]) then return fresh[i] end
			end
			-- backup: poll the body itself in case the event missed it
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("ProximityPrompt") and not known[d] and d ~= primary and eligible(d) then
					return d
				end
			end
		end

		local ok, err = pcall(function()
			task.wait(ARRIVE_WAIT)
			local started = os.clock()
			local lastPickup = os.clock()
			while stillWanted() and getRoot() and pickups < MAX_PICKUPS and os.clock() - started < VISIT_TIMEOUT do
				local prompt = pickPrompt()
				if prompt then
					if triggerPrompt(prompt, stillWanted) then
						pickups += 1
						dprint("picked up", prompt.Name, "from", model.Name, "#" .. pickups)
						if PICKUP_GAP > 0 then task.wait(PICKUP_GAP) end
						lastPickup = os.clock()
					else
						abandoned[prompt] = true
						dprint("gave up on", prompt.Name, "from", model.Name)
					end
				elseif strict or pickups == 0 or os.clock() - lastPickup >= ((pickups >= 2) and SETTLE_AFTER_SECOND or SETTLE_TIME) then
					break -- nothing new showed up: done
				else
					task.wait() -- still inside the settle window, watching for the second tag (checks every frame)
				end
			end
		end)

		lock:Disconnect()
		if addConn then addConn:Disconnect() end
		if not ok then warn("[LOOT] error: " .. tostring(err)) end
		return pickups -- (going back is done by the main loop once NO body is left, so bodies are chained without bouncing home in between)
	end

	-- where you stood before the first body of this run; you only go back there once every body is looted
	local origin, idleSince = nil, nil
	local function goHome()
		local r = getRoot()
		if origin and r then
			r.CFrame = origin
			r.AssemblyLinearVelocity = Vector3.zero
			r.AssemblyAngularVelocity = Vector3.zero
		end
		origin, idleSince = nil, nil
	end

	local function nextTarget(fromPos)
		for _, target in ipairs(collectTargets(fromPos)) do -- players first, then the nearest one to where you are NOW
			local last = lastFired[target.prompt]
			local cooldown = PROMPT_COOLDOWN * 2 ^ math.min(fails[target.prompt] or 0, 4)
			if not promptGone(target.prompt) and (not last or os.clock() - last >= cooldown) then
				return target
			end
		end
		return nil
	end

	task.spawn(function()
		while alive do
			task.wait(SCAN_DELAY)
			local root = getRoot()
			if not root then
				origin, idleSince = nil, nil -- died / respawning: forget the old spot
				continue
			end
			if not (playersOn or npcsOn) then
				if origin then goHome() end
				continue
			end
			local target = nextTarget(root.Position)
			if target then
				idleSince = nil
				origin = origin or root.CFrame
				dprint("looting", target.kind, target.model.Name)
				local got = lootTarget(target)
				lastFired[target.prompt] = os.clock()
				fails[target.prompt] = (got == 0) and ((fails[target.prompt] or 0) + 1) or nil
			elseif origin then
				idleSince = idleSince or os.clock()
				if os.clock() - idleSince >= HOME_DELAY then goHome() end
			end
		end
	end)

	local setVisPlayers, setVisNpcs
