	-- PlayerGui.Voiceline can be rebuilt by the game (respawn), so everything is looked up fresh and by NAME
	local function getVoice()
		local g = PlayerGui:FindFirstChild("Voiceline")
		return g, g and g:FindFirstChild("VoiceEvent"), g and g:FindFirstChild("VoiceLines")
	end

	local path = {} -- names from VoiceLines down to the folder being shown

	local function nodeAt(names)
		local _, _, root = getVoice()
		local n = root
		for _, nm in ipairs(names) do
			if not n then return nil end
			n = n:FindFirstChild(nm)
		end
