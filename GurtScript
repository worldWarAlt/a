runSection("6", function()
	local TRIGGER_IDS = {
		"103116263598605", "124609826792133", "123537622120693", "107330587130064",
		"137506764113023",
	}
	Kit.execTriggers = TRIGGER_IDS -- VIRAL packs (section 27) start their executions on the same game animations

	local ATTACKER_ANIM   = "rbxassetid://134236285508230"
	local VICTIM_ANIM     = "rbxassetid://95514686805008"
	local EXEC_CHANCE     = 0.5
	local execMode = 3 -- 1 = SIN only, 2 = VISA3 only, 3 = both

	local EXEC_SOUND   = "rbxassetid://132399674940969"

	-- SIN = ATTACKER_ANIM / VICTIM_ANIM (execution2 / Victim2)
	-- VISA3 = the new execution:
	local VISA3_ATTACKER_ANIM = "rbxassetid://99375529712653"
	local VISA3_VICTIM_ANIM   = "rbxassetid://84540363335923"
	local VISA3_SOUND         = "rbxassetid://129763735896948"
	local VICTIM_RANGE  = 15
	local EXEC_GAP      = 0.5  -- seconds the game's execution tracks must be gone before a NEW execution can trigger ours
	local EXEC_MAX_LOCK = 20   -- safety: never stay locked longer than this
	local DEBUG         = false

	local MOVE_COOLDOWN = 0.25
	-- 114916713932875 = the game switch-to-sledge animation -> SIN switch-to-sledge (98239206283649)
	-- (110884272924322 is the game sledgehammer IDLE: handled by the SIN move anims below, not a swing)
	local MOVE_IDS = { "138691140561523", "91463196236370", "83632013221100", "91849031357031",
		"114891880675311", "97660793956521", "114916713932875" }
	local REPLACEMENTS = { "rbxassetid://139352596916392" }
	local OVERRIDES = {
		["114891880675311"] = { "rbxassetid://81929375120036" },
		["97660793956521"] = { "rbxassetid://109639053938974" },
		["114916713932875"] = { "rbxassetid://98239206283649" },
	}
	local TRIM_END = {}

	local SWAP_MAP = {}
	for _, moveId in ipairs(MOVE_IDS) do
		SWAP_MAP[moveId] = {
			pool = OVERRIDES[moveId] or REPLACEMENTS,
			loop = false, start = 0.15, speed = 1.3, cooldown = MOVE_COOLDOWN, owner = "sin",
			hitLockout = 0.05, refractory = 0.02, -- short lockouts so SIN moves can replay right away
			trimEnd = TRIM_END,
		}
	end

	SWAP_MAP["114916713932875"].start = 0   -- equip animation: play it whole, at normal speed
	SWAP_MAP["114916713932875"].speed = 1

	local RUN_ANIM  = "rbxassetid://91791369037012"
	local RUN_START, RUN_STOP, RUN_GRACE = 19, 12, 0.3

	local sinOn = false
	Shared.sin = false
	local execOn = false -- EXEC ANIM toggle (the execution animations), separate from SIN
	Shared.exec = false
	local conns = {}
	local locoMuted = {}
	local handled = setmetatable({}, { __mode = "k" })
	local seenIds = {}
	local execTrack = nil
	local execLocked = false      -- we already handled the execution that is currently going on
	local execLockedAt = 0
	local triggerIdleSince = nil  -- when the game's execution tracks last went quiet
	env["__SIN_EXECUTION_GUARD_UNTIL"] = nil -- clear the old global lockout left behind by earlier runs
	local ContentProvider = game:GetService("ContentProvider")
	local hookToken = 0
	local rng = Random.new()
	local runTrack, lastRunGood = nil, 0

	local function playSound(parent, soundId)
		-- tagged as ours (the exec-sound muter leaves it alone) and de-duplicated, see Kit.execSfx
		Kit.execSfx(soundId or EXEC_SOUND, 1, parent)
	end

	local function playOnAttacker(char, animator, original)
		-- the game's own execution is always silenced so only ours shows
		Kit.silence(original, "exec")
		if locoMuted[original] == nil then locoMuted[original] = false end

		local now = os.clock()
		if execLocked and now - execLockedAt > EXEC_MAX_LOCK then execLocked = false end
		if execLocked then return end                          -- same execution, already handled
		if execTrack and execTrack.IsPlaying then return end

		local which = execMode
		if which == 3 then which = rng:NextInteger(1, 2) end -- both, equal chance

		local attackerId, victimId, soundId
		if which == 1 then -- SIN
			attackerId, victimId, soundId = ATTACKER_ANIM, VICTIM_ANIM, EXEC_SOUND
		else -- VISA3
			attackerId, victimId, soundId = VISA3_ATTACKER_ANIM, VISA3_VICTIM_ANIM, VISA3_SOUND
		end

		local track = Kit.get(animator, attackerId)
		if not track then return end -- a failed attempt no longer starts a lockout

		-- lock only now that we really are going to play
		execLocked = true
		execLockedAt = now
		triggerIdleSince = nil

		task.spawn(function()
			-- if the clip isn't loaded yet, wait for it so it doesn't start late (after the kill)
			local t0 = os.clock()
			while track.Length <= 0 and os.clock() - t0 < 0.75 do task.wait() end
			if not execOn then return end

			if track.IsPlaying then track:Stop(0) end
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = false
			execTrack = track
			Kit.claim(track, "exec")
			track:Play(0.05, 1, 1)
			Shared.execUntil = os.clock() + math.max(track.Length, 2) + 1
			track.Stopped:Once(function()
				if execTrack == track then execTrack = nil end
			end)
			playSound(char:FindFirstChild("HumanoidRootPart"), soundId)

			-- the victim may not be in range on the very first frame, so retry briefly
			local victim = Kit.nearestVictim(char, VICTIM_RANGE)
			if not victim then
				for _ = 1, 8 do
					task.wait(0.05)
					victim = Kit.nearestVictim(char, VICTIM_RANGE)
					if victim then break end
				end
			end
			if victim then Kit.playOnVictim(victim, victimId, { fadeIn = 0.05, owner = "exec" }) end
		end)
	end

	local lastPos = setmetatable({}, { __mode = "k" })
	local moveLock = {}
	local sledgeEquipSignal = -1e9 -- os.clock() of the last time the game's switch-to-sledge animation was swapped (read by the move-anim controller)

	-- Items that count as "the sledgehammer is out". The SIN switch animation, the sledgehammer idle / walk / run and the SIN grip only apply
	-- while one of these Tools is held. Names are matched ignoring case, spaces and symbols ("Halligan Bar" = HalliganBar). Edit the list freely.
	Kit.SLEDGE_ITEMS = { sledgehammer = true, halliganbar = true, greenaxe = true, axe = true }
	function Kit.sledgeItem(tool)
		local key = string.lower((string.gsub(tool.Name, "[^%w]", "")))
		if Kit.SLEDGE_ITEMS[key] then return true end
		return string.find(key, "sledgehammer", 1, true) ~= nil or string.find(key, "halligan", 1, true) ~= nil
			or string.find(key, "greenaxe", 1, true) ~= nil
	end
	-- the held Tool if it is one of Kit.SLEDGE_ITEMS, else nil (looks on your Character and on workspace.Characters.<you>)
	function Kit.sledgeHeld()
		local function scan(holder)
			if not holder then return nil end
			for _, c in ipairs(holder:GetChildren()) do
				if c:IsA("Tool") and Kit.sledgeItem(c) then return c end
			end
			return nil
		end
		local t = scan(LocalPlayer.Character)
		if t then return t end
		local f = Workspace:FindFirstChild("Characters")
		return scan(f and f:FindFirstChild(LocalPlayer.Name))
	end

	local function swapMove(animator, original, fromEvent)
		local id = Kit.idOf(original)
		local entry = id and SWAP_MAP[id]
		if not entry then return end
		if Kit.arIds[id] or Kit.viral.swingIds[id] then return end -- ANIM REPLACE / a VIRAL pack owns this game animation: SIN stays out of its way
		-- the game's switch-to-sledge animation is only swapped while you hold a Sledgehammer / HalliganBar / GreenAxe / Axe
		-- (returns before the track is marked as handled, so the next scan tries again once the Tool is in your hands)
		if id == "114916713932875" and not Kit.sledgeHeld() then return end

		local firstTime = not handled[original]
		if not firstTime then
			local last, now = lastPos[original], original.TimePosition
			lastPos[original] = now
			if not fromEvent then return end
		end

		handled[original] = true
		lastPos[original] = original.TimePosition
		if id == "114916713932875" then sledgeEquipSignal = os.clock() end

		local usable = {}
		for _, candidate in ipairs(entry.pool) do
			local t = Kit.get(animator, candidate)
			if t and t.Length > 0 then table.insert(usable, candidate) end
		end
		local choices = #usable > 0 and usable or entry.pool
		local repId = choices[#choices == 1 and 1 or rng:NextInteger(1, #choices)]
		local rep, why = Kit.swap(animator, original, repId, entry, moveLock)
		if rep then
			locoMuted[original] = rep
		elseif (why == "lock" or why == "stopped") and locoMuted[original] == nil then
			locoMuted[original] = false
		end
		if firstTime then
			original.Stopped:Once(function()
				handled[original] = nil
				locoMuted[original] = nil
				lastPos[original] = nil
			end)
		end
	end

	local cChar, cHum, cRoot
	local function updateRun(char, animator)
		if cChar ~= char or not (cHum and cHum.Parent) or not (cRoot and cRoot.Parent) then
			cChar = char
			cHum = char:FindFirstChildOfClass("Humanoid")
			cRoot = char:FindFirstChild("HumanoidRootPart")
		end
		local hum, root = cHum, cRoot
		if not (hum and root) then return end
		if not runTrack then
			runTrack = Kit.get(animator, RUN_ANIM)
			if not runTrack then return end
			runTrack.Priority = Enum.AnimationPriority.Action3 -- above everything but our own Action4 swings / executions
			runTrack.Looped = true
		end
		local v = root.AssemblyLinearVelocity
		local speed = Vector3.new(v.X, 0, v.Z).Magnitude
		local playing = runTrack.IsPlaying
		local wanted = hum.Health > 0 and hum.MoveDirection.Magnitude > 0.05
		local good = wanted
			and speed >= (playing and RUN_STOP or RUN_START)
			and hum.FloorMaterial ~= Enum.Material.Air
		if good then
			lastRunGood = os.clock()
			if not playing then runTrack:Play(0.05) end
		elseif playing and (not wanted or os.clock() - lastRunGood > RUN_GRACE) then
			runTrack:Stop(0.15)
		end
	end

	local function stopAllLoco()
		if runTrack and runTrack.IsPlaying then runTrack:Stop(0.15) end
		for orig, rep in pairs(locoMuted) do
			if rep and rep.IsPlaying then rep:Stop(0.15) end
			if orig.IsPlaying then orig:AdjustWeight(1, 0.15) end
		end
		table.clear(locoMuted)
		table.clear(handled)
		moveLock.rep, moveLock.startedAt, moveLock.stopToken = nil, nil, nil
		Kit.restore("sin")
	end

	-- EXEC ANIM off: stop our execution animation and give the game's own back
	local function stopExec()
		local ex = execTrack
		execTrack = nil
		if ex and ex.IsPlaying then ex:Stop(0.1) end
		execLocked, triggerIdleSince = false, nil
		Kit.stopVictims("exec")
		Kit.restore("exec")
	end

	local function clearConns()
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
	end

	local function hookCharacter(char)
		hookToken += 1
		local myToken = hookToken
		clearConns()
		table.clear(locoMuted)
		table.clear(handled)
		moveLock.rep, moveLock.startedAt, moveLock.stopToken = nil, nil, nil
		execTrack, execLocked, triggerIdleSince = nil, false, nil
		runTrack = nil
		local hum = char:WaitForChild("Humanoid", 10)
		local animator = hum and hum:WaitForChild("Animator", 10)
		if not animator or myToken ~= hookToken then return end

		-- preload clips + sound so the first execution doesn't start late
		task.spawn(function()
			local assets = {}
			for _, id in ipairs({ ATTACKER_ANIM, VICTIM_ANIM, VISA3_ATTACKER_ANIM, VISA3_VICTIM_ANIM }) do
				local a = Instance.new("Animation")
				a.AnimationId = id
				table.insert(assets, a)
			end
			for _, sid in ipairs({ EXEC_SOUND, VISA3_SOUND }) do
				local snd = Instance.new("Sound")
				snd.SoundId = sid
				table.insert(assets, snd)
			end
			pcall(function() ContentProvider:PreloadAsync(assets) end)
			for _, a in ipairs(assets) do a:Destroy() end
		end)

		for _, id in ipairs({ ATTACKER_ANIM, VICTIM_ANIM, VISA3_ATTACKER_ANIM, VISA3_VICTIM_ANIM, RUN_ANIM }) do
			Kit.warm(animator, id)
		end
		for _, repId in ipairs(REPLACEMENTS) do
			Kit.warm(animator, repId)
		end
		for _, entry in pairs(SWAP_MAP) do
			for _, repId in ipairs(entry.pool) do Kit.warm(animator, repId) end
		end

		local function onTrack(track)
			if Kit.matches(track, TRIGGER_IDS) then
				if not execOn or Kit.viral.on then return end -- a VIRAL pack plays its own execution
				if not handled[track] then
					handled[track] = true
					track.Stopped:Once(function()
						handled[track] = nil
						locoMuted[track] = nil
					end)
					playOnAttacker(char, animator, track)
				end
			elseif sinOn then
				swapMove(animator, track, true)
			end
		end

		table.insert(conns, animator.AnimationPlayed:Connect(onTrack))

		local nextScan, anyTriggerCached = 0, false
		table.insert(conns, RunService.RenderStepped:Connect(function()
			if not (sinOn or execOn) then return end
			if sinOn then
				if Kit.viral.loco then -- a VIRAL pack has its own run
					if runTrack and runTrack.IsPlaying then runTrack:Stop(0.15) end
				else
					updateRun(char, animator)
				end
			end

			local nowScan = os.clock()
			if nowScan >= nextScan then
				nextScan = nowScan + 0.03
				local found = false
				for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
					if Kit.matches(t, TRIGGER_IDS) then
						found = true
						if execOn and not handled[t] then onTrack(t) end
					elseif sinOn then
						swapMove(animator, t, false)
					end
				end
				anyTriggerCached = found
			end
			local anyTrigger = anyTriggerCached

			-- re-arm for the next execution once the game's execution tracks have been gone for EXEC_GAP
			if anyTrigger or (execTrack and execTrack.IsPlaying) then
				triggerIdleSince = nil
			elseif execLocked then
				triggerIdleSince = triggerIdleSince or os.clock()
				if os.clock() - triggerIdleSince >= EXEC_GAP then
					execLocked = false
					triggerIdleSince = nil
				end
			end

			for orig in pairs(locoMuted) do
				if orig.IsPlaying and orig.WeightTarget > 0 then orig:AdjustWeight(0, 0) end
			end
		end))
	end

	bind(LocalPlayer.CharacterAdded:Connect(hookCharacter))
	onCleanup(function()
		sinOn, execOn = false, false
		Shared.sin, Shared.exec = false, false
		hookToken += 1
		clearConns()
		stopAllLoco()
		stopExec()
	end)

	makeToggleCard("SinSwapGui", "SIN", "SIN", 15, Color3.fromRGB(190, 60, 255), 120, function()
		sinOn = not sinOn
		Shared.sin = sinOn
		if sinOn then
			local char = LocalPlayer.Character
			if char and not execOn then task.spawn(hookCharacter, char) end
		else
			if not execOn then
				hookToken += 1
				clearConns()
			end
			stopAllLoco()
		end
		return sinOn
	end)

	-- EXEC ANIM: the execution animations (SIN / VISA3, picked with the EXECUTION card) as their own toggle
	local setExecVisual
	local function setExec(on)
		on = on and true or false
		if on == execOn then return execOn end
		execOn = on
		Shared.exec = on
		if on then
			local char = LocalPlayer.Character
			if char and not sinOn then task.spawn(hookCharacter, char) end
		else
			if not sinOn then
				hookToken += 1
				clearConns()
			end
			stopExec()
		end
		return execOn
	end
	setExecVisual = makeToggleCard("ExecAnimGui", "ExecAnimToggle", "EXEC ANIM", 13, Color3.fromRGB(255, 90, 90), 64, function()
		return setExec(not execOn)
	end)
