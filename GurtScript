	end)

	FeatureHooks.corpse_players = function() playersOn = false; setVisPlayers(false) end
	FeatureHooks.corpse_npcs = function() npcsOn = false; setVisNpcs(false) end
end)

---------------------------------------------------------------- 12) thirdperson (first person still reachable by zooming in)
runSection("12", function()
	-- THIRDPERSON now only UNLOCKS the camera (zoom range + Classic mode).
	-- It never moves the camera: you scroll / pinch out yourself.
	local MIN_ZOOM = 0.5
	local MAX_ZOOM = 128
	local HIDE_ACCESSORIES = true -- while THIRDPERSON is ON: hide your own hats / hair / face / back accessories in FIRST PERSON only (client side), so they never block the camera; in third person they are shown normally
	local FIRST_PERSON_DIST = 1.5 -- camera closer than this many studs to you = first person

	local on = false
	local conn, charConn = nil, nil
	local saved = nil

	-- ---------- hide own accessories in first person only (event driven: the list is kept up to date from DescendantAdded / Removing, one tiny render step) ----------
	local hideParts = {}        -- [BasePart] = true : parts that sit inside one of your Accessory objects
	local hideConns = {}
	local hideState = false     -- true while they are hidden (first person)
	local HIDE_STEP = "ThirdPersonHideAccessories"

	local function setHidden(v) -- v: 1 = hidden, 0 = shown
		for part in pairs(hideParts) do
			if part.Parent then
				if part.LocalTransparencyModifier ~= v then part.LocalTransparencyModifier = v end
			else
				hideParts[part] = nil
			end
		end
	end

	local function stopHide()
		for _, c in ipairs(hideConns) do c:Disconnect() end
		table.clear(hideConns)
		pcall(function() RunService:UnbindFromRenderStep(HIDE_STEP) end)
		pcall(function() if hideState then setHidden(0) end end) -- shown again
		hideState = false
		table.clear(hideParts)
	end

	local function startHide(char)
		stopHide()
		if not (HIDE_ACCESSORIES and char) then return end
		local function consider(d)
			if d:IsA("BasePart") and d:FindFirstAncestorWhichIsA("Accoutrement") then
				hideParts[d] = true
				if hideState then d.LocalTransparencyModifier = 1 end
			end
		end
		for _, d in ipairs(char:GetDescendants()) do consider(d) end
		hideConns[1] = char.DescendantAdded:Connect(consider)
		hideConns[2] = char.DescendantRemoving:Connect(function(d) hideParts[d] = nil end)
		-- right after the camera has updated, so nothing flashes for a frame
		RunService:BindToRenderStep(HIDE_STEP, Enum.RenderPriority.Camera.Value + 1, function()
			local cam = Workspace.CurrentCamera
			local first = cam ~= nil and (cam.CFrame.Position - cam.Focus.Position).Magnitude < FIRST_PERSON_DIST
			if first then
				hideState = true
				setHidden(1) -- every frame while in first person (the game's own camera code may flip them back)
			elseif hideState then
				hideState = false
				setHidden(0) -- back in third person: shown once, nothing is touched after that
			end
		end)
	end

	local function unlock()
		if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
			LocalPlayer.CameraMode = Enum.CameraMode.Classic
		end
		if LocalPlayer.CameraMinZoomDistance > MIN_ZOOM then
			LocalPlayer.CameraMinZoomDistance = MIN_ZOOM
		end
		if LocalPlayer.CameraMaxZoomDistance < MAX_ZOOM then
			LocalPlayer.CameraMaxZoomDistance = MAX_ZOOM
		end
	end

	local function react()
		if on then pcall(unlock) end
	end
	local function dropConn()
		if conn then
			for _, c in ipairs(conn) do c:Disconnect() end
			conn = nil
		end
	end

	local function setOn(state)
		if state == on then return end
		on = state
		dropConn()
		if charConn then charConn:Disconnect(); charConn = nil end
		if not state then stopHide() end
		if on then
			saved = {
				mode = LocalPlayer.CameraMode,
				min = LocalPlayer.CameraMinZoomDistance,
				max = LocalPlayer.CameraMaxZoomDistance,
			}
			pcall(unlock)
			-- keeps the game from re-locking the camera
			conn = {
				LocalPlayer:GetPropertyChangedSignal("CameraMode"):Connect(react),
				LocalPlayer:GetPropertyChangedSignal("CameraMinZoomDistance"):Connect(react),
				LocalPlayer:GetPropertyChangedSignal("CameraMaxZoomDistance"):Connect(react),
			}
			startHide(LocalPlayer.Character)
			charConn = LocalPlayer.CharacterAdded:Connect(function(char)
				startHide(char)
				task.wait(0.5)
				if on then pcall(unlock) end
			end)
		elseif saved then
			pcall(function()
				LocalPlayer.CameraMaxZoomDistance = saved.max
				LocalPlayer.CameraMinZoomDistance = saved.min
				LocalPlayer.CameraMode = saved.mode
			end)
			saved = nil
		end
	end
	onCleanup(function() setOn(false) stopHide() end)

	local setVisual
	setVisual = makeToggleCard("ThirdPersonGui", "ThirdPersonToggle", "THIRDPERSON", 11, Color3.fromRGB(90, 200, 255), 648, function()
		setOn(not on)
		return on
	end)
	FeatureHooks.thirdperson = function() setOn(false); setVisual(false) end
end)

---------------------------------------------------------------- 13) fullbright loop
runSection("13", function()
	local TARGET = {
		Brightness = 2,
		ClockTime = 14,
		FogEnd = 1e6,
		GlobalShadows = false,
		Ambient = Color3.new(1, 1, 1),
		OutdoorAmbient = Color3.new(1, 1, 1),
	}
	local ATMOS_CHECK = 0.5   -- seconds between atmosphere scans (keeps the loop cheap)

	env.__FULLBRIGHT = false -- read by LIGHT LOCK (section 32) so the two do not fight
	local on = false
	local conn = nil
	local saved = nil
	local atmos = {}          -- Atmosphere -> original Density / Haze
	local lastAtmos = 0

	-- only writes a property when the game changed it back, so it costs almost nothing per frame
	local function enforce()
		for prop, value in pairs(TARGET) do
			if Lighting[prop] ~= value then Lighting[prop] = value end
		end
		local now = os.clock()
		if now - lastAtmos >= ATMOS_CHECK then
			lastAtmos = now
			for _, c in ipairs(Lighting:GetChildren()) do
				if c:IsA("Atmosphere") then
					if not atmos[c] then atmos[c] = { Density = c.Density, Haze = c.Haze } end
					if c.Density ~= 0 then c.Density = 0 end
					if c.Haze ~= 0 then c.Haze = 0 end
				end
			end
		end
	end

	local function setOn(state)
		if state == on then return end
		on = state
		env.__FULLBRIGHT = state
		if conn then conn:Disconnect(); conn = nil end
		if on then
			saved = {}
			for prop in pairs(TARGET) do saved[prop] = Lighting[prop] end
			lastAtmos = 0
			enforce()
			conn = RunService.RenderStepped:Connect(enforce)
		else
			if saved then
				for prop, value in pairs(saved) do pcall(function() Lighting[prop] = value end) end
				saved = nil
			end
			for c, orig in pairs(atmos) do
				if c.Parent then
					c.Density = orig.Density
					c.Haze = orig.Haze
				end
			end
			table.clear(atmos)
		end
	end
	onCleanup(function() setOn(false) end)

	local setVisual
	setVisual = makeToggleCard("FullbrightGui", "FullbrightToggle", "FULLBRIGHT", 12, Color3.fromRGB(255, 240, 120), 704, function()
		setOn(not on)
		return on
	end)
	FeatureHooks.fullbright = function() setOn(false); setVisual(false) end
end)

