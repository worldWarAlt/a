	-- Stun = three animations back to back: START (StunBegin) -> HOLD (stun idle, looped) -> GET UP (StunGetUp).
	-- Movement stays locked for the whole thing, and damage taken while stunned never counts toward the next stun.
	local function waitTrackLength(tr, timeout)
		local t0 = os.clock()
		while tr and tr.Length <= 0 and os.clock() - t0 < (timeout or 4) do task.wait(0.05) end
		return tr and tr.Length or 0
	end
	local function runStun(char, hum, animator)
		stunBusy = true
		Kit.stunBusy = true -- (pack idle / walk / run and RIF DODGE stay quiet while stunned)
		SinGrip.update()
		damageTotal = 0
		local savedMove = { WalkSpeed = hum.WalkSpeed, JumpPower = hum.JumpPower, JumpHeight = hum.JumpHeight, AutoRotate = hum.AutoRotate }
		local lockedRoot = char:FindFirstChild("HumanoidRootPart")
		local function lock()
			if hum.Parent then
				hum.WalkSpeed = 0
				hum.JumpPower = 0
				hum.JumpHeight = 0
				hum.AutoRotate = false
			end
			if lockedRoot and lockedRoot.Parent then
				local v = lockedRoot.AssemblyLinearVelocity
				lockedRoot.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
				lockedRoot.AssemblyAngularVelocity = Vector3.zero
			end
		end
		lock()
		local lockConn = RunService.Heartbeat:Connect(function()
			if stunBusy then lock() end
		end)
		stopLoco(animator)

		-- the active character pack (D-ZERO / GILBERT) brings its own stun animations; without one SIN's are used
		local beginId, idleId, getupId = STUN_ID, STUN_IDLE_ID, GETUP_ID
		local ps = Kit.viral.on and Kit.viral.stun or nil
		if ps then
			if ps.begin and #ps.begin > 0 then beginId = "rbxassetid://" .. ps.begin[math.random(1, #ps.begin)] end
			if ps.idle then idleId = "rbxassetid://" .. ps.idle end
			if ps.getup then getupId = "rbxassetid://" .. ps.getup end
		end
		local beginTr = Kit.get(animator, beginId)
		local idleTr = idleId ~= "" and not env.__NO_IDLES and Kit.get(animator, idleId) or nil
		local getupTr = Kit.get(animator, getupId)
		if not beginTr then warn("[SIN] Could not load stun animation " .. beginId) end
		if not getupTr then warn("[SIN] Could not load get-up animation " .. getupId) end
		if idleId ~= "" and not env.__NO_IDLES and not idleTr then warn("[SIN] Could not load stun idle animation " .. idleId) end
		for _, tr in ipairs({ beginTr or false, idleTr or false, getupTr or false }) do
			if tr then Kit.protect[tr] = true end -- no pack / ANIM REPLACE may demote the stun hold
		end
		if beginTr then beginTr.Priority = Enum.AnimationPriority.Action4 beginTr.Looped = false end
		if idleTr then idleTr.Priority = Enum.AnimationPriority.Action4 idleTr.Looped = true end
		if getupTr then getupTr.Priority = Enum.AnimationPriority.Action4 getupTr.Looped = false end

		playStunVoice()

		task.spawn(function()
			local t0 = os.clock()
			local function alive() return hum.Parent ~= nil and hum.Health > 0 end
			local function waitUntil(t)
				while alive() and os.clock() < t do task.wait() end
			end
			-- 1) START
			if beginTr then
				local len = waitTrackLength(beginTr)
				if beginTr.IsPlaying then beginTr:Stop(0) end
				beginTr:AdjustSpeed(1)
				local ok, err = pcall(function() beginTr:Play(0.08, 1, 1) end)
				if not ok then warn("[SIN] stun animation failed: " .. tostring(err)) end
				waitUntil(os.clock() + math.max(len - 0.12, 0.05))
			end
			-- 2) HOLD (the in-between anim). Without a stun idle animation, the last frame of the start anim is frozen instead.
			if alive() then
				if idleTr then
					pcall(function() idleTr:Play(0.15, 1, 1) end)
				elseif beginTr then
					beginTr:AdjustSpeed(0)
				end
				waitUntil(math.max(t0 + STUN_TIME, os.clock() + 1))
			end
			-- 3) GET UP
			if alive() then
				if idleTr and idleTr.IsPlaying then idleTr:Stop(0.1) end
				if beginTr then beginTr:AdjustSpeed(1) if beginTr.IsPlaying then beginTr:Stop(0.1) end end
				if getupTr then
					pcall(function() getupTr:Play(0.1, 1, 1) end)
					local len = waitTrackLength(getupTr)
					waitUntil(os.clock() + math.max(len - 0.05, 0.05))
				end
			end
			-- release
			lockConn:Disconnect()
			for _, tr in ipairs({ beginTr, idleTr, getupTr }) do
				if tr then
					pcall(function() tr:AdjustSpeed(1) end)
					if tr.IsPlaying then tr:Stop(0.12) end
				end
			end
			if hum.Parent then
				hum.WalkSpeed = savedMove.WalkSpeed
				hum.JumpPower = savedMove.JumpPower
				hum.JumpHeight = savedMove.JumpHeight
				hum.AutoRotate = savedMove.AutoRotate
			end
			damageTotal = 0
			lastHealth = hum.Parent and hum.Health or nil
			stunBusy = false
			Kit.stunBusy = false
			SinGrip.update()
			if locoEnabled and LocalPlayer.Character == char then startLocoController(char) end
		end)
	end
	local function hookStunCharacter(char)
		local hum = char:WaitForChild("Humanoid", 10)
		local animator = hum and hum:WaitForChild("Animator", 10)
		if not hum or not animator then return end
		lastHealth = hum.Health
		bind(hum.HealthChanged:Connect(function(hp)
			if stunBusy then
				-- already stunned (start / hold / get-up): damage is ignored so you can't be stunned again or chain-stunned
				damageTotal = 0
				lastHealth = hp
				return
			end
			if not stunEnabled then lastHealth = hp return end
			if lastHealth and hp < lastHealth then damageTotal += lastHealth - hp end
			lastHealth = hp
			if damageTotal >= STUN_DAMAGE and hp > 0 then
				runStun(char, hum, animator)
			end
		end))
	end
	if LocalPlayer.Character then
		task.spawn(hookStunCharacter, LocalPlayer.Character)
	end
