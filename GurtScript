			-- text typed in the Custom tab -> bundle id / search (returns true if it was a bundle request)
			function Body.bundleRequest(text)
				local id = text:match("/bundles/(%d+)") or text:match("^[Bb]%s*:%s*(%d+)%s*$")
				if id then
					Body.morphIntoBundle(tonumber(id), "Bundle " .. id, Body.addBundleEntry(tonumber(id), "Bundle " .. id))
					return true
				end
				local kw = text:match("^[Bb]%s*:%s*(.-)%s*$") or text:match("^[Bb]undle%s+(.-)%s*$")
				if kw and kw ~= "" then
					status.Text = "Searching bundles: " .. kw .. "..."
					task.spawn(function()
						local found, err = Body.searchBundles(kw)
						if #found == 0 then
							status.Text = err and ("Search failed (" .. tostring(err) .. ") - paste the bundle id / link instead") or ("No bundles found for '" .. kw .. "'")
							return
						end
						for _, f in ipairs(found) do Body.addBundleEntry(f.id, f.name) end
						status.Text = "Found " .. #found .. " bundle(s) - tap one in the list"
					end)
					return true
				end
				return false
			end

