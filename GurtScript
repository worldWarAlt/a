		-- hold - / +: one step on press, repeats after a short wait and speeds up
		local function holdButton(text, x, sign)
			local b = mk("TextButton", {
				Position = UDim2.fromOffset(x, 58), Size = UDim2.fromOffset(44, 34), BackgroundColor3 = ROW_BG, BorderSizePixel = 0,
				Font = Enum.Font.GothamBold, Text = text, TextSize = 20, TextColor3 = WHITE, AutoButtonColor = true,
			}, f)
			corner(b, 8)
			b.InputBegan:Connect(function(input)
				if not isPress(input) then return end
				nudToken += 1
				local mine, down, conn = nudToken, true, nil
				conn = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						down = false
						conn:Disconnect()
					end
				end)
				bump(sign * nudUnit())
				task.spawn(function()
					task.wait(0.35)
					local n = 0
					while down and nudToken == mine do
						n += 1
						bump(sign * nudUnit() * (n > 15 and 5 or 1))
						task.wait(0.06)
					end
				end)
			end)
		end
		holdButton("-", 8, -1)
		holdButton("+", 260, 1)

		-- the big swipe bar: every PX_PER_UNIT pixels of finger travel = one step
		nudBar = mk("TextButton", {
			Position = UDim2.fromOffset(56, 58), Size = UDim2.fromOffset(200, 34), BackgroundColor3 = TAB_SAVED_ON, BorderSizePixel = 0,
			Font = Enum.Font.GothamBold, Text = "", TextSize = 13, TextColor3 = WHITE, AutoButtonColor = false,
		}, f)
		corner(nudBar, 8)
		nudBar.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			local last, acc = input.Position.X, 0
			local conn, ec
			conn = UIS.InputChanged:Connect(function(i)
				if i == input or i.UserInputType == Enum.UserInputType.MouseMovement then
					local x = i.Position.X
					acc += x - last
					last = x
					local units = acc >= 0 and math.floor(acc / PX_PER_UNIT) or -math.floor(-acc / PX_PER_UNIT)
					if units ~= 0 then
						acc -= units * PX_PER_UNIT
						bump(units * nudUnit())
					end
				end
			end)
			ec = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					conn:Disconnect()
					ec:Disconnect()
				end
			end)
		end)
		nudRefresh()
	end

