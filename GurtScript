	---------------- stun voice picker: browse the game's voice lines, pick one line / a folder (random line) / everything
	-- The line is played the same way the VOICELINES panel plays it (VoiceEvent:FireServer), so other players hear it too.
	local VOICE_SAVE = "stun_voice.json"
	local voiceChain = nil -- nil = no voice | {} = random line from everything | {names...} = a line, or a folder (random line from it)

	local function voiceRoot()
		local g = PlayerGui:FindFirstChild("Voiceline")
		return g, g and g:FindFirstChild("VoiceEvent"), g and g:FindFirstChild("VoiceLines")
	end
	local function voiceNodeAt(names)
		local _, _, root = voiceRoot()
		local n = root
		for _, nm in ipairs(names) do
			if not n then return nil end
			n = n:FindFirstChild(nm)
		end
		return n
	end
	local function voicePretty(name) return (string.gsub(name, '^"(.*)"$', "%1")) end
	local function voiceIsLeaf(n) return n:IsA("Sound") or #n:GetChildren() == 0 end
	local function voiceLeaves(node, out)
		for _, kid in ipairs(node:GetChildren()) do
			if voiceIsLeaf(kid) then out[#out + 1] = kid else voiceLeaves(kid, out) end
		end
		return out
	end
	local function voiceSame(a, b)
		if a == nil or b == nil then return a == b end
		if #a ~= #b then return false end
		for i = 1, #a do if a[i] ~= b[i] then return false end end
		return true
	end
	local function voiceFire(line)
		local g, ev = voiceRoot()
		if ev and line and line.Parent and line:IsDescendantOf(g) then
			if pcall(function() ev:FireServer(line, line.Parent.Name) end) then return true end
		end
		if line and line:IsA("Sound") then pcall(function() line:Play() end) return true end
		return false
	end
	local function playStunVoice()
		if not voiceChain then return end
		local node = voiceNodeAt(voiceChain)
		if not node then return end
		if voiceIsLeaf(node) and #voiceChain > 0 then voiceFire(node) return end
		local leaves = voiceLeaves(node, {})
		if #leaves > 0 then voiceFire(leaves[math.random(#leaves)]) end
	end
	local function voiceLabel()
		if not voiceChain then return "NONE" end
		if #voiceChain == 0 then return "RANDOM (ALL)" end
		local node = voiceNodeAt(voiceChain)
		local last = voicePretty(voiceChain[#voiceChain])
		if node and not voiceIsLeaf(node) then return "RANDOM: " .. last end
		return last
	end
	local function refreshVoiceButton()
		voiceButton.Text = "STUN VOICE: " .. string.upper(voiceLabel())
	end
