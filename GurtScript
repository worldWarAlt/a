---------------------------------------------------------------- 34) core chat (CHAT card: forces the Roblox CoreGui chat on; turning it off puts the chat back how it was)
runSection("34", function()
	local StarterGui = game:GetService("StarterGui")
	local TextChatService = game:GetService("TextChatService")

	local on = false
	local token = 0
	local orig = nil -- chat state recorded when the card is switched on

	local function textChatObj(name)
		local ok, o = pcall(function() return TextChatService:FindFirstChild(name) end)
		return ok and o or nil
	end

	local function record()
		local win, bar = textChatObj("ChatWindowConfiguration"), textChatObj("ChatInputBarConfiguration")
		local okCore, core = pcall(function() return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Chat) end)
		orig = {
			core = okCore and core or nil,
			win = win and win.Enabled,
			bar = bar and bar.Enabled,
		}
	end

	-- legacy chat (CoreGui) and the newer TextChatService window + input bar
	local function force()
		pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true) end)
		local win, bar = textChatObj("ChatWindowConfiguration"), textChatObj("ChatInputBarConfiguration")
		if win and not win.Enabled then pcall(function() win.Enabled = true end) end
		if bar and not bar.Enabled then pcall(function() bar.Enabled = true end) end
	end

	local function restore()
		if not orig then return end
		if orig.core ~= nil then pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, orig.core) end) end
		local win, bar = textChatObj("ChatWindowConfiguration"), textChatObj("ChatInputBarConfiguration")
		if win and orig.win ~= nil then pcall(function() win.Enabled = orig.win end) end
		if bar and orig.bar ~= nil then pcall(function() bar.Enabled = orig.bar end) end
		orig = nil
	end

	local function turnOn()
		if on then return end
		on = true
		token += 1
		local my = token
		record()
		force()
		task.spawn(function() -- the game may switch the chat off again: keep it on while the card is on
			while on and token == my do
				force()
				task.wait(0.5)
			end
		end)
	end

	local function turnOff()
		if not on then return end
		on = false
		token += 1
		restore()
	end
	onCleanup(turnOff)

	local setVisual
	setVisual = makeToggleCard("CoreChatGui", "CoreChatToggle", "CHAT", 15, Color3.fromRGB(90, 170, 255), 1992, function()
		if on then turnOff() else turnOn() end
		return on
	end)
	FeatureHooks.corechat = function() turnOff() setVisual(false) end
end)

---------------------------------------------------------------- 35) mute music (MUTE MUSIC card: silences music only; sound effects, voices, footsteps, character sounds and the script's own sfx are never touched)
runSection("35", function()
	local SoundService = game:GetService("SoundService")

	-- What counts as MUSIC (a sound is only muted if it matches one of these rules AND is not excluded):
	local KEYWORDS = { "music", "song", "bgm", "soundtrack", "theme", "jingle", "lobbymusic" } -- found anywhere in the sound's name, its parent names, or its SoundGroup name
	local TOKEN_WORDS = { ost = true, bg = true }                                                -- short words: only count as a whole word in a name ("Boss OST", not "Post")
	local EXTRA_MUSIC_NAMES = {}                                                                 -- add exact Sound names here to always mute them, e.g. EXTRA_MUSIC_NAMES["RoundTheme"] = true
	local NEVER_MUTE_NAMES = {}                                                                  -- add exact Sound names here to never mute them
	local LONG_IN_SOUNDSERVICE = 45                                                              -- looped / this-many-seconds-long sounds inside SoundService count as music
	local LONG_ELSEWHERE = 90                                                                    -- sounds elsewhere (Workspace, PlayerGui) must be this long to count without a music-like name
	local SCRIPT_MUSIC = { BossMusic = true, BossMusicLoop = true }                              -- the script's own music sounds (everything else it plays is a sound effect)

	local on = false
	local candidates = setmetatable({}, { __mode = "k" }) -- every Sound seen under SoundService / Workspace / PlayerGui
	local tracked = {}                                    -- [Sound] = { orig = original volume, conn = Volume watcher }
	local watchConns = {}
	local sweepToken = 0

	local function nameLooksLikeMusic(name)
		local lower = string.lower(name)
		for _, kw in ipairs(KEYWORDS) do
			if string.find(lower, kw, 1, true) then return true end
		end
		for word in string.gmatch(string.gsub(name, "(%l)(%u)", "%1 %2"), "%a+") do
			if TOKEN_WORDS[string.lower(word)] then return true end
		end
		return false
	end

	local function insideCharacter(s)
		local a = s.Parent
		while a and a ~= game do
			if a:IsA("Model") and a:FindFirstChildOfClass("Humanoid") then return true end
			a = a.Parent
		end
		return false
	end

	local function isMusic(s)
		if not s:IsA("Sound") then return false end
		if NEVER_MUTE_NAMES[s.Name] then return false end
		if s:GetAttribute("ScriptSound") == true then return SCRIPT_MUSIC[s.Name] == true end -- script sfx are never muted; its music sounds are
		if insideCharacter(s) then return false end                                       -- footsteps, voices, weapon sounds of players and NPCs
		if EXTRA_MUSIC_NAMES[s.Name] then return true end

		local sg = s.SoundGroup
		if sg and nameLooksLikeMusic(sg.Name) then return true end
		if nameLooksLikeMusic(s.Name) then return true end

		-- a music-named folder / model around it (Workspace.Music.Track1, SoundService.BGM.Main ...)
		local a, depth = s.Parent, 0
		while a and a ~= game and a ~= Workspace and a ~= SoundService and a ~= PlayerGui and depth < 6 do
			if nameLooksLikeMusic(a.Name) then return true end
			a, depth = a.Parent, depth + 1
		end

		local len = s.TimeLength
		if s:IsDescendantOf(SoundService) then
			return s.Looped or len >= LONG_IN_SOUNDSERVICE
		end
		return len >= LONG_ELSEWHERE
	end

	local function mute(s)
		local rec = tracked[s]
		if not rec then
			rec = { orig = s.Volume }
			tracked[s] = rec
			-- the game / script keeps changing its volume (fades, tweens): remember the newest wanted volume and keep it silent
			rec.conn = s:GetPropertyChangedSignal("Volume"):Connect(function()
				if on and s.Volume > 0 then
					rec.orig = s.Volume
					s.Volume = 0
				end
			end)
		end
		if s.Volume > 0 then
			rec.orig = s.Volume
			s.Volume = 0
		end
	end

	local function consider(s)
		if s:IsA("Sound") then candidates[s] = true end
	end

	local function sweep()
		for s in pairs(candidates) do
			if not s.Parent then
				candidates[s] = nil
				local rec = tracked[s]
				if rec then
					if rec.conn then rec.conn:Disconnect() end
					tracked[s] = nil
				end
			elseif not tracked[s] and isMusic(s) then
				mute(s)
			end
		end
	end

	local function turnOn()
		if on then return end
		on = true
		sweepToken += 1
		local my = sweepToken
		for _, root in ipairs({ SoundService, Workspace, PlayerGui }) do
			for _, d in ipairs(root:GetDescendants()) do consider(d) end
			table.insert(watchConns, root.DescendantAdded:Connect(function(d)
				consider(d)
				if on and d:IsA("Sound") then
					task.defer(function() if on and d.Parent and not tracked[d] and isMusic(d) then mute(d) end end)
				end
			end))
		end
		sweep()
		task.spawn(function() -- sounds whose length / group only becomes known once they load
			while on and sweepToken == my do
				task.wait(1)
				if on then sweep() end
			end
		end)
	end

	local function turnOff()
		if not on then return end
		on = false
		sweepToken += 1
		for _, c in ipairs(watchConns) do c:Disconnect() end
		table.clear(watchConns)
		for s, rec in pairs(tracked) do
			if rec.conn then rec.conn:Disconnect() end
			if s.Parent and rec.orig then s.Volume = rec.orig end
		end
		table.clear(tracked)
		table.clear(candidates)
	end
	onCleanup(turnOff)

	local setVisual
	setVisual = makeToggleCard("MuteMusicGui", "MuteMusicToggle", "MUTE MUSIC", 11, Color3.fromRGB(190, 120, 255), 2048, function()
		if on then turnOff() else turnOn() end
		return on
	end)
	FeatureHooks.mutemusic = function() turnOff() setVisual(false) end
end)

---------------------------------------------------------------- 36) taunt controls (merged from TauntControl script, rebuilt as cards: TAUNT + ANIM, TAUNT, BLOCK ANIM, AUTO DETECT)
runSection("36", function()
	local ReplicatedStorage = game:GetService("ReplicatedStorage")

	local TAUNT_ANIM_ID = "rbxassetid://115866019662594"   -- played by TAUNT + ANIM
	local BLOCKED_ANIM_ID = "rbxassetid://117471643829663" -- stopped on sight while BLOCK ANIM is on
	local BLOCK_CHECK_EVERY = 0.05                         -- seconds between sweeps for the blocked animation (AnimationPlayed also catches it instantly)
	local TAUNT_COOLDOWN = 0.4                             -- seconds between two taunts (both taunt cards share it)
	local TAUNT_PRIORITY = Enum.AnimationPriority.Action4 -- the HIGHEST priority there is (Core is the LOWEST, below Idle): the taunt animation beats every other animation
	local OVERRIDE_WINDOW = 0.8                            -- seconds after a taunt during which other copies of the taunt animation (the game's own) are stopped

	local blockOn = false
	local autoDetect = true
	local lastWarn = 0

	local function idNum(id) return tostring(id or ""):match("%d+") end
	local BLOCK_NUM = idNum(BLOCKED_ANIM_ID)

	local function warnOnce(msg)
		if os.clock() - lastWarn > 2 then
			lastWarn = os.clock()
			warn(msg)
		end
	end

	-- ---------- TauntEvent lookup ----------
	-- AUTO DETECT on: equipped ViralFists, then ViralFists in the backpack, then any TauntEvent in your character / backpack, then ReplicatedStorage.
	-- AUTO DETECT off: only the ViralFists you are holding.
	local function remoteIn(tool)
		local e = tool and tool:FindFirstChild("TauntEvent")
		if e and e:IsA("RemoteEvent") then return e end
		return nil
	end

	local function getTauntEvent()
		local char = LocalPlayer.Character
		local e = remoteIn(char and char:FindFirstChild("ViralFists"))
		if e then return e end
		if autoDetect then
			local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
			e = remoteIn(bp and bp:FindFirstChild("ViralFists"))
			if e then return e end
			e = (char and char:FindFirstChild("TauntEvent", true)) or (bp and bp:FindFirstChild("TauntEvent", true)) or ReplicatedStorage:FindFirstChild("TauntEvent")
			if e and e:IsA("RemoteEvent") then return e end
			warnOnce("[TAUNT] Auto-detect: ViralFists / TauntEvent not found (equip the fists and try again)")
		else
			warnOnce("[TAUNT] Auto-detect is off and ViralFists is not in your hands")
		end
		return nil
	end

	-- ---------- taunt animation (one loaded track per Animator, reused) ----------
	local tauntAnim = Instance.new("Animation")
	tauntAnim.AnimationId = TAUNT_ANIM_ID
	local tauntTracks = setmetatable({}, { __mode = "k" })

	local function currentAnimator()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		return hum and hum:FindFirstChildOfClass("Animator"), hum
	end

	local TAUNT_NUM = idNum(TAUNT_ANIM_ID)
	local overrideToken = 0

	-- stops every OTHER playing copy of the taunt animation (the game plays its own when TauntEvent fires, at a lower priority / out of sync)
	local function stopOtherTauntCopies(animator, mine)
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
			if t ~= mine and t.Animation and idNum(t.Animation.AnimationId) == TAUNT_NUM then
				pcall(function() t:Stop(0) end)
			end
		end
	end

	local function playTauntAnimation()
		local animator = currentAnimator()
		if not animator then return end
		local tr = tauntTracks[animator]
		if not tr then
			local ok, loaded = pcall(function() return animator:LoadAnimation(tauntAnim) end)
			if not ok or not loaded then return end
			tr = loaded
			tauntTracks[animator] = tr
		end
		tr.Priority = TAUNT_PRIORITY      -- overrides everything else
		Kit.protect[tr] = true             -- no other part of this script (SIN, packs, ANIM REPLACE ...) may demote or stop it
		if tr.IsPlaying then tr:Stop(0) end -- overrides ITSELF: pressing again restarts it from the first frame
		tr:Play(0, 1, 1)
		tr:AdjustWeight(1, 0)

		-- the game's own taunt copy arrives a moment later: keep removing it for a short while so only ours shows
		overrideToken += 1
		local my = overrideToken
		task.spawn(function()
			local t0 = os.clock()
			while overrideToken == my and os.clock() - t0 < OVERRIDE_WINDOW do
				stopOtherTauntCopies(animator, tr)
				if tr.Priority ~= TAUNT_PRIORITY then tr.Priority = TAUNT_PRIORITY end -- nothing may lower it while the game's copy is arriving
				task.wait(0.03)
			end
		end)
	end

	local nextTaunt = 0
	-- returns "ok" (fired), "missing" (no TauntEvent) or "cooldown" (pressed within TAUNT_COOLDOWN of the last taunt)
	local function fireTaunt(withAnim)
		local now = os.clock()
		if now < nextTaunt then return "cooldown" end
		local event = getTauntEvent()
		if not event then return "missing" end
		nextTaunt = now + TAUNT_COOLDOWN
		if withAnim then pcall(playTauntAnimation) end
		event:FireServer()
		return "ok"
	end

	-- ---------- BLOCK ANIM ----------
	local function isBlocked(track)
		return track.Animation ~= nil and idNum(track.Animation.AnimationId) == BLOCK_NUM
	end

	local function stopBlockedNow()
		local animator = currentAnimator()
		if not animator then return end
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
			if isBlocked(t) then pcall(function() t:Stop(0) end) end
		end
	end

	local function hookAnimator(animator)
		bind(animator.AnimationPlayed:Connect(function(track)
			if blockOn and isBlocked(track) then pcall(function() track:Stop(0) end) end
		end))
	end

	local function setupCharacter(char)
		task.spawn(function()
			local hum = char:WaitForChild("Humanoid", 10)
			local animator = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 10))
			if animator then hookAnimator(animator) end
		end)
	end
	if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
	bind(LocalPlayer.CharacterAdded:Connect(setupCharacter))

	local blockToken = 0
	local function setBlock(state)
		if blockOn == state then return end
		blockOn = state
		blockToken += 1
		if blockOn then
			local my = blockToken
			stopBlockedNow()
			task.spawn(function() -- the server can also start it: sweep until the toggle is switched off
				while blockOn and blockToken == my do
					stopBlockedNow()
					task.wait(BLOCK_CHECK_EVERY)
				end
			end)
		end
	end
	onCleanup(function() setBlock(false) end)

	-- ---------- cards ----------
	-- a tap-to-fire card in the same look as the toggle cards (no on / off state: it flashes when pressed)
	local function makeActionCard(guiName, cardName, titleText, titleSize, accent, yOffset, onPress)
		local CARD_BG, STROKE_OFF = Color3.fromRGB(8, 8, 10), Color3.fromRGB(235, 235, 240)

		local g = Instance.new("ScreenGui")
		g.Name = guiName
		g.ResetOnSpawn = false
		g.Parent = PlayerGui

		local card = Instance.new("TextButton")
		card.Name = cardName
		card.Size = UDim2.new(0, 156, 0, 46)
		card.Position = UDim2.new(0.02, 0, 0.45, yOffset)
		card.BackgroundColor3 = CARD_BG
		card.BackgroundTransparency = 0.3
		card.BorderSizePixel = 0
		card.AutoButtonColor = false
		card.Text = ""
		card.Parent = g
		Instance.new("UICorner", card).CornerRadius = UDim.new(1, 0)

		local stroke = Instance.new("UIStroke")
		stroke.Color = accent
		stroke.Thickness = 1
		stroke.Transparency = 0.45
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = card

		local scale = Instance.new("UIScale")
		scale.Parent = card

		local title = Instance.new("TextLabel")
		title.BackgroundTransparency = 1
		title.Size = UDim2.new(0, 90, 0, 18)
		title.Position = UDim2.new(0, 20, 0, 7)
		title.Font = Enum.Font.GothamMedium
		title.Text = titleText
		title.TextSize = titleSize
		title.TextColor3 = Color3.fromRGB(240, 240, 248)
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = card

		local status = Instance.new("TextLabel")
		status.BackgroundTransparency = 1
		status.Size = UDim2.new(0, 90, 0, 14)
		status.Position = UDim2.new(0, 20, 0, 25)
		status.Font = Enum.Font.GothamMedium
		status.Text = "TAP TO FIRE"
		status.TextSize = 10
		status.TextColor3 = GREY_TEXT
		status.TextXAlignment = Enum.TextXAlignment.Left
		status.Parent = card

		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(1, 0.5)
		dot.Size = UDim2.new(0, 20, 0, 20)
		dot.Position = UDim2.new(1, -16, 0.5, 0)
		dot.BackgroundColor3 = accent
		dot.BackgroundTransparency = 0.55
		dot.BorderSizePixel = 0
		dot.Parent = card
		Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

		local flashId = 0
		local function flash(result)
			flashId += 1
			local my = flashId
			local ok = (result == "ok")
			if result == "cooldown" then
				status.Text = "COOLDOWN"
				tween(status, 0.05, { TextColor3 = Color3.fromRGB(255, 190, 90) })
			else
				tween(stroke, 0.08, { Transparency = 0.05 })
				tween(dot, 0.08, { BackgroundTransparency = 0 })
				status.Text = ok and "FIRED" or "NOT FOUND"
				tween(status, 0.08, { TextColor3 = ok and accent or Color3.fromRGB(255, 110, 110) })
			end
			task.delay((result == "cooldown") and 0.25 or 0.35, function()
				if flashId ~= my or not card.Parent then return end
				tween(stroke, 0.25, { Transparency = 0.45 })
				tween(dot, 0.25, { BackgroundTransparency = 0.55 })
				status.Text = "TAP TO FIRE"
				tween(status, 0.25, { TextColor3 = GREY_TEXT })
			end)
		end

		card.MouseEnter:Connect(function() tween(scale, 0.12, { Scale = 1.05 }) end)
		card.MouseLeave:Connect(function() tween(scale, 0.12, { Scale = 1 }) end)
		card.MouseButton1Down:Connect(function() tween(scale, 0.08, { Scale = 0.95 }) end)
		card.MouseButton1Up:Connect(function() tween(scale, 0.1, { Scale = 1.05 }) end)
		card.MouseButton1Click:Connect(function() flash(onPress()) end)
	end

	makeActionCard("TauntAnimGui", "TauntAnimButton", "TAUNT + ANIM", 11, Color3.fromRGB(70, 130, 255), 2104, function()
		return fireTaunt(true)
	end)
	makeActionCard("TauntFireGui", "TauntFireButton", "TAUNT", 13, Color3.fromRGB(235, 90, 90), 2160, function()
		return fireTaunt(false)
	end)

	-- LIGHTING RESET: puts Lighting back to the plain default look and switches off every post effect (bloom, blur, colour correction, sun rays, depth of field)
