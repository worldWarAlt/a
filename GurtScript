			function Chain.load(file)
				local function fromBuiltin()
					local b = Chain.BUILTIN_BY_FILE[file]
					if not b then return nil end
					local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(b.json) end)
					if ok and type(data) == "table" and type(data.pieces) == "table" then return data.pieces, data end
					return nil
				end
				if not (isfile and readfile and writefile) then return fromBuiltin() end
				if not isfile(file) then
					local b = Chain.BUILTIN_BY_FILE[file]
					if b then pcall(writefile, file, b.json) else chainDownload(file) end
				end
				if not isfile(file) then return fromBuiltin() end
				local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(file)) end)
				if ok and type(data) == "table" and type(data.pieces) == "table" then return data.pieces, data end
				return fromBuiltin()
			end

			-- rebuilds one saved piece as a handle inside the hats folder
			function Chain.buildEntry(e, hats)
				local cls = e.class or "MeshPart" -- files from older versions only have meshes
				local mp
				if cls == "MeshPart" then
					pcall(function()
						mp = game:GetService("InsertService"):CreateMeshPartAsync(e.MeshId, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
					end)
					if not mp then
						-- could not create a real MeshPart: use a plain part with a FileMesh scaled to the saved size
						mp = Instance.new("Part")
						local sm = Instance.new("SpecialMesh")
						sm.MeshType = Enum.MeshType.FileMesh
						sm.MeshId = e.MeshId
						sm.TextureId = e.TextureID or ""
						if e.MeshSize and e.MeshSize[1] > 0 and e.MeshSize[2] > 0 and e.MeshSize[3] > 0 then
							sm.Scale = Vector3.new(e.Size[1] / e.MeshSize[1], e.Size[2] / e.MeshSize[2], e.Size[3] / e.MeshSize[3])
						end
						sm.Parent = mp
					else
						pcall(function() mp.TextureID = e.TextureID or "" end)
					end
				else
					mp = Instance.new(Chain.PART_CLASS[cls] and cls or "Part")
					if e.Shape and mp:IsA("Part") then pcall(function() mp.Shape = Enum.PartType[e.Shape] end) end
					if e.sm then
						local sm = Instance.new("SpecialMesh")
						pcall(function() sm.MeshType = Enum.MeshType[e.sm.MeshType] end)
						pcall(function() sm.MeshId = e.sm.MeshId or "" end)
						pcall(function() sm.TextureId = e.sm.TextureId or "" end)
						if e.sm.Scale then pcall(function() sm.Scale = Vector3.new(e.sm.Scale[1], e.sm.Scale[2], e.sm.Scale[3]) end) end
						if e.sm.Offset then pcall(function() sm.Offset = Vector3.new(e.sm.Offset[1], e.sm.Offset[2], e.sm.Offset[3]) end) end
						if e.sm.VertexColor then pcall(function() sm.VertexColor = Vector3.new(e.sm.VertexColor[1], e.sm.VertexColor[2], e.sm.VertexColor[3]) end) end
						sm.Parent = mp
					end
				end
				pcall(function() mp.Size = Vector3.new(e.Size[1], e.Size[2], e.Size[3]) end)
				mp.Color = Color3.new(e.Color[1], e.Color[2], e.Color[3])
				pcall(function() mp.Material = Enum.Material[e.Material] end)
				mp.Transparency = e.Transparency or 0
				mp.Reflectance = e.Reflectance or 0
				if e.sa then
					local sa = Instance.new("SurfaceAppearance")
					pcall(function() sa.ColorMap = e.sa.ColorMap end)
					pcall(function() sa.NormalMap = e.sa.NormalMap end)
					pcall(function() sa.MetalnessMap = e.sa.MetalnessMap end)
					pcall(function() sa.RoughnessMap = e.sa.RoughnessMap end)
					if e.sa.Color then pcall(function() sa.Color = Color3.new(e.sa.Color[1], e.sa.Color[2], e.sa.Color[3]) end) end
					if e.sa.AlphaMode then pcall(function() sa.AlphaMode = Enum.AlphaMode[e.sa.AlphaMode] end) end
					sa.Parent = mp
				end
				for _, dd in ipairs(e.decals or {}) do
					local d = Instance.new(dd.tile and "Texture" or "Decal")
					d.Texture = dd.Texture
					pcall(function() d.Face = Enum.NormalId[dd.Face] end)
					d.Transparency = dd.Transparency or 0
					if dd.Color3 then pcall(function() d.Color3 = Color3.new(dd.Color3[1], dd.Color3[2], dd.Color3[3]) end) end
					if dd.tile then
						pcall(function() d.StudsPerTileU = dd.tile[1] end)
						pcall(function() d.StudsPerTileV = dd.tile[2] end)
					end
					d.Parent = mp
				end
				for _, l in ipairs(e.lights or {}) do
					pcall(function()
						local li = Instance.new(l.class)
						li.Color = Color3.new(l.Color[1], l.Color[2], l.Color[3])
						li.Brightness = l.Brightness
						li.Range = l.Range
						li.Enabled = l.Enabled ~= false
						if l.Face then li.Face = Enum.NormalId[l.Face] end
						li.Parent = mp
					end)
				end
				Chain.addAcc(hats, e.limb .. "_" .. e.name, mp, e.limb, tableToCf(e.rel), tableToCf(e.anchor))
			end

			function Chain.fromData(entries, hats, data, morph)
				for _, e in ipairs(entries) do
					local ok, err = pcall(Chain.buildEntry, e, hats)
					if not ok then warn("[ChainMorph] could not rebuild " .. tostring(e.name) .. ": " .. tostring(err)) end
				end
				Chain.applyExtra(morph, hats, data) -- body colors + shirt / pants (files from older versions have none: black limbs as before)
			end
			-- forms
			function Chain.makeMorph(name, parentNow)
				local morph = Instance.new("Folder")
				morph.Name = name
				morph:SetAttribute("ChainLazy", true)
				morph:SetAttribute("HideFace", Chain.HIDE_FACE)
				local hats = Instance.new("Folder")
				hats.Name = "Hats"
				hats.Parent = morph
				local bc = Instance.new("BodyColors")
				bc.HeadColor3 = Chain.COLOR
				bc.TorsoColor3 = Chain.COLOR
				bc.LeftArmColor3 = Chain.COLOR
				bc.RightArmColor3 = Chain.COLOR
				bc.LeftLegColor3 = Chain.COLOR
				bc.RightLegColor3 = Chain.COLOR
				bc.Parent = morph
				if parentNow then morph.Parent = morphFolder end
				return morph
			end

			function Chain.saveIndex()
				if not writefile then return end
				local list = {}
				for _, f in pairs(Chain.forms) do
					if f.sig then list[#list + 1] = { name = f.name, sig = f.sig, file = f.file, parts = f.parts, schema = f.schema } end
				end
				table.sort(list, function(a, b) return a.name < b.name end)
				pcall(writefile, Chain.INDEX, game:GetService("HttpService"):JSONEncode({ forms = list }))
			end

			function Chain.loadIndex()
				if isfile and readfile and isfile(Chain.INDEX) then
					local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile(Chain.INDEX)) end)
					if ok and type(data) == "table" and type(data.forms) == "table" then
						for _, e in ipairs(data.forms) do
							if type(e.name) == "string" and type(e.file) == "string" and not Chain.forms[e.name] then
								Chain.forms[e.name] = { name = e.name, sig = e.sig, file = e.file, parts = e.parts, schema = e.schema, morph = Chain.makeMorph(e.name, true) }
								if e.sig then Chain.bySig[e.sig] = Chain.forms[e.name] end
							end
						end
					end
				end
				-- install the built-in CHAIN looks: write any missing file, and add any look that is not in the list yet
				local added = false
				for _, b in ipairs(Chain.BUILTIN) do
					if writefile and isfile and not isfile(b.file) then pcall(writefile, b.file, b.json) end
					if not Chain.forms[b.name] and not Chain.bySig[b.sig] then
						Chain.forms[b.name] = { name = b.name, sig = b.sig, file = b.file, parts = b.parts, schema = b.schema, morph = Chain.makeMorph(b.name, true) }
						Chain.bySig[b.sig] = Chain.forms[b.name]
						added = true
					end
				end
				if added then Chain.saveIndex() end
				if next(Chain.forms) == nil then
					Chain.forms["CHAIN"] = { name = "CHAIN", file = "ChainMorph_CHAIN.json", morph = Chain.makeMorph("CHAIN", true) }
				end
			end

			-- looks at one CHAIN model; if its look (meshes, textures, colors, materials, glow, clothes, body colors) is new, saves + names it
			function Chain.check(m)
				local pieces, extra = Chain.gather(m)
				if #pieces == 0 and next(extra.clothes) == nil then return nil end
				local parts = Chain.sigParts(pieces, extra)
				local sig = Chain.signature(parts)
				if Chain.bySig[sig] then return nil end

				local count = 0
				for _ in pairs(Chain.forms) do count = count + 1 end

				local base = m.Name
				local form = Chain.forms[base]
				if form and form.sig and form.schema == Chain.SCHEMA then
					-- same model name as an existing form but a different look: name it after what changed
					if count >= Chain.MAX_FORMS then return nil end
					local name = Chain.nameFor(base, parts, form)
					form = { name = name, file = "ChainMorph_" .. name:gsub("[^%w]+", "_") .. ".json" }
					Chain.forms[name] = form
				elseif form then
					-- saved by an older version (or never seen live yet): the same button is upgraded to the fuller look
					if form.sig then Chain.bySig[form.sig] = nil end
				else
					if count >= Chain.MAX_FORMS then return nil end
					form = { name = base, file = "ChainMorph_" .. base:gsub("[^%w]+", "_") .. ".json" }
					Chain.forms[base] = form
				end

				local hats
				if form.morph then
					hats = form.morph:FindFirstChild("Hats")
					for _, c in ipairs(hats:GetChildren()) do c:Destroy() end
				else
					form.morph = Chain.makeMorph(form.name, false)
					hats = form.morph:FindFirstChild("Hats")
				end
				Chain.fromLive(pieces, hats, extra, form.morph)
				form.sig, form.parts, form.schema = sig, parts, Chain.SCHEMA
				Chain.bySig[sig] = form
				Chain.save(pieces, form.file, extra)
				if not form.morph.Parent then form.morph.Parent = morphFolder end
				Chain.saveIndex()
				print("[ChainMorph] new form saved: " .. form.name .. " -> " .. form.file .. " (" .. #pieces .. " pieces)")
				return form.name
			end

			-- console: ChainDump() lists what was captured from every CHAIN model (per limb) and what was skipped, so a
			-- missing piece can be tracked down
			function Chain.dump()
				if not Chain.models or #Chain.models == 0 then Chain.scan() end
				for _, m in ipairs(Chain.models or {}) do
					local pieces, extra = Chain.gather(m)
					print(string.format("[ChainDump] %s: %d pieces captured", m:GetFullName(), #pieces))
					local got = {}
					for _, p in ipairs(pieces) do
						got[p.src] = true
						print(string.format("  + [%s] %s (%s)%s", p.limb, p.src:GetFullName(), p.src.ClassName,
							Chain.entryOf(p) and "" or "  <- only while CHAIN is loaded (cannot be saved to a file)"))
					end
					local shown = 0
					for _, d in ipairs(m:GetDescendants()) do
						if d:IsA("BasePart") and not got[d] and d.Name ~= "HumanoidRootPart" then
							shown = shown + 1
							if shown <= 60 then
								print(string.format("  - skipped %s (%s) transparency %.2f", d:GetFullName(), d.ClassName, d.Transparency))
							end
						end
					end
					if shown > 60 then print("  - ... and " .. (shown - 60) .. " more skipped parts") end
					for limbName, t in pairs(extra.colors) do
						print(string.format("  color %s = %.3f, %.3f, %.3f", limbName, t[1], t[2], t[3]))
					end
					for k, c in pairs(extra.clothes) do print("  " .. k .. " = " .. c.tmpl) end
				end
			end
			-- finds every loaded CHAIN model; saves + registers each look that has not been seen yet
			function Chain.scan()
				local newNames = {}
				Chain.models = {}
				for _, root in ipairs({ workspace, ReplicatedStorage }) do
					for _, d in ipairs(root:GetDescendants()) do
						if d:IsA("Model") and d.Name:lower():sub(1, 5) == "chain" and d:FindFirstChild("Torso") then
							Chain.models[#Chain.models + 1] = d
						end
					end
				end
				for _, m in ipairs(Chain.models) do
					local n = Chain.check(m)
					if n then newNames[#newNames + 1] = n end
				end
				Chain.lastScan = os.clock()
				return newNames
			end

			-- called when you click a CHAIN button; returns true when that form is ready
			function Chain.ensure(morph, setStatus)
				local hats = morph:FindFirstChild("Hats")
				if not hats then return false end
				if Chain.building then return false end
				Chain.building = true
				local ok, res = pcall(function()
					if #hats:GetChildren() == 0 or os.clock() - Chain.lastScan > 10 then
						setStatus("Looking for CHAIN...")
						local newNames = Chain.scan()
						if #newNames > 0 then
							setStatus("Saved: " .. table.concat(newNames, ", "))
						end
					end
					if #hats:GetChildren() == 0 then
						local form = Chain.forms[morph.Name]
						local entries, data
						if form then entries, data = Chain.load(form.file) end
						if entries then
							setStatus("Rebuilding from " .. form.file .. "...")
							Chain.fromData(entries, hats, data, morph)
						end
					end
					return #hats:GetChildren() > 0
				end)
				Chain.building = false
				if not ok then warn("[ChainMorph] " .. tostring(res)) return false end
				return res == true
			end

			Chain.loadIndex()
			env.ChainDump = function() local ok, err = pcall(Chain.dump) if not ok then warn("[ChainDump] " .. tostring(err)) end end

			-- background watcher: once CHAIN models have been seen, re-check them every 3s so a look change
			-- (new textures, glow, enrage...) is saved and named automatically, without clicking anything
			task.spawn(function()
				while alive do
					task.wait(3)
					local list = Chain.models
					if list and #list > 0 then
						for _, m in ipairs(list) do
							if m.Parent then
								local ok, err = pcall(Chain.check, m)
								if not ok then warn("[ChainMorph] watcher: " .. tostring(err)) end
							end
						end
					end
				end
			end)

			local function findHats(morph)
				for _, c in ipairs(morph:GetChildren()) do
					if c.Name:lower():gsub("%s", "") == "hats" then
						return c
					end
				end
				for _, c in ipairs(morph:GetDescendants()) do
					if c.Name:lower():gsub("%s", "") == "hats" then
						return c
					end
				end
				for _, c in ipairs(morph:GetChildren()) do
					if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") then
						return morph
					end
				end
				return nil
			end

			----------------------------------------------------------------
			-- Settings
			----------------------------------------------------------------
			local DEBUG = false           -- prints what the game changed / what got fixed (leaks console memory when on)
			local WATCHDOG_INTERVAL = 1.5 -- seconds between safety-net checks
			-- false = the game may make your morph transparent (first-person executions, invisibility, fades).
			-- true  = the look lock also forces Transparency back (this is what blocked your view in v4)
			local LOCK_TRANSPARENCY = false

			----------------------------------------------------------------
			-- State
			----------------------------------------------------------------
			local TAG = "MG_Added" -- attribute put on everything this GUI adds to the character

			alive = true
			local conns = {}      -- script-wide connections (disconnected on unload)
			local charConns = {}  -- connections to the current character

			local snapshot = nil
			local snapshotBC = nil      -- original BodyColors instance (if any)
			local snapshotColors = nil  -- original per-part colors

			local currentMorph = nil
			local currentMorphObj = nil
			local currentHatsOverride = nil
			local plan = {}             -- list of source items that SHOULD be on the character
			local planColors = nil      -- BodyColors the morph wants (or nil)

			local hideHead = false
			local autoRefresh = true
			local lockLookOn = true
			local thirdPerson = false
			local origCam = nil

			local busy = false          -- lock so full operations never overlap (they can yield)
			local charGen = 0           -- increments every respawn, lets stale tasks bail out
			local ready = true          -- false while a respawn is still loading its outfit

			local createdBy = setmetatable({}, { __mode = "k" })  -- [item on character] = source item it was built from
			local released = setmetatable({}, { __mode = "k" })   -- items WE removed on purpose
			local unattached = setmetatable({}, { __mode = "k" }) -- accessories that could not be welded at all
			local knownDesc = setmetatable({}, { __mode = "k" })  -- every descendant that was part of a piece when WE built it
			local dirtyPieces = setmetatable({}, { __mode = "k" })-- pieces whose parts were destroyed / swapped by the game
			local looks = {}                                      -- [piece] = list of { instance, property, expectedValue, rebuildOnly }
			local bodyLook = {}                                   -- list of { bodyPart, property, expectedValue }
			local lookWarned = {}
			local lookFixes = 0
			local curStats = nil
			local lastStats = nil

			----------------------------------------------------------------
			-- BODY: body scales ("body type"), limbs (CharacterMesh) and clothes that sit outside the Hats folder.
			-- One table on purpose (this function is close to the local-variable limit).
			----------------------------------------------------------------
			local Body = { snap = nil, plan = nil, limbs = false, changed = false, warnedR15 = false }
			Body.NAMES = { "BodyTypeScale", "BodyProportionScale", "BodyWidthScale", "BodyHeightScale", "BodyDepthScale", "HeadScale" }
			Body.SET = {}
			for _, n in ipairs(Body.NAMES) do Body.SET[n] = true end
			-- HumanoidDescription property -> Humanoid scale value
			Body.DESC = {
				BodyTypeScale = "BodyTypeScale", ProportionScale = "BodyProportionScale", WidthScale = "BodyWidthScale",
				HeightScale = "BodyHeightScale", DepthScale = "BodyDepthScale", HeadScale = "HeadScale",
			}
			Body.LIMBS = { "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg" }
			-- BODY BUNDLES (v45): state
			Body.hide = nil        -- set of R6 limb names hidden because a bundle's R15 meshes are drawn over them
			Body.hidden = false    -- true while we have hidden something (so reconcile skips the work when nothing is hidden)
			Body.guards = {}       -- limb part -> Changed connection that keeps it hidden if the game resets it
			Body.orig = nil        -- your own HumanoidDescription (R15 characters only), put back on reset
			Body.ACCESSORIES = true -- bring the bundle's hair / hats along too
			Body.R6NAMES = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }
			Body.BODYPART = { Head = "Head", Torso = "Torso", LeftArm = "Left Arm", RightArm = "Right Arm", LeftLeg = "Left Leg", RightLeg = "Right Leg" }
			-- which R6 limb each R15 part follows
			Body.R15MAP = {
				Head = "Head", UpperTorso = "Torso", LowerTorso = "Torso",
				LeftUpperArm = "Left Arm", LeftLowerArm = "Left Arm", LeftHand = "Left Arm",
				RightUpperArm = "Right Arm", RightLowerArm = "Right Arm", RightHand = "Right Arm",
				LeftUpperLeg = "Left Leg", LeftLowerLeg = "Left Leg", LeftFoot = "Left Leg",
				RightUpperLeg = "Right Leg", RightLowerLeg = "Right Leg", RightFoot = "Right Leg",
			}
			-- where each R6 limb rests relative to the HumanoidRootPart
			Body.R6REST = {
				["Head"] = CFrame.new(0, 1.5, 0), ["Torso"] = CFrame.new(0, 0, 0),
				["Left Arm"] = CFrame.new(-1.5, 0, 0), ["Right Arm"] = CFrame.new(1.5, 0, 0),
				["Left Leg"] = CFrame.new(-0.5, -2, 0), ["Right Leg"] = CFrame.new(0.5, -2, 0),
			}

			-- remembers YOUR scales (called with the outfit snapshot, before any morph touches them)
			function Body.snapshot(char)
				local hum = char:FindFirstChildOfClass("Humanoid")
				local t = {}
				if hum then
					for _, n in ipairs(Body.NAMES) do
						local v = hum:FindFirstChild(n)
						t[n] = (v and v:IsA("NumberValue")) and v.Value or false
					end
				end
				Body.snap = t
			end

			-- downloads a catalog asset and returns the instances of one class inside it (Shirt / Pants / ShirtGraphic / CharacterMesh)
			function Body.load(id, class)
				local roots
				local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
				if ok and type(res) == "table" and #res > 0 then
					roots = res
				else
					local ok2, model = pcall(function() return game:GetService("InsertService"):LoadAsset(id) end)
					if ok2 and model then roots = model:GetChildren() end
				end
				local out = {}
				if not roots then return out end
				for _, o in ipairs(roots) do
					if o:IsA(class) then out[#out + 1] = o end
					for _, d in ipairs(o:GetDescendants()) do
						if d:IsA(class) then out[#out + 1] = d end
					end
				end
				return out
			end

			----------------------------------------------------------------
			-- BODY BUNDLES: catalog bundle -> HumanoidDescription -> morph source (Folder)
			----------------------------------------------------------------
			-- GET a Roblox catalog path (executor request first, HttpGet second; roblox.com first, roproxy as a fallback host)
			function Body.http(path)
				local req = (syn and syn.request) or http_request or request
				local lastErr = "no response"
				for _, host in ipairs({ "https://catalog.roblox.com", "https://catalog.roproxy.com" }) do
					local url = host .. path
					local ok, body = pcall(function()
						if req then
							local r = req({ Url = url, Method = "GET" })
							if r and (r.Success or r.StatusCode == 200) and r.Body then return r.Body end
							error("HTTP " .. tostring(r and r.StatusCode))
						end
						return game:HttpGet(url)
					end)
					if ok and type(body) == "string" then
						local okJ, data = pcall(HttpService.JSONDecode, HttpService, body)
						if okJ and type(data) == "table" then return data end
						lastErr = "bad answer"
					else
						lastErr = tostring(body)
					end
				end
				return nil, lastErr
			end

			-- bundle search by name -> { { id =, name = }, ... } (bundles only)
			function Body.searchBundles(keyword)
				local q = HttpService:UrlEncode(keyword)
				local out, lastErr = {}, nil
				for _, kw in ipairs({ q, q .. "%20bundle" }) do
					local data, err = Body.http("/v1/search/items/details?Keyword=" .. kw .. "&Limit=30")
					lastErr = err
					if data and type(data.data) == "table" then
						for _, it in ipairs(data.data) do
							if it.itemType == "Bundle" and (it.bundleType == nil or it.bundleType == 1) and #out < 8 then
								out[#out + 1] = { id = it.id, name = tostring(it.name or it.id) }
							end
						end
					end
					if #out > 0 then break end
				end
				return out, lastErr
			end

			-- bundle details (name + item list)
			function Body.fetchBundle(id)
				local data, err = Body.http("/v1/bundles/" .. tostring(id) .. "/details")
				if not (data and type(data.items) == "table") then return nil, err or "bundle not found" end
				return data
			end

			-- the bundle's own outfit is a ready-made HumanoidDescription; if it has none, build one from its body-part assets
			function Body.bundleDescription(data)
				for _, it in ipairs(data.items) do
					if it.type == "UserOutfit" then
						local ok, desc = pcall(function() return Players:GetHumanoidDescriptionFromOutfitId(it.id) end)
						if ok and desc then return desc end
					end
				end
				local PROP = { [17] = "Head", [18] = "Face", [27] = "Torso", [28] = "RightArm", [29] = "LeftArm", [30] = "LeftLeg", [31] = "RightLeg" }
				local MPS = game:GetService("MarketplaceService")
				local desc, any = Instance.new("HumanoidDescription"), false
				for _, it in ipairs(data.items) do
					if it.type == "Asset" then
						local ok, info = pcall(function() return MPS:GetProductInfo(it.id) end)
						local prop = ok and info and PROP[info.AssetTypeId]
						if prop then
							desc[prop] = it.id
							any = true
						end
					end
				end
				if any then return desc end
				desc:Destroy()
				return nil
			end

			-- Turns a bundle's HumanoidDescription into a morph source. Can yield (downloads), so call it from a task.
			--  * R6 limb meshes (CharacterMesh) in the bundle's assets are used as they are (they animate and take clothes like normal limbs).
			--  * Limbs that only exist as R15 meshes (Super Hero and most newer bundles) are built from an R15 rig made out of the
			--    description: every R15 mesh is welded to the matching R6 limb (shifted so the feet touch the ground) and the real
			--    limb is hidden. Clothes do not draw on these meshes, the bundle's own textures do.
			--  * R15 characters just get the description applied (Body.applyDesc).
			function Body.makeBundle(desc, name, r6)
				local container = Instance.new("Folder")
				container.Name = name
				container:SetAttribute("MG_Bundle", true)
				desc.Parent = container -- Body.gather reads scales / shirt / pants from it
				if not r6 then return container end

				local defined = {
					["Head"] = desc.Head, ["Torso"] = desc.Torso, ["Left Arm"] = desc.LeftArm,
					["Right Arm"] = desc.RightArm, ["Left Leg"] = desc.LeftLeg, ["Right Leg"] = desc.RightLeg,
				}
				local haveMesh = {}
				for _, id in pairs(defined) do
					if type(id) == "number" and id > 0 then
						for _, cm in ipairs(Body.load(id, "CharacterMesh")) do
							local limb = Body.BODYPART[cm.BodyPart.Name]
							if limb and not haveMesh[limb] then
								haveMesh[limb] = true
								cm.Parent = container
							end
						end
					end
				end

				local okR, rig = pcall(function()
					return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
				end)
				if not (okR and rig) then
					warn("[MorphGui] couldn't build the R15 body of '" .. name .. "': " .. tostring(rig))
					return container
				end
				local hrp = rig:FindFirstChild("HumanoidRootPart")
				if not hrp then
					rig:Destroy()
					return container
				end

				local list, lowest = {}, math.huge
				for partName, limb in pairs(Body.R15MAP) do
					local part = rig:FindFirstChild(partName)
					if part and part:IsA("BasePart") and type(defined[limb]) == "number" and defined[limb] > 0 and not haveMesh[limb] then
						local rel = hrp.CFrame:ToObjectSpace(part.CFrame)
						list[#list + 1] = { part, limb, rel }
						if limb:find("Leg") then lowest = math.min(lowest, rel.Position.Y - part.Size.Y / 2) end
					end
				end
				-- R6 feet are 3 studs under the root; a taller / shorter bundle body is shifted so its feet land there
				local dy = lowest < math.huge and math.clamp(-3 - lowest, -2, 4) or 0

				local hideSet, hideList = {}, {}
				for _, e in ipairs(list) do
					local part, limb, rel = e[1], e[2], e[3]
					local acc = Instance.new("Accessory")
					acc.Name = "MG_" .. part.Name
					local h = part:Clone()
					h.Name = "Handle"
					for _, d in ipairs(h:GetChildren()) do
						if d:IsA("Attachment") or d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("LuaSourceContainer") or d:IsA("FaceControls") then
							d:Destroy()
						end
					end
					h.Anchored, h.CanCollide, h.Massless, h.CanTouch = false, false, true, false
					h.Parent = acc
					acc:SetAttribute("MG_Limb", limb)
					acc:SetAttribute("MG_Off", Body.R6REST[limb]:Inverse() * (rel + Vector3.new(0, dy, 0)))
					acc.Parent = container
					if not hideSet[limb] then
						hideSet[limb] = true
						hideList[#hideList + 1] = limb
					end
				end
				container:SetAttribute("MG_Limbs", table.concat(hideList, ","))

				if Body.ACCESSORIES then
					for _, a in ipairs(rig:GetChildren()) do
						if a:IsA("Accessory") then a.Parent = container end
					end
				end
				rig:Destroy()
				return container
			end

			-- R15 characters: apply the bundle's description to your body (put back on reset). Best effort, needs ApplyDescription to work client side.
			function Body.applyDesc(hum, morph)
				if not hum or hum.RigType ~= Enum.HumanoidRigType.R15 then return end
				if not (morph and morph:GetAttribute("MG_Bundle")) then
					if Body.orig then task.spawn(Body.restoreDesc, hum) end -- switched from a bundle to a normal morph: put your body back
					return
				end
				local desc = morph:FindFirstChildOfClass("HumanoidDescription")
				if not desc then return end
				if not Body.orig then
					local okO, o = pcall(hum.GetAppliedDescription, hum)
					if okO then Body.orig = o end
				end
				local ok, err = pcall(hum.ApplyDescription, hum, desc)
				if not ok then warn("[MorphGui] couldn't apply the bundle to your R15 body: " .. tostring(err)) end
			end

			function Body.restoreDesc(hum)
				local o = Body.orig
				Body.orig = nil
				if o and hum and hum.Parent then pcall(hum.ApplyDescription, hum, o) end
			end

			-- Looks through a whole morph (not only its Hats folder). Adds the clothes / limbs it finds to `leaves`
			-- (the Hats folder wins when both have a Shirt / Pants / T-shirt, or a mesh for the same limb) and returns the body scales
			-- the morph asks for (or nil). Can yield (HumanoidDescription items are downloaded), so it runs inside doMorph only.
			function Body.gather(morph, hats, leaves, hum)
				local scales, any = {}, false
				local function put(name, v)
					if Body.SET[name] and type(v) == "number" and v == v then
						scales[name] = v
						any = true
					end
				end
				local descs, found = {}, {}
				local function inAccessory(d)
					local p = d.Parent
					while p and p ~= morph do
						if p:IsA("Accoutrement") then return true end
						p = p.Parent
					end
					return false
				end
				local function visit(d)
					if d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("CharacterMesh") then
						if not inAccessory(d) then found[#found + 1] = d end
					elseif d:IsA("NumberValue") then
						put(d.Name, d.Value)
					elseif d:IsA("HumanoidDescription") then
						descs[#descs + 1] = d
					end
					for _, n in ipairs(Body.NAMES) do
						local a = d:GetAttribute(n)
						if a ~= nil then put(n, a) end
					end
				end
				visit(morph)
				for _, d in ipairs(morph:GetDescendants()) do visit(d) end

				local seen, haveClass, haveMesh = {}, {}, {}
				local function note(l)
					seen[l] = true
					if l:IsA("CharacterMesh") then haveMesh[l.BodyPart] = true else haveClass[l.ClassName] = true end
				end
				for _, l in ipairs(leaves) do note(l) end
				for _, d in ipairs(found) do
					if not seen[d] then
						local dup
						if d:IsA("CharacterMesh") then dup = haveMesh[d.BodyPart] else dup = haveClass[d.ClassName] end
						if not dup then
							leaves[#leaves + 1] = d
							note(d)
						end
					end
				end

				local r6 = hum ~= nil and hum.RigType == Enum.HumanoidRigType.R6
				for _, desc in ipairs(descs) do
					for dn, sn in pairs(Body.DESC) do
						local ok, v = pcall(function() return desc[dn] end)
						if ok then put(sn, v) end
					end
					local function wear(class, id)
						if type(id) ~= "number" or id <= 0 or haveClass[class] then return end
						local items = Body.load(id, class)
						if items[1] then
							leaves[#leaves + 1] = items[1]
							note(items[1])
						end
					end
					wear("Shirt", desc.Shirt)
					wear("Pants", desc.Pants)
					wear("ShirtGraphic", desc.GraphicTShirt)
					for _, prop in ipairs(Body.LIMBS) do
						local id = desc[prop]
						if type(id) == "number" and id > 0 then
							if r6 then
								for _, cm in ipairs(Body.load(id, "CharacterMesh")) do
									if not haveMesh[cm.BodyPart] then
										leaves[#leaves + 1] = cm
										note(cm)
									end
								end
							elseif not Body.warnedR15 then
								Body.warnedR15 = true
								warn("[MorphGui] this morph has custom limb meshes, but your character is R15: limb meshes can't be swapped there (clothes and body scales still apply)")
							end
						end
					end
				end

				Body.limbs = false
				for _, l in ipairs(leaves) do
					if l:IsA("CharacterMesh") then Body.limbs = true break end
				end
				return any and scales or nil
			end

			-- puts the morph's scales on the Humanoid (scales the morph does not set go back to yours; no morph = all back to yours).
			-- returns true if something had to be changed
			function Body.apply(hum)
				if not (hum and hum.Parent) then return false end
				local want, snap = Body.plan, Body.snap
				if not want and not Body.changed then return false end
				local changed = false
				for _, n in ipairs(Body.NAMES) do
					local target = want and want[n]
					if target == nil and snap and type(snap[n]) == "number" then target = snap[n] end
					if target ~= nil then
						local v = hum:FindFirstChild(n)
						if v and v:IsA("NumberValue") then
							if math.abs(v.Value - target) > 1e-4 then
								v.Value = target
								changed = true
							end
						elseif want and want[n] ~= nil and hum.RigType == Enum.HumanoidRigType.R15 then
							local nv = Instance.new("NumberValue")
							nv.Name = n
							nv.Value = target
							nv.Parent = hum
							changed = true
						end
					end
				end
				Body.changed = want ~= nil
				return changed
			end

			-- console: MorphDump()
			function Body.dump()
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				print("[MorphDump] morph: " .. tostring(currentMorph) .. " | rig: " .. (hum and tostring(hum.RigType) or "?"))
				local counts, parts = {}, {}
				for _, s in ipairs(plan) do counts[s.ClassName] = (counts[s.ClassName] or 0) + 1 end
				for k, v in pairs(counts) do parts[#parts + 1] = k .. " x" .. v end
				print("[MorphDump] plan: " .. (#parts > 0 and table.concat(parts, ", ") or "(empty)"))
				for _, n in ipairs(Body.NAMES) do
					local v = hum and hum:FindFirstChild(n)
					local want = Body.plan and Body.plan[n]
					print(string.format("[MorphDump] %s: now %s | morph wants %s | yours %s", n,
						v and tostring(v.Value) or "(none)", want ~= nil and tostring(want) or "-",
						Body.snap and tostring(Body.snap[n]) or "-"))
				end
				if char then
					for _, v in ipairs(char:GetChildren()) do
						if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("CharacterMesh") then
							print("[MorphDump] on character: " .. v.ClassName .. " '" .. v.Name .. "'" .. (v:GetAttribute(TAG) and " (morph)" or " (game)"))
						end
					end
				end
			end
			-- the structure of the active morph + what your limb parts look like (to see what a morph really contains)
			function Body.tree()
				local lines = 0
				local function walk(o, depth)
					for _, c in ipairs(o:GetChildren()) do
						lines += 1
						if lines > 90 then return end
						local n = #c:GetChildren()
						print("[MorphDump] " .. string.rep("  ", depth) .. c.ClassName .. " '" .. c.Name .. "'" .. (n > 0 and (" (" .. n .. " children)") or ""))
						if depth < 2 then walk(c, depth + 1) end
					end
				end
				if currentMorphObj then
					print("[MorphDump] morph source '" .. currentMorphObj.Name .. "':")
					walk(currentMorphObj, 1)
				end
				local char = player.Character
				if char then
					for _, v in ipairs(char:GetChildren()) do
						if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
							local kids = {}
							for _, k in ipairs(v:GetChildren()) do
								if k:IsA("SpecialMesh") or k:IsA("SurfaceAppearance") or k:IsA("Decal") or k:IsA("Texture") then kids[#kids + 1] = k.ClassName end
							end
							print("[MorphDump] limb " .. v.Name .. ": " .. v.ClassName .. (#kids > 0 and (" + " .. table.concat(kids, ", ")) or ""))
						elseif v:IsA("CharacterMesh") then
							print("[MorphDump] CharacterMesh " .. tostring(v.BodyPart) .. " mesh=" .. tostring(v.MeshId) .. (v:GetAttribute(TAG) and " (morph)" or " (game)"))
						end
					end
				end
			end
			env.MorphDump = function() Body.dump() Body.tree() end

			local statusLabel
			local gui

			local function connect(signal, fn)
				local c = signal:Connect(fn)
				conns[#conns + 1] = c
				return c
			end

			local function setStatus(text)
				if statusLabel then
					statusLabel.Text = text
				end
			end

			-- removes one of OUR pieces on purpose (so nothing tries to "restore" it)
			local function dropPiece(inst)
				released[inst] = true
				looks[inst] = nil
				dirtyPieces[inst] = nil
				pcall(function() inst:Destroy() end)
			end

			----------------------------------------------------------------
			-- Look lock bookkeeping
			----------------------------------------------------------------
			local LOOK_PROPS = {
				{ "BasePart", { "Color", "Material", "Transparency", "Reflectance" } },
				{ "MeshPart", { "TextureID", "MeshId" } },
				{ "SpecialMesh", { "TextureId", "MeshId", "VertexColor" } },
				{ "Decal", { "Color3", "Transparency", "Texture" } }, -- also covers Texture
				{ "SurfaceAppearance", { "ColorMap", "NormalMap", "MetalnessMap", "RoughnessMap", "Color" } },
			}

			-- game effects that get removed if they appear INSIDE one of our pieces
			local OVERLAY = {
				Highlight = true, SurfaceAppearance = true, Decal = true, Texture = true,
				ParticleEmitter = true, Fire = true, Smoke = true, Sparkles = true, Trail = true, Beam = true,
				PointLight = true, SpotLight = true, SurfaceLight = true, SpecialMesh = true,
				BillboardGui = true, SurfaceGui = true,
			}

			local function warnLook(inst, prop, cur)
				if not DEBUG then return end
				local key = inst.Name .. "." .. prop
				if lookWarned[key] then return end
				lookWarned[key] = true
				print("[MorphGui] game changed " .. inst:GetFullName() .. "." .. prop .. " to " .. tostring(cur) .. ", putting it back")
			end

			-- records how a freshly built piece looks (called BEFORE it is parented to the character)
			local function recordLook(piece)
				local rec = {}
				local function visit(d)
					knownDesc[d] = true
					for _, entry in ipairs(LOOK_PROPS) do
						if d:IsA(entry[1]) then
							for _, prop in ipairs(entry[2]) do
								local ok, v = pcall(function() return d[prop] end)
								if ok then
									-- MeshPart.MeshId can't be assigned by scripts: if it changes, the piece is rebuilt instead
									rec[#rec + 1] = { d, prop, v, entry[1] == "MeshPart" and prop == "MeshId" }
								end
							end
						end
					end
				end
				visit(piece)
				for _, d in ipairs(piece:GetDescendants()) do
					visit(d)
				end
				looks[piece] = rec
			end

			local function recordBody(char)
				table.clear(bodyLook)
				for _, v in ipairs(char:GetChildren()) do
					if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
						bodyLook[#bodyLook + 1] = { v, "Color", v.Color }
						bodyLook[#bodyLook + 1] = { v, "Material", v.Material }
					end
				end
			end

			-- body colors take a moment to apply, so record them shortly after any color change
			local bodyPending = false
			local function scheduleRecordBody()
				if bodyPending then return end
				bodyPending = true
				local gen = charGen
				task.delay(0.4, function()
					bodyPending = false
					if not alive or gen ~= charGen or not currentMorphObj then return end
					local char = player.Character
					if char then recordBody(char) end
				end)
			end

			----------------------------------------------------------------
			-- Character helpers
			----------------------------------------------------------------
			local function getCharacter()
				local char = player.Character or player.CharacterAdded:Wait()
				local hum = char:WaitForChild("Humanoid")
				return char, hum
			end

			local function isOutfitItem(v)
				return v:IsA("Accoutrement") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("CharacterMesh")
			end

			local function takeSnapshot(char)
				local items = {}
				for _, v in ipairs(char:GetChildren()) do
					if isOutfitItem(v) and not v:GetAttribute(TAG) then
						table.insert(items, v:Clone())
					end
				end
				snapshot = items
				pcall(Body.snapshot, char)

				local bc = char:FindFirstChildOfClass("BodyColors")
				snapshotBC = (bc and not bc:GetAttribute(TAG)) and bc:Clone() or nil

				snapshotColors = {}
				for _, v in ipairs(char:GetChildren()) do
					if v:IsA("BasePart") then
						snapshotColors[v.Name] = v.Color
					end
				end
			end

			local function setBodyColors(char, bc)
				table.clear(bodyLook) -- old expectations would fight the new colors
				local old = char:FindFirstChildOfClass("BodyColors")
				if old then old:Destroy() end
				if bc then
					local c = bc:Clone()
					c:SetAttribute(TAG, true)
					c.Parent = char
				end
				scheduleRecordBody()
			end

			local function restoreOriginalColors(char)
				table.clear(bodyLook)
				setBodyColors(char, snapshotBC)
				if snapshotColors then
					for name, color in pairs(snapshotColors) do
						local part = char:FindFirstChild(name)
						if part and part:IsA("BasePart") then
							part.Color = color
						end
					end
				end
				scheduleRecordBody()
			end

			local function sameColors(a, b)
				return a.HeadColor3 == b.HeadColor3 and a.TorsoColor3 == b.TorsoColor3
					and a.LeftArmColor3 == b.LeftArmColor3 and a.RightArmColor3 == b.RightArmColor3
					and a.LeftLegColor3 == b.LeftLegColor3 and a.RightLegColor3 == b.RightLegColor3
			end

			-- is this instance part of something this GUI added (walks up to the character's direct child)
			local function isOurs(d, char)
				local top = d
				while top.Parent and top.Parent ~= char do
					top = top.Parent
				end
				return top:GetAttribute(TAG) == true
			end

			----------------------------------------------------------------
			-- Hide face / head
			----------------------------------------------------------------
			local mgCache = setmetatable({}, { __mode = "k" }) -- inst -> true while hidden by the Hide Face & Head toggle
			local function isMgHidden(inst)
				local v = mgCache[inst]
				if v == nil then
					v = inst:GetAttribute("MG_T") ~= nil
					mgCache[inst] = v
				end
				return v
			end

			local function setHidden(obj, hide)
				if hide then
					if obj:GetAttribute("MG_T") == nil then
						obj:SetAttribute("MG_T", obj.Transparency)
					end
					mgCache[obj] = true
					obj.Transparency = 1
				else
					local orig = obj:GetAttribute("MG_T")
					if orig ~= nil then
						obj.Transparency = orig
						obj:SetAttribute("MG_T", nil)
					end
					mgCache[obj] = false
				end
			end

			local function hideVisuals(root, hide)
				for _, d in ipairs(root:GetDescendants()) do
					if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
						setHidden(d, hide)
					end
				end
				if root:IsA("BasePart") then
					setHidden(root, hide)
				end
			end

			local function isFaceItem(item)
				if item:IsA("Accessory") then
					if item.AccessoryType == Enum.AccessoryType.Face then
						return true
					end
					local handle = item:FindFirstChild("Handle")
					if handle then
						for _, a in ipairs(handle:GetChildren()) do
							if a:IsA("Attachment") and a.Name:find("^Face") then
								return true
							end
						end
					end
				end
				return item.Name:lower():find("face") ~= nil
			end

			-- true while the active morph asks for no face (all CHAIN forms do)
			local function hideBodyNow()
				return currentMorphObj ~= nil and currentMorphObj:GetAttribute("HideFace") == true
			end

			local function applyHeadState()
				local char = player.Character
				if not char then return end

				local faceHide = hideBodyNow()
				local hide = (hideHead and currentMorph ~= nil) or (Body.hide ~= nil and Body.hide["Head"] == true)

				local head = char:FindFirstChild("Head")
				if head and head:IsA("BasePart") then
					-- the head part itself + every decal/texture (the face) on it
					setHidden(head, hide)
					for _, d in ipairs(head:GetDescendants()) do
						if d:IsA("Decal") or d:IsA("Texture") then
							setHidden(d, hide or faceHide) -- the face stays off, the head itself stays visible (black)
						elseif d:IsA("BasePart") then
							setHidden(d, hide)
						end
					end
				end

				-- face accessories / face models, including any decals inside them
				for _, item in ipairs(char:GetChildren()) do
					if (item:IsA("Accessory") or item:IsA("Model")) and isFaceItem(item) then
						hideVisuals(item, hide or faceHide)
					end
				end
			end

			local headPending = false
			local function scheduleHeadState()
				if headPending then return end
				headPending = true
				task.delay(0.1, function()
					headPending = false
					if alive and (hideHead or hideBodyNow()) and currentMorph then
						applyHeadState()
					end
				end)
			end

			-- which R6 limbs the active bundle replaces (read from the morph source)
			function Body.setHide(morph)
				local list = morph and morph:GetAttribute("MG_Limbs")
				if type(list) == "string" and list ~= "" then
					local set = {}
					for n in list:gmatch("[^,]+") do set[n] = true end
					Body.hide = set
				else
					Body.hide = nil
				end
			end

			-- hides the limbs a bundle replaces (event based: a Changed guard puts it back if the game resets Transparency), shows the rest again
			function Body.syncLimbs(char)
				if not Body.hide and not Body.hidden then return end
				local want = Body.hide
				for limb, c in pairs(Body.guards) do
					if not (want and want[limb.Name] and limb.Parent == char) then
						c:Disconnect()
						Body.guards[limb] = nil
					end
				end
				for _, name in ipairs(Body.R6NAMES) do
					local limb = char:FindFirstChild(name)
					if limb and limb:IsA("BasePart") then
						if want and want[name] then
							if name ~= "Head" then setHidden(limb, true) end -- the head is handled by applyHeadState (it also hides the face)
							if not Body.guards[limb] then
								Body.guards[limb] = limb:GetPropertyChangedSignal("Transparency"):Connect(function()
									if limb.Transparency ~= 1 and Body.hide and Body.hide[name] then limb.Transparency = 1 end
								end)
							end
						elseif name ~= "Head" and limb:GetAttribute("MG_T") ~= nil then
							setHidden(limb, false)
						end
					end
				end
				Body.hidden = want ~= nil
				applyHeadState()
			end

			----------------------------------------------------------------
			-- Building ONE piece (every piece we add is tagged and registered in createdBy)
			----------------------------------------------------------------
			local function prepParts(root)
				for _, p in ipairs(root:GetDescendants()) do
					if p:IsA("BasePart") then
						p.Anchored = false
						p.CanCollide = false
						p.Massless = true
					end
				end
			end

			-- welds the accessory to the matching attachment on the character (the method that worked in the old version)
			local function attachAccessory(acc, char)
				local handle = acc:FindFirstChild("Handle")
				if not handle or not handle:IsA("BasePart") then
					unattached[acc] = true
					if curStats then curStats.failed += 1 end
					warn("[MorphGui] accessory '" .. acc.Name .. "' has no Handle part, can't attach it")
					return false
				end

				-- drop stale welds copied along with the item
				for _, d in ipairs(handle:GetChildren()) do
					if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("ManualWeld") then
						if not (d.Part1 and d.Part1:IsDescendantOf(acc)) then
							d:Destroy()
						end
					end
				end

				-- bundle body part: welded straight to the R6 limb it replaces (offset stored by Body.makeBundle)
				local limbName = acc:GetAttribute("MG_Limb")
				if limbName then
					local limb = char:FindFirstChild(limbName)
					local off = acc:GetAttribute("MG_Off")
					if limb and limb:IsA("BasePart") and typeof(off) == "CFrame" then
						local w = Instance.new("Weld")
						w.Name = "AccessoryWeld"
						w.Part0 = handle
						w.Part1 = limb
						w.C1 = off
						handle.CFrame = limb.CFrame * off
						w.Parent = handle
						return true
					end
				end

				local weld = Instance.new("Weld")
				weld.Name = "AccessoryWeld"
				weld.Part0 = handle

				local function finish(part1)
					weld.Part1 = part1
					handle.CFrame = part1.CFrame * weld.C1 * weld.C0:Inverse()
					weld.Parent = handle
				end

				for _, att in ipairs(handle:GetChildren()) do
					if att:IsA("Attachment") then
						for _, bodyPart in ipairs(char:GetChildren()) do
							if bodyPart:IsA("BasePart") then
								local target = bodyPart:FindFirstChild(att.Name)
								if target and target:IsA("Attachment") then
									weld.C0 = att.CFrame
									weld.C1 = target.CFrame
									finish(bodyPart)
									return true
								end
							end
						end
					end
				end

				local head = char:FindFirstChild("Head")
				if head then
					weld.C0 = acc.AttachmentPoint
					weld.C1 = CFrame.new(0, head.Size.Y / 2, 0)
					finish(head)
					warn("[MorphGui] '" .. acc.Name .. "' has no matching attachment on your character, placed on head")
					return true
				end

				unattached[acc] = true
				if curStats then curStats.failed += 1 end
				return false
			end

			local function buildAccessory(template, src, char)
				local acc = template:Clone()
				acc:SetAttribute(TAG, true)
				createdBy[acc] = src
				prepParts(acc)

				if not acc:FindFirstChild("Handle") then
					-- main part isn't called "Handle": use the first part inside the accessory
					local part = acc:FindFirstChildWhichIsA("BasePart")
					if part then
						part.Name = "Handle"
					end
				end

				attachAccessory(acc, char)
				recordLook(acc) -- remember the pristine look BEFORE the game can touch it
				acc.Parent = char
				return acc
			end

			local function attachModel(model, char)
				local clone = model:Clone()
				local root = clone.PrimaryPart or clone:FindFirstChildWhichIsA("BasePart", true)
				local head = char:FindFirstChild("Head")
				if not root or not head then
					clone:Destroy()
					return nil
				end
				for _, p in ipairs(clone:GetDescendants()) do
					if p:IsA("BasePart") then
						p.Anchored = false
						p.CanCollide = false
						p.Massless = true
						if p ~= root then
							local wc = Instance.new("WeldConstraint")
							wc.Part0 = root
							wc.Part1 = p
							wc.Parent = p
						end
					end
				end
				clone:SetAttribute(TAG, true)
				createdBy[clone] = model
				recordLook(clone)
				clone.Parent = char
				local w = Instance.new("Weld")
				w.Part0 = head
				w.Part1 = root
				w.C0 = CFrame.new(0, head.Size.Y / 2 + root.Size.Y / 2, 0)
				w.Parent = root
				return clone
			end

			-- builds exactly one instance on the character for one source item; returns it (or nil)
			local function buildLeaf(src, char)
				if src:IsA("Accoutrement") then
					return buildAccessory(src, src, char)
				elseif src:IsA("BasePart") then
					local tmpl = Instance.new("Accessory")
					tmpl.Name = src.Name
					local h = src:Clone()
					h.Name = "Handle"
					h.Parent = tmpl
					local made = buildAccessory(tmpl, src, char)
					tmpl:Destroy()
					return made
				elseif src:IsA("Shirt") or src:IsA("Pants") or src:IsA("ShirtGraphic") or src:IsA("CharacterMesh") then
					local c = src:Clone()
					c:SetAttribute(TAG, true)
					createdBy[c] = src
					c.Parent = char
					return c
				elseif src:IsA("Model") then
					return attachModel(src, char)
				end
				return nil
			end

			-- flattens a morph's "hats" container into a list of leaf items
			local function collectLeaves(item, out)
				if item:IsA("Accoutrement") or item:IsA("BasePart")
					or item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("CharacterMesh") then
					out[#out + 1] = item
				elseif item:IsA("Folder") or item:IsA("Model") then
					local hasNested = item:IsA("Folder")
					if not hasNested then
						for _, d in ipairs(item:GetDescendants()) do
							if d:IsA("Accoutrement") or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") or d:IsA("CharacterMesh") then
								hasNested = true
								break
							end
						end
					end
					if hasNested then
						for _, child in ipairs(item:GetChildren()) do
							collectLeaves(child, out)
						end
					else
						out[#out + 1] = item
					end
				elseif item:IsA("BodyColors") or item:IsA("Humanoid") or item:IsA("ValueBase") or item:IsA("HumanoidDescription") then
					-- handled separately / ignored
				else
					warn("[MorphGui] unsupported item type: " .. item:GetFullName() .. " (" .. item.ClassName .. ")")
				end
			end

			----------------------------------------------------------------
			-- RECONCILE: make the character match the plan. Safe to run any number of times.
			--   keeps healthy pieces, re-adds missing ones, rebuilds damaged ones, removes duplicates,
			--   leftovers from other morphs and the game's own outfit pieces.
			-- It never yields, so it can't overlap itself.
			----------------------------------------------------------------
			local function isHealthy(inst, char)
				if inst.Parent ~= char then return false end
				if inst:IsA("Accoutrement") then
					if unattached[inst] then return true end -- can't be fixed by rebuilding anyway
					local h = inst:FindFirstChild("Handle")
					if not (h and h:IsA("BasePart")) then return false end
					for _, d in ipairs(h:GetChildren()) do
						if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
							local other = (d.Part0 == h) and d.Part1 or d.Part0
							if other and other ~= h and other:IsDescendantOf(char) then
								return true
							end
						end
					end
					return false
				end
				return true
			end

			local function ensureColors(char, stats)
				if not planColors then return end
				local cur = char:FindFirstChildOfClass("BodyColors")
				if cur and sameColors(cur, planColors) then return end
				setBodyColors(char, planColors)
				if stats then stats.colors = true end
			end

			local function reconcile(char, hum, force)
				local stats = { added = 0, removed = 0, deduped = 0, foreign = 0, failed = 0, colors = false, scales = false }
				curStats = stats

				local want = {}
				for _, s in ipairs(plan) do want[s] = true end

				-- 1) look at everything on the character
				local have = {} -- [source] = { our instances built from it }
				for _, v in ipairs(char:GetChildren()) do
					if v:IsA("BodyColors") then
						-- colors are handled by ensureColors
					elseif v:GetAttribute(TAG) then
						local src = createdBy[v]
						if force or not (src and want[src]) then
							-- leftover from another morph / another copy of the script / forced rebuild
							dropPiece(v)
							stats.removed += 1
						elseif dirtyPieces[v] then
							-- the game destroyed / swapped a part of it: rebuild it from the source below
							dropPiece(v)
						else
							local l = have[src]
							if not l then
								l = {}
								have[src] = l
							end
							l[#l + 1] = v
						end
					elseif currentMorphObj and isOutfitItem(v) and (Body.limbs or not v:IsA("CharacterMesh")) then
						-- the game's own outfit piece, the morph replaces it
						pcall(function() v:Destroy() end)
						stats.foreign += 1
					end
				end

				-- 2) every planned piece must exist exactly once and be healthy
				for _, src in ipairs(plan) do
					local keep = nil
					local l = have[src]
					if l then
						for _, inst in ipairs(l) do
							if not keep and isHealthy(inst, char) then
								keep = inst
							else
								dropPiece(inst)
								stats.deduped += 1
							end
						end
					end
					if not keep then
						local ok, res = pcall(buildLeaf, src, char)
						if ok and res then
							stats.added += 1
						else
							stats.failed += 1
							warn("[MorphGui] couldn't add '" .. src.Name .. "' (" .. src.ClassName .. ")"
								.. (ok and "" or (": " .. tostring(res))))
						end
					end
				end

				-- 3) colors
				ensureColors(char, stats)

				-- 4) body scales (body type)
				if hum and Body.apply(hum) then stats.scales = true end
				Body.syncLimbs(char)

				curStats = nil
				return stats
			end

			local function changedCount(s)
				return s.added + s.removed + s.deduped + s.foreign + (s.colors and 1 or 0) + (s.scales and 1 or 0)
			end

			local function describe(s)
				local parts = {}
				if s.added > 0 then parts[#parts + 1] = "re-added " .. s.added end
				local extra = s.removed + s.deduped + s.foreign
				if extra > 0 then parts[#parts + 1] = "removed " .. extra .. " extra" end
				if s.colors then parts[#parts + 1] = "fixed colors" end
					if s.scales then parts[#parts + 1] = "fixed body scale" end
				if s.failed > 0 then parts[#parts + 1] = s.failed .. " FAILED (see Output)" end
				if #parts == 0 then
					return "all " .. #plan .. " pieces OK"
				end
				return table.concat(parts, ", ")
			end

			----------------------------------------------------------------
			-- Auto refresh (debounced events + a cheap watchdog; all of it funnels into the same reconcile)
			----------------------------------------------------------------
			local fight = { n = 0, t = 0, block = 0 }
			local function noteFix()
				local now = os.clock()
				if now - fight.t > 3 then
					fight.n = 0
					fight.t = now
				end
				fight.n += 1
				if fight.n > 8 then
					fight.n = 0
					fight.block = now + 4
					warn("[MorphGui] something keeps changing your outfit (8 fixes in 3s) - pausing auto refresh for 4s. "
						.. "If this keeps happening, an older copy of a morph script is still running: rejoin and run only this version.")
				end
			end

			local function runReconcile(reason)
				if not alive or not currentMorphObj or not ready or busy or not autoRefresh then return end
				if os.clock() < fight.block then return end
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not char or not hum or hum.Health <= 0 or not char:IsDescendantOf(workspace) then return end

				local ok, stats = pcall(reconcile, char, hum)
				curStats = nil
				if not ok then
					warn("[MorphGui] auto refresh failed: " .. tostring(stats))
					return
				end
				if changedCount(stats) > 0 then
					noteFix()
					if DEBUG then
						print("[MorphGui] auto refresh (" .. reason .. "): " .. describe(stats))
					end
					if hideHead or hideBodyNow() then applyHeadState() end
					setStatus("Auto refresh: " .. describe(stats))
				end
			end

			local pending = false
			local function scheduleReconcile(reason)
				if pending or not alive or not currentMorphObj or not autoRefresh then return end
				pending = true
				task.delay(0.05, function()
					pending = false
					runReconcile(reason)
				end)
			end

			----------------------------------------------------------------
			-- LOOK LOCK: runs every frame right before rendering (after the game's own render-step code),
			-- so whatever the game set this frame is replaced by the morph's real look before you see it.
			----------------------------------------------------------------
			local function enforceLooks()
				if not alive or not currentMorphObj or not lockLookOn then return end
				local fixed = 0
				local dirty = false

				for piece, rec in pairs(looks) do
					if piece.Parent then
						for i = 1, #rec do
							local r = rec[i]
							local inst, prop = r[1], r[2]
							if inst.Parent == nil then
								-- a part of this piece was destroyed by the game
								if not dirtyPieces[piece] then
									dirtyPieces[piece] = true
									dirty = true
								end
								break
							end
							local expected = r[3]
							if prop == "Transparency" and isMgHidden(inst) then
								expected = 1 -- hidden on purpose by the "Hide Face & Head" toggle
							end
							local cur = inst[prop]
							if cur ~= expected then
								if r[4] then
									-- can't be assigned (mesh swapped): rebuild the piece instead
									warnLook(inst, prop, cur)
									if not dirtyPieces[piece] then
										dirtyPieces[piece] = true
										dirty = true
									end
									break
								end
								warnLook(inst, prop, cur)
								if pcall(function() inst[prop] = expected end) then
									fixed += 1
								end
							end
						end
					end
				end

				for i = 1, #bodyLook do
					local r = bodyLook[i]
					local inst, prop = r[1], r[2]
					if inst.Parent then
						local cur = inst[prop]
						if cur ~= r[3] then
							warnLook(inst, prop, cur)
							if pcall(function() inst[prop] = r[3] end) then
								fixed += 1
							end
						end
					end
				end

				if fixed > 0 then
					lookFixes += fixed
				end
				if dirty then
					scheduleReconcile("a part of a morph piece changed")
				end
			end

			pcall(function() RunService:UnbindFromRenderStep("MorphGuiLook") end)
			RunService:BindToRenderStep("MorphGuiLook", Enum.RenderPriority.Last.Value + 1, function()
				local ok, err = pcall(enforceLooks)
				if not ok and not lookWarned["_err"] then
					lookWarned["_err"] = true
					warn("[MorphGui] look lock error: " .. tostring(err))
				end
			end)

			----------------------------------------------------------------
			-- Morph / reset / refresh
			----------------------------------------------------------------
			-- CHAIN LIGHTING FIX
			-- Bright lighting (fullbright: white ambient + brightness 2) pushes CHAIN's gray meshes past 1.0 so they
			-- clip to pure white. Chain.fixLighting() scales the colors of the morph pieces (part colors and
			-- SurfaceAppearance tint) down so they look the same as in normal lighting, and keeps the look lock
			-- from putting the old colors back.
			--   Chain.fixLighting()        automatic: factor from the current Lighting (runs by itself every 0.5s)
			--   Chain.fixLighting(0.6)     force a brightness factor (1 = untouched, lower = darker)
			--   Chain.fixLighting(false)   restore the original colors
			-- Also available from the executor console as ChainFixLighting(...).
			Chain.LIGHT_FIX = true         -- the automatic fix
			Chain.TARGET_EXPOSURE = 1.5    -- what "normal" lighting adds up to (ambient average + brightness / 2)
			Chain.MIN_FACTOR = 0.3         -- never darken below this
			Chain.factor = 1

			function Chain.exposure()
				local L = game:GetService("Lighting")
				local a = L.Ambient
				return (a.R + a.G + a.B) / 3 + 0.5 * L.Brightness
			end

			function Chain.fixLighting(arg)
				local char = player.Character
				if not char then return end
				local active = currentMorphObj ~= nil and currentMorphObj:GetAttribute("ChainLazy") == true
				local factor = 1
				if arg ~= false and active then
					if type(arg) == "number" then
						factor = math.clamp(arg, 0, 1)
					else
						factor = math.clamp(Chain.TARGET_EXPOSURE / math.max(Chain.exposure(), 0.01), Chain.MIN_FACTOR, 1)
					end
				end
				if factor == 1 and Chain.factor == 1 and arg == nil then return end -- nothing is dimmed and nothing needs to be: skip the scan (this runs every 0.5s)
				Chain.factor = factor
				for piece, rec in pairs(looks) do
					if piece.Parent == char then
						for _, r in ipairs(rec) do
							local inst, prop = r[1], r[2]
							if prop == "Color" and inst.Parent and typeof(r[3]) == "Color3"
								and (inst:IsA("BasePart") or inst:IsA("SurfaceAppearance")) then
								if r[5] == nil and factor < 1 then r[5] = r[3] end -- remember the untouched color
								local base = r[5]
								if base then
									local want = Color3.new(base.R * factor, base.G * factor, base.B * factor)
									r[3] = want -- the look lock now expects the adjusted color
									if inst.Color ~= want then pcall(function() inst.Color = want end) end
									if factor >= 1 then r[5] = nil end
								end
							end
						end
					end
				end
			end

			do
				local genv = (getgenv and getgenv()) or _G
				genv.ChainFixLighting = Chain.fixLighting
				task.spawn(function()
					while alive do
						task.wait(0.5)
						if Chain.LIGHT_FIX or Chain.factor < 1 then
							local ok, err
					if Chain.LIGHT_FIX then
						ok, err = pcall(Chain.fixLighting)
					else
						ok, err = pcall(Chain.fixLighting, false) -- fix turned off: put the colors back once
					end
							if not ok and DEBUG then warn("[ChainMorph] lighting: " .. tostring(err)) end
						end
					end
				end)
			end

			local function doMorph(morph, hatsOverride)
				local char, hum = getCharacter()
				if not snapshot then
					takeSnapshot(char)
				end

				local hats = hatsOverride or findHats(morph)
				if not hats then
					warn("Morph '" .. morph.Name .. "' has no hats folder")
					return false
				end

				local leaves = {}
				for _, item in ipairs(hats:GetChildren()) do
					collectLeaves(item, leaves)
				end
				local bc = morph:FindFirstChildOfClass("BodyColors") or hats:FindFirstChildOfClass("BodyColors")

				local okB, bodyScales = pcall(Body.gather, morph, hats, leaves, hum)
				if not okB then
					warn("[MorphGui] body scan failed: " .. tostring(bodyScales))
					bodyScales = nil
				end
				Body.plan = bodyScales
				Body.setHide(morph)
				pcall(Body.applyDesc, hum, morph)
				plan = leaves
				planColors = bc
				currentMorph = morph.Name
				currentMorphObj = morph
				currentHatsOverride = hatsOverride
				table.clear(lookWarned)
				table.clear(bodyLook)

				lastStats = reconcile(char, hum)
				if not bc then
					-- no colors in the morph: go back to the original ones (stops the previous morph's colors sticking)
					restoreOriginalColors(char)
				end

				applyHeadState()
				scheduleRecordBody()
				return true
			end

			local function morphMessage(name)
				local msg = "Morphed into: " .. name .. " (" .. #plan .. " pieces"
				do
					local limbN, clothN, meshN = 0, 0, 0
					for _, s in ipairs(plan) do
						if s:IsA("CharacterMesh") then limbN += 1
						elseif s:IsA("Shirt") or s:IsA("Pants") or s:IsA("ShirtGraphic") then clothN += 1
						elseif s:IsA("Accessory") and s:GetAttribute("MG_Limb") then meshN += 1 end
					end
					if limbN > 0 then msg = msg .. ", " .. limbN .. " limb meshes" end
					if clothN > 0 then msg = msg .. ", " .. clothN .. " clothes" end
					if meshN > 0 then msg = msg .. ", " .. meshN .. " body meshes" end
				end
				if lastStats and lastStats.failed > 0 then
					msg = msg .. ", " .. lastStats.failed .. " FAILED - see Output"
				end
				return msg .. ")"
			end

			-- synchronous reset (no yielding), also used by unload
			local function resetNow()
				if not snapshot then return false end
				local char = player.Character
				if not char then return false end

				plan = {}
				planColors = nil
				currentMorph = nil
				currentMorphObj = nil
				currentHatsOverride = nil
				table.clear(bodyLook)

				for _, v in ipairs(char:GetChildren()) do
					if not v:IsA("BodyColors") and (v:GetAttribute(TAG) or isOutfitItem(v)) then
						dropPiece(v)
					end
				end
				for _, item in ipairs(snapshot) do
					local ok, err = pcall(buildLeaf, item, char)
					if not ok then
						warn("[MorphGui] couldn't restore '" .. item.Name .. "': " .. tostring(err))
					end
				end
				table.clear(looks) -- no morph active: nothing to lock
				curStats = nil
				restoreOriginalColors(char)
				Body.plan, Body.limbs = nil, false
				local bodyHum = char:FindFirstChildOfClass("Humanoid")
				if bodyHum then pcall(Body.apply, bodyHum) end
				Body.hide = nil
				Body.syncLimbs(char) -- shows the limbs a bundle had hidden
				task.spawn(Body.restoreDesc, bodyHum)
				applyHeadState() -- brings face/head back
				return true
			end

			local function locked(fn, ...)
				while busy do task.wait() end
				busy = true
				local ok, res = pcall(fn, ...)
				busy = false
				if not ok then
					warn("[MorphGui] " .. tostring(res))
					return false
				end
				return res
			end

			local function morphInto(morph, hatsOverride)
				return locked(doMorph, morph, hatsOverride)
			end

			local function resetMorph()
				return locked(resetNow)
			end

			-- Refresh button: reconcile (keeps what's fine, fixes what's not). force = rebuild everything.
			local function refreshNow(force)
				if not currentMorphObj then return false end
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if not (char and hum) then return false end
				local stats = reconcile(char, hum, force)
				applyHeadState()
				return stats
			end

			----------------------------------------------------------------
			-- First person body / head accessory control
			----------------------------------------------------------------
			local fpBody = false         -- show whole body + accessories in first person
			local fpHideHeadAcc = false  -- head accessories always invisible in first person
			local fpTouched = setmetatable({}, { __mode = "k" }) -- parts we forced via LocalTransparencyModifier
			local fpPieceCache = setmetatable({}, { __mode = "k" })

			pcall(function() RunService:UnbindFromRenderStep("MorphGuiFP") end)

			-- true if this accessory/model is welded to the head (hats, hair, face items)
			local function isHeadPiece(piece, head)
				local cached = fpPieceCache[piece]
				if cached ~= nil then return cached end
				local foundJoint = false
				for _, d in ipairs(piece:GetDescendants()) do
					if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
						local p0, p1 = d.Part0, d.Part1
						if p0 == head or p1 == head then
							fpPieceCache[piece] = true
							return true
						end
						if p0 and p1 and not (p0:IsDescendantOf(piece) and p1:IsDescendantOf(piece)) then
							foundJoint = true -- welded to something outside the piece, and it isn't the head
						end
					end
				end
				if foundJoint then fpPieceCache[piece] = false end
				return false
			end

			local function setPieceFP(piece, mod)
				for _, d in ipairs(piece:GetDescendants()) do
					if d:IsA("BasePart") then
						d.LocalTransparencyModifier = mod
						fpTouched[d] = true
					end
				end
				if piece:IsA("BasePart") then
					piece.LocalTransparencyModifier = mod
					fpTouched[piece] = true
				end
			end

			local function fpStep()
				if not alive then return end
				if not (fpBody or fpHideHeadAcc) and next(fpTouched) == nil then return end -- both options off, nothing to undo
				local char = player.Character
				local cam = workspace.CurrentCamera
				local head = char and char:FindFirstChild("Head")
				if not (head and cam) then return end

				local inFP = (cam.CFrame.Position - head.Position).Magnitude < 1.5
					or player.CameraMode == Enum.CameraMode.LockFirstPerson

				if not (inFP and (fpBody or fpHideHeadAcc)) then
					-- leaving first person (or toggles off): give control back
					for part in pairs(fpTouched) do
						if part.Parent then part.LocalTransparencyModifier = 0 end
						fpTouched[part] = nil
					end
					return
				end

				for _, v in ipairs(char:GetChildren()) do
					if v.Name ~= "HumanoidRootPart" then
						if v:IsA("Accoutrement") or v:IsA("Model") then
							if isHeadPiece(v, head) then
								setPieceFP(v, 1) -- head accessories: always invisible in first person
							elseif fpBody then
								setPieceFP(v, 0)
							end
						elseif v:IsA("BasePart") and fpBody then
							setPieceFP(v, v == head and 1 or 0)
						end
					end
				end
			end

			RunService:BindToRenderStep("MorphGuiFP", Enum.RenderPriority.Last.Value + 2, function()
				pcall(fpStep)
			end)

			----------------------------------------------------------------
			-- Third person (first person stays available by scrolling in)
			----------------------------------------------------------------
			local TP_DISTANCE = 12
			local zoomBusy = false

			local function fixCamera()
				local cam = workspace.CurrentCamera
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if cam and hum then
					cam.CameraType = Enum.CameraType.Custom
					cam.CameraSubject = hum
				end
			end

			-- keeps the game from locking you back into first person, but doesn't lock you out of it
			local function enforceThirdPerson()
				if not alive or not thirdPerson or zoomBusy then return end
				if player.CameraMode ~= Enum.CameraMode.Classic then
					player.CameraMode = Enum.CameraMode.Classic
				end
				if player.CameraMinZoomDistance > 0.5 then
					player.CameraMinZoomDistance = 0.5
				end
				if player.CameraMaxZoomDistance < 20 then
					player.CameraMaxZoomDistance = 128
				end
			end

			-- pushes the camera out to a third person distance once, then frees the zoom range again
			local function pushOut()
				if not thirdPerson then return end
				zoomBusy = true
				player.CameraMode = Enum.CameraMode.Classic
				player.CameraMaxZoomDistance = math.max(TP_DISTANCE, player.CameraMinZoomDistance)
				player.CameraMinZoomDistance = TP_DISTANCE
				player.CameraMaxZoomDistance = TP_DISTANCE
				fixCamera()
				task.wait(0.35)
				player.CameraMinZoomDistance = 0.5
				player.CameraMaxZoomDistance = 128
				zoomBusy = false
				enforceThirdPerson()
			end

			local function setThirdPerson(on)
				if on == thirdPerson then return end
				if on then
					origCam = {
						mode = player.CameraMode,
						min = player.CameraMinZoomDistance,
						max = player.CameraMaxZoomDistance,
					}
					thirdPerson = true
					task.spawn(pushOut)
				else
					thirdPerson = false
					zoomBusy = false
					if origCam then
						player.CameraMaxZoomDistance = origCam.max
						player.CameraMinZoomDistance = origCam.min
						player.CameraMode = origCam.mode
					end
				end
			end

			connect(player:GetPropertyChangedSignal("CameraMode"), enforceThirdPerson)
			connect(player:GetPropertyChangedSignal("CameraMinZoomDistance"), enforceThirdPerson)
			connect(player:GetPropertyChangedSignal("CameraMaxZoomDistance"), enforceThirdPerson)

			----------------------------------------------------------------
			-- Character hooks + respawn
			----------------------------------------------------------------
			local function disconnectChar()
				for _, c in ipairs(charConns) do
					pcall(function() c:Disconnect() end)
				end
				table.clear(charConns)
			end

			local function hookCharacter(char)
				disconnectChar()
				local function add(c) charConns[#charConns + 1] = c end

				-- the game changed one of the body scales while a morph is on: put the morph's back
				local bodyHum = char:FindFirstChildOfClass("Humanoid")
				if bodyHum then
					local function watchScale(v)
						if v:IsA("NumberValue") and Body.SET[v.Name] then
							add(v:GetPropertyChangedSignal("Value"):Connect(function()
								if Body.plan and alive then scheduleReconcile("body scale changed") end
							end))
						end
					end
					for _, v in ipairs(bodyHum:GetChildren()) do watchScale(v) end
					add(bodyHum.ChildAdded:Connect(watchScale))
				end

				-- something took one of OUR pieces off the character
				add(char.ChildRemoved:Connect(function(child)
					if not alive or not currentMorphObj then return end
					if child:GetAttribute(TAG) and not released[child] and not child:IsA("BodyColors") then
						if child.Parent ~= nil then
							-- it was moved somewhere else (not destroyed): drop that stray copy, reconcile re-adds a clean one
							dropPiece(child)
						end
						scheduleReconcile("a morph piece was removed")
					end
				end))

				-- something was added that isn't ours (game outfit / colors), or a stray copy of ours
				add(char.ChildAdded:Connect(function(child)
					if not alive or not currentMorphObj then return end
					if child:GetAttribute(TAG) then
						if not createdBy[child] and not child:IsA("BodyColors") then
							scheduleReconcile("stray copy")
						end
					elseif isOutfitItem(child) or child:IsA("BodyColors") then
						scheduleReconcile("the game added " .. child.Name)
					end
				end))

				add(char.DescendantAdded:Connect(function(d)
					if not alive then return end
					if (hideHead or hideBodyNow()) and currentMorph and not isOurs(d, char) then
						scheduleHeadState()
					end
					if not currentMorphObj then return end

					-- the game put a visual effect INSIDE one of our pieces (highlight, extra texture, particles...): remove it
					if lockLookOn and OVERLAY[d.ClassName] and not knownDesc[d] and isOurs(d, char) then
						if DEBUG then
							print("[MorphGui] removed a game effect (" .. d.ClassName .. " '" .. d.Name .. "') from a morph piece")
						end
						pcall(function() d:Destroy() end)
					elseif DEBUG and (d:IsA("Highlight") or d:IsA("ForceField")) and not isOurs(d, char) then
						local key = "fx" .. d.ClassName
						if not lookWarned[key] then
							lookWarned[key] = true
							print("[MorphGui] the game added a " .. d.ClassName .. " to your character (" .. d:GetFullName() .. ")")
						end
					end
				end))
			end

			-- HasAppearanceLoaded is already true when a respawned character is added, so wait for
			-- CharacterAppearanceLoaded (with a minimum wait and a timeout as a safety net)
			local function waitForAppearance(timeout)
				local done = false
				local c = player.CharacterAppearanceLoaded:Connect(function() done = true end)
				local t = os.clock()
				while alive and not done and os.clock() - t < timeout do
					if player:HasAppearanceLoaded() and os.clock() - t >= 1.5 then
						break
					end
					task.wait(0.1)
				end
				c:Disconnect()
			end

			connect(player.CharacterAdded, function(char)
				charGen += 1
				local myGen = charGen
				snapshot = nil
				snapshotBC = nil
				snapshotColors = nil
				ready = false
				table.clear(looks)
				table.clear(bodyLook)
				table.clear(fpTouched)
				hookCharacter(char)

				task.spawn(function()
					local hum = char:WaitForChild("Humanoid", 10)
					if not hum then
						if charGen == myGen then ready = true end
						return
					end

					waitForAppearance(8)
					task.wait(0.5)
					if not alive or charGen ~= myGen or player.Character ~= char then return end

					-- remember the game's outfit for "Reset", then put the morph back on
					takeSnapshot(char)
					if currentMorphObj then
						local stats = locked(function()
							local s = reconcile(char, hum)
							applyHeadState()
							return s
						end)
						if stats then
							setStatus("Morph re-applied: " .. tostring(currentMorph))
						end
						scheduleRecordBody()
					end

					if charGen ~= myGen then return end
					ready = true

					if thirdPerson then
						pushOut()
					end
				end)
			end)

			if player.Character then
				local okHook, errHook = pcall(hookCharacter, player.Character)
				if not okHook then
					warn("[MorphGui] hookCharacter failed: " .. tostring(errHook))
				end
			end

			-- watchdog: catches whatever the events miss (broken welds, new game outfit pieces, moved pieces)
			-- and reports how many game changes the look lock has undone
			task.spawn(function()
				while alive do
					task.wait(WATCHDOG_INTERVAL)
					if not alive then break end
					runReconcile("watchdog")
					if lookFixes > 0 then
						setStatus("Look lock: undid " .. (lookFixes > 99 and "99+" or tostring(lookFixes)) .. " game changes")
						lookFixes = 0
					end
				end
			end)

			----------------------------------------------------------------
			-- GUI
			----------------------------------------------------------------
			gui = Instance.new("ScreenGui")
			gui.Name = "MorphGui"
			gui.ResetOnSpawn = false
			gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
			gui.Parent = player:WaitForChild("PlayerGui")

			local main = Instance.new("Frame")
			main.Name = "Main"
			main.Size = UDim2.fromOffset(300, 420)
			main.Position = UDim2.new(0.5, -150, 0.5, -210)
			main.BackgroundColor3 = Color3.fromRGB(24, 24, 32)
			main.BorderSizePixel = 0
			main.ClipsDescendants = true
			-- embed into the Settings panel's MORPH tab when it exists (falls back to a floating window)
			local host = Shared.MorphHost
			local embedded = host ~= nil and host.Parent ~= nil
			if embedded then
				local loading = host:FindFirstChild("MorphLoading")
				if loading then loading:Destroy() end
				main.Parent = host
				main.Position = UDim2.new(0, 0, 0, -42) -- the title bar sits above the visible area
				main.Size = UDim2.new(1, 0, 1, 42)
				main.BackgroundTransparency = 1
			else
				main.Parent = gui
			end

			Instance.new("UICorner", main).CornerRadius = UDim.new(0, 12)

			local stroke = Instance.new("UIStroke", main)
			stroke.Enabled = not embedded
			stroke.Color = Color3.fromRGB(120, 90, 255)
			stroke.Thickness = 1.5

			local title = Instance.new("Frame")
			title.Name = "TitleBar"
			title.Size = UDim2.new(1, 0, 0, 42)
			title.BackgroundColor3 = Color3.fromRGB(36, 34, 52)
			title.BorderSizePixel = 0
