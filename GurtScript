---------------------------------------------------------------- 37) no freeze (NO FREEZE card: undoes whatever freezes / pins your character in place)
runSection("37", function()
	-- Names the game might use for a "frozen / stunned" flag (attribute or BoolValue on your character, humanoid or player): set to false while ON.
	-- This list is a guess, add the game's real names here if you find them.
	local FREEZE_FLAGS = { "Stunned", "Frozen", "Freeze", "Rooted", "Root", "Immobilized", "Immobile", "Paralyzed", "CantMove", "Ragdoll", "Ragdolled", "Stun" }
	local BAD_STATES = {
		[Enum.HumanoidStateType.Ragdoll] = true,
		[Enum.HumanoidStateType.Physics] = true,
		[Enum.HumanoidStateType.FallingDown] = true,
		[Enum.HumanoidStateType.PlatformStanding] = true,
	}
	local MIN_WALK = 0.5     -- WalkSpeed at or below this counts as frozen and is put back to your last normal speed
	local SWEEP_EVERY = 0.1  -- seconds between full sweeps (anchored parts, outside welds / constraints, flags); property changes are also caught instantly

	local on = false
	local token = 0
	local conns = {}      -- connections that live while the card is on (respawn hook)
	local charConns = {}  -- connections for the current character
	local lastGood = { walk = 16, jumpPower = 50, jumpHeight = 7.2 }

	-- workspace.Characters.<your name>.GlobalStates.isExecuting: while the game says you are in an execution, the normal un-freezing is paused and the player is held still instead (see holdPlayer below)
	local function readFlag(v)
		if type(v) == "boolean" then return v end
		if type(v) == "number" then return v ~= 0 end
		if type(v) == "string" then local l = v:lower() return l == "true" or l == "1" end
		return false
	end
	local function isExecuting()
		local folder = Workspace:FindFirstChild("Characters")
		local holders = { folder and folder:FindFirstChild(LocalPlayer.Name), LocalPlayer.Character }
		for _, holder in pairs(holders) do
			local gs = holder and holder:FindFirstChild("GlobalStates")
			if gs then
				local o = gs:FindFirstChild("isExecuting")
				if o and o:IsA("ValueBase") and readFlag(o.Value) then return true end -- value object
				if readFlag(gs:GetAttribute("isExecuting")) then return true end -- attribute on GlobalStates
			end
			if holder and readFlag(holder:GetAttribute("isExecuting")) then return true end -- attribute on the character
		end
		return false
	end

	-- the script's own 300 DMG STUN holds you on purpose, and during a game execution (isExecuting) we hold you ourselves: the un-freezing stays out of both
	local function myStun() return Kit.stunBusy == true or isExecuting() end

	local function charAndHum()
		local char = LocalPlayer.Character
		return char, char and char:FindFirstChildOfClass("Humanoid")
	end

	-- ---------- manual freeze while isExecuting is true ----------
	local held = nil -- remembers the values from before the freeze while we are holding you

	local function releaseHold()
		local h = held
		if not h then return end
		held = nil
		Kit.log("exec hold OFF")
		pcall(function()
			if h.hum and h.hum.Parent then
				if h.hum.WalkSpeed == 0 then h.hum.WalkSpeed = h.walk end
				if h.hum.UseJumpPower then h.hum.JumpPower = h.jumpPower else h.hum.JumpHeight = h.jumpHeight end -- back to what it was (0 stays 0)
				h.hum.AutoRotate = h.autoRotate
			end
			if h.root and h.root.Parent and not h.rootWasAnchored then h.root.Anchored = false end
		end)
	end

	local function holdPlayer()
		local char, hum = charAndHum()
		if not char or not hum or hum.Health <= 0 then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		if held and held.hum ~= hum then held = nil end -- respawned mid-execution: start over on the new character
		if not held then
			held = {
				hum = hum,
				root = root,
				walk = hum.WalkSpeed > MIN_WALK and hum.WalkSpeed or lastGood.walk,
				jumpPower = hum.JumpPower,
				jumpHeight = hum.JumpHeight,
				autoRotate = hum.AutoRotate,
				rootWasAnchored = root ~= nil and root.Anchored or false,
				pin = root and root.CFrame or nil, -- the spot you were standing on when the execution began
			}
			Kit.log("exec hold ON")
		end
		hum.WalkSpeed = 0
		if hum.UseJumpPower then hum.JumpPower = 0 else hum.JumpHeight = 0 end
		hum.AutoRotate = false
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
			root.Anchored = true
			if held.pin then root.CFrame = held.pin end -- a script that moves you by CFrame is pushed straight back
		end
	end

	-- ---------- movement properties ----------
	local function fixMovement()
		if not on or myStun() then return end
		local _, hum = charAndHum()
		if not hum or hum.Health <= 0 then return end

		if hum.WalkSpeed > MIN_WALK then lastGood.walk = hum.WalkSpeed else hum.WalkSpeed = lastGood.walk end
		-- jump is left exactly as the game has it (NO FREEZE no longer turns jumping back on)
		if hum.PlatformStand then hum.PlatformStand = false end
		if hum.Sit and not hum.SeatPart then hum.Sit = false end -- a real seat is left alone, only a "fake" sit is undone
		if BAD_STATES[hum:GetState()] then hum:ChangeState(Enum.HumanoidStateType.Running) end
	end

	-- ---------- anchored parts ----------
	-- items (tools, hats / accessories and whatever is inside them) are NEVER touched: games anchor / weld them on purpose
	local function isItem(inst)
		local p = inst
		while p and p ~= Workspace and p ~= game do
			if p:IsA("Tool") or p:IsA("Accoutrement") or p:IsA("BackpackItem") then return true end
			p = p.Parent
		end
		return false
	end
	local ITEM_JOINT_WORDS = { "grip", "handle", "tool", "weapon", "item", "accessory", "equip", "hold" }
	local function itemJointName(name)
		name = string.lower(name)
		for _, w in ipairs(ITEM_JOINT_WORDS) do
			if string.find(name, w, 1, true) then return true end
		end
		return false
	end

	local function fixAnchored(char)
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") and d.Anchored and not isItem(d) then d.Anchored = false end
		end
	end

	-- ---------- welds / constraints that tie you to something outside your character (grabs, pins, traps) ----------
	local function outside(part, char)
		return part ~= nil and not part:IsDescendantOf(char)
	end

	local disabledJoints = {} -- joints WE switched off: switched back on when NO FREEZE goes off

	local function fixJoints(char)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and not isItem(part) then
				for _, j in ipairs(part:GetJoints()) do
					local a, b
					if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
						a, b = j.Part0, j.Part1
					elseif j:IsA("Constraint") then
						a, b = j.Attachment0 and j.Attachment0.Parent, j.Attachment1 and j.Attachment1.Parent
					end
					if (outside(a, char) or outside(b, char)) and j.Name ~= "SeatWeld" then
						local isSeat = (a and (a:IsA("Seat") or a:IsA("VehicleSeat"))) or (b and (b:IsA("Seat") or b:IsA("VehicleSeat")))
						local isGear = itemJointName(j.Name) or isItem(a) or isItem(b) or isItem(j)
						if not isSeat and not isGear then
							pcall(function()
								if j.Enabled then disabledJoints[j] = true j.Enabled = false end
							end)
						end
					end
				end
			end
		end
	end

	-- ---------- freeze flags ----------
	local function clearFlags(obj)
		if not obj then return end
		for _, n in ipairs(FREEZE_FLAGS) do
			if obj:GetAttribute(n) == true then pcall(function() obj:SetAttribute(n, false) end) end
			local v = obj:FindFirstChild(n)
			if v and v:IsA("BoolValue") and v.Value == true then pcall(function() v.Value = false end) end
		end
	end

	local function fullSweep()
		if not on or myStun() then return end
		local char, hum = charAndHum()
		if not char then return end
		fixAnchored(char)
		fixJoints(char)
		clearFlags(char)
		clearFlags(hum)
		clearFlags(LocalPlayer)
		fixMovement()
	end

	-- ---------- instant reactions (the sweep above is the safety net) ----------
	local function dropCharConns()
		for _, c in ipairs(charConns) do c:Disconnect() end
		table.clear(charConns)
	end

	local function hookCharacter(char)
		dropCharConns()
		if not char then return end
		task.spawn(function()
			local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
			local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 10)
			if not on or LocalPlayer.Character ~= char then return end
			if hum then
				for _, prop in ipairs({ "WalkSpeed", "PlatformStand", "Sit" }) do
					table.insert(charConns, hum:GetPropertyChangedSignal(prop):Connect(fixMovement))
				end
				table.insert(charConns, hum.StateChanged:Connect(fixMovement))
			end
			if root then
				table.insert(charConns, root:GetPropertyChangedSignal("Anchored"):Connect(function()
					if on and not myStun() and root.Anchored then root.Anchored = false end
				end))
			end
			table.insert(charConns, char.DescendantAdded:Connect(function(d)
				if not on then return end
				if d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("WeldConstraint") then
					task.defer(function() if on and char.Parent then fixJoints(char) end end)
				end
			end))
			fullSweep()
		end)
	end

	local function turnOn()
		if on then return end
		on = true
		token += 1
		local my = token
		hookCharacter(LocalPlayer.Character)
		table.insert(conns, LocalPlayer.CharacterAdded:Connect(hookCharacter))
		task.spawn(function()
			while on and token == my do
				fullSweep()
				task.wait(SWEEP_EVERY)
			end
		end)
		-- holds you still while isExecuting is true, lets go the frame it turns false
		local function holdStep()
			if not on then return end
			if isExecuting() then holdPlayer() elseif held then releaseHold() end
		end
		table.insert(conns, RunService.Stepped:Connect(holdStep))
		table.insert(conns, RunService.Heartbeat:Connect(holdStep))
	end

	local function turnOff()
		if not on then return end
		on = false
		token += 1
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		dropCharConns()
		releaseHold()
		for j in pairs(disabledJoints) do -- put back every weld / constraint this feature switched off
			pcall(function() if j.Parent then j.Enabled = true end end)
		end
		table.clear(disabledJoints)
	end
	onCleanup(turnOff)

	local setVisual
	setVisual = makeToggleCard("NoFreezeGui", "NoFreezeToggle", "NO FREEZE", 11, Color3.fromRGB(110, 200, 255), 2328, function()
		if on then turnOff() else turnOn() end
		return on
	end)
	FeatureHooks.nofreeze = function() turnOff() setVisual(false) end
end)

---------------------------------------------------------------- 38) shift lock (SHIFT LOCK card: your character turns to face where the camera looks; paused while isExecuting is true)
runSection("38", function()
	local on = false
	local conn = nil
	local controlling = false
	local prevAutoRotate = nil

	local function readFlag(v)
		if type(v) == "boolean" then return v end
		if type(v) == "number" then return v ~= 0 end
		if type(v) == "string" then local l = v:lower() return l == "true" or l == "1" end
		return false
	end
	local function isExecuting()
		local folder = Workspace:FindFirstChild("Characters")
		local holders = { folder and folder:FindFirstChild(LocalPlayer.Name), LocalPlayer.Character }
		for _, holder in pairs(holders) do
			local gs = holder and holder:FindFirstChild("GlobalStates")
			if gs then
				local o = gs:FindFirstChild("isExecuting")
				if o and o:IsA("ValueBase") and readFlag(o.Value) then return true end
				if readFlag(gs:GetAttribute("isExecuting")) then return true end
			end
			if holder and readFlag(holder:GetAttribute("isExecuting")) then return true end
		end
		return false
	end

	-- hands AutoRotate back exactly as it was before shift lock took it over (nothing is forced on while the feature is off)
	local function release()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if controlling and hum then
			hum.AutoRotate = (prevAutoRotate == nil) or prevAutoRotate
		end
		controlling = false
		prevAutoRotate = nil
	end

	local function step()
		local char = LocalPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local cam = Workspace.CurrentCamera
		if not hum or not root or not cam then return end
		if isExecuting() then
			if controlling then release() end
			return
		end
		if not controlling then
			controlling = true
			prevAutoRotate = hum.AutoRotate
		end
		hum.AutoRotate = false
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.001 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
		end
	end

	local function turnOn()
		if on then return end
		on = true
		conn = RunService.RenderStepped:Connect(step)
	end
	local function turnOff()
		if not on then return end
		on = false
		if conn then conn:Disconnect() conn = nil end
		release()
	end
	onCleanup(turnOff)

	local setVisual
	setVisual = makeToggleCard("ShiftLockGui", "ShiftLockToggle", "SHIFT LOCK", 11, Color3.fromRGB(255, 170, 70), 2384, function()
		if on then turnOff() else turnOn() end
		return on
	end)
	FeatureHooks.shiftlock = function() turnOff() setVisual(false) end
end)

--------------------------------------------------------------------------------------------- 39) big heads (BIG HEADS card: the head of every NPC becomes 4x4x4, see-through and non-colliding; fully event driven, no scanning loops)
runSection("39", function()
	local HEAD_SIZE = Vector3.new(4, 4, 4)
	local HEAD_TRANSPARENCY = 0.5
	-- folders directly inside workspace whose models are NPCs (the game keeps them in workspace.Characters). Models that are put straight into workspace and already contain a Humanoid are checked too.
	local NPC_FOLDERS = { Characters = true }

	local on = false
	local tracked = {}       -- [model] = { head, origSize, origCollide, origTransp, sizeConn, childConn }
	local folderConns = {}   -- [folder] = { ChildAdded, ChildRemoved }
	local rootConns = {}

	local function isPlayerModel(m)
		if Players:GetPlayerFromCharacter(m) then return true end
		local p = Players:FindFirstChild(m.Name) -- the game also keeps player characters in workspace.Characters.<name>
		return p ~= nil and p:IsA("Player")
	end

	local function releaseHead(st)
		if st.sizeConn then st.sizeConn:Disconnect() st.sizeConn = nil end
		local h = st.head
		st.head = nil
		if h and h.Parent then
			pcall(function()
				h.Size = st.origSize
				h.CanCollide = st.origCollide
				h.Transparency = st.origTransp
			end)
		end
	end

	local function applyHead(st, head)
		if st.head ~= head then
			releaseHead(st)
			st.head = head
			st.origSize, st.origCollide, st.origTransp = head.Size, head.CanCollide, head.Transparency
			-- only reacts if the game shrinks the head again (setting the same value fires nothing, so no loop)
			st.sizeConn = head:GetPropertyChangedSignal("Size"):Connect(function()
				if on and head.Size ~= HEAD_SIZE then head.Size = HEAD_SIZE end
			end)
		end
		head.Size = HEAD_SIZE
		head.CanCollide = false
		head.Transparency = HEAD_TRANSPARENCY
	end

	local function tryHead(m, st)
		local head = m:FindFirstChild("Head")
		if head and head:IsA("BasePart") and m:FindFirstChildWhichIsA("Humanoid") then
			applyHead(st, head)
		end
	end

	-- strict = the model sits straight in workspace: it is only taken if it is already a humanoid model (so map models get no listener at all)
	local function register(m, strict)
		if tracked[m] or not m:IsA("Model") then return end
		if strict and not m:FindFirstChildWhichIsA("Humanoid") then return end
		if isPlayerModel(m) then return end
		local st = {}
		tracked[m] = st
		-- the head / humanoid can arrive after the model (streaming), or the head can be replaced: one listener per NPC
		st.childConn = m.ChildAdded:Connect(function(c)
			if c.Name == "Head" or c:IsA("Humanoid") then tryHead(m, st) end
		end)
		tryHead(m, st)
	end

	local function unregister(m)
		local st = tracked[m]
		if not st then return end
		tracked[m] = nil
		if st.childConn then st.childConn:Disconnect() end
		releaseHead(st)
	end

	local function watchFolder(f)
		if folderConns[f] then return end
		folderConns[f] = {
			f.ChildAdded:Connect(function(c) register(c, false) end),
			f.ChildRemoved:Connect(unregister),
		}
		for _, m in ipairs(f:GetChildren()) do register(m, false) end
	end
	local function unwatchFolder(f)
		local c = folderConns[f]
		if not c then return end
		folderConns[f] = nil
		for _, x in ipairs(c) do x:Disconnect() end
		for m in pairs(tracked) do
			if m.Parent == f or m.Parent == nil then unregister(m) end
		end
	end

	local function rootAdded(c)
		if NPC_FOLDERS[c.Name] and not c:IsA("Terrain") then watchFolder(c)
		else register(c, true) end
	end
	local function rootRemoved(c)
		if folderConns[c] then unwatchFolder(c) else unregister(c) end
	end

	local function turnOff()
		if not on then return end
		on = false
		for _, c in ipairs(rootConns) do c:Disconnect() end
		table.clear(rootConns)
		for f in pairs(folderConns) do unwatchFolder(f) end
		for m in pairs(tracked) do unregister(m) end -- puts every head back the way it was
	end
	local function turnOn()
		if on then return end
		on = true
		rootConns[1] = Workspace.ChildAdded:Connect(rootAdded)
		rootConns[2] = Workspace.ChildRemoved:Connect(rootRemoved)
		for _, c in ipairs(Workspace:GetChildren()) do rootAdded(c) end
	end
	onCleanup(turnOff)

	local setVisual
	setVisual = makeToggleCard("BigHeadsGui", "BigHeadsToggle", "BIG HEADS", 11, Color3.fromRGB(255, 120, 70), 2440, function()
		if on then turnOff() else turnOn() end
		return on
	end)
	FeatureHooks.bigheads = function() turnOff() setVisual(false) end
end)

runSection("7", function()
	local SAVE_FILE = "ui_layout.json"
	local ACCENT = Color3.fromRGB(130, 80, 255)
	local CARD_BG = Color3.fromRGB(20, 20, 27)
	local BTN_BG = Color3.fromRGB(46, 46, 60)
	local STROKE_OFF = Color3.fromRGB(55, 55, 68)

	local function screen()
		local cam = workspace.CurrentCamera
		local v = cam and cam.ViewportSize or Vector2.new(800, 450)
		return v.X, v.Y
	end

	local layout = Instance.new("ScreenGui")
	layout.Name = "LayoutEditorGui"
	layout.ResetOnSpawn = false
	layout.IgnoreGuiInset = true
	layout.DisplayOrder = 150
	layout.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	layout.Parent = PlayerGui

	local order = {}
	local UI_SIZE = 0.85 -- BUTTON SIZE (change it in-game with EDIT, then SIZE - / SIZE +; the choice is saved): all buttons are drawn at this multiple of their normal size (1 = v65 size, 0.75 = the old tiny v66 size, 1.3 = very big). Try 0.9 for a bit smaller or 1.1 for a bit bigger. Change this one number to resize everything; press RESET (in EDIT mode) once afterwards to re-grid.
	local scaleFactor = 1
	local editing = false
	local saved = {}
	local deviceKind = nil

	pcall(function()
		if isfile and readfile and isfile(SAVE_FILE) then
			local d = HttpService:JSONDecode(readfile(SAVE_FILE))
			if type(d) == "table" then
				saved = d
				if d.__device == "phone" or d.__device == "tablet" or d.__device == "pc" then deviceKind = d.__device end
				if type(d.__size) == "number" then UI_SIZE = math.clamp(d.__size, 0.2, 3) end
			end
		end
	end)

	local function curPos(it)
		local W, H = screen()
		local p = it.holder.Position
		return Vector2.new(p.X.Scale * W, p.Y.Scale * H)
	end

	local function setPos(it, p)
		local W, H = screen()
		local sx = it.w * scaleFactor
		local sy = it.h * scaleFactor
		local x = math.clamp(p.X, 0, math.max(W - sx, 0))
		local y = math.clamp(p.Y, 0, math.max(H - sy - it.pad * scaleFactor, 0))
		it.holder.Position = UDim2.fromScale(x / W, y / H)
	end

	local function save()
		if not writefile then return end
		local W, H = screen()
		local t = {}
		for _, it in ipairs(order) do
			local p = curPos(it)
			t[it.key] = { x = p.X / W, y = p.Y / H }
		end
		t.__device = deviceKind
		t.__size = UI_SIZE
		saved = t
		pcall(writefile, SAVE_FILE, HttpService:JSONEncode(t))
	end

	-- Default grid for the toggle cards: filled column by column, and the number of rows follows the screen height,
	-- so cards never pile up under each other. Columns are spread across the left ~70% of the screen.
	local GRID_KEYS = {
		"esp", "victim", "sin", "exec", "visor", "menlo", "hidehud", "teams", "taunt",
		"corpse_players", "corpse_npcs", "thirdperson", "fullbright", "qte", "infect", "attrboost",
		"bossmusic", "voicelines", "sin_loco", "execanim", "toolgrip_custom", "animreplace",
		"chainrage", "noidle", "magna", "music", "songs", "stun", "stunvoice",
		"viral_leader", "viral_runner", "viral_executioner", "weapon_pack",
		"dzero_pack", "dave_pack", "gilbert_pack", "gilbert_item", "tight_grip", "lightlock", "hatredgod", "forceequip", "forceequip_set", "corechat", "mutemusic", "taunt_anim", "taunt_fire", "blockanim", "autodetect", "nofreeze", "shiftlock", "bigheads", "lightreset",
	}
	local GRID_SET = {}
	for _, k in ipairs(GRID_KEYS) do GRID_SET[k] = true end

	local function gridPos(key, W, H, s)
		local present = {}
		for _, it in ipairs(order) do present[it.key] = true end
		local idx, n = nil, 0
		for _, k in ipairs(GRID_KEYS) do
			if present[k] then
				if k == key then idx = n end
				n += 1
			end
		end
		if not idx then return nil end
		local top = 0.30 * H
		local rowH = 58 * s
		local rows = math.max(1, math.floor((0.95 * H - top) / rowH))
		local cols = math.max(1, math.ceil(n / rows))
		local left = 0.02 * W
		local usable = math.max(W * 0.72 - left, 164 * s)
		local colW = math.clamp(usable / cols, 164 * s, 210 * s)
		return Vector2.new(left + math.floor(idx / rows) * colW, top + (idx % rows) * rowH)
	end

	local function defaultPos(key, W, H, s)
		if GRID_SET[key] then
			local gp = gridPos(key, W, H, s)
			if gp then return gp end
		end
