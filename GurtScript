runSection("21", function()
	local SoundService = game:GetService("SoundService")

	local RANGE = 40          -- studs from the NPC's body (its edge, not its center): music starts when you are this close
	local LEAVE_RANGE = 46    -- studs: music stops when it is this far (stops flicker at the edge)
	local MIN_HEALTH = 1500   -- NPC needs at least this much (max) health
	local VOLUME = 10         -- default boss volume (1 = normal, 10 = max); change it live with the BOSS slider in SONGS
	local MAGNA_VOLUME = 10   -- default MAGNA volume; change it live with the MAGNA slider in SONGS
	local MUSIC_VOLUME = 1    -- default MUSIC (loop) volume; change it live with the MUSIC slider in SONGS
	local CHECK_EVERY = 0.25  -- seconds between distance checks
	local FADE = 0.8          -- fade in / out seconds
	local MAGNA_REPEAT = false -- true = MAGNA starts over from the first song after the last one ends
	local OLD_MUSIC_VOLUMES = { 0.5, 1, 2, 4, 10 } -- only used to read the old VOL button setting from boss_music.json

	-- every mp3 in the repo. `path` is the URL-encoded file name in the repo; `file` is the name saved in your executor's workspace folder
	local TRACKS = {
		{ key = "parabola",      name = "Parabola",                        path = "TOOL%20-%20Parabola%20(Audio).mp3" },
		{ key = "metallica",     name = "Metallica",                       path = "Metallica.mp3" },
		-- Спокойная ночь
		{ key = "night",         name = "\u{421}\u{43F}\u{43E}\u{43A}\u{43E}\u{439}\u{43D}\u{430}\u{44F} \u{43D}\u{43E}\u{447}\u{44C}",
		                                                                   path = "%D0%A1%D0%BF%D0%BE%D0%BA%D0%BE%D0%B9%D0%BD%D0%B0%D1%8F%20%D0%BD%D0%BE%D1%87%D1%8C.mp3" },
		{ key = "anesthesia",    name = "Anesthesia",                      path = "Anesthesia%20(1).mp3" },
		{ key = "runaway",       name = "Jagad K - Run Away",              path = "01.%20Jagad%20K%20%E2%80%94%20Run%20Away.mp3" },
		{ key = "omega_inst",    name = "Slendytubbies 3 - Omega (Inst.)", path = "14.%20Slendytubbies%203%20Ost%20%E2%80%94%20Omega%20(Instrumental).mp3" },
		{ key = "chain_enraged", name = "Chain - Enraged Theme",           path = "ROBLOX%20CHAIN%20ENRAGED%20THEME%20OST.mp3" },
		{ key = "chain_p2",      name = "Chain - BGM Phase 2",             path = "Roblox%20Chain%20BGM%20-%20Phase%202%20%5BUnofficial%20Visualizer%5D.mp3" },
		{ key = "omega",         name = "Slendytubbies III - Omega",       path = "SlendyTubbies%20III%20-%20Omega.mp3" },
		{ key = "jaekelopterus", name = "Jaekelopterus fight song",        path = "Song%20that%20Plays%20when%20You%20Fight%20a%20Jaekelopterus.mp3", file = "Jaekelopterus_Theme.mp3" },
		{ key = "lv0",           name = "lv_0_20261017200555",             path = "lv_0_20261017200555.mp3" },
	}
	for _, t in ipairs(TRACKS) do t.file = t.file or ("ExamMusic_" .. t.key .. ".mp3") end

	local function idxOf(key)
		for i, t in ipairs(TRACKS) do if t.key == key then return i end end
		return nil
	end

	-- MAGNA order: Parabola, Metallica, Спокойная ночь, Anesthesia
	local MAGNA = { idxOf("parabola"), idxOf("metallica"), idxOf("night"), idxOf("anesthesia") }

	local function urlsFor(path)
		return {
			"https://raw.githubusercontent.com/absscidii/Examination/main/" .. path,
			"https://github.com/absscidii/Examination/raw/main/" .. path,
			"https://media.githubusercontent.com/media/absscidii/Examination/main/" .. path,
		}
	end

	---------------------------------------------------------------- state
	local bossOn, magnaOn, musicOn = false, false, false
	local near = false                       -- a big NPC is within range
	local mode = nil                         -- what should be audible right now: "boss" | "magna" | "music" | nil
	local token = 0                          -- bumps on every change so slow downloads can't start stale audio
	local magnaPos, magnaDone = 1, false
	local bossTrack, musicTrack = idxOf("jaekelopterus"), idxOf("parabola")
	local bossVol, magnaVol, musicVol = VOLUME, MAGNA_VOLUME, MUSIC_VOLUME
	local pickFor = "boss"                   -- what a tap in the SONGS list assigns: "boss" or "music"
	local bossSound, musicSound
	local infoLabel, noteLabel, render       -- panel bits, filled in below

	local SAVE = "boss_music.json"
	pcall(function()
		if not (isfile and readfile and isfile(SAVE)) then return end
		local d = HttpService:JSONDecode(readfile(SAVE))
		if type(d) ~= "table" then return end
		if type(d.boss) == "string" and idxOf(d.boss) then bossTrack = idxOf(d.boss) end
		if type(d.music) == "string" and idxOf(d.music) then musicTrack = idxOf(d.music) end
		if type(d.vol) == "number" and OLD_MUSIC_VOLUMES[d.vol] then musicVol = OLD_MUSIC_VOLUMES[d.vol] end -- old VOL button
		if type(d.bossVol) == "number" then bossVol = math.clamp(d.bossVol, 0, 10) end
		if type(d.magnaVol) == "number" then magnaVol = math.clamp(d.magnaVol, 0, 10) end
		if type(d.musicVol) == "number" then musicVol = math.clamp(d.musicVol, 0, 10) end
	end)
	local function saveChoice()
		if not writefile then return end
		pcall(writefile, SAVE, HttpService:JSONEncode({
			boss = TRACKS[bossTrack].key, music = TRACKS[musicTrack].key,
			bossVol = bossVol, magnaVol = magnaVol, musicVol = musicVol,
		}))
	end

	local function note(msg)
		print("[BossMusic] " .. tostring(msg))
		if noteLabel then noteLabel.Text = tostring(msg) end
	end

	---------------------------------------------------------------- downloading (each song is saved once, then reused)
	local function isAudio(body)
		if type(body) ~= "string" or #body < 10000 then return false end
		if string.sub(body, 1, 3) == "ID3" then return true end
		return string.byte(body, 1) == 0xFF and (string.byte(body, 2) or 0) >= 0xE0
	end

	local function fileOk(t)
		if t.good then return true end
		local ok, body = pcall(function()
			return isfile and readfile and isfile(t.file) and readfile(t.file)
		end)
		if ok and isAudio(body) then t.good = true end
		return t.good == true
	end

	local lastErr = "no response"
	local function fetch(url)
		local req = (syn and syn.request) or (http and http.request) or http_request or request
		if req then
			local ok, res = pcall(req, { Url = url, Method = "GET" })
			if ok and type(res) == "table" then
				if res.StatusCode == 200 and isAudio(res.Body) then return res.Body end
				lastErr = "HTTP " .. tostring(res.StatusCode) .. (res.StatusCode == 200 and " (not an mp3)" or "")
			elseif not ok then
				lastErr = tostring(res)
			end
		end
		local ok, res = pcall(function() return game:HttpGet(url) end)
		if ok and isAudio(res) then return res end
		return nil
	end

	local function download(t)
		if fileOk(t) then return true end
		if not writefile then note("cannot save songs: writefile not supported") return false end
		while t.downloading do task.wait(0.1) end
		if fileOk(t) then return true end
		t.downloading = true
		note("downloading " .. t.name .. "...")
		local body
		for _, url in ipairs(urlsFor(t.path)) do
			body = fetch(url)
			if body then break end
		end
		t.downloading = false
		if not body then note("download failed: " .. t.name .. " (" .. lastErr .. ")") return false end
		local ok, err = pcall(writefile, t.file, body)
		if not ok then note("writefile failed: " .. tostring(err)) return false end
		t.good = nil
		if fileOk(t) then note("saved " .. t.name) return true end
		note("saved file is not valid: " .. t.name)
		return false
	end

	-- yields; returns the rbxasset id for song i (downloads it first if needed)
	local function getAsset(i)
		local t = TRACKS[i]
		if not t then return nil end
		if t.asset then return t.asset end
		if not download(t) then return nil end
		local fn = getcustomasset or getsynasset
		if not fn then note("executor has no getcustomasset, cannot play local files") return nil end
		local ok, id = pcall(fn, t.file)
		if ok and id then t.asset = id else note("getcustomasset failed: " .. tostring(id)) end
		return t.asset
	end

	local function preload(list)
		task.spawn(function()
			for _, i in ipairs(list) do getAsset(i) end
		end)
	end

	---------------------------------------------------------------- sounds
	local function mkSound(name, looped)
		local s = Instance.new("Sound")
		s.Name = name
		s.Looped = looped
		s.Volume = 0
		s:SetAttribute("ScriptSound", true) -- exec-sound muting (section 19) leaves sounds with this attribute alone
		s.Parent = SoundService
		return s
	end
	bossSound = mkSound("BossMusic", true)
	musicSound = mkSound("BossMusicLoop", true)

	-- other music (long or looping sounds) is silenced while the boss song plays, then restored
	-- weak keys: every Sound the game ever creates in the world lands here, so destroyed ones must be collectable
	local allSounds = setmetatable({}, { __mode = "k" })
	local muted = setmetatable({}, { __mode = "k" })
	local watchConns = {}

	local function trackSound(s)
		if s:IsA("Sound") and s ~= bossSound and s ~= musicSound then allSounds[s] = true end
	end

	local function isMusic(s)
		return s.IsPlaying and (s.Looped or s.TimeLength >= 45)
	end

	local function startMuting()
		if #watchConns > 0 then return end
		for _, root in ipairs({ SoundService, Workspace, PlayerGui }) do
			for _, d in ipairs(root:GetDescendants()) do trackSound(d) end
			table.insert(watchConns, root.DescendantAdded:Connect(trackSound))
		end
	end

	local function sweepMusic()
		for s in pairs(allSounds) do
			if not s.Parent then
				allSounds[s], muted[s] = nil, nil
			elseif muted[s] then
				if s.Volume > 0 then s.Volume = 0 end
			elseif isMusic(s) and s.Volume > 0 then
				muted[s] = s.Volume
				s.Volume = 0
			end
		end
	end

	local function stopMuting()
		for _, c in ipairs(watchConns) do c:Disconnect() end
		table.clear(watchConns)
		for s, v in pairs(muted) do
			if s.Parent then s.Volume = v end
		end
		table.clear(muted)
		table.clear(allSounds)
	end

	---------------------------------------------------------------- playback
	-- fade a sound out, then pause it (unless it became wanted again meanwhile)
	local function fadeOutSound(s, stillWanted)
		if not (s and s.Parent) then return end
		local t = tween(s, FADE, { Volume = 0 })
		t.Completed:Connect(function()
			if s.Parent and not stillWanted() then s:Pause() end
		end)
	end
	local function bossWanted() return mode == "boss" or mode == "magna" end
	local function musicWanted() return mode == "music" end

	local function playBoss(idx, looped, my)
		local id = getAsset(idx)
		if my ~= token or not id then return false end
		startMuting()
		sweepMusic()
		bossSound.Looped = looped
		bossSound.SoundId = id
		bossSound.TimePosition = 0
		bossSound.Volume = 0
		bossSound:Play()
		tween(bossSound, FADE, { Volume = mode == "magna" and magnaVol or bossVol })
		note("playing " .. TRACKS[idx].name)
		return true
	end

	local function playMagna(my)
		while my == token and magnaPos <= #MAGNA do
			if playBoss(MAGNA[magnaPos], false, my) then return end
			if my ~= token then return end
			magnaPos += 1 -- that song would not load, skip to the next
		end
		if my == token then
			magnaDone = true
			stopMuting()
		end
	end

	-- MAGNA: when a song ends, the next one in order starts
	bossSound.Ended:Connect(function()
		if mode ~= "magna" or magnaDone then return end
		local my = token
		magnaPos += 1
		if magnaPos > #MAGNA then
			if MAGNA_REPEAT then
				magnaPos = 1
			else
				magnaDone = true
				stopMuting()
				note("MAGNA finished")
				return
			end
		end
		task.spawn(playMagna, my)
	end)

	local function target()
		if near and (magnaOn or bossOn) then return magnaOn and "magna" or "boss" end
		if musicOn then return "music" end
		return nil
	end

	local function reconcile(force)
		local want = target()
		if want == mode and not force then return end
		local prev = mode
		mode = want
		token += 1
		local my = token

		if (prev == "boss" or prev == "magna") and not bossWanted() then
			stopMuting()
			fadeOutSound(bossSound, bossWanted)
		end
		if prev == "music" and want ~= "music" then fadeOutSound(musicSound, musicWanted) end
		if not want then return end

		task.spawn(function()
			if want == "music" then
				local id = getAsset(musicTrack)
				if my ~= token or not id then return end
				if musicSound.SoundId ~= id then
					musicSound.SoundId = id
					musicSound.TimePosition = 0
				end
				musicSound:Play()
				tween(musicSound, FADE, { Volume = musicVol })
				note("music: " .. TRACKS[musicTrack].name)
			elseif want == "magna" then
				magnaPos, magnaDone = 1, false
				if musicSound.IsPlaying then fadeOutSound(musicSound, musicWanted) end
				playMagna(my)
			else
				if musicSound.IsPlaying then fadeOutSound(musicSound, musicWanted) end
				playBoss(bossTrack, true, my)
			end
		end)
	end

	---------------------------------------------------------------- finding a boss (big NPC nearby)
	local nearestInfo = nil
	local function bigNpcNear(range)
		nearestInfo = nil
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local myHum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or (myHum and myHum.Health <= 0) then return false end
		local folder = Workspace:FindFirstChild("Characters") or Workspace
		local pos = root.Position
		local bestD, bestName, bestHp = math.huge, nil, 0
		for _, m in ipairs(folder:GetChildren()) do
			if m:IsA("Model") and m ~= char
				and not Players:GetPlayerFromCharacter(m) and not Players:FindFirstChild(m.Name) then
				local hum = m:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					local hrp = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
					local hp = math.max(hum.MaxHealth, hum.Health)
					if hrp then
						local hd = (hrp.Position - pos).Magnitude
						if hd < bestD then bestD, bestName, bestHp = hd, m.Name, hp end
					end
					if hp >= MIN_HEALTH then
						local ok, cf, size = pcall(m.GetBoundingBox, m)
						if ok then
							local rel = cf:PointToObjectSpace(pos)
							local d = Vector3.new(
								math.max(math.abs(rel.X) - size.X / 2, 0),
								math.max(math.abs(rel.Y) - size.Y / 2, 0),
								math.max(math.abs(rel.Z) - size.Z / 2, 0)
							).Magnitude
							if d <= range then
								nearestInfo = string.format("BOSS: %s | HP %d | %d studs", m.Name, math.floor(hp), math.floor(d))
								return true
							end
						end
					end
				end
			end
		end
		if bestName then
			nearestInfo = string.format("nearest NPC: %s | HP %d | %d studs (needs HP %d+ within %d)", bestName, math.floor(bestHp), math.floor(bestD), MIN_HEALTH, math.floor(range))
		else
			nearestInfo = "no NPCs found in " .. (folder == Workspace and "workspace" or "workspace.Characters")
		end
		return false
	end

