		return r
	end

	local function fillRow(r, title, coords)
		if r.t ~= title then
			r.t = title
			r.title.Text = title
		end
		if r.c ~= coords then
			r.c = coords
			r.coords.Text = coords
		end
		if not r.shown then
			r.shown = true
			r.frame.Visible = true
		end
	end

	rebuild = function()
		local savedTab = tab == "saved"
		tabSaved.BackgroundColor3 = savedTab and TAB_SAVED_ON or ROW_BG
		tabItems.BackgroundColor3 = savedTab and ROW_BG or TAB_ITEMS_ON
		local n = 0
		if savedTab then
			for i, p in ipairs(presets) do
				n = i
				local r = getRow(i)
				r.kind, r.idx, r.data = "saved", i, p
				fillRow(r, p.name, coordText(p))
			end
		else
			local names = {}
			for key in pairs(assignments) do names[#names + 1] = key end
			table.sort(names)
			for i, key in ipairs(names) do
				n = i
				local a = assignments[key]
				local r = getRow(i)
				r.kind, r.key, r.data = "items", key, a
				fillRow(r, a.name, coordText(a))
			end
		end
		for i = n + 1, #rows do
			local r = rows[i]
			if r.shown then
				r.shown = false
				r.frame.Visible = false
			end
		end
		if n == 0 then emptyLabel.Text = savedTab and "No saved positions yet" or "No items assigned yet" end
		emptyLabel.Visible = n == 0
	end

