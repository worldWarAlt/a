-- feature name -> function that switches that feature off (used by Settings when a button is hidden)
local FeatureHooks = {}
local ExecAudio = { setMute = function() end, setTaunt = function() end } -- filled in by section 19
local Extras = { setNameTag = function() end, setInstant = function() end } -- filled in by section 20

---------------------------------------------------------------- animation kit
local Kit = {}
Kit.protect = setmetatable({}, { __mode = "k" }) -- animation tracks nothing else may demote / stop (ANIM REPLACE's replacements)
Kit.arIds = {}                                   -- game animation ids ANIM REPLACE is handling right now (SIN leaves those alone)
Kit.viral = { on = false, loco = false, swingIds = {} }        -- VIRAL packs (section 27): on = a pack is active, swingIds = game swing ids it replaces (SIN / ANIM REPLACE / SWAP ANIM step aside)
local trackCache = setmetatable({}, { __mode = "k" })
local idCache    = setmetatable({}, { __mode = "k" })
local setCache   = setmetatable({}, { __mode = "k" })
local nameCache  = setmetatable({}, { __mode = "k" })

local LOG_ENABLED = false
env.__ScriptRun = (env.__ScriptRun or 0) + 1
local RUN_ID = env.__ScriptRun
local logLines = {}
local logLabel

function Kit.log(msg)
	if not LOG_ENABLED then return end
	local line = string.format("r%d %.2f %s", RUN_ID, os.clock() % 1000, msg)
	table.insert(logLines, line)
	if #logLines > 15 then table.remove(logLines, 1) end
end

function Kit.describe(track)
	local ok, text = pcall(function()
		local id = nameCache[track] or (function()
			local a = track.Animation
			return a and string.match(tostring(a.AnimationId), "%d+") or "?"
		end)()
		return string.format("%s %s len=%.2f w=%.2f", id, track.Priority.Name, track.Length, track.WeightTarget)
	end)
	return ok and text or "?"
end

function Kit.digits(id)
	return string.match(tostring(id or ""), "%d+")
end

function Kit.idOf(track)
	local id = idCache[track]
	if id == nil then
		local anim = track.Animation
		local s = anim and tostring(anim.AnimationId) or ""
		id = string.match(s, "id=(%d+)") or string.match(s, "%d+") or false
		idCache[track] = id
	end
	return id or nil
end

function Kit.matches(track, ids)
	local set = setCache[ids]
	if not set then
		set = {}
		for _, target in ipairs(ids) do
			local d = Kit.digits(target)
			if d then set[d] = true end
		end
		setCache[ids] = set
	end
	local id = Kit.idOf(track)
	return id ~= nil and set[id] == true
end

function Kit.get(animator, id)
	local byId = trackCache[animator]
	if not byId then
		byId = {}
		trackCache[animator] = byId
		-- tracks reference their animator, so a weak key alone never frees it: drop the entry explicitly
		pcall(function()
			animator.Destroying:Once(function()
				local t = trackCache[animator]
				if t then
					for _, tr in pairs(t) do nameCache[tr] = nil idCache[tr] = nil end
				end
				trackCache[animator] = nil
			end)
		end)
	end
	if byId[id] then return byId[id] end
	local anim = Instance.new("Animation")
	anim.AnimationId = id
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	anim:Destroy()
	if not ok or not track then return nil end
	byId[id] = track
	nameCache[track] = Kit.digits(id)
	return track
end

function Kit.warm(animator, id)
	task.spawn(function()
		local t = Kit.get(animator, id)
		if not t then return end
		local t0 = os.clock()
		while t.Length <= 0 and os.clock() - t0 < 8 do task.wait() end
		if t.Length <= 0 then return end
		if t.IsPlaying then return end
		t:Play(0, 0.001, 1)
		task.wait()
		if t.IsPlaying and t.WeightTarget <= 0.01 then t:Stop(0) end
	end)
end

function Kit.nearestVictim(myChar, range, npcOnly)
	local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not root then return nil end

	local pool
	local folder = Workspace:FindFirstChild("Characters")
	if folder then
		pool = folder:GetChildren()
	else
		pool = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character then table.insert(pool, p.Character) end
		end
	end

	local best, bestDist = nil, range
	for _, c in ipairs(pool) do
		local isPlayerChar = npcOnly and (Players:GetPlayerFromCharacter(c) ~= nil or Players:FindFirstChild(c.Name) ~= nil)
		if c ~= myChar and c:IsA("Model") and not isPlayerChar then
			local hrp = c:FindFirstChild("HumanoidRootPart")
			local hum = c:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				local d = (hrp.Position - root.Position).Magnitude
				if d <= bestDist then best, bestDist = c, d end
			end
		end
	end
	return best
end

local demoted = setmetatable({}, { __mode = "k" })

function Kit.demote(track, owner)
	local info = demoted[track]
	if not info then
		info = { priority = track.Priority, owners = {} }
		demoted[track] = info
		pcall(function() track.Priority = Enum.AnimationPriority.Idle end)
	end
	info.owners[owner] = true
end

Kit.watching = setmetatable({}, { __mode = "k" })

function Kit.restore(owner)
	for track, info in pairs(demoted) do
		if info.owners[owner] then
			info.owners[owner] = nil
			if next(info.owners) == nil then
				pcall(function() track.Priority = info.priority end)
				demoted[track] = nil
			end
		end
	end
	for orig, w in pairs(Kit.watching) do
		if w.opt.owner == owner then Kit.watching[orig] = nil end
	end
end

function Kit.silence(track, owner)
	Kit.demote(track, owner)
	track:AdjustWeight(0, 0)
end

-- OUR execution sound (SIN / VISA3 / VIRAL weapons). It is tagged "ScriptSound" BEFORE it is parented, so the
-- "Mute exec sounds" muter (section 19) only ever silences the GAME's sound of the execution that got replaced, never this one.
-- Only one runs at a time: a second request right after the first one (the game chaining several execution tracks, or two
-- characters / animators reporting the same execution) is ignored, so the sound can't play twice.
Kit.EXEC_SFX_GAP = 0.06
Kit.execSfxAt = -1e9
Kit.execSfxCurrent = nil
function Kit.execSfx(soundId, volume, parent, speed)
	if not soundId then return nil end
	local now = os.clock()
	if now - Kit.execSfxAt < Kit.EXEC_SFX_GAP then return nil end
	Kit.execSfxAt = now
	local prev = Kit.execSfxCurrent
	Kit.execSfxCurrent = nil
	if prev then pcall(function() prev:Stop() prev:Destroy() end) end
	local ok, s = pcall(function()
		local snd = Instance.new("Sound")
		snd.SoundId = soundId
		snd:SetAttribute("ScriptSound", true) -- must be set before Parent: the muter looks at it the moment the Sound appears
		snd.Volume = volume or 1
		snd.PlaybackSpeed = speed or 1
		snd.Parent = parent or Workspace
		snd:Play()
		snd.Ended:Once(function()
			if Kit.execSfxCurrent == snd then Kit.execSfxCurrent = nil end
			snd:Destroy()
		end)
		task.delay(10, function() if snd.Parent then snd:Destroy() end end)
		return snd
	end)
	if ok and s then
		Kit.execSfxCurrent = s
		return s
	end
	return nil
end

Kit.live = {}
Kit.lastStart = -1e9
Kit.lastEnd = -1e9
Kit.REFRACTORY = 0.2
Kit.HIT_LOCKOUT = 0.25

function Kit.claim(track, kind)
	for other in pairs(Kit.live) do
		if other ~= track and other.IsPlaying then other:Stop(0) end
	end
	Kit.live[track] = { t = os.clock(), kind = kind or "move" }
	Kit.lastStart = os.clock()
	track.Stopped:Once(function()
		if not track.IsPlaying then
			Kit.lastEnd = os.clock()
		end
	end)
end

function Kit.execPlaying()
	for track, info in pairs(Kit.live) do
		if info.kind == "exec" and track.IsPlaying then return true end
	end
	return false
end

function Kit.enforce()
	local newest, newestT, count = nil, -1e9, 0
	for track, info in pairs(Kit.live) do
		if track.IsPlaying then
			count += 1
			if info.t > newestT then newest, newestT = track, info.t end
		else
			Kit.live[track] = nil
		end
	end
	if count > 1 then
		for track in pairs(Kit.live) do
			if track ~= newest and track.IsPlaying then track:Stop(0) end
		end
	end
end

function Kit.tick()
	if next(Kit.live) == nil and next(Kit.watching) == nil then return end -- nothing to police
	Kit.enforce()
	local now = os.clock()
	for orig, w in pairs(Kit.watching) do
		local elapsed = now - w.t
		local expected = (w.rep.Length - w.start) / math.max(w.speed, 0.01)
		if elapsed > 0.2 or elapsed > expected * 0.5 or not orig.IsPlaying then
			Kit.watching[orig] = nil
		elseif not w.rep.IsPlaying and w.tries < 1 then
			w.tries += 1
			w.rep:Play(0, w.opt.weight or 1, w.speed)
			w.rep.TimePosition = w.start
		end
	end
end

bind(RunService.RenderStepped:Connect(Kit.tick))

function Kit.swap(animator, original, repId, opt, lock)
	local now = os.clock()
	local window = 0.15 -- rapid-fire stop window

	-- If played again in under 0.4 seconds, stop the active replacement animation
	if lock.startedAt and (now - lock.startedAt) < window then
		if lock.rep and lock.rep.IsPlaying then
			lock.rep:Stop(0)
		end
		lock.rep = nil
		lock.startedAt = nil
		lock.origs = nil
		Kit.silence(original, opt.owner)
		return nil, "stopped"
	end

	local busy = nil
	if opt.override then
		-- an overriding swap (SWAP ANIM) never waits for other animations: only its own earlier replacement can block it
		if lock.rep and lock.rep.IsPlaying then busy = "rep playing" end
	elseif Kit.execPlaying() then busy = "execution playing"
	elseif lock.rep and lock.rep.IsPlaying then busy = "rep playing"
	elseif now - Kit.lastStart < (opt.hitLockout or Kit.HIT_LOCKOUT) then busy = "other started"
	elseif now - Kit.lastEnd < (opt.refractory or Kit.REFRACTORY) then busy = "just ended"
	end
	if not busy and lock.origs and now - (lock.startedAt or -1e9) < 0.6 then
		for o in pairs(lock.origs) do
			if o ~= original and o.IsPlaying then busy = "game move still running" break end
		end
	end
	if busy then
		Kit.silence(original, opt.owner)
		return nil, "lock"
	end

	local rep = Kit.get(animator, repId)
	if not rep or rep.Length <= 0 then
		return nil, "unloaded"
	end

	Kit.silence(original, opt.owner)

	rep.Priority = Enum.AnimationPriority.Action4
	rep.Looped = opt.loop or false
	if rep.IsPlaying then rep:Stop(0) end
	Kit.claim(rep, "move")

	local len = rep.Length
	local start = opt.start or 0
	local speed = opt.speed or 1
	start = math.clamp(start, 0, math.max(len - 0.05, 0))

	rep:Play(opt.fadeIn or 0, opt.weight or 1, speed)
	rep.TimePosition = start

	lock.rep = rep
	lock.startedAt = now
	lock.origs = { [original] = true }

	local trim = opt.trimEnd and opt.trimEnd[Kit.digits(repId)]
	lock.stopToken = nil
	if trim and trim > 0 then
		local playFor = (len - start - trim) / math.max(speed, 0.01)
		if playFor > 0.05 then
			local token = {}
			lock.stopToken = token
			task.delay(playFor, function()
				if lock.stopToken == token and lock.rep == rep and rep.IsPlaying then
					rep:Stop(opt.trimFade or 0)
				end
			end)
		end
	end
	if opt.owner ~= "sin" then
		Kit.watching[original] = { rep = rep, t = now, start = start, speed = speed, opt = opt, tries = 0 }
	else
		Kit.watching[original] = nil
	end
	return rep
end

-- Kit.override(animator, track): while `track` plays it wins over every other animation. Everything else that would compete
-- with it (priority Action3 / Action4: SIN, executions, the game's own actions) is pushed down to Action2 and put back
-- when the last overriding track is done. Event based: one listener per animator and one step, both only alive while an
-- overriding track is playing. The step runs right before animations are evaluated, so nothing can raise a priority back.
local Over = { tracks = {}, under = {}, listeners = {}, step = nil }
local OVER_FROM = Enum.AnimationPriority.Action3.Value
local OVER_BELOW = Enum.AnimationPriority.Core.Value -- Core is the lowest priority of all: never touched
local OVER_PRIO = Enum.AnimationPriority.Action2
local OVER_GRACE = 0.15 -- seconds a fresh overriding track may still report "not playing"
local overSignal = RunService.RenderStepped
pcall(function() overSignal = RunService.PreAnimation end)

local function overSetPrio(t, p) t.Priority = p end

local function overPush(t)
	if Over.tracks[t] then return end
	local v = t.Priority.Value
	if v < OVER_FROM or v >= OVER_BELOW then return end
	Over.under[t] = t.Priority
	t.Priority = OVER_PRIO
end

local function overEnd()
	if Over.step then Over.step:Disconnect() Over.step = nil end
	for a, c in pairs(Over.listeners) do
		c:Disconnect()
		Over.listeners[a] = nil
	end
	for t, p in pairs(Over.under) do
		Over.under[t] = nil
		pcall(overSetPrio, t, p)
	end
end

local function overStep()
	local any, now = false, os.clock()
	for t, t0 in pairs(Over.tracks) do
		if t.IsPlaying or now - t0 < OVER_GRACE then
			any = true
		else
			Over.tracks[t] = nil
		end
	end
	if not any then overEnd() return end
	for t in pairs(Over.under) do -- a script that raised a pushed track again gets it pushed down again
		local v = t.Priority.Value
		if v >= OVER_FROM and v < OVER_BELOW then
			Over.under[t] = t.Priority
			t.Priority = OVER_PRIO
		end
	end
end

function Kit.override(animator, track)
	Over.tracks[track] = os.clock()
	for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
		if t ~= track then overPush(t) end
	end
	if not Over.listeners[animator] then
		Over.listeners[animator] = animator.AnimationPlayed:Connect(overPush)
	end
	if not Over.step then Over.step = overSignal:Connect(overStep) end
end

function Kit.overrideEnd() -- feature turned off: let go of everything right now
	table.clear(Over.tracks)
	overEnd()
end

local victimLast = setmetatable({}, { __mode = "k" })
local victimState = setmetatable({}, { __mode = "k" })
local victimActive = {}

local function victimFinish(state, token)
	if state.token ~= token or state.done then return end
	state.done = true
	victimActive[state] = nil
	for _, c in ipairs(state.conns) do c:Disconnect() end
	table.clear(state.conns)
	for t, info in pairs(state.muted) do
		if t.IsPlaying then
			if info.loop then t:AdjustWeight(info.w, 0.1) else t:Stop(0.1) end
		end
	end
	table.clear(state.muted)
end
onCleanup(function()
	for st in pairs(victimActive) do victimFinish(st, st.token) end
end)

-- immediately ends every victim animation started by `owner` (nil = all): restores the muted tracks and stops ours
function Kit.stopVictims(owner)
	for st in pairs(victimActive) do
		if owner == nil or st.owner == owner then
			local tr = st.track
			victimFinish(st, st.token)
			if tr then pcall(function() if tr.IsPlaying then tr:Stop(0.1) end end) end
		end
	end
	for animator, last in pairs(victimLast) do
		if owner == nil or last.owner == owner then victimLast[animator] = nil end
	end
end

function Kit.playOnVictim(victim, animId, opt)
	opt = opt or {}
	local hum = victim:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then return end

	local track = Kit.get(animator, animId)
	if not track then return end

	local fade = opt.fadeIn or 0.05

	if opt.dedupe then
		local last = victimLast[animator]
		if last and last.track.IsPlaying then
			if last.track == track and os.clock() - last.t < 0.3 then return end
			if last.track ~= track then last.track:Stop(0) end
		end
		victimLast[animator] = { track = track, t = os.clock(), owner = opt.owner }
	end

	local state = victimState[animator]
	if state and not state.done then
		for _, c in ipairs(state.conns) do c:Disconnect() end
		table.clear(state.conns)
	else
		state = { muted = {}, conns = {}, done = false }
		victimState[animator] = state
	end
	local token = {}
	state.token = token
	state.t0 = os.clock()
	state.track = track
	state.owner = opt.owner
	victimActive[state] = true

	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = false
	if track.IsPlaying then track:Stop(0) end

	local function muteOthers(f)
		for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
			if t ~= track and t.WeightTarget > 0 then
				if state.muted[t] == nil then state.muted[t] = { w = t.WeightTarget, loop = t.Looped } end
				t:AdjustWeight(0, f)
			end
		end
	end
	muteOthers(fade)

	track:Play(fade, opt.weight or 1, opt.speed or 1)

	table.insert(state.conns, animator.AnimationPlayed:Connect(function()
		if state.token == token then muteOthers(0) end
	end))
	table.insert(state.conns, RunService.RenderStepped:Connect(function()
		if state.token ~= token then return end
		muteOthers(0)
		if not track.IsPlaying and os.clock() - state.t0 > 0.5 then victimFinish(state, token) end
	end))
	track.Stopped:Once(function()
		if state.token ~= token or track.IsPlaying then return end
		victimFinish(state, token)
	end)
end

---------------------------------------------------------------- 1) stamina (boosted & infinite)
runSection("1", function()
	local cachedStateObj = nil
	local cachedBar = nil
	local FULL_BAR = UDim2.new(1, 0, 1, 0)

	local function isEnabled()
		local Toggles = env.Toggles or rawget(_G, "Toggles")
		local toggle = Toggles and Toggles.inf_stamina_toggle
		if toggle == nil then return true end
		return toggle.Value == true
	end

	local function getBar()
		if cachedBar and cachedBar.Parent then return cachedBar end
		local gui = PlayerGui:FindFirstChild("Gui")
		local statusFrame = gui and gui:FindFirstChild("statusFrame")
		local stamina = statusFrame and statusFrame:FindFirstChild("stamina")
		cachedBar = stamina and stamina:FindFirstChild("bar") or nil
		return cachedBar
	end

	local function applyStamina()
		if not isEnabled() then return end

		local char = LocalPlayer.Character
		if not char then return end

		if not cachedStateObj then
			local clientHandler = char:FindFirstChild("ClientHandler") or char:FindFirstChild("Client")
			local stateMod = clientHandler and clientHandler:FindFirstChild("State")
			if stateMod then
				pcall(function() cachedStateObj = require(stateMod) end)
			end
		end

		local st = cachedStateObj and cachedStateObj.stamina
		if type(st) == "table" then
			st.max = 1000
			st.current = 1000
		end

		local bar = getBar()
		if bar and bar.Size ~= FULL_BAR then bar.Size = FULL_BAR end
	end

	bind(LocalPlayer.CharacterAdded:Connect(function()
		cachedStateObj = nil
		cachedBar = nil
	end))
	bind(RunService.Heartbeat:Connect(applyStamina))
end)

---------------------------------------------------------------- 2) ESP
-- v69 rewrite, based on the Roblox docs / devforum:
--  * only 31 Highlights are ever drawn at once, extra ones are silently ignored and a DISABLED one still uses a slot -> only the nearest MAX_HIGHLIGHTS
--    get one (and unused ones are deleted, not disabled); adding / removing Highlights causes lag spikes, so a swap only happens when the new one is clearly closer
--  * every BillboardGui with text is its own draw call and text re-layouts are expensive -> only the nearest few are shown, and the text is only rewritten
--    when the shown number really changed (no HealthChanged connection per character any more, one throttled loop does everything)
--  * highlights / billboards live in their own folder (not inside the character), so a game that cleans up its characters cannot delete them; anything
--    that still disappears is re-created by the loop
runSection("2", function()
	local CharactersFolder = Workspace:FindFirstChild("Characters") or Workspace:WaitForChild("Characters", 5)

	local espEnabled = false
	local tracked = {} -- [char] = { char, humanoid, head, color, highlight, billboard, label, hp, maxHp, dist }
	local stepConn = nil

	local COLOR_PLAYER = Color3.fromRGB(0, 255, 100)
	local COLOR_OTHER  = Color3.fromRGB(255, 50, 50)
	local MAX_TEXT_DISTANCE = 125
	local MAX_BILLBOARDS = 25   -- name / health labels shown at once (nearest first)
	local MAX_HIGHLIGHTS = 30   -- Roblox draws 31 at once; one slot is left free
	local HIGHLIGHT_RANGE = 1500
	local SWAP_MARGIN = 10      -- studs a waiting target must be closer than the farthest holder before they swap (stops flicker / spikes)
	local STEP = 0.15           -- seconds between updates

	local container = nil
	local function getContainer()
		if container and container.Parent then return container end
		container = Instance.new("Folder")
		container.Name = "ESPContainer"
		container.Parent = Workspace
		return container
	end

	local function isPlayerCharacter(char)
		return Players:GetPlayerFromCharacter(char) ~= nil or Players:FindFirstChild(char.Name) ~= nil
	end

	local function dropHighlight(e)
		if e.highlight then pcall(function() e.highlight:Destroy() end) e.highlight = nil end
	end
	local function dropBillboard(e)
		if e.billboard then pcall(function() e.billboard:Destroy() end) e.billboard, e.label, e.hp, e.maxHp = nil, nil, nil, nil end
	end
	local function untrack(char)
		local e = tracked[char]
		if not e then return end
		tracked[char] = nil
		dropHighlight(e)
		dropBillboard(e)
	end

	local function giveHighlight(e)
		local h = Instance.new("Highlight")
		h.Name = "ESPHighlight"
		h.FillColor = e.color
		h.OutlineColor = Color3.fromRGB(255, 255, 255)
		h.FillTransparency = 0.5
		h.OutlineTransparency = 0.2
		h.Adornee = e.char
		h.Parent = getContainer()
		e.highlight = h
	end

	local function ensureBillboard(e)
		if e.billboard and e.billboard.Parent and e.label then return end
		dropBillboard(e)
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "ESPBillboard"
		billboard.Size = UDim2.new(0, 180, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 3.5, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = MAX_TEXT_DISTANCE
		billboard.Adornee = e.head

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = e.color
		label.TextStrokeTransparency = 0.2
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.Font = Enum.Font.SourceSansBold
		label.TextSize = 14
		label.Parent = billboard

		billboard.Parent = getContainer()
		e.billboard, e.label, e.hp, e.maxHp = billboard, label, nil, nil
	end

	local function step()
		local cam = Workspace.CurrentCamera
		if not cam then return end
		local camPos = cam.CFrame.Position

		local list = {}
		for char, e in pairs(tracked) do
			if e.humanoid then
				if not char:IsDescendantOf(Workspace) then
					untrack(char)
				else
					-- the game replaced the Humanoid / Head: find the new ones
					if e.humanoid.Parent ~= char then e.humanoid = char:FindFirstChildOfClass("Humanoid") or e.humanoid end
					if e.head.Parent ~= char then
						e.head = char:FindFirstChild("Head") or char.PrimaryPart or e.head
						if e.billboard then e.billboard.Adornee = e.head end
					end
					if e.humanoid.Health <= 0 then
						untrack(char)
					else
						local root = char:FindFirstChild("HumanoidRootPart") or e.head
						e.dist = root and (root.Position - camPos).Magnitude or math.huge
						if e.highlight and not e.highlight.Parent then e.highlight = nil end -- deleted by something else: re-created below
						list[#list + 1] = e
					end
				end
			end
		end
		table.sort(list, function(a, b) return a.dist < b.dist end)

		-- name / health labels: nearest few only, text rewritten only when the shown numbers changed
		local shown = 0
		for _, e in ipairs(list) do
			if shown < MAX_BILLBOARDS and e.dist <= MAX_TEXT_DISTANCE + 5 then
				shown += 1
				ensureBillboard(e)
				local hp = math.floor(math.max(0, e.humanoid.Health))
				local maxHp = math.floor(e.humanoid.MaxHealth)
				if hp ~= e.hp or maxHp ~= e.maxHp then
					e.hp, e.maxHp = hp, maxHp
					e.label.Text = string.format("%s\n[%d / %d HP]", e.char.Name, hp, maxHp)
				end
				e.billboard.Enabled = true
			elseif e.billboard then
				e.billboard.Enabled = false
			end
		end

		-- highlights: the nearest MAX_HIGHLIGHTS, with a margin so the set does not flicker
		local count = 0
		for _, e in ipairs(list) do
			if e.highlight and e.dist > HIGHLIGHT_RANGE then dropHighlight(e) end
			if e.highlight then count += 1 end
		end
		local waiting, outsideHolders, inside = {}, {}, 0
		for _, e in ipairs(list) do
			if e.dist <= HIGHLIGHT_RANGE then
				inside += 1
				if inside <= MAX_HIGHLIGHTS then
					if not e.highlight then waiting[#waiting + 1] = e end
				elseif e.highlight then
					outsideHolders[#outsideHolders + 1] = e -- nearest first, so the farthest holder is the last one
				end
			end
		end
		for _, cand in ipairs(waiting) do
			if count < MAX_HIGHLIGHTS then
				giveHighlight(cand)
				count += 1
			else
				local far = outsideHolders[#outsideHolders]
				if far and far.dist - cand.dist > SWAP_MARGIN then
					outsideHolders[#outsideHolders] = nil
					dropHighlight(far)
					giveHighlight(cand)
				else
					break
				end
			end
		end
	end

	local function track(char)
		if not char:IsA("Model") then return end
		if char == LocalPlayer.Character or char.Name == LocalPlayer.Name then return end
		if tracked[char] then return end
		local entry = { char = char } -- reserved right away so the same character is never set up twice
		tracked[char] = entry
		task.spawn(function()
			local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 3)
			local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 3) or char.PrimaryPart
			if not espEnabled or tracked[char] ~= entry or not humanoid or not head then
				if tracked[char] == entry then tracked[char] = nil end
				return
			end
			entry.color = isPlayerCharacter(char) and COLOR_PLAYER or COLOR_OTHER
			entry.humanoid, entry.head, entry.dist = humanoid, head, math.huge
		end)
	end

	local function disableAllESP()
		espEnabled = false
		if stepConn then stepConn:Disconnect() stepConn = nil end
		for char in pairs(tracked) do untrack(char) end
		if container then pcall(function() container:Destroy() end) container = nil end
	end

	local function listCharacters()
		if CharactersFolder then return CharactersFolder:GetChildren() end
		local out = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character then table.insert(out, p.Character) end
		end
		return out
	end

	if CharactersFolder then
		bind(CharactersFolder.ChildAdded:Connect(function(child)
			if espEnabled then track(child) end
		end))
		bind(CharactersFolder.ChildRemoved:Connect(untrack))
	else
		local function watchPlayer(p)
			if p == LocalPlayer then return end
			bind(p.CharacterAdded:Connect(function(c)
				if espEnabled then track(c) end
			end))
			bind(p.CharacterRemoving:Connect(untrack))
		end
		for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
		bind(Players.PlayerAdded:Connect(watchPlayer))
	end
	onCleanup(disableAllESP)

	-- leftovers of an earlier run / the old ESP (instances inside the characters, or an old container)
	local old = Workspace:FindFirstChild("ESPContainer")
	if old then old:Destroy() end
	for _, c in ipairs(listCharacters()) do
		for _, n in ipairs({ "ESPHighlight", "ESPBillboard" }) do
			local o = c:FindFirstChild(n)
			if o then o:Destroy() end
		end
	end

	makeToggleCard("ESPToggleGui", "ToggleButton", "ESP", 15, Color3.fromRGB(46, 213, 115), 0, function()
		if espEnabled then
			disableAllESP()
		else
			espEnabled = true
			for _, child in ipairs(listCharacters()) do track(child) end
			local acc = STEP -- first update right away
			stepConn = RunService.Heartbeat:Connect(function(dt)
				acc += dt
				if acc < STEP then return end
				acc = 0
				local ok, err = pcall(step)
				if not ok then warn("[ESP] " .. tostring(err)) end
			end)
		end
		return espEnabled
	end)
end)

