	local function stopLoco(animator)
		if not animator then return end
		for _, id in ipairs({BASE_IDLE, BASE_WALK, BASE_RUN, SLEDGE_IDLE, SLEDGE_WALK, SLEDGE_RUN}) do
			local tr = Kit.get(animator, id)
			if tr and tr.IsPlaying then tr:Stop(0.12) end
		end
		locoCurrent = nil
	end
	local function playLoco(animator, id, priority)
		if locoCurrent == id then
			local current = Kit.get(animator, id)
			if current then
				current.Priority = priority
				current.Looped = true
				if not current.IsPlaying then current:Play(0.12, 1, 1) end
			end
			return
		end
		stopLoco(animator)
		local tr = Kit.get(animator, id)
		if not tr then warn("[SIN] Could not load locomotion animation " .. id) return end
		tr.Priority = priority
		tr.Looped = true
		local ok, err = pcall(function() tr:Play(0.12, 1, 1) end)
		if ok then locoCurrent = id else warn("[SIN] locomotion Play failed: " .. tostring(err)) end
	end
	-- SIN grips: the held sledgehammer's Tool.Grip changes with what SIN is doing (values come from the saved presets).
	-- Same grip maths as CUSTOM GRIP: grip = original * (move, then tilt)^-1, so 0,0,0 is the tool's normal hold.
	-- One table on purpose (this section is close to the local-variable limit).
	local SinGrip = {
		idle  = { x = -0.1, y = 0,    z = 0,   rx = 25,  ry = 3,  rz = 99 },  -- preset "sin": the default sledgehammer grip
		swing = { x = -0.3, y = 0.4,  z = 0.1, rx = -20, ry = -7, rz = 11 },  -- preset "sledge hammer swing": game anim 97660793956521 only
		stun  = { x = -1.2, y = -2.5, z = 0,   rx = 31,  ry = 55, rz = -41 }, -- preset "stun": only while stunned
		-- the game swing animation and the two animations that replace it (SIN swap / ANIM REPLACE): any of them playing = swinging
		SWING_IDS = { ["97660793956521"] = true, ["109639053938974"] = true, ["111371061821635"] = true },
		animator = nil, DEBUG = false,
		orig = setmetatable({}, { __mode = "k" }),
		swings = 0, state = nil, tool = nil, want = nil, conn = nil, n = 0, t0 = 0, swingConn = nil,
	}
	function SinGrip.cf(orig, g)
		local t = CFrame.new(g.x, g.y, g.z) * CFrame.Angles(math.rad(g.rx), math.rad(g.ry), math.rad(g.rz))
		return orig * t:Inverse()
	end
	-- writes Tool.Grip and also the RightGrip weld's C1 (the default tool system keeps them in sync; a custom one may not)
	function SinGrip.write(tool, cf)
		pcall(function() tool.Grip = cf end)
		pcall(function()
			local h = tool:FindFirstChild("Handle")
			if h then
				for _, j in ipairs(h:GetJoints()) do
					if j.Name == "RightGrip" then j.C1 = cf end
				end
			end
		end)
	end
	-- is a swing animation playing right now? (checked on the controller's animator and on workspace.Characters.<you>)
	function SinGrip.scanSwing()
		local function scan(a)
			if not a then return false end
			for _, t in ipairs(a:GetPlayingAnimationTracks()) do
				local id = Kit.idOf(t)
				if id and SinGrip.SWING_IDS[id] and t.IsPlaying then return true end
			end
			return false
		end
		if scan(SinGrip.animator) then return true end
		local f = Workspace:FindFirstChild("Characters")
		local m = f and f:FindFirstChild(LocalPlayer.Name)
		local hum = m and m:FindFirstChildOfClass("Humanoid")
		return scan(hum and hum:FindFirstChildOfClass("Animator"))
	end
	function SinGrip.restore()
		local tool = SinGrip.tool
		if SinGrip.conn then SinGrip.conn:Disconnect() SinGrip.conn = nil end
		if tool then
			local o = SinGrip.orig[tool]
			if o then SinGrip.write(tool, o) end
		end
		SinGrip.tool, SinGrip.state, SinGrip.want = nil, nil, nil
	end
	function SinGrip.held()
		local c = LocalPlayer.Character
		local t = c and c:FindFirstChildOfClass("Tool")
		if not t then
			local f = Workspace:FindFirstChild("Characters")
			local m = f and f:FindFirstChild(LocalPlayer.Name)
			t = m and m:FindFirstChildOfClass("Tool")
		end
		return t
	end
	function SinGrip.update()
		if not locoEnabled or Kit.customGripOn then
			if SinGrip.tool then SinGrip.restore() end
			return
		end
		-- the "sin" grip is the default for the sledgehammer (idle, walk, run, anything); only a swing or a stun changes it
		local state = "idle"
		if stunBusy then state = "stun"
		elseif SinGrip.swings > 0 or SinGrip.scanSwing() then state = "swing" end
		local tool = SinGrip.held()
		if tool then
			local nm = string.lower(tool.Name)
			if not (sledgeOn or string.find(nm, "sledge", 1, true) or string.find(nm, "hammer", 1, true)) then tool = nil end
		end
		if not tool then
			if SinGrip.tool then SinGrip.restore() end
			return
		end
		if tool == SinGrip.tool and state == SinGrip.state then return end
		if SinGrip.tool and SinGrip.tool ~= tool then SinGrip.restore() end
		if not SinGrip.orig[tool] then SinGrip.orig[tool] = tool.Grip end
		SinGrip.tool, SinGrip.state = tool, state
		local want = SinGrip.cf(SinGrip.orig[tool], SinGrip[state])
		SinGrip.want = want
		if SinGrip.DEBUG then warn("[SIN grip] " .. state .. " -> " .. tool.Name) end
		SinGrip.write(tool, want)
		if not SinGrip.conn then
			-- if the game resets the grip, put ours back (at most 8 times per 0.1s so nothing can ping-pong)
			SinGrip.conn = tool:GetPropertyChangedSignal("Grip"):Connect(function()
				local w = SinGrip.want
				if not w or tool.Grip == w then return end
				local now = os.clock()
				if now - SinGrip.t0 > 0.1 then SinGrip.t0, SinGrip.n = now, 0 end
				SinGrip.n += 1
				if SinGrip.n <= 8 then tool.Grip = w end
			end)
		end
	end
	Kit.sinGripUpdate = SinGrip.update

	local activeLocoChar = nil
	local function startLocoController(char)
		locoToken += 1
		local myToken = locoToken
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not hum and char then hum = char:WaitForChild("Humanoid", 10) end
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		if not animator and hum then animator = hum:WaitForChild("Animator", 10) end
		if not (hum and animator) then warn("[SIN] Humanoid/Animator missing; locomotion controller not started") return end
		-- the swing grip follows the game animation 97660793956521 (playing = swing grip)
		if SinGrip.swingConn then SinGrip.swingConn:Disconnect() end
		SinGrip.swings = 0
		SinGrip.animator = animator
		SinGrip.swingConn = animator.AnimationPlayed:Connect(function(t)
			local sid = Kit.idOf(t)
			if not (sid and SinGrip.SWING_IDS[sid]) then return end
			SinGrip.swings += 1
			SinGrip.update()
			t.Stopped:Once(function()
				SinGrip.swings = math.max(SinGrip.swings - 1, 0)
				SinGrip.update()
			end)
		end)
		activeLocoChar = char
		if not locoEnabled then
			stopLoco(animator)
			return
		end
		-- Keep the character's Animate object in sync while this toggle is enabled.
		-- This preserves compatibility with Roblox's built-in locomotion state changes.
		if sledgeChar ~= char then sledgeOn = false sledgeChar = char end
		local function syncAnimate()
			setAnimateClip(char, "idle", chosenIdleId())
			setAnimateClip(char, "walk", chosenWalkId())
			setAnimateClip(char, "run", chosenRunId())
		end
		syncAnimate()
		task.spawn(function()
			local warnedBlock = {}
			local sledgeGoneSince = nil
			local sledgeTool = nil -- the Tool that was equipped when the sledgehammer came out (if the game uses Tools)
			local noIdleSeen = env.__NO_IDLES == true
			while myToken == locoToken and char.Parent and hum.Parent and hum.Health > 0 do
				if (env.__NO_IDLES == true) ~= noIdleSeen then noIdleSeen = env.__NO_IDLES == true syncAnimate() end
				if not locoEnabled or stunBusy or Kit.viral.loco then -- (a VIRAL pack has its own idle / walk / run)
					Kit.restore("sinrun")
					stopLoco(animator)
				else
					local moving = hum.MoveDirection.Magnitude > 0.05
					local root = char:FindFirstChild("HumanoidRootPart")
					local speed = root and Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z).Magnitude or 0
					local wantRun = false
					if moving then
						if locoRunning then
							wantRun = speed >= 17 or hum.WalkSpeed >= 18
						else
							wantRun = speed >= 19 or hum.WalkSpeed >= 18
						end
						locoRunning = wantRun
					end
					-- Let active action animations (attacks, executions, ...) override SIN movement.
					-- Looped game animations at Action priority or above (the game's own run / sprint loop) do NOT stop SIN run:
					-- while running (or walking with the sledgehammer) they are demoted so the SIN animation actually wins.
					local hardBlock, softBlock = nil, false
					local loops, markers = {}, {}
					for _, playingTrack in ipairs(animator:GetPlayingAnimationTracks()) do
						local id = Kit.idOf(playingTrack)
						local isMarker = id == SLEDGE_GAME_IDLE
						if isMarker and playingTrack.IsPlaying then markers[#markers + 1] = playingTrack end
						local isOurs = id == "110122744601596" or id == "105632845947615" or id == "74278973146163"
							or id == "95464797704887" or id == "139858886667310" or id == "116782067880718" or id == "91791369037012"
							or Kit.protect[playingTrack] == true -- ANIM REPLACE's animations are never demoted or blocked by SIN
						-- NOTE: Enum.AnimationPriority.Core has Value 1000 but is the LOWEST priority in practice.
						-- The default Animate idle/walk tracks are Core, so a raw >= comparison always counted them as an
						-- "override" and the controller never played anything.
						local pr = playingTrack.Priority
						if playingTrack.IsPlaying and not isOurs and not isMarker and pr ~= Enum.AnimationPriority.Core and pr.Value >= Enum.AnimationPriority.Action.Value then
							if not playingTrack.Looped and playingTrack.WeightTarget > 0.01 and (YIELD_TO_GAME_ACTIONS or Kit.live[playingTrack]) then
								-- no break: keep scanning so the sledgehammer markers further down the list are still seen
								hardBlock = hardBlock or playingTrack
							else
								loops[#loops + 1] = playingTrack
							end
						end
					end
					-- the sledgehammer state follows the HELD ITEM: ON only while a Sledgehammer / HalliganBar / GreenAxe / Axe Tool is in your hands
					-- (the game's own equip / idle animations no longer switch it on, so other items keep the normal SIN idle / walk / run)
					local wasSledge = sledgeOn
					local heldTool = Kit.sledgeHeld()
					if heldTool then
						sledgeTool = heldTool
						sledgeOn = true
					elseif sledgeOn then
						sledgeOn = false
						sledgeTool = nil
					end
					if sledgeOn ~= wasSledge then syncAnimate() end
					local function demoteMarkers()
						for _, m in ipairs(markers) do Kit.demote(m, "sinrun") end
					end
					if hardBlock then
						Kit.restore("sinrun")
						stopLoco(animator)
						if wantRun then
							local bid = tostring(Kit.idOf(hardBlock))
							if not warnedBlock[bid] then
								warnedBlock[bid] = true
								warn("[SIN] run blocked by animation " .. bid .. " (priority " .. tostring(hardBlock.Priority) .. ", looped=false)")
							end
						end
					elseif moving and (wantRun or sledgeOn) then
						for _, lt in ipairs(loops) do Kit.demote(lt, "sinrun") end
						demoteMarkers()
						playLoco(animator, wantRun and chosenRunId() or chosenWalkId(), Enum.AnimationPriority.Action4)
					elseif env.__NO_IDLES and not moving then -- NO IDLES: no idle from this script, the game's own idle plays
						Kit.restore("sinrun")
						stopLoco(animator)
					else
						Kit.restore("sinrun")
						for _, lt in ipairs(loops) do Kit.demote(lt, "sinrun") end
						demoteMarkers()
						playLoco(animator, moving and chosenWalkId() or chosenIdleId(), Enum.AnimationPriority.Action4)
					end
				end
				SinGrip.update()
				task.wait(0.12)
			end
			Kit.restore("sinrun")
			-- only clean up if no newer controller took over (otherwise we'd kill its freshly started idle/walk)
			if myToken == locoToken then stopLoco(animator) end
		end)
	end
