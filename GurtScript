	local function onRowPick(r)
		if r.kind == "saved" then
			local p = r.data
			nameBox.Text = p.name
			if loadValues(p) then applyIfOn() end
		else
			local a = r.data
			itemBox.Text = a.name
			local c1 = commitItem()
			local c2 = loadValues(a)
			if c1 or c2 then applyIfOn() end
			say("Editing: " .. a.name)
		end
