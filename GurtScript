	local EDGE_V, EDGE_H = SOFT_FX and 0.08 or 0.2, SOFT_FX and 0.05 or 0.14 -- how deep the top/bottom and left/right vignette bands reach
	edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, EDGE_V), 90)
	edge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, EDGE_V), 270)
	edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(EDGE_H, 1), 0)
	edge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(EDGE_H, 1), 180)

	if RETRO then
		local ROWS = SOFT_FX and 120 or 240
		for i = 0, ROWS - 1 do
			mk("Frame", hud, {
				Position = UDim2.fromScale(0, i / ROWS), Size = UDim2.new(1, 0, 0, 1),
				BackgroundColor3 = Color3.fromRGB(0, 0, 0), BackgroundTransparency = SOFT_FX and 0.92 or 0.72, BorderSizePixel = 0,
			})
		end
	end
	local scanLine = mk("Frame", hud, {
		Size = UDim2.new(1, 0, 0, 2), BackgroundColor3 = RED, BackgroundTransparency = RETRO and 0.45 or 1, BorderSizePixel = 0, Visible = RETRO,
	})
