	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, -44, 0, 24)
	title.Position = UDim2.fromOffset(10, 6)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 12
	title.TextColor3 = ACCENT
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Text = "RIF DODGE"
	title.ZIndex = 62
	title.Parent = panel

	local closeButton = panelButton(panel, "X", UDim2.fromOffset(24, 24), UDim2.new(1, -30, 0, 6))

	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(6, 36)
	list.Size = UDim2.new(1, -12, 1, -42)
	list.ScrollBarThickness = 4
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ZIndex = 61
	list.Parent = panel

	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 4)
	listLayout.SortOrder = Enum.SortOrder.LayoutOrder
	listLayout.Parent = list

	local refreshers = {}
	local rowCount = 0

	local function makeRow(labelText)
		rowCount += 1
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 30)
		row.BackgroundColor3 = ROW_BG
		row.BorderSizePixel = 0
		row.LayoutOrder = rowCount
		row.ZIndex = 61
		row.Parent = list
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
		if labelText then
			local label = Instance.new("TextLabel")
