	pcall(function() RunService:UnbindFromRenderStep("ChainRageStep") end)
	pcall(Rage.reset, true)
	pcall(function() local g = PlayerGui:FindFirstChild("ChainRageFlashGui") if g then g:Destroy() end end)
	for _, T in ipairs({ Theme, Blood }) do
		pcall(H.stopTrack, T, true)
		if T.sound then pcall(function() T.sound:Destroy() end) T.sound = nil end
	end
	pcall(H.bloodStop, true)
end

