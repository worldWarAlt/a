		local r = rows[i]
		if r then return r end
		local frame = mk("Frame", { Size = UDim2.new(1, -8, 0, 34), BackgroundColor3 = ROW_BG, BorderSizePixel = 0, LayoutOrder = i, Visible = false }, list)
