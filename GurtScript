			-- Add or remove ids in MAGNA_ASSETS; the items are downloaded the first time you press the button, then reused.
			----------------------------------------------------------------
			local MAGNA_ASSETS = {
				{ 128713755392549, "PBR-Ranger-Green-6094-Plate-Carrier" },
				{ 15834438262, "Black-Powder-no-gear pants" },
				{ 84403918149306, "Emissive-Protogen-Visor-Red-Black" },
