function H.enrageFx(char, sh)
	local root = char:FindFirstChild("HumanoidRootPart")
	H.shockBall(sh, 14, 0.7)
	if root and root:IsA("BasePart") then H.shockRing(root.Position - Vector3.new(0, 2.8, 0), 24, 0.8) end
	H.burst(sh, 50)
	H.flash(0.25, 0.4)
end

-- glow groups: the outermost model / accessory / part each arm part sits in, one Highlight per group
function H.groupNode(char, p)
	local node = p
	while node.Parent and node.Parent ~= char and not H.isLimbPart(char, node.Parent) do
		node = node.Parent
	end
	return node
end

function H.buildGroups(char, infos)
	local byNode, groups = {}, {}
	for _, info in ipairs(infos) do
		local node = H.groupNode(char, info.part)
		local g = byNode[node]
		if not g then
			local adornee = node
			if node:IsA("Accessory") then adornee = node:FindFirstChild("Handle") end
			g = { adornee = adornee, t = info.t }
			byNode[node] = g
			groups[#groups + 1] = g
		end
		if info.t < g.t then g.t = info.t end
		info.group = g
	end
	table.sort(groups, function(a, b) return a.t < b.t end)
	for i, g in ipairs(groups) do g.glow = i <= Rage.MAX_HIGHLIGHTS and g.adornee ~= nil end
	return groups
end

function H.ensureHighlight(g)
	if g.hl and g.hl.Parent then return g.hl end
	local h = Instance.new("Highlight")
	h.Name = "MG_RageGlow"
	h.FillColor = Rage.GLOW
	h.OutlineColor = Rage.GLOW
	h.FillTransparency = 1
	h.OutlineTransparency = 1
	h.DepthMode = Enum.HighlightDepthMode.Occluded
	h.Enabled = false
	h.Adornee = g.adornee
	h.Parent = workspace.CurrentCamera
	g.hl = h
	return h
end

-- red glow: white-hot when a piece appears, cooling to a pulsing red
function H.updateGlow(g, now)
	if not (g.born and g.glow) or not (g.adornee and g.adornee.Parent) then return end
	local hl = H.ensureHighlight(g)
	local heat = math.clamp(1 - (now - g.born) / 1.8, 0, 1)
	local pulse = 0.5 + 0.5 * math.sin(now * 4.2 + g.t * 3)
	hl.Enabled = true
	hl.FillColor = Rage.GLOW:Lerp(Rage.HOT, heat)
	hl.OutlineColor = Rage.GLOW:Lerp(Rage.HOT, heat * 0.7)
	hl.FillTransparency = math.clamp((0.45 + 0.2 * pulse) * (1 - heat) + 0.08 * heat, 0, 1)
	hl.OutlineTransparency = math.clamp(0.1 + 0.3 * pulse * (1 - heat), 0, 1)
end

function H.updateFx(now)
	local fx = Rage.fx
	if not (fx and fx.att.Parent) or Rage.phase == "armless" then return end
	local pulse = 0.5 + 0.5 * math.sin(now * 4.2)
	local flash = math.clamp(1 - (now - Rage.flashAt) / 1.6, 0, 1)
	fx.light.Enabled = true
	fx.light.Brightness = 2 + 1.2 * pulse + 9 * flash
	fx.light.Range = 12 + 10 * flash
	local regrow = Rage.phase == "regrow"
	local n = math.max(Rage.limbFx and #Rage.limbFx or 1, 1)
	if Rage.limbFx then
		for _, e in ipairs(Rage.limbFx) do
			e.flame.Rate = (regrow and 46 or 16) / n
			e.smoke.Rate = (regrow and 16 or 6) / n
		end
	end
end

-- ---------- speed ----------
function H.speedKey(v) return math.floor(v * 100 + 0.5) end

-- the boosted speed for a normal speed: phase 2 = gentle (x1.25, capped), BLOODMOON = x2
function H.boostFor(base)
	local mult, addMax, cap = Rage.SPEED_MULT, Rage.SPEED_ADD_MAX, Rage.SPEED_CAP
	if Rage.phase == "blood" then mult, addMax, cap = Rage.BLOOD_MULT, math.huge, Rage.BLOOD_CAP end
	return math.max(math.min(base * mult, base + addMax, cap), base) -- never slows you down
end

function H.speedStep(hum)
	if not Rage.speedOn then return end
	local cur = hum.WalkSpeed
	if Rage.lastSet and math.abs(cur - Rage.lastSet) < 0.01 then return end -- still our value
	local known = Rage.mine[H.speedKey(cur)]
	if known then Rage.base, Rage.lastSet = known, cur return end -- one of our boosted values restored by something else (stun...)
	if cur <= 0.01 then return end -- frozen / stunned: leave it alone
	-- the game or another feature changed the speed (sprint...): that is the new normal speed, boost it gently
	Rage.base = cur
	local boosted = H.boostFor(cur)
	Rage.lastSet = boosted
	Rage.mine[H.speedKey(boosted)] = cur
	hum.WalkSpeed = boosted
end

-- ---------- sound + animation ----------
local Roar = { good = false, downloading = false, assetId = nil, lastErr = "no response" }

function H.roarIsAudio(body)
	return H.themeIsAudio(body) -- real mp3 data (rejects error pages / LFS pointers)
end

function H.roarFileOk()
	if Roar.good then return true end
	local ok, body = pcall(function() return isfile and readfile and isfile(Rage.ROAR_FILE) and readfile(Rage.ROAR_FILE) end)
	if ok and H.roarIsAudio(body) then Roar.good = true end
	return Roar.good
end

function H.roarFetch(url)
	local req = (syn and syn.request) or (http and http.request) or http_request or request
	if req then
		local ok, res = pcall(req, { Url = url, Method = "GET" })
		if ok and type(res) == "table" then
			if res.StatusCode == 200 and H.roarIsAudio(res.Body) then return res.Body end
			Roar.lastErr = "HTTP " .. tostring(res.StatusCode) .. (res.StatusCode == 200 and " (not an mp3)" or "")
		elseif not ok then
			Roar.lastErr = tostring(res)
		end
	end
	local ok, res = pcall(function() return game:HttpGet(url) end)
	if ok and H.roarIsAudio(res) then return res end
	return nil
end

function H.roarDownload()
	if H.roarFileOk() then return true end
	if not writefile then Roar.lastErr = "writefile not supported" return false end
	if Roar.downloading then return false end
	Roar.downloading = true
	local body
	for _, url in ipairs(Rage.ROAR_URLS) do
		body = H.roarFetch(url)
		if body then break end
	end
	Roar.downloading = false
	if not body then return false end
	local ok, err = pcall(writefile, Rage.ROAR_FILE, body)
	if not ok then Roar.lastErr = "writefile failed: " .. tostring(err) return false end
	Roar.good = false
	return H.roarFileOk()
end

function H.roarAsset()
	if Roar.assetId then return Roar.assetId end
	if not H.roarFileOk() then return nil end
	local fn = getcustomasset or getsynasset
	if not fn then Roar.lastErr = "executor has no getcustomasset" return nil end
	local ok, id = pcall(fn, Rage.ROAR_FILE)
	if ok and id then Roar.assetId = id else Roar.lastErr = "getcustomasset failed: " .. tostring(id) end
	return Roar.assetId
end

function H.playRoar()
	task.spawn(function()
		local waited = 0
		while Roar.downloading and waited < 30 do task.wait(0.25) waited += 0.25 end
		if not H.roarDownload() then warn("[ChainRage] roar download failed (" .. Roar.lastErr .. ")") return end
		local id = H.roarAsset()
		if not id then warn("[ChainRage] roar not playable (" .. Roar.lastErr .. ")") return end
		if not alive then return end
		if Rage.roarSound then pcall(function() Rage.roarSound:Destroy() end) end
		local snd = Instance.new("Sound")
		snd.Name = "MG_RageRoar"
		snd.SoundId = id
		snd.Volume = Rage.SOUND_VOLUME
		snd.Looped = false
		snd.Parent = RageSoundService
		Rage.roarSound = snd
		snd:Play()
		snd.Ended:Once(function() snd:Destroy() end)
		task.delay(60, function() if snd.Parent then snd:Destroy() end end)
	end)
end

function H.playAnimThenBoost(hum, token)
	task.spawn(function()
		local animator = hum:FindFirstChildOfClass("Animator")
		local track
		if animator then
			local a = Instance.new("Animation")
			a.AnimationId = Rage.ANIM_ID
			local ok, t = pcall(function() return animator:LoadAnimation(a) end)
			if ok then track = t end
		end
		if track then
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = false
			track:Play(0.1)
			Rage.track = track
			local t0 = os.clock()
			while track.Length <= 0 and os.clock() - t0 < 1.5 do task.wait() end
			if track.Length > 0 then
				local stopped = false
				track.Stopped:Once(function() stopped = true end)
				local limit = os.clock() + track.Length / math.max(track.Speed, 0.05) + 1
				while not stopped and os.clock() < limit and Rage.token == token do task.wait(0.05) end
			else
				task.wait(Rage.REGROW_TIME) -- animation could not be loaded: boost after the regrow
			end
		else
			task.wait(Rage.REGROW_TIME)
		end
		if Rage.token == token and (Rage.phase == "enraged" or Rage.phase == "blood") then
			Rage.speedOn = true
		end
	end)
end

-- ---------- dodge (any damage while enraged: random animation + teleport a few studs, never through walls) ----------
function H.dodgeTracks(hum)
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then return nil end
	if Rage.dodgeFor ~= animator or not Rage.dodgeList then
		Rage.dodgeFor = animator
		Rage.dodgeList = {}
		for _, id in ipairs(Rage.DODGE_ANIMS) do
			local a = Instance.new("Animation")
			a.AnimationId = id
			local ok, t = pcall(function() return animator:LoadAnimation(a) end)
			if ok and t then
				t.Priority = Enum.AnimationPriority.Action4
				t.Looped = false
				Rage.dodgeList[#Rage.dodgeList + 1] = t
			end
		end
	end
	return Rage.dodgeList
end

-- true when nothing solid is between the two points (body-sized sweep + three rays as a second opinion)
function H.pathClear(origin, target, body, params)
	local delta = target - origin
	local ok, hit = pcall(function() return workspace:Blockcast(CFrame.new(origin), body, delta, params) end)
	if ok and hit then return false end
	for _, dy in ipairs({ -1.2, 0, 1.6 }) do
		if workspace:Raycast(origin + Vector3.new(0, dy, 0), delta, params) then return false end
	end
	return true
end

-- a free standing spot near you: on the ground, about your height, nothing solid inside it, no wall in the way
function H.findDodgeSpot(char, hum, root)
	local ignore = { char, workspace.CurrentCamera }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore
	local origin = root.Position
	local rootH = (hum.RigType == Enum.HumanoidRigType.R6 and 2 or hum.HipHeight) + root.Size.Y / 2
	local feetY = origin.Y - rootH
	local body = Vector3.new(1.8, 4.2, 1.8) -- a bit slimmer than you, so standing next to a wall does not count as blocked
	for _ = 1, 18 do
		local ang = math.random() * math.pi * 2
		local dist = Rage.DODGE_MIN + math.random() * (Rage.DODGE_MAX - Rage.DODGE_MIN)
		local flat = Vector3.new(math.cos(ang), 0, math.sin(ang)) * dist
		local down = workspace:Raycast(origin + flat + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), params)
		if down and down.Normal.Y > 0.6 and math.abs(down.Position.Y - feetY) <= 5 then
			local pos = down.Position + Vector3.new(0, rootH + 0.1, 0)
			local blocked = false
			for _, part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(pos), body, overlap)) do
				if part.CanCollide then blocked = true break end
			end
			if not blocked and H.pathClear(origin, pos, body, params) then return pos end
		end
	end
	return nil
end

-- one thin red lightning bolt between two points
function H.bolt(p0, p1, width, life, hot)
	local function node(pos)
		local part = Instance.new("Part")
		part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
		part.Transparency = 1
		part.Size = Vector3.new(0.2, 0.2, 0.2)
		part.CFrame = CFrame.new(pos)
		part.Parent = workspace.CurrentCamera
		local att = Instance.new("Attachment")
		att.Parent = part
		return part, att
	end
	local part0, a0 = node(p0)
	local part1, a1 = node(p1)
	local b = Instance.new("Beam")
	b.Attachment0, b.Attachment1 = a0, a1
	b.Color = hot and ColorSequence.new(Color3.fromRGB(255, 235, 225), Color3.fromRGB(255, 35, 25))
		or ColorSequence.new(Color3.fromRGB(255, 90, 70), Color3.fromRGB(200, 15, 10))
	b.LightEmission = 1
	b.LightInfluence = 0
	b.FaceCamera = true
	b.Segments = 8
	b.Width0, b.Width1 = width, width * 0.2
	b.CurveSize0, b.CurveSize1 = (math.random() - 0.5) * 2.5, (math.random() - 0.5) * 2.5
	b.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.7) })
	b.Parent = part0
	task.delay(life, function() part0:Destroy() part1:Destroy() end)
end

-- red afterimage of your body left behind where you were (call BEFORE teleporting)
function H.afterimage(char)
	local made = 0
	for _, d in ipairs(char:GetChildren()) do
		if made < 18 and d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and d.Transparency + d.LocalTransparencyModifier < 0.9 then
			made += 1
			local g = Instance.new("Part")
			g.Anchored, g.CanCollide, g.CanTouch, g.CanQuery, g.CastShadow = true, false, false, false, false
			g.Material = Enum.Material.Neon
			g.Color = Rage.GLOW
			g.Transparency = 0.3
			g.Size = d.Size
			g.CFrame = d.CFrame
			g.Parent = workspace.CurrentCamera
			TweenService:Create(g, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Transparency = 1, Size = d.Size * 1.2,
			}):Play()
			task.delay(0.55, function() g:Destroy() end)
		end
	end
end

-- brief red light at a spot
function H.lightFlash(pos, brightness, range, time)
	local part = Instance.new("Part")
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.CFrame = CFrame.new(pos)
	part.Parent = workspace.CurrentCamera
	local l = Instance.new("PointLight")
	l.Color = Rage.GLOW
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = part
	TweenService:Create(l, TweenInfo.new(time, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0 }):Play()
	task.delay(time + 0.1, function() part:Destroy() end)
end

-- dodge effect: lightning radiating from both ends, a triple bolt linking them, a lightning strike on the landing spot,
-- ground shockwaves, a light flash and a short screen flash
function H.dodgeFx(from, to)
	for n, pos in ipairs({ from, to }) do
		for _ = 1, 7 do
			local dir = Vector3.new(math.random() - 0.5, math.random() - 0.2, math.random() - 0.5)
			if dir.Magnitude > 0.1 then
				local base = pos + Vector3.new(0, 0.5 + math.random() * 1.8, 0)
				H.bolt(base, base + dir.Unit * (2.5 + math.random() * 3), 0.45, 0.16, true)
			end
		end
		H.shockRing(pos - Vector3.new(0, 2.8, 0), n == 1 and 14 or 20, 0.4, n == 2 and Rage.HOT or nil)
		H.shockBall(pos, n == 1 and 5 or 8, 0.22, n == 2 and Color3.fromRGB(255, 255, 255) or nil)
		H.lightFlash(pos, n == 1 and 6 or 10, 22, 0.35)
	end
	local a, b = from + Vector3.new(0, 0.5, 0), to + Vector3.new(0, 0.5, 0)
	H.bolt(a, b, 0.55, 0.2, true)
	H.bolt(a, b, 0.3, 0.18)
	H.bolt(a, b, 0.3, 0.16)
	H.bolt(to + Vector3.new(0, 30, 0), to, 1, 0.22, true) -- strike coming down on the landing spot
	H.bolt(to + Vector3.new(1.5, 24, 0), to, 0.4, 0.18)
	H.flash(0.15, 0.25)
end

function H.dodge(hum, char)
	local now = os.clock()
	if now - (Rage.dodgeAt or -100) < Rage.DODGE_COOLDOWN then return end
	if (Rage.phase ~= "enraged" and Rage.phase ~= "blood") or Rage.char ~= char or hum.Health <= 0 then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then return end
	Rage.dodgeAt = now
	local list = H.dodgeTracks(hum)
	if list and #list > 0 then
		for _, t in ipairs(list) do
			if t.IsPlaying then t:Stop(0.05) end
		end
		if Rage.track and Rage.track.IsPlaying then Rage.track:Stop(0.05) end -- cuts the roar short
		list[math.random(#list)]:Play(0.05)
	end
	local from = root.Position
	local spot = H.findDodgeSpot(char, hum, root)
	if spot then
		H.afterimage(char)
		root.CFrame = CFrame.new(spot) * (root.CFrame - root.Position) -- same facing
		root.AssemblyLinearVelocity = Vector3.zero
		H.dodgeFx(from, spot)
	end
end

-- ---------- replacement arm: the "Chain arm" shoulder accessory from the catalog ----------
function H.loadArmTemplate()
	if Rage.armTemplate then return Rage.armTemplate end
	if Rage.armLoading then return nil end
	Rage.armLoading = true
	local roots
	local ok, res = pcall(function() return game:GetObjects("rbxassetid://" .. Rage.ARM_ID) end)
	if ok and type(res) == "table" and #res > 0 then
		roots = res
	else
		local ok2, model = pcall(function() return game:GetService("InsertService"):LoadAsset(Rage.ARM_ID) end)
		if ok2 and model then roots = model:GetChildren() end
	end
	Rage.armLoading = false
	if not roots then warn("[ChainRage] could not load the Chain arm (" .. Rage.ARM_ID .. ")") return nil end
	local found
	for _, o in ipairs(roots) do
		if o:IsA("Accoutrement") then found = o break end
	end
	if not found then
		for _, o in ipairs(roots) do
			found = o:FindFirstChildWhichIsA("Accoutrement", true)
			if found then break end
		end
	end
	if not found then
		for _, o in ipairs(roots) do
			found = o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart", true)
			if found then break end
		end
	end
	Rage.armTemplate = found
	if not found then warn("[ChainRage] the Chain arm asset has no accessory / part in it") end
	return found
end

-- puts the arm on the shoulder of the character's current left arm (re-done when the game swaps the limb)
function H.weldChainArm(limb, handle, weld)
	local hAtt = handle:FindFirstChildOfClass("Attachment")
	local lAtt = (hAtt and limb:FindFirstChild(hAtt.Name)) or limb:FindFirstChild("LeftShoulderAttachment")
	weld.Part0 = limb
	weld.Part1 = handle
	weld.C0 = (lAtt and lAtt:IsA("Attachment")) and lAtt.CFrame or CFrame.new(0, limb.Size.Y / 2, 0)
	weld.C1 = hAtt and hAtt.CFrame or CFrame.new()
end

function H.attachChainArm(char)
	local tpl = Rage.armTemplate
	if not tpl then return end
	local limb = char:FindFirstChild("Left Arm") or char:FindFirstChild("LeftUpperArm")
	if not (limb and limb:IsA("BasePart")) then return end
	local a = Rage.arm
	if a and a.handle.Parent and a.weld.Parent then
		if a.weld.Part0 ~= limb then H.weldChainArm(limb, a.handle, a.weld) end
		return
	end
	if a then pcall(function() a.acc:Destroy() end) Rage.arm = nil end
	local clone = tpl:Clone()
	local handle = clone:IsA("BasePart") and clone
		or (clone:IsA("Accoutrement") and clone:FindFirstChild("Handle"))
		or clone:FindFirstChildWhichIsA("BasePart", true)
	if not handle then clone:Destroy() return end
	clone:SetAttribute("MG_RageArm", true)
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d:SetAttribute("MG_RageArm", true)
			d.Anchored, d.CanCollide, d.CanTouch, d.CanQuery, d.Massless = false, false, false, false, true
		end
	end
	handle:SetAttribute("MG_RageArm", true)
	handle.Anchored, handle.CanCollide, handle.CanTouch, handle.CanQuery, handle.Massless = false, false, false, false, true
	local weld = Instance.new("Weld")
	weld.Name = "MG_RageArmWeld"
	H.weldChainArm(limb, handle, weld)
	weld.Parent = handle
	local want = handle.Transparency
	handle.Transparency = 1
	clone.Parent = workspace.CurrentCamera -- not inside the character: the morph engine would remove a foreign accessory
	TweenService:Create(handle, TweenInfo.new(0.45), { Transparency = want }):Play()
	Rage.arm = { acc = clone, handle = handle, weld = weld }
end

function H.destroyArm()
	if Rage.arm then pcall(function() Rage.arm.acc:Destroy() end) Rage.arm = nil end
end

-- anything that shows up looking like a left arm is hidden in the same frame (equipping something, viewmodels ...)
function H.hideNew(p)
	if Rage.phase ~= "armless" or not Rage.char then return end
	if not p:IsA("BasePart") or Rage.info[p] or p:GetAttribute("MG_RageArm") then return end
	if not H.isLeftArmName(p.Name) then return end
	local info = H.newInfo(Rage.char, p)
	Rage.info[p] = info
	Rage.list[#Rage.list + 1] = info
	H.scanFx(info)
	H.applyVisibility(info, 0)
end

function H.disconnectArmWatch()
	for _, c in ipairs(Rage.conns) do pcall(function() c:Disconnect() end) end
	table.clear(Rage.conns)
end

-- your real arm / the replacement arm are done: stop hiding, give the arm parts back
function H.releaseArm()
	H.disconnectArmWatch()
	for _, info in pairs(Rage.info) do
		pcall(function()
			info.fxOn = nil
			H.applyVisibility(info, 1)
		end)
	end
	table.clear(Rage.info)
	Rage.list = {}
	H.destroyArm()
	H.destroyFx()
end

-- ---------- CHAIN forms (built and applied by the morph engine of section 17) ----------
function H.prepareForms()
	if Rage.preparing then return end
	Rage.preparing = true
	local waited = 0
	while not env.MorphGuiRage and waited < 45 and alive do task.wait(0.5) waited = waited + 0.5 end
	local api = env.MorphGuiRage
	if not api then
		warn("[ChainRage] the morph GUI (section 17) is not loaded: the CHAIN forms are skipped")
		Rage.formsFailed = true
		Rage.preparing = false
		return
	end
	if Rage.formsApi ~= api then Rage.forms = {} Rage.formsApi = api end
	for _, key in ipairs({ "phase2", "blood" }) do
		if not alive then break end
		if not Rage.forms[key] then
			local ok, morph, err = pcall(api.prepare, RAGE_FORMS[key])
			if ok and morph then
				Rage.forms[key] = morph
			else
				warn("[ChainRage] could not build the '" .. key .. "' form: " .. tostring(ok and err or morph))
			end
		end
	end
	Rage.preparing = false
end

-- morph into a prepared form (waits for it when it is still being built)
function H.applyForm(key, token)
	local prev = Rage.prev
	task.spawn(function()
		local waited = 0
		while not Rage.forms[key] and not Rage.formsFailed and waited < 60 and alive and Rage.token == token do
			if not Rage.preparing then task.spawn(H.prepareForms) end
			task.wait(0.25)
			waited = waited + 0.25
		end
		local morph, api = Rage.forms[key], env.MorphGuiRage
		if Rage.token ~= token or not alive then return end
		if not (morph and api) then warn("[ChainRage] the '" .. key .. "' form is not ready") return end
		local ok, res = pcall(api.apply, morph)
		if not (ok and res) then warn("[ChainRage] could not morph into '" .. key .. "': " .. tostring(res)) return end
		if Rage.token ~= token then -- reset while the morph was being built: undo it
			pcall(api.restore, prev and prev.obj, prev and prev.hats)
			return
		end
		Rage.morphed = true
	end)
end

-- back to the form you had before the rage (or your normal outfit)
function H.revertForm()
	if not Rage.morphed then return end
	Rage.morphed = false
	local api, prev = env.MorphGuiRage, Rage.prev
	if not api then return end
	task.spawn(function() pcall(api.restore, prev and prev.obj, prev and prev.hats) end)
end

-- ---------- BLOODMOON: the whole screen turns blood red ----------
function H.bloodStart()
	local L = game:GetService("Lighting")
	if Rage.cc and Rage.cc.Parent then return end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "MG_BloodMoonCC"
	cc.Parent = L
	Rage.cc = cc
	TweenService:Create(cc, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		TintColor = Rage.BLOOD_TINT, Saturation = 0.45, Contrast = 0.22, Brightness = -0.06,
	}):Play()
end

function H.bloodStep(now)
	local cc = Rage.cc
	if not (cc and cc.Parent) or not Rage.bloodAt then return end
	if now - Rage.bloodAt > 1.8 then -- after the fade-in, a slow heartbeat on the brightness
		cc.Brightness = -0.06 + 0.035 * math.sin((now - Rage.bloodAt) * 3.2)
	end
end

function H.bloodStop(instant)
	local cc = Rage.cc
	Rage.cc = nil
	if not (cc and cc.Parent) then return end
	if instant then cc:Destroy() return end
	TweenService:Create(cc, TweenInfo.new(1.2), { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0, Brightness = 0 }):Play()
	task.delay(1.3, function() if cc.Parent then cc:Destroy() end end)
end

-- ---------- state ----------
function Rage.reset(instant)
	Rage.token = Rage.token + 1
	local char, hum = Rage.char, Rage.hum
	if Rage.hpConn then Rage.hpConn:Disconnect() Rage.hpConn = nil end

	if hum and hum.Parent then -- back to the normal speed if we are still boosting it
		local was = Rage.mine[H.speedKey(hum.WalkSpeed)]
		if was then hum.WalkSpeed = was end
	end
	Rage.speedOn, Rage.lastSet, Rage.base = false, nil, nil
	table.clear(Rage.mine)

	if Rage.track then
		pcall(function() if Rage.track.IsPlaying then Rage.track:Stop(0.2) end end)
		Rage.track = nil
	end

	H.releaseArm() -- your arm comes back exactly as it was
	H.destroyLimbFx()
	if Rage.dodgeList then
		for _, t in ipairs(Rage.dodgeList) do pcall(function() if t.IsPlaying then t:Stop(0.1) end end) end
	end
	Rage.dodgeList, Rage.dodgeFor = nil, nil
	if Rage.roarSound then pcall(function() Rage.roarSound:Destroy() end) Rage.roarSound = nil end
	Rage.phase = "off" -- (before the songs stop, so their delayed stop goes through)
	H.stopTrack(Theme, instant)
	H.stopTrack(Blood, instant)
	H.bloodStop(instant)
	H.revertForm()
	Rage.damage, Rage.damage2, Rage.lastHealth, Rage.bloodAt = 0, 0, nil, nil
	Rage.char, Rage.hum = nil, nil
end

function Rage.begin(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then return false end
	local hasLimb = false
	for name in pairs(LIMB_NAMES) do
		if char:FindFirstChild(name) then hasLimb = true break end
	end
	if not hasLimb then return false end
	Rage.token = Rage.token + 1
	Rage.phase = "armless"
	Rage.char, Rage.hum = char, hum
	Rage.damage, Rage.damage2 = 0, 0
	Rage.lastHealth = hum.Health
	Rage.poofPending = true
	Rage.partsAt = -100
	Rage.armAt = -100
	-- what you are wearing now is what you go back to when it is over
	local api = env.MorphGuiRage
	if api then
		local obj, hats = api.state()
		if obj ~= Rage.forms.phase2 and obj ~= Rage.forms.blood then Rage.prev = { obj = obj, hats = hats } end
	end
	H.disconnectArmWatch()
	Rage.conns[#Rage.conns + 1] = char.DescendantAdded:Connect(H.hideNew)
	local cam = workspace.CurrentCamera
	if cam then Rage.conns[#Rage.conns + 1] = cam.DescendantAdded:Connect(H.hideNew) end
	Rage.hpConn = hum.HealthChanged:Connect(function(hp)
		local last = Rage.lastHealth
		Rage.lastHealth = hp
		if last and hp < last then
			local d = last - hp
			if Rage.phase == "armless" then
				Rage.damage = Rage.damage + d
			elseif Rage.phase == "enraged" then
				Rage.damage2 = Rage.damage2 + d
				if hp > 0 then task.spawn(function() pcall(H.dodge, hum, char) end) end -- any damage while enraged
			elseif Rage.phase == "blood" and hp > 0 then
				task.spawn(function() pcall(H.dodge, hum, char) end)
			end
		end
	end)
	task.spawn(H.trackDownload, Theme) -- have both songs ready before they are needed
	task.spawn(H.trackDownload, Blood)
	task.spawn(H.roarDownload)         -- ... and the roar
	task.spawn(H.loadArmTemplate)      -- ... the Chain arm
	task.spawn(H.prepareForms)         -- ... and both CHAIN forms
	return true
end

-- re-scan the arm a few times a second: picks up parts the game adds or swaps
function H.refreshArm(char, now, force)
	if not force and now - Rage.partsAt < 0.4 then return false end
	Rage.partsAt = now
	local list = H.collectArm(char)
	local changed = false
	for _, p in ipairs(list) do
		if not Rage.info[p] then
			Rage.info[p] = H.newInfo(char, p)
			changed = true
		end
	end
	local infos = {}
	for _, p in ipairs(list) do
		local info = Rage.info[p]
		H.scanFx(info)
		infos[#infos + 1] = info
	end
	for p in pairs(Rage.info) do
		if not p.Parent then Rage.info[p] = nil end
	end
	Rage.list = infos
	return changed
end

-- PHASE 2: roar, theme, shockwave, and you become the CHAIN (Textures, Colors) form
function Rage.trigger(char, hum, now)
	Rage.phase = "enraged"
	Rage.t0, Rage.flashAt = now, now
	Rage.damage2 = 0
	local token = Rage.token
	local sh = H.shoulderPos(char)
	local root = char:FindFirstChild("HumanoidRootPart")
	H.releaseArm() -- the form brings its own arm
	H.triggerFx(root, sh)
	H.playRoar()
	H.startTrack(Theme, token)
	H.applyForm("phase2", token)
	task.spawn(H.dodgeTracks, hum) -- have the dodge animations loaded before the first hit
	H.playAnimThenBoost(hum, token)
end

-- BLOODMOON: new song, blood red screen, the Bloodmoon form, x2 speed, 46 seconds
function Rage.startBlood(char, hum, now)
	Rage.phase = "blood"
	Rage.bloodAt, Rage.flashAt = now, now
	local token = Rage.token
	local sh = H.shoulderPos(char)
	local root = char:FindFirstChild("HumanoidRootPart")
	H.stopTrack(Theme, false)
	H.startTrack(Blood, token)
	H.bloodStart()
	H.applyForm("blood", token)
	H.triggerFx(root, sh)
	Rage.speedOn = true
	if Rage.base then -- re-boost from the normal speed with the BLOODMOON multiplier
		local b = H.boostFor(Rage.base)
		Rage.lastSet = b
		Rage.mine[H.speedKey(b)] = Rage.base
		hum.WalkSpeed = b
	end
end

-- the BLOODMOON is over: back to your original form, the button switches itself off
function Rage.finish()
	Rage.on = false
	if setVisual then pcall(setVisual, false) end
	Rage.reset(false)
end

function H.rageStep()
	if not alive then return end
	local char = LocalPlayer.Character
	if Rage.phase ~= "off" and (not Rage.on or char ~= Rage.char) then Rage.reset() end
	if not Rage.on or not char or not char.Parent then return end
	local now = os.clock()

	if Rage.phase == "off" then
		if now - (Rage.detectAt or -100) < 0.3 then return end
		Rage.detectAt = now
		if not Rage.begin(char) then return end
	end

	local hum = Rage.hum
	if hum.Health <= 0 then
		if Rage.phase ~= "armless" then Rage.reset() end
		return
	end

	if Rage.phase == "armless" then
		H.refreshArm(char, now, Rage.poofPending)
		for _, info in ipairs(Rage.list) do H.applyVisibility(info, 0) end
		if now - Rage.armAt >= 0.4 then
			Rage.armAt = now
			H.attachChainArm(char)
		end
		if Rage.poofPending and #Rage.list > 0 then
			Rage.poofPending = false
			H.poof(char)
		end
		if Rage.damage >= Rage.DAMAGE then Rage.trigger(char, hum, now) end

	elseif Rage.phase == "enraged" then
		if Rage.damage2 >= Rage.BLOOD_DAMAGE then Rage.startBlood(char, hum, now) end

	elseif Rage.phase == "blood" then
		H.bloodStep(now)
		if now - Rage.bloodAt >= Rage.BLOOD_TIME then Rage.finish() return end
	end

	H.speedStep(hum)
end

