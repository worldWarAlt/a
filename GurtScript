		{ key = "w_classic_knife", morph = "Funeds", tool = "CLASSIC KNIFE", title = "CLASSIC KNIFE", color = Color3.fromRGB(220, 220, 230),
			swings = { "94161088", "94160738" }, speed = 1.1, sound = "134102584735851", vol = 0.5,
			execs = {
				{ attacker = "99981181501970", victim = "131982006004500", sound = "119470699890462" },
			} },
	}
	local WEAPON_ORDER = {}
	for _, w in ipairs(WEAPONS) do
		w.weapon, w.randomExec = true, true
		PACKS[w.key] = w
		WEAPON_ORDER[#WEAPON_ORDER + 1] = w.key
	end

	local function playSfx(id, vol, char, speed)
		if not (WEAPON_SOUNDS and id) then return end
		pcall(function()
			local snd = Instance.new("Sound")
			snd.SoundId = A(id)
			snd:SetAttribute("ScriptSound", true) -- ours: the "Mute exec sounds" muter (section 19) must not silence it (set before Parent)
			snd.Volume = vol or 1
			snd.PlaybackSpeed = speed or 1
			snd.Parent = (char and char:FindFirstChild("HumanoidRootPart")) or Workspace
			snd:Play()
			game:GetService("Debris"):AddItem(snd, 10)
		end)
	end

	local MAX_EXEC_SPEED = 3 -- an execution longer than the game's one is sped up to fit, but never faster than this

	-- ===== saved execution speeds =====
	-- key = "<replacement attacker animation id>|<game execution animation id>"  ->  speed. Measured once, then read from the file.
	local SPEED_FILE = "exec_speeds.json"
	local SPEED_MIN = 0.25
	local execSpeeds = {}
	local execSpeedsDirty = false
	do
		local ok, body = pcall(function() return isfile and readfile and isfile(SPEED_FILE) and readfile(SPEED_FILE) end)
		if ok and type(body) == "string" and body ~= "" then
			local ok2, d = pcall(HttpService.JSONDecode, HttpService, body)
			if ok2 and type(d) == "table" then
				for k, v in pairs(d) do
					if type(k) == "string" and type(v) == "number" and v == v then
						execSpeeds[k] = math.clamp(v, SPEED_MIN, MAX_EXEC_SPEED)
					end
				end
			end
		end
	end
	local function saveExecSpeeds()
		execSpeedsDirty = false
		if not writefile then return end
		pcall(writefile, SPEED_FILE, HttpService:JSONEncode(execSpeeds))
	end
	local function rememberExecSpeed(key, speed)
		execSpeeds[key] = math.floor(speed * 1000 + 0.5) / 1000
		if execSpeedsDirty then return end
		execSpeedsDirty = true
		task.delay(0.5, saveExecSpeeds) -- one write for a burst of changes
	end
	env.ExecSpeeds = function()
		local n = 0
		for k, v in pairs(execSpeeds) do
			n += 1
			print(string.format("[EXEC SPEED] %s = x%.3f", k, v))
		end
		print("[EXEC SPEED] " .. n .. " saved in " .. SPEED_FILE)
	end
	env.ExecSpeedsReset = function()
		table.clear(execSpeeds)
		saveExecSpeeds()
		print("[EXEC SPEED] cleared " .. SPEED_FILE .. " (speeds are measured again)")
	end
	-- the game's three swings in order (a weapon with 2 swings: 1 -> 1, 2 -> 2, 3 -> 1)
	local GAME_SWING_ORDER = { ["114891880675311"] = 1, ["97660793956521"] = 2, ["120021777910522"] = 3 }
	local EXTRA_SWING_ID = "120021777910522"

	local function dig(root, names)
		local cur = root
		for _, n in ipairs(names) do
			cur = cur and cur:FindFirstChild(n)
		end
		return cur
	end

	local function scanAnims(root, pack, skip)
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Animation") and d.AnimationId ~= "" and not (skip and d:IsDescendantOf(skip)) then
				local n = string.lower(d.Name)
				local id = string.match(d.AnimationId, "%d+")
				if id then
					if not pack.idle and string.find(n, "idle") then pack.idle = id
					elseif not pack.walk and string.find(n, "walk") then pack.walk = id
					elseif not pack.run and (string.find(n, "run") or string.find(n, "sprint")) then pack.run = id end
				end
			end
		end
	end

	-- looks for the item's idle / walk / run Animation objects (in its tool first, then in its morph)
	local function findWeaponAnims(pack)
		if pack.scanned then return end
		pack.scanned = true
		pcall(function()
			local morph = dig(ReplicatedStorage, { "ClassModels", "DEV FOLDER", "DEV MORPH", pack.morph or "" })
			if not morph then return end
			local tools = morph:FindFirstChild("Tools")
			local tool = tools and tools:FindFirstChild(pack.tool or "")
			if tool then scanAnims(tool, pack, nil) end
			if not (pack.idle or pack.walk or pack.run) then scanAnims(morph, pack, tools) end
		end)
		print(string.format("[WEAPON] %s: idle=%s walk=%s run=%s", pack.title, tostring(pack.idle), tostring(pack.walk), tostring(pack.run)))
	end

	env.WeaponDump = function()
		for _, w in ipairs(WEAPONS) do
			local morph = dig(ReplicatedStorage, { "ClassModels", "DEV FOLDER", "DEV MORPH", w.morph })
			local tools = morph and morph:FindFirstChild("Tools")
			local tool = tools and tools:FindFirstChild(w.tool)
			print("== " .. w.title .. (tool and "" or "   (tool not found)"))
			if tool then
				local base = #tool:GetFullName() + 2
				for _, d in ipairs(tool:GetDescendants()) do
					if d:IsA("Animation") then
						print("  Animation " .. string.sub(d:GetFullName(), base) .. "  " .. tostring(d.AnimationId))
					elseif d:IsA("Sound") then
						print("  Sound " .. string.sub(d:GetFullName(), base) .. "  " .. tostring(d.SoundId))
					end
				end
			end
		end
	end

	local active = nil              -- key of the pack that is on
	local extraTracks = {}          -- PlayExtra tracks that are playing (stopped when the pack goes off)
	local states = {}               -- [animator] = per-character state
	local conns = {}
	local stepConn = nil
	local nextScan = 0
	local anyTriggerCached = false
	local rng = Random.new()
	local execLocked, execLockedAt, execTrack, triggerIdleSince = false, 0, nil, nil

	---------------------------------------------------------------- locomotion
	-- PACK IDLE / WALK / RUN priority (all packs: VIRAL, D-ZERO, DAVE, GILBERT, weapon packs). Movement = LOW: the game's own action / tool / emote /
	-- looped animations show over the pack. If the game's own run shows instead of the pack's run, raise this to Enum.AnimationPriority.Action
	-- (medium) or Action3 (the old high priority). Idle (lowest) is Enum.AnimationPriority.Idle.
	local LOCO_PRIORITY = Enum.AnimationPriority.Movement

	local function stopLoco(st)
		local tr = st.locoTrack
		if tr and tr.IsPlaying then tr:Stop(0.12) end
		st.locoKey, st.locoTrack = nil, nil
		Kit.restore("viralrun")
	end

	local function playLoco(st, key)
		if st.locoKey == key then
			local tr = st.locoTrack
			if tr and not tr.IsPlaying then tr:Play(0.12, 1, 1) end
			return
		end
		local now = os.clock()
		if (st.retry[key] or 0) > now then return end
		local tr = Kit.get(st.animator, A(st.pack[key]))
		if not tr then
			st.retry[key] = now + 2 -- could not load it: try again in a moment instead of every frame
			return
		end
		-- walk / run stay at Action3, but IDLE sits much lower (Movement: above the game's own idle, below its Action animations),
		-- so the game's tool holds, blocks, emotes and other looped actions show over the pack idle instead of being buried by it.
		-- (use Enum.AnimationPriority.Idle here for the very lowest)
		tr.Priority = LOCO_PRIORITY
		tr.Looped = true
		Kit.protect[tr] = true
		st.own[tr] = true
		if key == "idle" then Kit.restore("viralrun") end -- the game's looped actions are no longer pushed under us while we only idle
		local prev = st.locoTrack
		tr:Play(0.12, 1, 1)
		if prev and prev ~= tr and prev.IsPlaying then prev:Stop(0.12) end
		st.locoKey, st.locoTrack = key, tr
	end

	local function locoStep(st, now)
		local pk = st.pack
		if not (pk.idle or pk.walk or pk.run) then return end -- no idle / walk / run of its own (a weapon without any)
		if Kit.stunBusy then -- stunned (300 DMG STUN): the stun animations own the body, our idle / walk / run wait
			if st.locoKey then stopLoco(st) end
			return
		end
		local hum, root = st.hum, st.root
		if not (hum and hum.Parent) then return end
		if not (root and root.Parent) then
			root = st.char:FindFirstChild("HumanoidRootPart")
			st.root = root
			if not root then return end
		end
		local want = nil
		if hum.Health > 0 and not hum.Sit and not hum.PlatformStand then
			local moving = hum.MoveDirection.Magnitude > 0.05
			if moving then
				local v = root.AssemblyLinearVelocity
				local speed = Vector3.new(v.X, 0, v.Z).Magnitude
				local run
				if st.running then
					run = speed >= RUN_STOP or hum.WalkSpeed >= RUN_WALKSPEED
				else
					run = speed >= RUN_START or hum.WalkSpeed >= RUN_WALKSPEED
				end
				st.running = run
				want = run and "run" or "walk"
			else
				st.running = false
				if not env.__NO_IDLES then want = "idle" end -- NO IDLES: the game's own idle plays
			end
			-- in the air for a moment: let the game's jump / fall animation show
			if hum.FloorMaterial == Enum.Material.Air then
				st.airSince = st.airSince or now
				if now - st.airSince > 0.25 then want = nil end
			else
				st.airSince = nil
			end
		end
		if want and not pk[want] then want = nil end -- (a weapon may only have an idle: the game's own walk / run play)
		if want then playLoco(st, want) elseif st.locoKey then stopLoco(st) end
	end

	---------------------------------------------------------------- swings
	local function swingMove(st, original, fromEvent)
		local id = Kit.idOf(original)
		if not (id and Kit.viral.swingIds[id]) then return end
		local firstTime = not st.handled[original]
		if not firstTime and not fromEvent then return end
		st.handled[original] = true

		local pack = st.pack
		local pool = pack.swingIds
		local rep, why
		if pack.weapon then
			-- in order: game swing 1 -> item swing 1, 2 -> 2, 3 -> 1 again (wraps around)
			local n = GAME_SWING_ORDER[id]
			if not n then
				st.swingN = (st.swingN or 0) % #pool + 1
				n = st.swingN
			end
			local repId = pool[(n - 1) % #pool + 1]
			local want = Kit.get(st.animator, repId)
			if not (want and want.Length > 0) then
				for _, cand in ipairs(pool) do
					local t = Kit.get(st.animator, cand)
					if t and t.Length > 0 then repId = cand break end
				end
			end
			-- a new swing cuts the previous replacement off, and never waits for it
			local prev = st.lock.rep
			if prev and prev.IsPlaying then prev:Stop(0.05) end
			rep, why = Kit.swap(st.animator, original, repId, st.entry, {})
			if rep then st.lock.rep = rep end
		else
			local usable = {}
			for _, cand in ipairs(pool) do
				local t = Kit.get(st.animator, cand)
				if t and t.Length > 0 then usable[#usable + 1] = cand end
			end
			local choices = #usable > 0 and usable or pool
			local repId = choices[#choices == 1 and 1 or rng:NextInteger(1, #choices)]
			rep, why = Kit.swap(st.animator, original, repId, st.entry, st.lock)
		end
		if rep or why == "lock" or why == "stopped" then st.muted[original] = true end
		if rep and pack.sound then playSfx(pack.sound, pack.vol, st.char) end
		if firstTime then
			original.Stopped:Once(function()
				st.handled[original] = nil
				st.muted[original] = nil
			end)
		end
	end

	---------------------------------------------------------------- executions
	local equipGilbertItemForExecution -- assigned below once the selector UI is created
	local function playExec(st, original)
		local pack = st.pack
		Kit.silence(original, "viral") -- the game's own execution is always silenced so only ours shows
		st.muted[original] = true

		local now = os.clock()
		if execLocked and now - execLockedAt > EXEC_MAX_LOCK then execLocked = false end
		if execLocked then return end
		if execTrack and execTrack.IsPlaying then return end

		local cfg
		if pack.randomExec then
			cfg = pack.execs[#pack.execs == 1 and 1 or rng:NextInteger(1, #pack.execs)]
		elseif #pack.execs == 1 then
			cfg = pack.execs[1]
		else
			local wantRiser = rng:NextNumber() < RISER_CHANCE
			for _, e in ipairs(pack.execs) do
				if (e.riser == true) == wantRiser then cfg = e break end
			end
			cfg = cfg or pack.execs[1]
		end

		local track = Kit.get(st.animator, A(cfg.attacker))
		if not track then return end -- a failed attempt does not start a lockout
		local speedKey = tostring(cfg.attacker) .. "|" .. tostring(Kit.idOf(original) or "?")
		local savedSpeed = execSpeeds[speedKey] -- measured on an earlier execution (or an earlier session)

		execLocked, execLockedAt, triggerIdleSince = true, now, nil
		local myPack = active
		task.spawn(function()
			-- if the clip is not loaded yet, wait for it so it does not start late (after the kill)
			local t0 = os.clock()
			while not savedSpeed and track.Length <= 0 and os.clock() - t0 < 0.75 do task.wait() end
			if active ~= myPack then return end

			-- AUTO SPEED-UP for every pack: match the replacement to the remaining duration of the game's execution.
			-- AnimationTrack.Length is the clip's base length; original.Speed accounts for the game's playback rate.
			local speed = 1
			if savedSpeed then
				speed = savedSpeed
			else
				local theirs = original.Length / math.max(original.Speed, 0.05)
				if theirs <= 0.2 and original.Length > 0 then theirs = original.Length end
				if track.Length > 0 and theirs > 0.2 then
					local ratio = track.Length / theirs
					if ratio > 1.03 then speed = math.min(ratio, MAX_EXEC_SPEED) end
					rememberExecSpeed(speedKey, speed) -- only a real measurement is saved (both clips were loaded)
				end
			end

			if track.IsPlaying then track:Stop(0) end
			track.Priority = Enum.AnimationPriority.Action4
			track.Looped = false
			execTrack = track
			Kit.claim(track, "exec")
			track:Play(0.05, 1, speed)
			if equipGilbertItemForExecution then equipGilbertItemForExecution(st.char, track) end
			Shared.execUntil = os.clock() + math.max(track.Length / speed, 2) + 1
			track.Stopped:Once(function()
				if execTrack == track then execTrack = nil end
			end)

			-- our execution sound: tagged as ours (never muted by "Mute exec sounds") and only ever one at a time
			if cfg.sound and WEAPON_SOUNDS then
				local soundSpeed = 1 -- execution sounds always play at normal speed (only the animations are sped up)
				Kit.execSfx(A(cfg.sound), 1, st.char:FindFirstChild("HumanoidRootPart"), soundSpeed)
				-- Gilbert's execution has a second randomized sound layer in the original pack.
				if cfg.extraSounds and #cfg.extraSounds > 0 then
					local extraId = cfg.extraSounds[rng:NextInteger(1, #cfg.extraSounds)]
					task.delay(0.08, function()
						Kit.execSfx(A(extraId), 1, st.char:FindFirstChild("HumanoidRootPart"), soundSpeed)
					end)
				end
			end

			-- the victim may not be in range on the very first frame, so retry briefly
			local victim = Kit.nearestVictim(st.char, VICTIM_RANGE)
			if not victim then
				for _ = 1, 8 do
					task.wait(0.05)
					victim = Kit.nearestVictim(st.char, VICTIM_RANGE)
					if victim then break end
				end
			end
			if victim and active == myPack then
				Kit.playOnVictim(victim, A(cfg.victim), { fadeIn = 0.05, owner = "viral", speed = speed })
			end
		end)
	end

	local function onTrack(st, track, fromEvent)
		if Kit.matches(track, TRIGGERS) then
			if not st.handled[track] then
				st.handled[track] = true
				track.Stopped:Once(function()
					st.handled[track] = nil
					st.muted[track] = nil
				end)
				playExec(st, track)
			end
		else
			swingMove(st, track, fromEvent)
		end
	end

	---------------------------------------------------------------- per-frame step (only while a pack is on)
	local function scanState(st)
		local anyTrigger = false
		local wantDemote = LOCO_PRIORITY.Value >= Enum.AnimationPriority.Action3.Value and st.locoKey ~= nil and st.locoKey ~= "idle" -- only a HIGH priority walk / run pushes the game's loops under (off while LOCO_PRIORITY is low)
		for _, t in ipairs(st.animator:GetPlayingAnimationTracks()) do
			if Kit.matches(t, TRIGGERS) then
				anyTrigger = true
				if not st.handled[t] then onTrack(st, t, false) end
			else
				local id = Kit.idOf(t)
				if id and Kit.viral.swingIds[id] then
					swingMove(st, t, false)
				elseif wantDemote and t.IsPlaying and t.Looped and not st.own[t] and not Kit.protect[t]
					and not Kit.live[t] and not SIN_OWN[id or ""] then
					-- a looped game animation at Action3 or above (the game's own run loop ...) would beat ours: push it under
					local pr = t.Priority
					if pr ~= Enum.AnimationPriority.Core and pr.Value >= Enum.AnimationPriority.Action3.Value then
						Kit.demote(t, "viralrun")
					end
				end
			end
		end
		return anyTrigger
	end

	local function step()
		if not active then return end
		local now = os.clock()
		local scan = now >= nextScan
		local anyTrigger = false
		if scan then nextScan = now + 0.04 end
		for _, st in pairs(states) do
			if scan then
				if scanState(st) then anyTrigger = true end
			end
			locoStep(st, now)
			for orig in pairs(st.muted) do -- the game's silenced tracks stay silenced
				if orig.IsPlaying and orig.WeightTarget > 0 then orig:AdjustWeight(0, 0) end
			end
		end
		if scan then anyTriggerCached = anyTrigger end

		-- re-arm for the next execution once the game's execution tracks have been gone for EXEC_GAP
		if anyTriggerCached or (execTrack and execTrack.IsPlaying) then
			triggerIdleSince = nil
		elseif execLocked then
			triggerIdleSince = triggerIdleSince or now
			if now - triggerIdleSince >= EXEC_GAP then
				execLocked = false
				triggerIdleSince = nil
			end
		end
	end

	---------------------------------------------------------------- hooking the character
	local function releaseState(st)
		stopLoco(st)
		for orig in pairs(st.muted) do
			pcall(function() if orig.IsPlaying then orig:AdjustWeight(1, 0.15) end end)
		end
		table.clear(st.muted)
		table.clear(st.handled)
		local lr = st.lock.rep
		if lr and lr.IsPlaying then lr:Stop(0.1) end
		st.lock.rep, st.lock.startedAt, st.lock.stopToken, st.lock.origs = nil, nil, nil, nil
		if st.conn then st.conn:Disconnect() st.conn = nil end
		if st.dconn then st.dconn:Disconnect() st.dconn = nil end
	end

	local function hookAnimator(a, model, hum)
		if states[a] then return end
		local pack = PACKS[active]
		if not pack then return end
		local st = {
			animator = a, char = model, hum = hum, root = model:FindFirstChild("HumanoidRootPart"), pack = pack,
			lock = {}, handled = {}, muted = {}, retry = {},
			own = setmetatable({}, { __mode = "k" }),
			entry = { loop = false, start = 0, speed = pack.speed or 1, override = pack.weapon or nil, owner = "viral", hitLockout = 0.05, refractory = 0.02, trimEnd = {} },
		}
		states[a] = st

		for _, k in ipairs({ "idle", "walk", "run" }) do if pack[k] then Kit.warm(a, A(pack[k])) end end
		for _, id in ipairs(pack.swingIds) do Kit.warm(a, id) end
		for _, e in ipairs(pack.execs) do Kit.warm(a, A(e.attacker)) end
		if pack.stun then
			for _, id in ipairs(pack.stun.begin or {}) do Kit.warm(a, A(id)) end
			if pack.stun.idle then Kit.warm(a, A(pack.stun.idle)) end
			if pack.stun.getup then Kit.warm(a, A(pack.stun.getup)) end
		end

		st.conn = a.AnimationPlayed:Connect(function(t) onTrack(st, t, true) end)
		st.dconn = a.Destroying:Once(function()
			if st.conn then st.conn:Disconnect() st.conn = nil end
			states[a] = nil
		end)
		for _, t in ipairs(a:GetPlayingAnimationTracks()) do onTrack(st, t, false) end -- already playing right now
	end

	local function hookModel(model)
		if not model then return end
		local key = active
		task.spawn(function()
			local hum = model:FindFirstChildOfClass("Humanoid") or model:WaitForChild("Humanoid", 10)
			local a = hum and (hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 10))
			if a and active == key and key then hookAnimator(a, model, hum) end
		end)
	end

	local function preload(pack)
		task.spawn(function()
			local assets = {}
			local function add(id)
				local a = Instance.new("Animation")
				a.AnimationId = A(id)
				assets[#assets + 1] = a
			end
			for _, k in ipairs({ "idle", "walk", "run" }) do if pack[k] then add(pack[k]) end end
			for _, id in ipairs(pack.swings) do add(id) end
			for _, e in ipairs(pack.execs) do add(e.attacker) add(e.victim) end
			if pack.stun then
				for _, id in ipairs(pack.stun.begin or {}) do add(id) end
				if pack.stun.idle then add(pack.stun.idle) end
				if pack.stun.getup then add(pack.stun.getup) end
			end
			pcall(function() ContentProvider:PreloadAsync(assets) end)
			for _, a in ipairs(assets) do a:Destroy() end
		end)
	end

	---------------------------------------------------------------- on / off
	local function deactivate()
		Kit.viral.on = false
		Kit.viral.loco = false
		table.clear(Kit.viral.swingIds)
		Kit.viral.stun = nil
		for tr in pairs(extraTracks) do pcall(function() if tr.IsPlaying then tr:Stop(0.1) end end) end
		table.clear(extraTracks)
		if stepConn then stepConn:Disconnect() stepConn = nil end
		for _, c in ipairs(conns) do c:Disconnect() end
		table.clear(conns)
		for a, st in pairs(states) do
			releaseState(st)
			states[a] = nil
		end
		local ex = execTrack
		execTrack = nil
		if ex and ex.IsPlaying then ex:Stop(0.1) end
		execLocked, triggerIdleSince, anyTriggerCached = false, nil, false
		Kit.stopVictims("viral")
		Kit.restore("viral")
		Kit.restore("viralrun")
	end

	local function activate(key)
		local pack = PACKS[key]
		if pack.weapon then findWeaponAnims(pack) end
		Kit.viral.on = true
		Kit.viral.loco = (pack.idle or pack.walk or pack.run) ~= nil
		Kit.viral.stun = pack.stun -- the 300 DMG STUN card plays these stun animations while the pack is on
		for _, id in ipairs(SWING_TRIGGERS) do Kit.viral.swingIds[id] = true end
		if pack.weapon then Kit.viral.swingIds[EXTRA_SWING_ID] = true end -- the 3rd game swing too
		preload(pack)
		conns[#conns + 1] = LocalPlayer.CharacterAdded:Connect(hookModel)
		local folder = Workspace:FindFirstChild("Characters")
		if folder then
			conns[#conns + 1] = folder.ChildAdded:Connect(function(c)
				if c.Name == LocalPlayer.Name then hookModel(c) end
			end)
		end
		hookModel(LocalPlayer.Character)
		local m = folder and folder:FindFirstChild(LocalPlayer.Name)
		if m and m ~= LocalPlayer.Character then hookModel(m) end
		stepConn = RunService.RenderStepped:Connect(step)
	end

	-- PlayExtra("Name"): plays one of the active pack's extra animations (charge / rage / backstab / defeat ...) on you.
	-- PlayExtra() prints the names. Calling a looped one again stops it.
	local EXTRA_LOOPED = { ChargeCycle = true, RageIdle = true, Charge = true, BackstabStunCycle = true }
	env.PlayExtra = function(name)
		local pack = active and PACKS[active]
		local list = pack and pack.extras
		if not list then warn("[PlayExtra] turn on D-ZERO / DAVE / GILBERT first") return nil end
		if not name then
			local names = {}
			for n in pairs(list) do names[#names + 1] = n end
			table.sort(names)
			print("[PlayExtra] " .. pack.title .. ": " .. table.concat(names, ", "))
			return nil
		end
		local id = list[name]
		if not id then warn("[PlayExtra] unknown animation " .. tostring(name)) return nil end
		for _, st in pairs(states) do
			local tr = Kit.get(st.animator, A(id))
			if tr then
				if tr.IsPlaying then tr:Stop(0.1) extraTracks[tr] = nil return tr end
				tr.Priority = Enum.AnimationPriority.Action4
				tr.Looped = EXTRA_LOOPED[name] == true
				st.own[tr] = true -- ours: the pack's looped-animation demoter leaves it alone
				extraTracks[tr] = true
				tr:Play(0.1, 1, 1)
				return tr
			end
		end
		return nil
	end

	local setVis = {}
	local setWeaponMode, weaponIndex = nil, {}
	local function setActive(key)
		if key == active then return end
		if active then deactivate() end
		active = key
		if key then activate(key) end
		for k, f in pairs(setVis) do f(k == key) end
		if setWeaponMode then setWeaponMode(weaponIndex[key or ""] or 1) end
	end

	for _, k in ipairs(WEAPON_ORDER) do
		local pack = PACKS[k]
		pack.swingIds = {}
		for i, id in ipairs(pack.swings) do pack.swingIds[i] = A(id) end
	end

	for _, k in ipairs(ORDER) do
		local pack = PACKS[k]
		pack.swingIds = {}
		for i, id in ipairs(pack.swings) do pack.swingIds[i] = A(id) end
		setVis[k] = makeToggleCard(pack.gui, pack.card, pack.title, pack.size, pack.color, pack.y, function()
			if active == k then setActive(nil) else setActive(k) end -- (v45 used "active == k and nil or k", which never switched off)
			return active == k
		end)
		-- long names (VIRAL EXECUTIONER): shrink the title to fit the card
		local g = PlayerGui:FindFirstChild(pack.gui)
		local card = g and g:FindFirstChild(pack.card)
		if card then
			for _, d in ipairs(card:GetChildren()) do
				if d:IsA("TextLabel") and d.Text == pack.title then
					d.Size = UDim2.new(0, 80, 0, 18)
					d.TextScaled = true
					local c = Instance.new("UITextSizeConstraint")
					c.MaxTextSize = pack.size
					c.Parent = d
				end
			end
		end
		-- Settings hides this button -> make sure the feature is really off too
		FeatureHooks[pack.key] = function()
			if active == k then setActive(nil) end
			setVis[k](false)
		end
	end

	-- GILBERT EXECUTION ITEM: pick a Tool; it is equipped only during Gilbert executions.
	-- A normal card (looks like the other cards, is moved / scaled in the layout editor and hidden from Settings).
	-- The choice is saved by tool NAME in gilbert_item.json, so it survives respawns and re-executing the script.
	local ITEM_FILE = "gilbert_item.json"
	local ITEM_COLOR = PACKS.gilbert.color
	local gilbertItemName = nil
	pcall(function()
		if not (isfile and readfile and isfile(ITEM_FILE)) then return end
		local d = HttpService:JSONDecode(readfile(ITEM_FILE))
		if type(d) == "table" and type(d.name) == "string" and d.name ~= "" then gilbertItemName = d.name end
	end)
	local function saveGilbertItem()
		if not writefile then return end
		pcall(writefile, ITEM_FILE, HttpService:JSONEncode({ name = gilbertItemName or "" }))
	end

	local function getInventoryTools()
		local list = {}
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		if backpack then for _, obj in ipairs(backpack:GetChildren()) do if obj:IsA("Tool") then list[#list + 1] = obj end end end
		local char = LocalPlayer.Character
		if char then for _, obj in ipairs(char:GetChildren()) do if obj:IsA("Tool") then list[#list + 1] = obj end end end
		table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)
		return list
	end
	-- the tool that goes with the saved name right now (tool objects change on respawn, the name does not)
	local function findGilbertItem()
		if not gilbertItemName then return nil end
		for _, tool in ipairs(getInventoryTools()) do
			if tool.Name == gilbertItemName then return tool end
		end
		return nil
	end

	local gilbertEquipGui = Instance.new("ScreenGui")
	gilbertEquipGui.Name = "GilbertExecItemGui"
	gilbertEquipGui.ResetOnSpawn = false
	gilbertEquipGui.Parent = PlayerGui

	local itemCard = Instance.new("TextButton")
	itemCard.Name = "GilbertExecItem"
	itemCard.Size = UDim2.new(0, 156, 0, 46)
	itemCard.Position = UDim2.new(0.02, 0, 0.45, 1712) -- the layout editor moves it into the grid
	itemCard.BackgroundColor3 = Color3.fromRGB(8, 8, 10)
	itemCard.BackgroundTransparency = 0.3
	itemCard.BorderSizePixel = 0
	itemCard.AutoButtonColor = false
	itemCard.Text = ""
	itemCard.Parent = gilbertEquipGui
	Instance.new("UICorner", itemCard).CornerRadius = UDim.new(1, 0)

	local itemStroke = Instance.new("UIStroke")
	itemStroke.Color = Color3.fromRGB(235, 235, 240)
	itemStroke.Thickness = 1
	itemStroke.Transparency = 0.55
	itemStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	itemStroke.Parent = itemCard

	local itemScale = Instance.new("UIScale")
	itemScale.Parent = itemCard

	local itemTitle = Instance.new("TextLabel")
	itemTitle.BackgroundTransparency = 1
	itemTitle.Size = UDim2.new(0, 120, 0, 18)
	itemTitle.Position = UDim2.new(0, 20, 0, 7)
	itemTitle.Font = Enum.Font.GothamMedium
	itemTitle.Text = "GILBERT ITEM"
	itemTitle.TextSize = 11
	itemTitle.TextColor3 = Color3.fromRGB(240, 240, 248)
	itemTitle.TextXAlignment = Enum.TextXAlignment.Left
	itemTitle.Parent = itemCard

	local itemStatus = Instance.new("TextLabel")
	itemStatus.BackgroundTransparency = 1
	itemStatus.Size = UDim2.new(0, 116, 0, 14)
	itemStatus.Position = UDim2.new(0, 20, 0, 25)
	itemStatus.Font = Enum.Font.GothamMedium
	itemStatus.TextSize = 10
	itemStatus.TextXAlignment = Enum.TextXAlignment.Left
	itemStatus.TextTruncate = Enum.TextTruncate.AtEnd
	itemStatus.Parent = itemCard

	local itemArrow = Instance.new("TextLabel")
	itemArrow.BackgroundTransparency = 1
	itemArrow.AnchorPoint = Vector2.new(1, 0.5)
	itemArrow.Size = UDim2.new(0, 16, 0, 20)
	itemArrow.Position = UDim2.new(1, -14, 0.5, 0)
	itemArrow.Font = Enum.Font.GothamBold
	itemArrow.Text = "›"
	itemArrow.TextSize = 18
	itemArrow.TextColor3 = GREY_TEXT
	itemArrow.Parent = itemCard

	local function renderItemCard()
		local has = gilbertItemName ~= nil
		itemStatus.Text = has and gilbertItemName or "NONE"
		tween(itemStatus, 0.2, { TextColor3 = has and ITEM_COLOR or GREY_TEXT })
		tween(itemArrow, 0.2, { TextColor3 = has and ITEM_COLOR or GREY_TEXT })
		tween(itemStroke, 0.2, { Color = has and ITEM_COLOR or Color3.fromRGB(235, 235, 240), Transparency = has and 0.05 or 0.55 })
	end
	renderItemCard()

	itemCard.MouseEnter:Connect(function() tween(itemScale, 0.12, { Scale = 1.05 }) end)
	itemCard.MouseLeave:Connect(function() tween(itemScale, 0.12, { Scale = 1 }) end)
	itemCard.MouseButton1Down:Connect(function() tween(itemScale, 0.08, { Scale = 0.95 }) end)
	itemCard.MouseButton1Up:Connect(function() tween(itemScale, 0.1, { Scale = 1.05 }) end)
	-- tap: NONE -> tool 1 -> tool 2 ... -> last tool -> NONE
	itemCard.MouseButton1Click:Connect(function()
		local names, seen = {}, {}
		for _, t in ipairs(getInventoryTools()) do
			if not seen[t.Name] then seen[t.Name] = true names[#names + 1] = t.Name end
		end
		local idx = 0
		for i, n in ipairs(names) do if n == gilbertItemName then idx = i break end end
		gilbertItemName = names[idx + 1] -- nil past the last tool = NONE
		saveGilbertItem()
		renderItemCard()
	end)
	-- Settings hides this card -> the item is cleared too
	FeatureHooks.gilbert_item = function()
		gilbertItemName = nil
		saveGilbertItem()
		renderItemCard()
	end

	equipGilbertItemForExecution = function(char, track)
		if active ~= "gilbert" then return end
		local selected = findGilbertItem()
		if not selected or not selected.Parent then return end
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if not humanoid then return end
		local previous = nil
		for _, obj in ipairs(char:GetChildren()) do if obj:IsA("Tool") then previous = obj break end end
		local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
		pcall(function() humanoid:EquipTool(selected) end)
		local restored = false
		local function restore()
			if restored then return end
			restored = true
			pcall(function() if humanoid.Parent and selected.Parent == char then humanoid:UnequipTools() end end)
			if previous and backpack and previous.Parent == backpack then pcall(function() humanoid:EquipTool(previous) end) end
		end
		track.Stopped:Once(restore)
		task.delay(math.max(track.Length / math.max(track.Speed, 0.05), 1) + 2, restore)
	end
	onCleanup(function() if gilbertEquipGui then gilbertEquipGui:Destroy() end end)

	-- WEAPON card: tap to go to the next weapon (OFF -> VIRAL FISTS -> EXO (SAL) -> ... -> OFF)
	local wmodes = { { label = "OFF", color = Color3.fromRGB(150, 150, 160) } }
	for i, k in ipairs(WEAPON_ORDER) do
		wmodes[i + 1] = { label = PACKS[k].title, color = PACKS[k].color }
		weaponIndex[k] = i + 1
	end
	local _, setMode = makeCycleCard("WeaponPackGui", "WeaponPack", "WEAPON", wmodes, 1, 1432, function(i)
		if i == 1 then setActive(nil) else setActive(WEAPON_ORDER[i - 1]) end
	end)
	setWeaponMode = setMode
	-- Settings hides this card -> make sure the weapon is really off too
	FeatureHooks.weapon_pack = function()
		if active and PACKS[active] and PACKS[active].weapon then setActive(nil) end
		setWeaponMode(1)
	end

	onCleanup(function() if active then setActive(nil) end env.PlayExtra = nil end)
end)

runSection("28", function()
	local SAVE_FILE = "rif_dodge.json"
	local ACCENT = Color3.fromRGB(80, 200, 255)
	local PANEL_BG = Color3.fromRGB(20, 20, 27)
	local ROW_BG = Color3.fromRGB(32, 32, 42)
	local BTN_BG = Color3.fromRGB(46, 46, 60)
	local TXT = Color3.fromRGB(240, 240, 248)
	local HANG_NAME = "__RifDodgeHang"
	local BURST_NAME = "__RifDodgeBurst"

	local DEFAULTS = { chance = 90, cooldown = 2, speed = 10, burst = 0.15, hang = true, anim = "RANDOM" }
	local cfg = {}
	for k, v in pairs(DEFAULTS) do cfg[k] = v end

	pcall(function()
		if not (isfile and readfile and isfile(SAVE_FILE)) then return end
		local d = HttpService:JSONDecode(readfile(SAVE_FILE))
		if type(d) ~= "table" then return end
		for k, v in pairs(DEFAULTS) do
			if type(d[k]) == type(v) then cfg[k] = d[k] end
		end
	end)

	local function saveCfg()
		if writefile then pcall(writefile, SAVE_FILE, HttpService:JSONEncode(cfg)) end
	end

	local function animList()
		local node = ReplicatedStorage
		for _, n in ipairs({ "Assets", "Framework", "RIF", "RIF_dodge", "DodgeAnimations" }) do
			node = node and node:FindFirstChild(n)
		end
		local list = {}
		if node then
			for _, c in ipairs(node:GetChildren()) do
				if c:IsA("Animation") then list[#list + 1] = c end
			end
		end
		table.sort(list, function(a, b) return a.Name < b.Name end)
		return list
	end

	local enabled = false
	local generation = 0
	local charConn = nil
	local state = { char = nil, hum = nil, root = nil, animator = nil, oldHealth = 0, canDodge = true, tracks = {}, animConns = {}, current = nil, healthConn = nil }

	local function disconnectAnim()
		for _, c in ipairs(state.animConns) do pcall(function() c:Disconnect() end) end
		table.clear(state.animConns)
	end

	local function clearOwn()
		local root = state.root
		if not root then return end
		for _, o in ipairs(root:GetChildren()) do
			if o.Name == HANG_NAME or o.Name == BURST_NAME then o:Destroy() end
		end
	end

	local function burst(velocity)
		local root = state.root
		if not (root and root.Parent) then return end
		clearOwn()
		local bv = Instance.new("BodyVelocity")
		bv.Name = BURST_NAME
		bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bv.Velocity = velocity
		bv.Parent = root
		task.delay(cfg.burst, function()
			if bv.Parent then bv:Destroy() end
		end)
	end

	local function canPlay()
		if Kit.stunBusy then return false end -- stunned (300 DMG STUN): no dodging out of the stun
		local hum, char = state.hum, state.char
		if not (hum and char and char.Parent) or hum.Health <= 0 then return false end
		if char:FindFirstChild("BeingExecuted") or char:FindFirstChild("__IsBashed") then return false end
		for _, name in ipairs({ "Tased", "IsBusyResurrecting", "IsExecuting" }) do
			local v = char:FindFirstChild(name)
			if v and v:IsA("BoolValue") and v.Value then return false end
		end
		return true
	end

	local function dodge()
		if not canPlay() then return false end
		local list = animList()
		if #list == 0 then return false end

		state.canDodge = false
		task.delay(cfg.cooldown, function() state.canDodge = true end)

		local pick = nil
		if cfg.anim ~= "RANDOM" then
			for _, a in ipairs(list) do
				if a.Name == cfg.anim then pick = a break end
			end
		end
		pick = pick or list[math.random(1, #list)]

		disconnectAnim()
		if state.current then pcall(function() state.current:Stop() end) end
		clearOwn()

		local track = state.tracks[pick]
		if not track then
			track = state.animator:LoadAnimation(pick)
			state.tracks[pick] = track
		end
		state.current = track

		local root = state.root
		if cfg.hang then
			local hang = Instance.new("BodyVelocity")
			hang.Name = HANG_NAME
			hang.MaxForce = Vector3.new(math.huge, 0, math.huge)
			hang.Velocity = Vector3.zero
			hang.Parent = root
		end

		local speed = cfg.speed
		local lastSide = nil
		table.insert(state.animConns, track:GetMarkerReachedSignal("DodgeToLeft"):Connect(function()
			lastSide = "Left"
			local cf = root.CFrame
			burst(-cf.RightVector * speed + cf.LookVector * speed * 0.5)
		end))
		table.insert(state.animConns, track:GetMarkerReachedSignal("DodgeToRight"):Connect(function()
			lastSide = "Right"
			local cf = root.CFrame
			burst(cf.RightVector * speed + cf.LookVector * speed * 0.5)
		end))
		table.insert(state.animConns, track:GetMarkerReachedSignal("DodgeToOriginalPos"):Connect(function()
			local cf = root.CFrame
			local side = (lastSide == "Right") and -cf.RightVector or cf.RightVector
			burst(side * speed + cf.LookVector * speed * 0.5)
		end))
		table.insert(state.animConns, track.Stopped:Connect(function()
			disconnectAnim()
			clearOwn()
			if state.current == track then state.current = nil end
		end))

		track:Play()
		return true
	end

	local function detach()
		if state.healthConn then
			state.healthConn:Disconnect()
			state.healthConn = nil
		end
		disconnectAnim()
		if state.current then
			pcall(function() state.current:Stop() end)
			state.current = nil
		end
		clearOwn()
		state.char, state.hum, state.root, state.animator = nil, nil, nil, nil
		state.canDodge = true
		table.clear(state.tracks)
	end

	local function attach(char, myGeneration)
		local hum = char:WaitForChild("Humanoid", 10)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not (hum and root) or myGeneration ~= generation then return end
		detach()
		state.char, state.hum, state.root = char, hum, root
		state.animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
		state.oldHealth = hum.Health
		state.healthConn = hum.HealthChanged:Connect(function(health)
			if health <= 0 then
				disconnectAnim()
				if state.current then pcall(function() state.current:Stop() end) state.current = nil end
				clearOwn()
				return
			end
			if health < state.oldHealth and state.canDodge and math.random() * 100 < cfg.chance then
				pcall(dodge)
			end
			state.oldHealth = health
		end)
	end

	local function setEnabled(on)
		enabled = on
		generation += 1
		if charConn then
			charConn:Disconnect()
			charConn = nil
		end
		detach()
		if on then
			local g = generation
			charConn = LocalPlayer.CharacterAdded:Connect(function(c) task.spawn(attach, c, g) end)
			if LocalPlayer.Character then task.spawn(attach, LocalPlayer.Character, g) end
		end
	end

	-- dodge AND parry are the RIF dodge (character packs have no dodge / parry of their own): PlayDodge() / PlayParry() run it on demand
	local function rifDodgeNow()
		if not enabled then return false end
		return dodge()
	end
	Kit.rifDodge = rifDodgeNow
	env.PlayDodge, env.PlayParry = rifDodgeNow, rifDodgeNow

	local setVisual
	setVisual = makeToggleCard("RifDodgeGui", "RifDodgeToggle", "RIF DODGE", 11, ACCENT, 1260, function()
		setEnabled(not enabled)
		return enabled
	end)

	FeatureHooks.rifdodge = function()
		setEnabled(false)
		setVisual(false)
	end
	onCleanup(function() setEnabled(false) env.PlayDodge, env.PlayParry, Kit.rifDodge = nil, nil, nil end)

	local setGui = Instance.new("ScreenGui")
	setGui.Name = "RifDodgeSetGui"
	setGui.ResetOnSpawn = false
	setGui.DisplayOrder = 300
	setGui.Parent = PlayerGui

	local setButton = Instance.new("TextButton")
	setButton.Name = "RifDodgeSetButton"
	setButton.Size = UDim2.fromOffset(156, 34)
	setButton.Position = UDim2.new(0.02, 0, 0.45, 1310)
	setButton.BackgroundColor3 = PANEL_BG
	setButton.TextColor3 = TXT
	setButton.Font = Enum.Font.GothamBold
	setButton.TextSize = 10
	setButton.Text = "DODGE SETTINGS"
	setButton.Parent = setGui
	Instance.new("UICorner", setButton).CornerRadius = UDim.new(0, 8)

	local panelGui = Instance.new("ScreenGui")
	panelGui.Name = "RifDodgePanelGui"
	panelGui.ResetOnSpawn = false
	panelGui.IgnoreGuiInset = true
	panelGui.DisplayOrder = 400
	panelGui.Parent = PlayerGui

	local panel = Instance.new("Frame")
	panel.BackgroundColor3 = PANEL_BG
	panel.BorderSizePixel = 0
	panel.Active = true
	panel.Visible = false
	panel.ZIndex = 60
	panel.Parent = panelGui
	Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 10)

	local panelStroke = Instance.new("UIStroke")
	panelStroke.Color = ACCENT
	panelStroke.Transparency = 0.4
	panelStroke.Thickness = 1.5
	panelStroke.Parent = panel

	local function place()
		local cam = workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(800, 450)
